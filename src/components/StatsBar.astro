---
---
<div class="stat-strip">
  <div class="stat">
    <span class="stat-num">$328K</span>
    <span class="stat-label">avg. annual revenue leak</span>
  </div>
  <div class="stat">
    <span class="stat-num">4</span>
    <span class="stat-label">documented failure modes</span>
  </div>
  <div class="stat">
    <span class="stat-num">36%</span>
    <span class="stat-label">of businesses fail here</span>
  </div>
  <div class="stat">
    <span class="stat-num">23+</span>
    <span class="stat-label">retainer clients diagnosed</span>
  </div>
</div>

<style>
  .stat-strip {
    padding: 28px 32px;
    background: rgba(255,255,255,0.03);
    border-top: 1px solid rgba(201,168,76,0.12);
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
    animation: fadeUp 0.6s 0.35s ease both;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .stat-num {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 700;
    color: #c9a84c;
    line-height: 1;
  }
  .stat-label {
    font-size: 12px;
    color: #8ba3bf;
    letter-spacing: 0.06em;
    font-weight: 400;
  }
  @media (max-width: 480px) {
    .stat-strip { padding: 24px 20px; gap: 28px; }
    .stat-num { font-size: 24px; }
  }
</style>
