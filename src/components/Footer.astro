<footer>
  <div class="footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="footer-name">Marketing Performance Group</span>
        <span class="footer-sub">Powered by EngageEngine™</span>
        <div class="footer-contact">
          <a href="mailto:robert@marketingperformance.net">robert@marketingperformance.net</a>
          <span>Columbia, South Carolina</span>
        </div>
      </div>
      <nav class="footer-nav">
        <a href="/diagnostic/">Free Diagnostic →</a>
        <a href="/toolkit">Free Toolkit — 30 Tools</a>
        <a href="/the-build">The Build</a>
        <a href="/videos">Watch</a>
        <a href="https://marketingperformance.net/score">AI Visibility</a>
        <a href="/b2b">B2B</a>
      </nav>
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} marketingperformance.net · All rights reserved. · <a href="/privacy" class="footer-legal-link">Privacy Policy</a></p>
    </div>
  </div>
</footer>

<style>
  footer {
    background: var(--white);
    border-top: 1px solid var(--border);
    padding: 48px 22px 32px;
  }
  .footer-inner { max-width: 1200px; margin: 0 auto; }
  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: 40px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }
  .footer-brand { display: flex; flex-direction: column; gap: 4px; }
  .footer-name {
    font-family: var(--font-t);
    font-size: 14px;
    font-weight: 600;
    color: var(--graphite);
  }
  .footer-sub {
    font-family: var(--font-t);
    font-size: 12px;
    font-weight: 400;
    color: var(--mid-gray);
  }
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 12px;
  }
  .footer-contact a, .footer-contact span {
    font-family: var(--font-t);
    font-size: 13px;
    color: var(--mid-gray);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-contact a:hover { color: var(--blue-link); }
  .footer-nav {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .footer-nav a {
    font-family: var(--font-t);
    font-size: 13px;
    color: var(--mid-gray);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-nav a:first-child { color: var(--blue-link); font-weight: 500; }
  .footer-nav a:hover { color: var(--blue-link); }
  .footer-bottom {
    border-top: 1px solid var(--border);
    padding-top: 20px;
  }
  .footer-bottom p {
    font-family: var(--font-t);
    font-size: 12px;
    color: var(--mid-gray);
  }
  .footer-legal-link {
    color: var(--mid-gray);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-legal-link:hover { color: var(--blue-link); }
</style>
