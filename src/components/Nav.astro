---
<nav>
  <div class="nav-inner">
    <a href="/" class="logo">
      <img src="/mp-logo-v3.png" alt="Marketing Performance — Powered by EngageEngine™" width="217" height="44" />
    </a>
    <div class="nav-right">
      <a href="/the-build" class="nav-link">The Build</a>
      <a href="/toolkit" class="nav-link">Free Toolkit</a>
      <a href="https://marketingperformance.net/score" class="nav-link">AI Visibility</a>
      <a href="/diagnostic/" class="nav-cta">Free Diagnostic →</a>
    </div>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255,255,255,0.85);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 22px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    display: flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .logo img {
    height: 44px;
    width: auto;
    display: block;
  }
  .logo:hover { text-decoration: none; }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .nav-link {
    font-family: var(--font-t);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--graphite);
    text-decoration: none;
    min-height: 44px;
    display: flex;
    align-items: center;
    transition: color 0.15s;
  }
  .nav-link:hover { color: var(--blue); text-decoration: none; }
  .nav-cta {
    font-family: var(--font-t);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--blue-link);
    text-decoration: none;
    min-height: 44px;
    display: flex;
    align-items: center;
    transition: color 0.15s;
  }
  .nav-cta:hover { color: var(--blue); text-decoration: none; }
  @media (max-width: 600px) {
    .nav-link { display: none; }
    .nav-inner { padding: 0 16px; }
    .logo img { height: 34px; }
  }
</style>
