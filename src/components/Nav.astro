---
---
<nav>
  <div class="nav-inner">
    <a href="/" class="logo">
      Marketing Performance Group
      <span class="logo-sub">Powered by EngageEngine™</span>
    </a>
    <div class="nav-right">
      <a href="/the-build" class="nav-link">The Build</a>
      <a href="/toolkit" class="nav-link">Free Toolkit</a>
      <a href="/diagnostic/" class="nav-cta">Free Diagnostic →</a>
    </div>
  </div>
</nav>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255,255,255,0.85);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 22px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .logo {
    font-family: var(--font-t);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--graphite);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-height: 44px;
    justify-content: center;
  }
  .logo:hover { text-decoration: none; color: var(--graphite); }
  .logo-sub {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--mid-gray);
  }
  .nav-right {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .nav-link {
    font-family: var(--font-t);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--graphite);
    text-decoration: none;
    min-height: 44px;
    display: flex;
    align-items: center;
    transition: color 0.15s;
  }
  .nav-link:hover { color: var(--blue); text-decoration: none; }
  .nav-cta {
    font-family: var(--font-t);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--blue-link);
    text-decoration: none;
    min-height: 44px;
    display: flex;
    align-items: center;
    transition: color 0.15s;
  }
  .nav-cta:hover { color: var(--blue); text-decoration: none; }
  @media (max-width: 600px) {
    .nav-link { display: none; }
    .nav-inner { padding: 0 16px; }
  }
</style>
