---
export const prerender = false
import Base from '../../layouts/Base.astro'
import Footer from '../../components/Footer.astro'

const cf = (Astro.locals as any).runtime?.cf
const detectedCity   = cf?.city   || ''
const detectedRegion = cf?.region || cf?.regionCode || ''
const detectedLocation = detectedCity
  ? (detectedRegion ? `${detectedCity}, ${detectedRegion}` : detectedCity)
  : ''
const displayMarket = detectedLocation || 'your market'

// Formspree endpoint — reuses the snapshot inbox; form_type field distinguishes recovery leads.
// TODO(robbie): swap to a dedicated Recovery Audit form id if you want separate routing.
const FORMSPREE_ID = 'mgodnjje'
---
<Base
  title="Demand Recovery — Marketing Performance Group"
  description="97% of the traffic you pay for leaves your website anonymous. We put real names and contact info to those buyers — and get them back before they call a competitor. Free Recovery Audit. No call required."
>
  <!-- Minimal top nav — logo only -->
  <nav class="mp-nav">
    <div class="mp-nav-inner">
      <a href="/" class="mp-logo">
        <img src="/mp-logo-v3.png" alt="Marketing Performance — Powered by EngageEngine™" width="217" height="44" />
      </a>
    </div>
  </nav>

  <main class="mp">

    <!-- ═══ 1. HERO — copy left, LIVE FORM right ═══ -->
    <section class="mp-hero">
      <div class="mp-hero-grid">
        <div class="mp-hero-copy">
          <h1 class="mp-h1">
            How many buyers are leaving your website without a trace?
          </h1>
          <p class="mp-hero-punch">
            Scan your site and find out.
          </p>
        </div>

        <!-- LIVE FORM — scan gate -->
        <div class="snap-card" id="recovery-form-card">

          <!-- STATE 1: URL gate -->
          <div id="recovery-card">
            <div class="snap-card-head">
              <span class="snap-card-eye">Free Recovery Audit · {displayMarket} · 24 Hours</span>
              <span class="snap-card-loc">{detectedLocation ? `Detected: ${detectedLocation}` : 'Detecting your market…'}</span>
            </div>

            <form id="recovery-scan-form" class="snap-form" novalidate>
              <label class="snap-sr-only" for="site-input">Your website</label>
              <p class="snap-sentence">
                Show me who's leaving
                <input
                  type="text"
                  name="website"
                  id="site-input"
                  placeholder="yoursite.com"
                  required
                  class="snap-inline-input"
                  autocomplete="off"
                  inputmode="url"
                />
                without calling.
              </p>

              <button type="submit" class="snap-btn" id="recovery-submit">
                <span>Scan My Site</span>
                <span class="snap-btn-arrow">→</span>
              </button>

              <p class="snap-micro">Takes 30 seconds. No email to see the result.</p>

              <div class="snap-scarcity">
                <span class="snap-scarcity-dot"></span>
                <span><strong>You can't recover traffic you already lost.</strong> Every day without it, that day's buyers are gone for good.</span>
              </div>
            </form>
          </div>

          <!-- STATE 2: reveal + email capture -->
          <div id="recovery-reveal" hidden>
            <div class="snap-card-head">
              <span class="snap-card-eye">Scan Complete · <span id="reveal-domain">your site</span></span>
              <span class="snap-card-loc">{displayMarket}</span>
            </div>
            <p class="rec-reveal-stat"><strong id="reveal-pct">97%</strong> of your visitors leave anonymous</p>
            <p class="rec-reveal-body">You're losing the overwhelming majority of the people you already pay to attract. We put a real name, email, and address to <strong>up to 80%</strong> of them. Your full Recovery Audit shows exactly who we can recover for <strong id="reveal-domain-2">your site</strong>.</p>
            <form id="recovery-email-form" class="snap-form" novalidate>
              <label class="snap-label" for="email-input">Where should we send your Recovery Audit?</label>
              <input
                type="email"
                name="email"
                id="email-input"
                placeholder="you@company.com"
                required
                class="snap-input"
                autocomplete="email"
                inputmode="email"
              />
              <button type="submit" class="snap-btn" id="recovery-email-submit">
                <span>Send My Recovery Audit</span>
                <span class="snap-btn-arrow">→</span>
              </button>
              <p class="snap-micro">Delivered within 24 hours. No call required.</p>
            </form>
          </div>

          <!-- STATE 3: confirmation -->
          <div id="recovery-done" hidden>
            <div class="snap-card-head">
              <span class="snap-card-eye">On Its Way</span>
              <span class="snap-card-loc">{displayMarket}</span>
            </div>
            <p class="rec-reveal-stat"><strong>✓</strong></p>
            <p class="rec-done-h">Your Recovery Audit is being built.</p>
            <p class="rec-reveal-body">We're scanning <strong id="done-domain">your site</strong> right now and will send your full audit — including how many buyers we can name — within 24 hours. Check your inbox. — Robbie</p>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══ 1.5 PROOF ARTIFACT — the leak, visualized ═══ -->
    <section class="mp-proof">
      <header class="mp-proof-head" data-animate>
        <h2 class="mp-proof-h">You already paid for the click. Then they vanished.</h2>
      </header>
      <figure class="mp-proof-inner" data-animate data-delay="0.1">
        <div class="rec-leak">
          <div class="rec-leak-row">
            <span class="rec-leak-label">Traffic you paid for</span>
            <span class="rec-leak-bar"><span class="rec-leak-fill rec-leak-100"></span></span>
            <span class="rec-leak-num">100%</span>
          </div>
          <div class="rec-leak-row">
            <span class="rec-leak-label">Filled out a form / called</span>
            <span class="rec-leak-bar"><span class="rec-leak-fill rec-leak-3"></span></span>
            <span class="rec-leak-num">~3%</span>
          </div>
          <div class="rec-leak-row rec-leak-ghost">
            <span class="rec-leak-label">Left anonymous — gone</span>
            <span class="rec-leak-bar"><span class="rec-leak-fill rec-leak-97"></span></span>
            <span class="rec-leak-num">~97%</span>
          </div>
        </div>
        <figcaption class="mp-proof-cap">
          <span class="mp-proof-cap-main"><strong>The leak</strong> · where your ad spend actually goes</span>
          <span class="mp-proof-cap-sub">Demand Recovery puts real names to up to 80% of them — before they call someone else.</span>
        </figcaption>
      </figure>
    </section>

    <!-- ═══ 2. ANCHOR TESTIMONIAL ═══ -->
    <section class="mp-anchor">
      <div class="mp-anchor-inner" data-animate>
        <div class="mp-anchor-photo">
          <img src="/img/rogerson.jpg" alt="McClintock HVAC" width="80" height="80" loading="lazy" decoding="async" />
        </div>
        <div class="mp-anchor-body">
          <p class="mp-anchor-quote">"Our cost per click dropped over 70%, clicks and engagement went up on our website, and in 30 days we doubled our booked appointments."</p>
          <p class="mp-anchor-attr"><strong>McClintock HVAC</strong> · Charlotte, NC</p>
          <div class="mp-anchor-stats">
            <span><strong>70%</strong> lower cost per click</span>
            <span class="mp-dot">·</span>
            <span><strong>2×</strong> booked appointments</span>
            <span class="mp-dot">·</span>
            <span>30 days</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 3. FOUNDER ═══ -->
    <section class="mp-founder">
      <div class="mp-founder-inner" data-animate>
        <img src="/img/robbie-butt.jpg" alt="Robbie Butt, Founder of EngageEngine™" class="mp-founder-photo" loading="lazy" decoding="async" width="280" height="527" />
        <div class="mp-founder-body">
          <p class="mp-founder-eye">The Founder</p>
          <h2 class="mp-founder-name">Robbie Butt</h2>
          <p class="mp-founder-title">Founder, EngageEngine™ · 41 years in this industry</p>
          <p class="mp-founder-quote">"You're paying for every click. It never sat right with me that 97% of them leave and you never even learn who they were. We fix that."</p>
          <p class="mp-founder-cred"><strong>31 years in business. Zero refunds.</strong> Not because we don't offer them — because we don't need to.</p>
        </div>
      </div>
    </section>

    <!-- ═══ 4. PRODUCT CLARITY ═══ -->
    <section class="mp-clarity">
      <div class="mp-section-head">
        <p class="mp-eye" data-animate>What This Is</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">Demand Recovery is a fully managed service.</h2>
        <p class="mp-lede" data-animate data-delay="0.1">Not a pixel you have to install and figure out. Not another dashboard. We put names to your anonymous visitors, drop them into your CRM, and follow up automatically — so the traffic you already pay for books twice the jobs.</p>
      </div>

      <div class="mp-do-grid" data-animate data-delay="0.2">
        <div class="mp-do-col mp-do-yes">
          <p class="mp-do-h">Here's what you do</p>
          <ul>
            <li><span class="mp-do-mark">✓</span> Give us your website</li>
            <li><span class="mp-do-mark">✓</span> Tell us what a good job looks like</li>
            <li><span class="mp-do-mark">✓</span> Answer the calls</li>
          </ul>
        </div>
        <div class="mp-do-col mp-do-no">
          <p class="mp-do-h">Here's what you don't</p>
          <ul>
            <li><span class="mp-do-mark mp-mark-x">✕</span> Install or manage a pixel</li>
            <li><span class="mp-do-mark mp-mark-x">✕</span> Work a list of names yourself</li>
            <li><span class="mp-do-mark mp-mark-x">✕</span> Write follow-up sequences</li>
            <li><span class="mp-do-mark mp-mark-x">✕</span> Learn another dashboard</li>
          </ul>
        </div>
      </div>

      <p class="mp-fit-line" data-animate data-delay="0.25">Built for service businesses doing <strong>$500K–$5M/year in revenue</strong> that already run paid traffic.</p>
    </section>

    <!-- ═══ 5. HOW IT WORKS ═══ -->
    <section class="mp-engine">
      <div class="mp-section-head">
        <p class="mp-eye" data-animate>Inside The Engine</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">Anonymous traffic in. Named buyers out.</h2>
      </div>

      <div class="mp-modules" data-animate data-delay="0.2">
        <div class="mp-mod">
          <div class="mp-mod-num">01</div>
          <div class="mp-mod-name">We see them</div>
          <div class="mp-mod-desc">Identity resolution puts a real name, address, and contact info to up to 80% of the anonymous people already on your site.</div>
        </div>
        <div class="mp-mod">
          <div class="mp-mod-num">02</div>
          <div class="mp-mod-name">We capture them</div>
          <div class="mp-mod-desc">Every identified buyer flows into the CRM you already use — in real time, no cap, no throttle.</div>
        </div>
        <div class="mp-mod">
          <div class="mp-mod-num">03</div>
          <div class="mp-mod-name">We follow up</div>
          <div class="mp-mod-desc">Done-for-you sequences fire the moment a buyer is identified. The list works itself.</div>
        </div>
        <div class="mp-mod">
          <div class="mp-mod-num">04</div>
          <div class="mp-mod-name">We recover them</div>
          <div class="mp-mod-desc">Buyers come back and call you — before they finish shopping the competitor down the road.</div>
        </div>
        <div class="mp-mod">
          <div class="mp-mod-num">05</div>
          <div class="mp-mod-name">We prove it</div>
          <div class="mp-mod-desc">Every recovered buyer traced back to the ad spend that paid for them. You see exactly what it returned.</div>
        </div>
      </div>

      <p class="mp-timeline" data-animate data-delay="0.25"><strong>First named buyers within 48 hours of going live.</strong></p>

      <div class="mp-status" data-animate data-delay="0.3">
        <p class="mp-status-cap">How the engine runs</p>
        <div class="mp-status-rows">
          <div class="mp-status-row"><span>System Status</span><span class="mp-status-v">ACTIVE</span></div>
          <div class="mp-status-row"><span>Visitor Resolution</span><span class="mp-status-v">UNCAPPED</span></div>
          <div class="mp-status-row"><span>Delivery</span><span class="mp-status-v">REAL-TIME → CRM</span></div>
          <div class="mp-status-row"><span>Follow-Up</span><span class="mp-status-v">AUTOMATED</span></div>
        </div>
      </div>
    </section>

    <!-- ═══ 7. THE MATH ═══ -->
    <section class="mp-results">
      <div class="mp-section-head mp-center">
        <p class="mp-eye" data-animate>The Math</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">You're not short on traffic. You're short on names.</h2>
        <p class="mp-lede" data-animate data-delay="0.1">Demand Recovery doesn't buy you more visitors. It captures the ones you already paid for.</p>
      </div>

      <div class="mp-results-grid">
        <article class="mp-result" data-animate>
          <p class="mp-result-headline">~97%</p>
          <p class="mp-result-quote">of the paid traffic landing on your site leaves anonymous — no name, no number, no way to follow up.</p>
          <p class="mp-result-attr"><strong>The leak</strong></p>
        </article>
        <article class="mp-result" data-animate data-delay="0.1">
          <p class="mp-result-headline">$30–50+</p>
          <p class="mp-result-quote">what a single home-service lead costs on Google. You're paying that to send them to a site that loses them.</p>
          <p class="mp-result-attr"><strong>What you pay now</strong></p>
        </article>
        <article class="mp-result" data-animate data-delay="0.2">
          <p class="mp-result-headline">Up to 80%</p>
          <p class="mp-result-quote">of your anonymous visitors, identified — with a real name, email, and mailing address you can actually reach.</p>
          <p class="mp-result-attr"><strong>What we recover</strong></p>
        </article>
        <article class="mp-result" data-animate data-delay="0.1">
          <p class="mp-result-headline">2×</p>
          <p class="mp-result-quote">the same ad budget, working twice — once to bring them in, again to bring them back when they leave.</p>
          <p class="mp-result-attr"><strong>What you get</strong></p>
        </article>
      </div>
    </section>

    <!-- ═══ 8. WHY NOW — lost traffic doesn't come back ═══ -->
    <section class="mp-exclusivity">
      <div class="mp-exclusivity-inner" data-animate>
        <p class="mp-excl-eye">Why Now</p>
        <h2 class="mp-excl-h">The traffic you lose today, you can't get back.</h2>
        <p class="mp-excl-body">Identity resolution only works going forward. We can name the buyers who land on your site after the pixel is live — we can't recover the ones who already came and left. Every day without it is a day of buyers gone for good.</p>
        <div class="mp-excl-warn">
          <p class="mp-excl-warn-h">You're paying for that traffic right now.</p>
          <p>The clicks are already hitting your site. The only question is whether you find out who they are — or keep letting them leave anonymous. The audit takes 30 seconds. No call.</p>
        </div>
      </div>
    </section>

    <!-- ═══ 9. GUARANTEE + PRICING ═══ -->
    <section class="mp-guarantee">
      <div class="mp-section-head mp-center">
        <p class="mp-eye" data-animate>The Guarantee</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">The guarantee nobody else in this industry will make.</h2>
      </div>

      <div class="mp-guarantee-card" data-animate data-delay="0.1">
        <div class="mp-guarantee-badge">
          <span class="mp-badge-check">✓</span>
          <span>The No Ghosts Guarantee™</span>
        </div>
        <p class="mp-guarantee-lead">We put names to your ghost traffic — or we work free.</p>
        <p class="mp-guarantee-body">If we don't put real names and contact info to your anonymous website visitors within <strong>72 hours of successful installation</strong>, we keep working until we do. Free. No refund-and-disappear. We stay. We fix. We run it until your ghost traffic has names.</p>
        <p class="mp-guarantee-closer">Because if we can't recover your buyers, we don't deserve to get paid.</p>

        <div class="mp-pricing">
          <p class="mp-pricing-eye">Pricing</p>
          <p class="mp-pricing-headline">
            <span class="mp-pricing-num">$750</span><span class="mp-pricing-per">/month</span>
            <span class="mp-pricing-plus">everything included</span>
          </p>
          <p class="mp-pricing-body">Uncapped resolution, CRM integration, and done-for-you follow-up — fully managed. No setup fee, no per-name charge, no dashboard to learn.</p>
        </div>
      </div>
    </section>

    <!-- ═══ 10. CLOSE — CTA scrolls to top form ═══ -->
    <section class="mp-close">
      <h2 class="mp-close-h1">The buyers are already on your website.</h2>
      <p class="mp-close-h2">Right now, leaving without a trace.</p>
      <p class="mp-close-body">Every day this runs without you is a day of buyers you paid for, gone for good — you can't get back the visitors who already left. Scan your site now. 30 seconds, no call.</p>
      <div class="mp-close-cta">
        <a href="#recovery-form-card" class="mp-btn-primary" id="close-cta">Scan My Site Free</a>
        <p class="mp-micro">No call required</p>
      </div>
    </section>

  </main>
  <Footer />

  <!-- Spinner overlay — dark scan state -->
  <div id="snap-spinner" aria-hidden="true">
    <div class="spinner-inner">
      <div class="spinner-ref" id="spinner-ref"></div>
      <div class="spinner-query" id="spinner-query"></div>
      <div class="spinner-bar-wrap">
        <div class="spinner-bar-track">
          <div class="spinner-bar" id="spinner-bar"></div>
        </div>
        <div class="spinner-pct" id="spinner-pct">0%</div>
      </div>
      <div class="spinner-log" id="spinner-log"></div>
    </div>
  </div>

  <script define:vars={{ detectedLocation, FORMSPREE_ID }}>
    const autoCity = detectedLocation || 'your market';

    // Prefill website from URL param if present (preserves ad-link behavior)
    const params = new URLSearchParams(window.location.search);
    const paramSite = params.get('website') || params.get('site') || '';
    if (paramSite) document.getElementById('site-input').value = paramSite;

    const scanForm   = document.getElementById('recovery-scan-form');
    const siteInput  = document.getElementById('site-input');
    const cardState  = document.getElementById('recovery-card');
    const revealState= document.getElementById('recovery-reveal');
    const doneState  = document.getElementById('recovery-done');
    const emailForm  = document.getElementById('recovery-email-form');
    const emailInput = document.getElementById('email-input');
    const spinner    = document.getElementById('snap-spinner');
    const spinnerRef = document.getElementById('spinner-ref');
    const spinnerQuery = document.getElementById('spinner-query');
    const spinnerLog = document.getElementById('spinner-log');
    const spinnerBar = document.getElementById('spinner-bar');
    const spinnerPct = document.getElementById('spinner-pct');
    const closeCta   = document.getElementById('close-cta');

    const STEP_MS = 1100;
    let cleanDomain = '';

    function normalizeDomain(raw) {
      let d = (raw || '').trim().replace(/^https?:\/\//i, '').replace(/^www\./i, '').replace(/\/.*$/, '');
      return d || 'your site';
    }

    closeCta?.addEventListener('click', (e) => {
      e.preventDefault();
      document.getElementById('recovery-form-card')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setTimeout(() => siteInput?.focus(), 600);
    });

    scanForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      const raw = (new FormData(scanForm).get('website') || '').trim();
      if (!raw) { siteInput?.focus(); return; }
      cleanDomain = normalizeDomain(raw);

      const refNum = 'EE-' + Date.now().toString(36).toUpperCase().slice(-6);
      spinnerRef.textContent = 'REF: ' + refNum + '  ·  ' + new Date().toLocaleString('en-US', {
        month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit'
      });
      spinnerQuery.textContent = 'SCAN: ' + cleanDomain + ' — anonymous visitor analysis';

      const steps = [
        'INIT      connecting to identity graph...',
        'CRAWL     reading traffic signature for ' + cleanDomain + '...',
        'RESOLVE   matching visitors against 250M+ identity records...',
        'CLASSIFY  separating named vs. anonymous sessions...',
        'MEASURE   calculating recoverable demand...',
        'READY     recovery audit compiled — access granted.',
      ];
      const TOTAL_MS = steps.length * STEP_MS + 600;
      spinner.classList.add('on');
      runSteps(steps);

      if (typeof gtag !== 'undefined') gtag('event', 'recovery_scan', { market: autoCity, website: cleanDomain });
      if (typeof fbq !== 'undefined') fbq('trackCustom', 'RecoveryScan', { website: cleanDomain });

      setTimeout(() => {
        spinner.classList.remove('on');
        document.getElementById('reveal-domain').textContent = cleanDomain;
        document.getElementById('reveal-domain-2').textContent = cleanDomain;
        cardState.hidden = true;
        revealState.hidden = false;
        setTimeout(() => emailInput?.focus(), 400);
      }, TOTAL_MS);
    });

    emailForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (new FormData(emailForm).get('email') || '').trim();
      if (!email || !/.+@.+\..+/.test(email)) { emailInput?.focus(); return; }
      const btn = document.getElementById('recovery-email-submit');
      btn.disabled = true;

      const payload = {
        form_type: 'recovery_audit',
        website: cleanDomain,
        email,
        market: autoCity,
        submitted_at: new Date().toISOString(),
      };

      try {
        await fetch('https://formspree.io/f/' + FORMSPREE_ID, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload),
        });
      } catch (_) { /* non-blocking — still show confirmation */ }

      if (typeof gtag !== 'undefined') gtag('event', 'recovery_audit_request', { market: autoCity, website: cleanDomain });
      if (typeof fbq !== 'undefined') fbq('track', 'Lead', { content_name: 'Recovery Audit', content_category: cleanDomain });

      document.getElementById('done-domain').textContent = cleanDomain;
      revealState.hidden = true;
      doneState.hidden = false;
    });

    function runSteps(steps) {
      let i = 0;
      spinnerLog.innerHTML = '';
      spinnerBar.style.width = '0%';
      spinnerPct.textContent = '0%';
      function next() {
        if (i >= steps.length) return;
        const el = document.createElement('div');
        el.className = 'log-line' + (i === steps.length - 1 ? ' log-ready' : '');
        el.textContent = steps[i];
        spinnerLog.appendChild(el);
        spinnerLog.scrollTop = spinnerLog.scrollHeight;
        const pct = Math.round(((i + 1) / steps.length) * 100);
        spinnerBar.style.width = pct + '%';
        spinnerPct.textContent = pct + '%';
        i++;
        if (i < steps.length) setTimeout(next, STEP_MS);
      }
      next();
    }
  </script>
</Base>

<style>
  /* ═══════════════════════════════════════════════════════
     /recovery — Demand Recovery Engine landing page
     Mirrors /snapshot exactly (.mp-* + .snap-* shared styles)
     plus .rec-* additions for the reveal + leak visual
     ═══════════════════════════════════════════════════════ */

  /* ─── Top nav ─── */
  .mp-nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(255,255,255,0.72);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .mp-nav-inner {
    max-width: 1280px; margin: 0 auto;
    padding: 0 32px; height: 56px;
    display: flex; align-items: center;
  }
  .mp-logo {
    display: flex; align-items: center;
    min-height: 44px; text-decoration: none;
  }
  .mp-logo img { height: 44px; width: auto; display: block; }
  .mp-logo:hover { text-decoration: none; }
  @media (max-width: 600px) {
    .mp-logo img { height: 34px; }
  }

  /* ─── Page base ─── */
  .mp { background: var(--canvas); color: var(--graphite); }
  .mp h1, .mp h2 { font-family: var(--font-d); color: var(--graphite); }
  .mp p { color: var(--graphite); }

  /* ─── Primary button ─── */
  .mp-btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--blue); color: #fff;
    font-family: var(--font-t); font-size: 17px;
    font-weight: 400; letter-spacing: -0.022em;
    padding: 12px 24px; border-radius: 980px;
    text-decoration: none; transition: background 0.2s;
    line-height: 1; border: none; cursor: pointer;
  }
  .mp-btn-primary:hover { background: var(--blue-link); text-decoration: none; color: #fff; }
  .mp-btn-primary::after { content: "→"; font-size: 17px; line-height: 1; transition: transform 0.2s; }
  .mp-btn-primary:hover::after { transform: translateX(3px); }

  /* ─── Eyebrows + headings ─── */
  .mp-eye {
    font-family: var(--font-t);
    font-size: 12px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--blue); margin-bottom: 16px;
  }
  .mp-h1 {
    font-family: var(--font-d);
    font-size: clamp(36px, 4.2vw, 52px);
    font-weight: 600; line-height: 1.05;
    letter-spacing: -0.022em; color: var(--graphite);
    margin-bottom: 14px;
  }
  .mp-h2 {
    font-family: var(--font-d);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600; line-height: 1.07;
    letter-spacing: -0.018em; color: var(--graphite);
    margin-bottom: 20px; max-width: 760px;
  }
  .mp-lede {
    font-family: var(--font-t);
    font-size: 21px; line-height: 1.4;
    letter-spacing: -0.022em; color: var(--mid-gray);
    max-width: 680px;
  }
  .mp-micro {
    font-family: var(--font-t);
    font-size: 13px; color: var(--light-gray);
    letter-spacing: -0.015em;
  }
  .mp-section-head { margin-bottom: 48px; }
  .mp-section-head.mp-center { text-align: center; }
  .mp-section-head.mp-center .mp-h2,
  .mp-section-head.mp-center .mp-lede { margin-left: auto; margin-right: auto; }

  /* ─── HERO ─── */
  .mp-hero { padding: 56px 32px 48px; background: var(--canvas); }
  .mp-hero-grid {
    max-width: 1320px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr; gap: 56px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .mp-hero-grid { grid-template-columns: minmax(360px, 460px) minmax(0, 1fr); gap: 64px; }
  }
  .mp-hero-copy { max-width: 460px; }
  .mp-hero-punch {
    font-family: var(--font-d);
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 500; line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--blue); margin-bottom: 24px;
  }

  /* ─── FORM CARD ─── */
  .snap-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 32px 36px;
    box-shadow: var(--shadow-xl, rgba(0,0,0,0.22) 3px 5px 30px 0px);
    justify-self: stretch; width: 100%;
    max-width: 560px; margin: 0 auto;
  }
  .snap-card-head {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: 18px; border-bottom: 1px solid var(--border);
    margin-bottom: 22px; gap: 12px; flex-wrap: wrap;
  }
  .snap-card-eye {
    font-family: var(--font-t);
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--blue);
  }
  .snap-card-loc {
    font-family: var(--font-m);
    font-size: 12px; color: var(--mid-gray);
    letter-spacing: 0.02em;
  }
  .snap-form { display: flex; flex-direction: column; }
  .snap-sr-only {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip: rect(0,0,0,0); white-space: nowrap; border: 0;
  }
  .snap-sentence {
    font-family: var(--font-d);
    font-size: clamp(20px, 2.2vw, 24px);
    line-height: 1.4; letter-spacing: -0.018em;
    color: var(--graphite); margin: 4px 0 22px;
  }
  .snap-sentence strong { color: var(--graphite); font-weight: 600; }
  .snap-inline-input {
    background: transparent; border: none;
    border-bottom: 2px solid var(--blue); border-radius: 0;
    font-family: var(--font-d); font-size: inherit;
    line-height: inherit; letter-spacing: inherit;
    color: var(--blue); font-weight: 600;
    padding: 0 6px 2px; margin: 0 2px;
    min-width: 160px; max-width: 100%;
    outline: none; -webkit-appearance: none;
    transition: border-color 0.15s;
    display: inline-block; vertical-align: baseline;
  }
  .snap-inline-input::placeholder { color: var(--light-gray); font-weight: 400; font-style: italic; }
  .snap-inline-input:focus { border-bottom-color: var(--graphite); }
  .snap-label {
    font-family: var(--font-t);
    font-size: 13px; font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--graphite); margin-bottom: 10px;
  }
  .snap-input {
    width: 100%; background: var(--canvas);
    border: 1px solid var(--border); border-radius: 0;
    color: var(--graphite); font-family: var(--font-t);
    font-size: 17px; letter-spacing: -0.022em;
    padding: 14px 16px; margin-bottom: 18px;
    outline: none; -webkit-appearance: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .snap-input::placeholder { color: var(--light-gray); }
  .snap-input:focus { border-color: var(--blue); background: var(--white); }
  .snap-btn {
    width: 100%;
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    background: var(--blue); color: #fff;
    font-family: var(--font-t); font-size: 17px; font-weight: 400;
    letter-spacing: -0.022em; padding: 14px 20px;
    border: none; border-radius: 980px;
    cursor: pointer; line-height: 1; transition: background 0.2s;
  }
  .snap-btn:hover { background: var(--blue-link); }
  .snap-btn:disabled { opacity: 0.6; cursor: wait; }
  .snap-btn-arrow { display: inline-block; transition: transform 0.2s; }
  .snap-btn:hover .snap-btn-arrow { transform: translateX(3px); }
  .snap-micro {
    font-family: var(--font-t); font-size: 12px;
    color: var(--light-gray); letter-spacing: -0.015em;
    text-align: center; margin-top: 12px;
  }
  .snap-scarcity {
    display: flex; align-items: flex-start; gap: 10px;
    margin-top: 22px; padding: 12px 14px;
    background: rgba(214,40,40,0.05);
    border: 1px solid rgba(214,40,40,0.2);
    border-radius: 8px;
    font-family: var(--font-t); font-size: 13px;
    line-height: 1.45; color: var(--graphite);
    letter-spacing: -0.015em;
  }
  .snap-scarcity strong { color: #d62828; font-weight: 600; }
  .snap-scarcity-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: #d62828; flex-shrink: 0; margin-top: 6px;
    animation: snapPulse 1.6s ease-in-out infinite;
  }
  @keyframes snapPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.35); }
  }

  /* ─── REVEAL + DONE states ─── */
  .rec-reveal-stat {
    font-family: var(--font-d);
    font-size: clamp(40px, 6vw, 56px);
    font-weight: 600; line-height: 1;
    color: var(--graphite); margin: 6px 0 14px;
  }
  .rec-reveal-stat strong { color: #d62828; font-weight: 600; }
  #recovery-done .rec-reveal-stat strong { color: var(--blue); }
  .rec-reveal-body {
    font-family: var(--font-t);
    font-size: 15px; line-height: 1.55;
    letter-spacing: -0.018em;
    color: var(--mid-gray); margin-bottom: 22px;
  }
  .rec-reveal-body strong { color: var(--graphite); font-weight: 600; }
  .rec-done-h {
    font-family: var(--font-d);
    font-size: 24px; font-weight: 600;
    letter-spacing: -0.018em;
    color: var(--graphite); margin-bottom: 12px;
  }

  /* ─── PROOF — leak visual ─── */
  .mp-proof { padding: 32px 32px 80px; background: var(--canvas); }
  .mp-proof-head { max-width: 880px; margin: 0 auto 24px; text-align: center; }
  .mp-proof-h {
    font-family: var(--font-d);
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 600; line-height: 1.1;
    letter-spacing: -0.018em; color: var(--graphite);
  }
  .mp-proof-inner {
    max-width: 880px; margin: 0 auto;
    display: flex; flex-direction: column;
    align-items: center; gap: 22px;
  }
  .rec-leak {
    width: 100%;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: var(--shadow-xl, rgba(0,0,0,0.22) 3px 5px 30px 0px);
    padding: 36px 40px;
    display: flex; flex-direction: column; gap: 22px;
  }
  .rec-leak-row {
    display: grid;
    grid-template-columns: 200px 1fr 60px;
    align-items: center; gap: 18px;
  }
  .rec-leak-label {
    font-family: var(--font-t); font-size: 14px;
    letter-spacing: -0.018em; color: var(--mid-gray);
  }
  .rec-leak-bar {
    height: 14px; background: var(--canvas);
    border-radius: 999px; overflow: hidden;
  }
  .rec-leak-fill {
    display: block; height: 100%; border-radius: 999px;
    background: var(--blue);
  }
  .rec-leak-100 { width: 100%; background: var(--mid-gray); }
  .rec-leak-3   { width: 3%;  background: var(--blue); min-width: 6px; }
  .rec-leak-97  { width: 97%; background: #d62828; }
  .rec-leak-num {
    font-family: var(--font-d); font-size: 16px; font-weight: 600;
    letter-spacing: -0.018em; color: var(--graphite); text-align: right;
  }
  .rec-leak-ghost .rec-leak-label { color: #d62828; font-weight: 600; }
  .rec-leak-ghost .rec-leak-num { color: #d62828; }
  @media (max-width: 560px) {
    .rec-leak { padding: 24px 22px; }
    .rec-leak-row { grid-template-columns: 1fr; gap: 6px; }
    .rec-leak-bar { order: 3; }
    .rec-leak-num { text-align: left; }
  }
  .mp-proof-cap {
    display: flex; flex-direction: column;
    align-items: center; text-align: center; gap: 4px;
  }
  .mp-proof-cap-main {
    font-family: var(--font-t); font-size: 14px;
    letter-spacing: -0.018em; color: var(--mid-gray);
  }
  .mp-proof-cap-main strong { color: var(--graphite); font-weight: 600; }
  .mp-proof-cap-sub {
    font-family: var(--font-t); font-size: 13px;
    letter-spacing: -0.015em; color: var(--light-gray);
  }

  /* ─── ANCHOR ─── */
  .mp-anchor {
    background: var(--white);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 48px 32px;
  }
  .mp-anchor-inner {
    max-width: 960px; margin: 0 auto;
    display: flex; align-items: center; gap: 32px;
  }
  .mp-anchor-photo {
    width: 80px; height: 80px; border-radius: 50%;
    background: var(--canvas); border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; overflow: hidden;
  }
  .mp-anchor-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .mp-anchor-quote {
    font-family: var(--font-d);
    font-size: 22px; line-height: 1.36;
    letter-spacing: -0.022em; color: var(--graphite);
    font-weight: 400; margin-bottom: 12px;
  }
  .mp-anchor-attr {
    font-family: var(--font-t); font-size: 14px;
    color: var(--mid-gray); margin-bottom: 8px; letter-spacing: -0.018em;
  }
  .mp-anchor-attr strong { color: var(--graphite); font-weight: 600; }
  .mp-anchor-stats {
    font-family: var(--font-t); font-size: 13px;
    color: var(--blue-link); letter-spacing: -0.015em;
    display: flex; flex-wrap: wrap; gap: 8px;
  }
  .mp-anchor-stats strong { font-weight: 600; }
  .mp-dot { color: var(--light-gray); }
  @media (max-width: 640px) {
    .mp-anchor-inner { flex-direction: column; align-items: flex-start; }
  }

  /* ─── FOUNDER ─── */
  .mp-founder { padding: 96px 32px; background: var(--canvas); }
  .mp-founder-inner {
    max-width: 960px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr; gap: 36px; align-items: center;
  }
  @media (min-width: 768px) {
    .mp-founder-inner { grid-template-columns: 280px 1fr; gap: 56px; }
  }
  .mp-founder-photo {
    width: 100%; max-width: 280px; aspect-ratio: 1 / 1;
    object-fit: cover; object-position: top; border-radius: 8px;
    box-shadow: var(--shadow-xl, rgba(0,0,0,0.22) 3px 5px 30px 0px);
  }
  .mp-founder-eye {
    font-family: var(--font-t); font-size: 12px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--blue); margin-bottom: 12px;
  }
  .mp-founder-name {
    font-family: var(--font-d);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 600; line-height: 1.1;
    letter-spacing: -0.018em; color: var(--graphite); margin-bottom: 6px;
  }
  .mp-founder-title {
    font-family: var(--font-t); font-size: 15px;
    color: var(--mid-gray); letter-spacing: -0.018em; margin-bottom: 24px;
  }
  .mp-founder-quote {
    font-family: var(--font-d);
    font-size: 21px; line-height: 1.36;
    letter-spacing: -0.022em; color: var(--graphite);
    padding-left: 18px; border-left: 2px solid var(--blue); margin-bottom: 24px;
  }
  .mp-founder-cred {
    font-family: var(--font-t); font-size: 14px; line-height: 1.55;
    letter-spacing: -0.018em; color: var(--mid-gray);
  }
  .mp-founder-cred strong { color: var(--graphite); font-weight: 600; }

  /* ─── CLARITY ─── */
  .mp-clarity { padding: 120px 32px; background: var(--white); border-top: 1px solid var(--border); }
  .mp-clarity .mp-section-head { max-width: 720px; text-align: center; margin: 0 auto 64px; }
  .mp-clarity .mp-h2, .mp-clarity .mp-lede { margin-left: auto; margin-right: auto; }
  .mp-do-grid {
    max-width: 880px; margin: 0 auto 40px;
    display: grid; grid-template-columns: 1fr; gap: 24px;
  }
  @media (min-width: 720px) { .mp-do-grid { grid-template-columns: 1fr 1fr; gap: 32px; } }
  .mp-do-col { padding: 32px 28px; background: var(--canvas); }
  .mp-do-yes { border-top: 2px solid var(--blue); }
  .mp-do-no { border-top: 2px solid var(--light-gray); }
  .mp-do-h {
    font-family: var(--font-t); font-size: 12px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--mid-gray); margin-bottom: 18px;
  }
  .mp-do-col ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .mp-do-col li {
    font-family: var(--font-t); font-size: 17px; line-height: 1.4;
    letter-spacing: -0.022em; color: var(--graphite);
    display: flex; align-items: flex-start; gap: 12px;
  }
  .mp-do-mark { font-weight: 600; color: var(--blue); flex-shrink: 0; width: 18px; display: inline-block; }
  .mp-mark-x { color: var(--light-gray); }
  .mp-fit-line {
    max-width: 720px; margin: 0 auto; text-align: center; padding: 20px 28px;
    background: var(--canvas); font-family: var(--font-t);
    font-size: 16px; line-height: 1.5; letter-spacing: -0.018em; color: var(--mid-gray);
  }
  .mp-fit-line strong { color: var(--graphite); font-weight: 600; }

  /* ─── ENGINE ─── */
  .mp-engine { padding: 120px 32px; background: var(--canvas); border-top: 1px solid var(--border); }
  .mp-engine .mp-section-head { max-width: 720px; text-align: center; margin: 0 auto 48px; }
  .mp-engine .mp-h2, .mp-engine .mp-lede { margin-left: auto; margin-right: auto; }
  .mp-modules {
    max-width: 1080px; margin: 0 auto 56px;
    display: grid; grid-template-columns: repeat(5, 1fr);
    gap: 1px; background: var(--border);
  }
  @media (max-width: 960px) { .mp-modules { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 640px) { .mp-modules { grid-template-columns: 1fr; } }
  .mp-mod { background: var(--white); padding: 28px 22px; }
  .mp-mod-num {
    font-family: var(--font-t); font-size: 11px; font-weight: 700;
    letter-spacing: 0.08em; color: var(--blue); margin-bottom: 12px;
  }
  .mp-mod-name {
    font-family: var(--font-d); font-size: 17px; font-weight: 600;
    letter-spacing: -0.022em; color: var(--graphite); margin-bottom: 10px; line-height: 1.3;
  }
  .mp-mod-desc {
    font-family: var(--font-t); font-size: 13px; line-height: 1.55;
    letter-spacing: -0.015em; color: var(--mid-gray);
  }
  .mp-timeline {
    max-width: 600px; margin: 0 auto 48px; text-align: center;
    padding: 16px 24px; background: rgba(0,113,227,0.05);
    border: 1px solid rgba(0,113,227,0.2);
    font-family: var(--font-t); font-size: 16px;
    letter-spacing: -0.018em; color: var(--graphite);
  }
  .mp-timeline strong { color: var(--blue); font-weight: 600; }
  .mp-status {
    max-width: 560px; margin: 0 auto; background: var(--white);
    border: 1px solid var(--border); padding: 28px 32px;
  }
  .mp-status-cap {
    font-family: var(--font-t); font-size: 11px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--mid-gray); margin-bottom: 18px;
    padding-bottom: 14px; border-bottom: 1px solid var(--border);
  }
  .mp-status-rows { display: flex; flex-direction: column; }
  .mp-status-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 0; border-bottom: 1px solid var(--canvas);
    font-family: var(--font-t); font-size: 13px;
    color: var(--mid-gray); letter-spacing: -0.015em;
  }
  .mp-status-row:last-child { border-bottom: none; }
  .mp-status-v {
    font-family: var(--font-t); color: var(--blue); font-weight: 600;
    letter-spacing: 0.04em; font-size: 12px;
  }

  /* ─── RESULTS / MATH ─── */
  .mp-results { padding: 120px 32px; background: var(--white); border-top: 1px solid var(--border); }
  .mp-results-grid {
    max-width: 1100px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 1px; background: var(--border); border: 1px solid var(--border);
  }
  @media (max-width: 720px) { .mp-results-grid { grid-template-columns: 1fr; } }
  .mp-result { background: var(--white); padding: 40px 36px; display: flex; flex-direction: column; }
  .mp-result-headline {
    font-family: var(--font-d); font-size: 34px; font-weight: 600;
    line-height: 1.1; letter-spacing: -0.022em; color: var(--blue); margin-bottom: 16px;
  }
  .mp-result-quote {
    font-family: var(--font-t); font-size: 15px; line-height: 1.55;
    letter-spacing: -0.018em; color: var(--mid-gray); margin-bottom: 16px; flex: 1;
  }
  .mp-result-attr {
    font-family: var(--font-t); font-size: 13px; color: var(--light-gray);
    letter-spacing: -0.015em; padding-top: 14px; border-top: 1px solid var(--border);
  }
  .mp-result-attr strong { color: var(--graphite); font-weight: 600; }

  /* ─── EXCLUSIVITY ─── */
  .mp-exclusivity { padding: 80px 32px; background: var(--canvas); border-top: 1px solid var(--border); }
  .mp-exclusivity-inner {
    max-width: 880px; margin: 0 auto; padding: 40px 44px;
    background: rgba(214,40,40,0.04); border-top: 2px solid #d62828;
  }
  .mp-excl-eye {
    font-family: var(--font-t); font-size: 12px; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase; color: #d62828; margin-bottom: 14px;
  }
  .mp-excl-h {
    font-family: var(--font-d); font-size: clamp(24px, 2.8vw, 32px);
    font-weight: 600; line-height: 1.15; letter-spacing: -0.018em;
    color: var(--graphite); margin-bottom: 16px;
  }
  .mp-excl-body {
    font-family: var(--font-t); font-size: 17px; line-height: 1.5;
    letter-spacing: -0.022em; color: var(--mid-gray); margin-bottom: 24px;
  }
  .mp-excl-warn { padding-top: 22px; border-top: 1px solid rgba(214,40,40,0.25); }
  .mp-excl-warn-h {
    font-family: var(--font-d); font-size: 19px; font-weight: 600;
    letter-spacing: -0.022em; color: #d62828; margin-bottom: 10px; line-height: 1.3;
  }
  .mp-excl-warn p:not(.mp-excl-warn-h) {
    font-family: var(--font-t); font-size: 15px; line-height: 1.55;
    letter-spacing: -0.018em; color: var(--graphite);
  }

  /* ─── GUARANTEE + PRICING ─── */
  .mp-guarantee { padding: 120px 32px; background: var(--canvas); border-top: 1px solid var(--border); }
  .mp-guarantee .mp-section-head { max-width: 720px; text-align: center; margin: 0 auto 48px; }
  .mp-guarantee .mp-h2 { margin-left: auto; margin-right: auto; }
  .mp-guarantee-card {
    max-width: 720px; margin: 0 auto; background: var(--white);
    border: 1px solid var(--border); padding: 48px 52px;
