---
import Base from '../layouts/Base.astro'
import Footer from '../components/Footer.astro'
import DemandEngine from '../components/DemandEngine.astro'
---
<Base
  title="How EngageEngine Works — Marketing Performance Group"
  description="Inside the buyer-identification system: five layers working as one engine to find, reach, convert, capture, and measure real named buyers in your market."
>
  <!-- Minimal top nav — logo only -->
  <nav class="mp-nav">
    <div class="mp-nav-inner">
      <a href="/" class="mp-logo">
        Marketing Performance Group
        <span class="mp-logo-sub">Powered by EngageEngine™</span>
      </a>
    </div>
  </nav>

  <main class="mp">

    <!-- ═══ HOW-IT-WORKS HERO ═══ -->
    <section class="mp-clarity">
      <div class="mp-section-head">
        <p class="mp-eye" data-animate>How It Works</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">EngageEngine™ is a fully managed service.</h2>
        <p class="mp-lede" data-animate data-delay="0.1">Not software. Not a dashboard. Not another platform to learn. We do the work. You tell us your market and your service — we handle audience building, ad placement, optimization, and reporting.</p>
      </div>

      <!-- The Intelligence Layer — the system visualized -->
      <div class="mp-intel-wrap" data-animate data-delay="0.15">
        <img src="/img/intelligence-layer.webp" alt="The Intelligence Layer — input data, the engine, and the outputs that find buyers before they call" class="mp-intel" />
      </div>

      <div class="mp-do-grid" data-animate data-delay="0.2">
        <div class="mp-do-col mp-do-yes">
          <p class="mp-do-h">Here's what you do</p>
          <ul>
            <li><span class="mp-do-mark">✓</span> Tell us your service area</li>
            <li><span class="mp-do-mark">✓</span> Tell us what a good job looks like</li>
            <li><span class="mp-do-mark">✓</span> Answer the calls</li>
          </ul>
        </div>
        <div class="mp-do-col mp-do-no">
          <p class="mp-do-h">Here's what you don't</p>
          <ul>
            <li><span class="mp-do-mark mp-mark-x">✕</span> Manage campaigns</li>
            <li><span class="mp-do-mark mp-mark-x">✕</span> Build audiences</li>
            <li><span class="mp-do-mark mp-mark-x">✕</span> Touch the platform</li>
            <li><span class="mp-do-mark mp-mark-x">✕</span> Learn another dashboard</li>
          </ul>
        </div>
      </div>

      <p class="mp-fit-line" data-animate data-delay="0.25">Built for service businesses doing <strong>$500K–$5M/year in revenue</strong>.</p>
    </section>

    <!-- ═══ INTERACTIVE 5-LAYER ENGINE ═══ -->
  <DemandEngine />

    <!-- ═══ FINAL CTA — back to snapshot ═══ -->
    <section class="mp-close">
      <h2 class="mp-close-h1" data-animate>See what the engine finds in your market.</h2>
      <p class="mp-close-h2" data-animate data-delay="0.05">Free. 30 seconds. No email.</p>
      <p class="mp-close-body" data-animate data-delay="0.1">The buyer identification runs in your market whether we're running it for you or not — the question is whether it's your ads in front of those buyers, or your competitor's.</p>
      <div class="mp-close-cta" data-animate data-delay="0.2">
        <a href="/snapshot" class="mp-btn-primary">See Who's Buying in My Market</a>
        <p class="mp-micro">Free. No email required. Takes 30 seconds.</p>
      </div>
    </section>

  </main>
  <Footer />
</Base>

<style>
  /* ═══════════════════════════════════════════════════════
     Apple-fidelity styles — extracted from homepage
     ═══════════════════════════════════════════════════════ */

  .mp-nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(255,255,255,0.72);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .mp-nav-inner {
    max-width: 1280px; margin: 0 auto;
    padding: 0 32px; height: 56px;
    display: flex; align-items: center;
  }
  .mp-logo {
    font-family: var(--font-t);
    font-size: 13px; font-weight: 600;
    letter-spacing: -0.01em; color: var(--graphite);
    text-decoration: none;
    display: flex; flex-direction: column; gap: 1px;
    min-height: 44px; justify-content: center;
  }
  .mp-logo:hover { color: var(--graphite); text-decoration: none; }
  .mp-logo-sub {
    font-size: 10px; font-weight: 400;
    letter-spacing: 0.02em; color: var(--mid-gray);
  }

  .mp { background: var(--canvas); color: var(--graphite); }
  .mp h1, .mp h2 { font-family: var(--font-d); color: var(--graphite); }
  .mp p { color: var(--graphite); }

  .mp-btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--blue); color: #fff;
    font-family: var(--font-t); font-size: 17px;
    font-weight: 400; letter-spacing: -0.022em;
    padding: 12px 24px; border-radius: 980px;
    text-decoration: none; transition: background 0.2s;
    line-height: 1;
  }
  .mp-btn-primary:hover { background: var(--blue-link); text-decoration: none; color: #fff; }
  .mp-btn-primary::after {
    content: "→"; font-size: 17px; line-height: 1;
    transition: transform 0.2s;
  }
  .mp-btn-primary:hover::after { transform: translateX(3px); }

  .mp-eye {
    font-family: var(--font-t);
    font-size: 12px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--blue); margin-bottom: 16px;
  }
  .mp-h2 {
    font-family: var(--font-d);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600; line-height: 1.07;
    letter-spacing: -0.018em; color: var(--graphite);
    margin-bottom: 20px;
    max-width: 760px;
  }
  .mp-lede {
    font-family: var(--font-t);
    font-size: 21px; line-height: 1.4;
    letter-spacing: -0.022em; color: var(--mid-gray);
    max-width: 680px;
  }
  .mp-micro {
    font-family: var(--font-t);
    font-size: 13px; color: var(--light-gray);
    letter-spacing: -0.015em;
  }
  .mp-section-head { margin-bottom: 48px; }
  .mp-section-head.mp-center { text-align: center; }
  .mp-section-head.mp-center .mp-h2,
  .mp-section-head.mp-center .mp-lede { margin-left: auto; margin-right: auto; }

  .mp-clarity {
    padding: 120px 32px;
    background: var(--white);
  }
  .mp-clarity .mp-section-head {
    max-width: 720px; text-align: center;
    margin: 0 auto 64px;
  }
  .mp-clarity .mp-h2,
  .mp-clarity .mp-lede { margin-left: auto; margin-right: auto; }

  .mp-intel-wrap {
    max-width: 1080px; margin: 0 auto 64px;
    border-radius: 8px; overflow: hidden;
    box-shadow: var(--shadow-xl, rgba(0,0,0,0.22) 3px 5px 30px 0px);
    background: #0a0a0a;
  }
  .mp-intel {
    width: 100%; height: auto; display: block;
  }

  .mp-do-grid {
    max-width: 880px; margin: 0 auto 40px;
    display: grid; grid-template-columns: 1fr; gap: 24px;
  }
  @media (min-width: 720px) {
    .mp-do-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
  .mp-do-col {
    padding: 32px 28px;
    background: var(--canvas);
  }
  .mp-do-yes { border-top: 2px solid var(--blue); }
  .mp-do-no { border-top: 2px solid var(--light-gray); }
  .mp-do-h {
    font-family: var(--font-t);
    font-size: 12px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--mid-gray); margin-bottom: 18px;
  }
  .mp-do-col ul {
    list-style: none; padding: 0;
    display: flex; flex-direction: column; gap: 12px;
  }
  .mp-do-col li {
    font-family: var(--font-t);
    font-size: 17px; line-height: 1.4;
    letter-spacing: -0.022em;
    color: var(--graphite);
    display: flex; align-items: flex-start; gap: 12px;
  }
  .mp-do-mark {
    font-weight: 600; color: var(--blue); flex-shrink: 0;
    width: 18px; display: inline-block;
  }
  .mp-mark-x { color: var(--light-gray); }
  .mp-fit-line {
    max-width: 720px; margin: 0 auto;
    text-align: center; padding: 20px 28px;
    background: var(--canvas);
    font-family: var(--font-t);
    font-size: 16px; line-height: 1.5;
    letter-spacing: -0.018em;
    color: var(--mid-gray);
  }
  .mp-fit-line strong { color: var(--graphite); font-weight: 600; }

  .mp-close {
    padding: 160px 32px 140px;
    background: var(--canvas);
    border-top: 1px solid var(--border);
    text-align: center;
  }
  .mp-close-h1 {
    font-family: var(--font-d);
    font-size: clamp(36px, 5.5vw, 56px);
    font-weight: 600; line-height: 1.05;
    letter-spacing: -0.022em;
    color: var(--graphite); margin-bottom: 4px;
  }
  .mp-close-h2 {
    font-family: var(--font-d);
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 500; line-height: 1.15;
    letter-spacing: -0.018em;
    color: var(--blue); margin-bottom: 32px;
  }
  .mp-close-body {
    font-family: var(--font-t);
    font-size: 19px; line-height: 1.5;
    letter-spacing: -0.022em;
    color: var(--mid-gray);
    max-width: 620px; margin: 0 auto 40px;
  }
  .mp-close-cta {
    display: flex; flex-direction: column;
    align-items: center; gap: 10px;
  }

  @media (max-width: 768px) {
    .mp-clarity { padding: 80px 22px; }
    .mp-close { padding: 96px 22px 88px; }
    .mp-do-col { padding: 24px 22px; }
  }
</style>
