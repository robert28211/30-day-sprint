                <label style="display:block;color:#1d1d1f;font-size:14px;font-weight:600;letter-spacing:-0.18px;margin-bottom:6px;" for="registrarPassword">Registrar password</label>
                <input id="registrarPassword" name="registrarPassword" type="password" placeholder="••••••••" autocomplete="current-password"
                  style="width:100%;background:#f5f5f7;border:1.5px solid #d6d6d6;padding:12px 16px;color:#1d1d1f;font-size:17px;outline:none;" />
              </div>
            </div>
          </div>
          <div style="border-top:1px solid #d6d6d6;padding-top:24px;">
            <p style="color:#1d1d1f;font-size:15px;font-weight:600;letter-spacing:-0.18px;margin-bottom:4px;">Website / CMS</p>
            <p style="color:#707070;font-size:13px;letter-spacing:-0.15px;margin-bottom:16px;line-height:1.47;">Your website admin panel — WordPress, Squarespace, Wix, Webflow, etc. We need admin access to make design and content changes.</p>
            <div style="display:flex;flex-direction:column;gap:12px;">
              <div>
                <label style="display:block;color:#1d1d1f;font-size:14px;font-weight:600;letter-spacing:-0.18px;margin-bottom:6px;" for="cmsUrl">CMS / admin URL</label>
                <input id="cmsUrl" name="cmsUrl" type="url" placeholder="https://yourdomain.com/wp-admin"
                  style="width:100%;background:#f5f5f7;border:1.5px solid #d6d6d6;padding:12px 16px;color:#1d1d1f;font-size:17px;outline:none;" />
              </div>
              <div>
                <label style="display:block;color:#1d1d1f;font-size:14px;font-weight:600;letter-spacing:-0.18px;margin-bottom:6px;" for="cmsUsername">CMS username</label>
                <input id="cmsUsername" name="cmsUsername" type="text" placeholder="admin" autocomplete="username"
                  style="width:100%;background:#f5f5f7;border:1.5px solid #d6d6d6;padding:12px 16px;color:#1d1d1f;font-size:17px;outline:none;" />
              </div>
              <div>
                <label style="display:block;color:#1d1d1f;font-size:14px;font-weight:600;letter-spacing:-0.18px;margin-bottom:6px;" for="cmsPassword">CMS password</label>
                <input id="cmsPassword" name="cmsPassword" type="password" placeholder="••••••••" autocomplete="current-password"
                  style="width:100%;background:#f5f5f7;border:1.5px solid #d6d6d6;padding:12px 16px;color:#1d1d1f;font-size:17px;outline:none;" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ─── STEP 5 ─── -->
      <div data-step="5" style="display:none;">
        <p style="color:#0071e3;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;font-weight:600;margin-bottom:4px;">Step 5 of 6</p>
        <h2 class="display-font" style="color:#1d1d1f;font-size:28px;font-weight:600;line-height:1.14;letter-spacing:0.29px;margin-bottom:4px;">Your brand and social accounts.</h2>
        <p style="color:#707070;font-size:15px;line-height:1.47;letter-spacing:-0.18px;margin-bottom:16px;">Upload your brand files and share login credentials for the social platforms you want us to manage.</p>

        <!-- Security note -->
        <div style="display:flex;align-items:flex-start;gap:10px;background:#f0f7ff;border:1px solid #b3d4f5;padding:14px 16px;margin-bottom:28px;">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0071e3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;margin-top:1px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          <p style="color:#1d1d1f;font-size:12px;line-height:1.5;letter-spacing:-0.15px;margin:0;"><strong>All credentials are encrypted in transit and stored securely.</strong> We use these to schedule and publish content on your behalf. You can update passwords after setup is complete.</p>
        </div>

        <div style="display:flex;flex-direction:column;gap:24px;">
          <div>
            <p style="color:#1d1d1f;font-size:15px;font-weight:600;letter-spacing:-0.18px;margin-bottom:4px;">Brand Files</p>
            <p style="color:#707070;font-size:13px;letter-spacing:-0.15px;margin-bottom:16px;">Upload your logo and any photos or videos. Include everything you have — we'll sort through it.</p>
            <div style="display:flex;flex-direction:column;gap:16px;">
              {[
                { field: 'logoFile', label: 'Logo files', accept: '.png,.jpg,.jpeg,.svg,.ai,.eps,.pdf,.zip', hint: 'PNG, SVG, AI, or ZIP with all formats. The more the better.' },
                { field: 'photosFile', label: 'Photos & videos', accept: 'image/*,video/*,.zip', hint: 'Single file or a ZIP of multiple images and videos.' },
              ].map(({ field, label, accept, hint }) => (
                <div class="upload-field" data-field={field}>
                  <p style="color:#1d1d1f;font-size:14px;font-weight:600;letter-spacing:-0.18px;margin-bottom:8px;">{label}</p>
                  <label style="display:flex;align-items:center;gap:12px;cursor:pointer;">
                    <input type="file" name={field} accept={accept} class="file-input" style="display:none;" />
                    <span class="upload-btn" style="display:inline-flex;align-items:center;gap:8px;background:#f5f5f7;border:1.5px solid #d6d6d6;padding:12px 20px;color:#1d1d1f;font-size:14px;cursor:pointer;flex-shrink:0;transition:border-color 0.2s;">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="#707070" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                      Choose File
                    </span>
                    <span class="file-name" style="color:#707070;font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">No file chosen</span>
                  </label>
                  <p style="color:#707070;font-size:12px;letter-spacing:-0.15px;margin-top:6px;">{hint}</p>
                </div>
              ))}
            </div>
          </div>

          <div style="border-top:1px solid #d6d6d6;padding-top:24px;">
            <p style="color:#1d1d1f;font-size:15px;font-weight:600;letter-spacing:-0.18px;margin-bottom:4px;">Social Media Credentials</p>
            <p style="color:#707070;font-size:13px;letter-spacing:-0.15px;margin-bottom:16px;">Leave blank for any platform you don't use or don't want us to manage.</p>
            <div style="display:flex;flex-direction:column;gap:16px;">
              {[
                { label: 'Instagram', u: 'igUsername', p: 'igPassword' },
                { label: 'Pinterest', u: 'pinterestUsername', p: 'pinterestPassword' },
                { label: 'X (Twitter)', u: 'xUsername', p: 'xPassword' },
                { label: 'TikTok', u: 'tiktokUsername', p: 'tiktokPassword' },
              ].map(({ label, u, p }) => (
                <div>
                  <p style="color:#474747;font-size:13px;font-weight:600;letter-spacing:-0.15px;margin-bottom:8px;">{label}</p>
                  <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                    <input name={u} type="text" placeholder="Username" autocomplete="username"
                      style="background:#f5f5f7;border:1.5px solid #d6d6d6;padding:12px;color:#1d1d1f;font-size:14px;outline:none;width:100%;" />
                    <input name={p} type="password" placeholder="Password" autocomplete="current-password"
                      style="background:#f5f5f7;border:1.5px solid #d6d6d6;padding:12px;color:#1d1d1f;font-size:14px;outline:none;width:100%;" />
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- ─── STEP 6 ─── -->
      <div data-step="6" style="display:none;">
        <p style="color:#0071e3;font-size:12px;letter-spacing:0.08em;text-transform:uppercase;font-weight:600;margin-bottom:4px;">Step 6 of 6</p>
        <h2 class="display-font" style="color:#1d1d1f;font-size:28px;font-weight:600;line-height:1.14;letter-spacing:0.29px;margin-bottom:4px;">Almost done — just a few more things.</h2>
        <p style="color:#707070;font-size:15px;line-height:1.47;letter-spacing:-0.18px;margin-bottom:32px;">These details help us configure your account and get everything set up before your onboarding call.</p>

        <div style="display:flex;flex-direction:column;gap:24px;">

          <!-- Customer list -->
          <div>
            <p style="color:#1d1d1f;font-size:15px;font-weight:600;letter-spacing:-0.18px;margin-bottom:4px;">Customer List <span style="color:#707070;font-size:12px;font-weight:400;">(optional)</span></p>
            <p style="color:#707070;font-size:13px;letter-spacing:-0.15px;margin-bottom:12px;line-height:1.47;">Any existing customer list — CSV, Excel, or spreadsheet. We use it to build retargeting audiences. No list yet? Leave this blank and we'll discuss it on your call.</p>
            <div class="upload-field" data-field="customerListFile">
              <label style="display:flex;align-items:center;gap:12px;cursor:pointer;">
                <input type="file" name="customerListFile" accept=".csv,.xlsx,.xls,.pdf,.doc,.docx" class="file-input" style="display:none;" />
                <span class="upload-btn" style="display:inline-flex;align-items:center;gap:8px;background:#f5f5f7;border:1.5px solid #d6d6d6;padding:12px 20px;color:#1d1d1f;font-size:14px;cursor:pointer;flex-shrink:0;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="#707070" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                  Choose File
                </span>
                <span class="file-name" style="color:#707070;font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">No file chosen</span>
              </label>
            </div>
          </div>

          <!-- App users -->
          <div style="border-top:1px solid #d6d6d6;padding-top:24px;">
            <p style="color:#1d1d1f;font-size:15px;font-weight:600;letter-spacing:-0.18px;margin-bottom:4px;">App Users <span style="color:#707070;font-size:12px;font-weight:400;">(up to 3)</span></p>
            <p style="color:#707070;font-size:13px;letter-spacing:-0.15px;margin-bottom:16px;line-height:1.47;">Who on your team will use the EngageEngine app? Fill in whoever applies — you don't need all three slots.</p>
            <div style="display:flex;flex-direction:column;gap:8px;">
              {[1,2,3].map(n => (
                <div>
                  <p style="color:#707070;font-size:11px;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;margin-bottom:4px;">Person {n}</p>
                  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;">
                    <input name={`appUser${n}Name`} type="text" placeholder="Name" autocomplete="name"
                      style="background:#f5f5f7;border:1.5px solid #d6d6d6;padding:10px 12px;color:#1d1d1f;font-size:14px;outline:none;width:100%;" />
                    <input name={`appUser${n}Email`} type="email" placeholder="Email" autocomplete="email"
                      style="background:#f5f5f7;border:1.5px solid #d6d6d6;padding:10px 12px;color:#1d1d1f;font-size:14px;outline:none;width:100%;" />
                    <input name={`appUser${n}Phone`} type="tel" placeholder="Phone" autocomplete="tel"
                      style="background:#f5f5f7;border:1.5px solid #d6d6d6;padding:10px 12px;color:#1d1d1f;font-size:14px;outline:none;width:100%;" />
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Notifications -->
          <div style="border-top:1px solid #d6d6d6;padding-top:24px;">
            <p style="color:#1d1d1f;font-size:15px;font-weight:600;letter-spacing:-0.18px;margin-bottom:4px;">Lead & Review Notifications</p>
            <p style="color:#707070;font-size:13px;letter-spacing:-0.15px;margin-bottom:12px;">Who should get notified when a new lead comes in or a review is posted?</p>
            <input id="notificationRecipient" name="notificationRecipient" type="email" placeholder="owner@yourbusiness.com" autocomplete="email"
              style="width:100%;background:#f5f5f7;border:1.5px solid #d6d6d6;padding:12px 16px;color:#1d1d1f;font-size:17px;outline:none;" />
          </div>

          <!-- Review sites -->
          <div style="border-top:1px solid #d6d6d6;padding-top:24px;">
            <p style="color:#1d1d1f;font-size:15px;font-weight:600;letter-spacing:-0.18px;margin-bottom:4px;">Review Site Credentials <span style="color:#707070;font-size:12px;font-weight:400;">(optional)</span></p>
            <p style="color:#707070;font-size:13px;letter-spacing:-0.15px;margin-bottom:16px;">Leave blank for any you don't use.</p>
            <div style="display:flex;flex-direction:column;gap:16px;">
              {[
                { label: 'Angi / HomeAdvisor', u: 'angiUsername', p: 'angiPassword' },
                { label: 'Yelp', u: 'yelpUsername', p: 'yelpPassword' },
              ].map(({ label, u, p }) => (
                <div>
                  <p style="color:#474747;font-size:13px;font-weight:600;letter-spacing:-0.15px;margin-bottom:8px;">{label}</p>
                  <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
                    <input name={u} type="text" placeholder="Username / Email" autocomplete="username"
                      style="background:#f5f5f7;border:1.5px solid #d6d6d6;padding:12px;color:#1d1d1f;font-size:14px;outline:none;width:100%;" />
                    <input name={p} type="password" placeholder="Password" autocomplete="current-password"
                      style="background:#f5f5f7;border:1.5px solid #d6d6d6;padding:12px;color:#1d1d1f;font-size:14px;outline:none;width:100%;" />
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- AI widget, competitors, call time -->
          <div style="border-top:1px solid #d6d6d6;padding-top:24px;display:flex;flex-direction:column;gap:20px;">
            <div>
              <p style="color:#1d1d1f;font-size:15px;font-weight:600;letter-spacing:-0.18px;margin-bottom:4px;">AI Chat Widget</p>
              <p style="color:#707070;font-size:13px;letter-spacing:-0.15px;margin-bottom:12px;">Would you like us to add an AI chat widget to your website? It answers common questions automatically and routes leads to you.</p>
              <div style="display:flex;gap:24px;">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;min-height:44px;">
                  <input type="radio" name="aiWidget" value="yes" />
                  <span style="color:#1d1d1f;font-size:14px;letter-spacing:-0.18px;">Yes, add it</span>
                </label>
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;min-height:44px;">
                  <input type="radio" name="aiWidget" value="no" />
                  <span style="color:#1d1d1f;font-size:14px;letter-spacing:-0.18px;">Not right now</span>
                </label>
              </div>
            </div>
            <div>
              <p style="color:#1d1d1f;font-size:15px;font-weight:600;letter-spacing:-0.18px;margin-bottom:4px;">Top 5 Competitors <span style="color:#707070;font-size:12px;font-weight:400;">(optional)</span></p>
              <p style="color:#707070;font-size:13px;letter-spacing:-0.15px;margin-bottom:8px;">Who are the other players in your market? Business names or websites, either works.</p>
              <textarea id="competitors" name="competitors" rows="3" placeholder={"1. Smith Plumbing\n2. ABC HVAC\n3. ..."} style="width:100%;background:#f5f5f7;border:1.5px solid #d6d6d6;padding:12px 16px;color:#1d1d1f;font-size:14px;letter-spacing:-0.18px;outline:none;resize:none;font-family:inherit;"></textarea>
            </div>
            <div>
              <p style="color:#1d1d1f;font-size:15px;font-weight:600;letter-spacing:-0.18px;margin-bottom:4px;">When can we call?</p>
              <p style="color:#707070;font-size:13px;letter-spacing:-0.15px;margin-bottom:8px;">What time works best for your onboarding call?</p>
              <input id="callTime" name="callTime" type="text" placeholder="e.g., Weekday mornings, Tuesdays after 2pm"
                style="width:100%;background:#f5f5f7;border:1.5px solid #d6d6d6;padding:12px 16px;color:#1d1d1f;font-size:17px;outline:none;" />
            </div>
          </div>

        </div>
      </div>

      <!-- ─── NAV ─── -->
      <div style="display:flex;align-items:center;justify-content:space-between;margin-top:40px;padding-top:24px;border-top:1px solid #d6d6d6;">
        <button id="btn-back" type="button" style="display:none;background:none;border:none;color:#0066cc;font-size:14px;letter-spacing:-0.18px;cursor:pointer;padding:12px 8px;min-height:44px;">← Back</button>
        <div style="flex:1;"></div>
        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px;">
          <button id="btn-next" type="button" class="pill" style="background:#0071e3;color:#fff;font-weight:600;font-size:14px;letter-spacing:-0.18px;padding:12px 28px;border:none;cursor:pointer;min-height:44px;transition:opacity 0.15s;">Next Step →</button>
          <button id="btn-submit" type="button" class="pill" style="display:none;background:#0071e3;color:#fff;font-weight:600;font-size:14px;letter-spacing:-0.18px;padding:12px 28px;border:none;cursor:pointer;min-height:44px;">Submit →</button>
          <p id="submit-error" style="display:none;color:#d70015;font-size:12px;text-align:right;max-width:280px;letter-spacing:-0.15px;"></p>
        </div>
      </div>

    </div><!-- end wizard-card -->

    <!-- Success -->
    <div id="success-card" class="card-shadow" style="display:none;width:100%;max-width:640px;background:#fff;padding:64px 40px;text-align:center;margin-top:24px;">
      <div style="width:64px;height:64px;border-radius:50%;background:#34c759;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;">
        <svg width="32" height="32" fill="none" viewBox="0 0 24 24" stroke="#fff" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
      </div>
      <h2 class="display-font" style="color:#1d1d1f;font-size:32px;font-weight:600;line-height:1.1;letter-spacing:0.29px;margin-bottom:12px;">You're all set.</h2>
      <p style="color:#333;font-size:17px;line-height:1.47;letter-spacing:-0.18px;margin-bottom:8px;">We've got everything we need to get started. Someone from our team will reach out within 24 hours to schedule your onboarding call.</p>
      <p style="color:#707070;font-size:14px;letter-spacing:-0.18px;">Questions in the meantime? <a href="mailto:robert@marketingperformance.net" style="color:#0066cc;text-decoration:none;border-bottom:1px solid #0066cc;">robert@marketingperformance.net</a></p>
    </div>

    <p style="margin-top:32px;color:#707070;font-size:12px;letter-spacing:-0.15px;">Questions? <a href="mailto:robert@marketingperformance.net" style="color:#0066cc;text-decoration:none;">robert@marketingperformance.net</a></p>

  </div>
</Base>

<script>
  const state = {
    step: 1, total: 6,
    data: {} as Record<string, string | boolean>,
    files: {} as Record<string, File>,
    direction: 'forward' as 'forward' | 'backward',
  }

  const introCard     = document.getElementById('intro-card')!
  const wizardCard    = document.getElementById('wizard-card')!
  const wizardHeader  = document.getElementById('wizard-header')!
  const stepIndicator = document.getElementById('step-indicator')!
  const successCard   = document.getElementById('success-card')!
  const btnBack       = document.getElementById('btn-back') as HTMLButtonElement
  const btnNext       = document.getElementById('btn-next') as HTMLButtonElement
  const btnSubmit     = document.getElementById('btn-submit') as HTMLButtonElement
  const submitError   = document.getElementById('submit-error')!
  const stepLabel     = document.getElementById('step-label')!
  const timeRemaining = document.getElementById('time-remaining')!
  const resumeBanner  = document.getElementById('resume-banner')!
  const btnResume     = document.getElementById('btn-resume') as HTMLButtonElement
  const btnStartOver  = document.getElementById('btn-start-over') as HTMLButtonElement

  const STORAGE_KEY = 'ee_onboarding_draft'
  const SKIP_PERSIST = new Set(['registrarPassword','cmsPassword','igPassword','pinterestPassword','xPassword','tiktokPassword','angiPassword','yelpPassword'])

  // Time estimates per step (minutes remaining including current step)
  const TIME_MAP: Record<number, string> = {
    1: 'About 12 minutes',
    2: 'About 9 minutes',
    3: 'About 7 minutes',
    4: 'About 4 minutes',
    5: 'About 2 minutes',
    6: 'Almost done',
  }

  // ── localStorage ──────────────────────────────────────────────────────────
  function saveDraft() {
    try {
      const safe: Record<string, string | boolean> = {}
      for (const [k,v] of Object.entries(state.data)) if (!SKIP_PERSIST.has(k)) safe[k]=v
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ step: state.step, data: safe }))
    } catch {}
  }
  function clearDraft() { try { localStorage.removeItem(STORAGE_KEY) } catch {} }
  function loadDraft(): { step: number; data: Record<string, string | boolean> } | null {
    try { const r = localStorage.getItem(STORAGE_KEY); return r ? JSON.parse(r) : null } catch { return null }
  }

  // ── File inputs ───────────────────────────────────────────────────────────
  document.querySelectorAll('input[type="file"].file-input').forEach(el => {
    el.addEventListener('change', () => {
      const input = el as HTMLInputElement
      const wrap = input.closest('.upload-field')
      const nameEl = input.closest('label')?.querySelector('.file-name')
      const btn = input.closest('label')?.querySelector('.upload-btn') as HTMLElement | null
      const f = input.files?.[0]
      if (nameEl) nameEl.textContent = f?.name || 'No file chosen'
      if (btn && f) { btn.style.borderColor = '#34c759'; btn.style.color = '#1d1d1f' }
      if (wrap) wrap.classList.remove('field-error')
    })
  })

  // ── Accordion ────────────────────────────────────────────────────────────
  document.querySelectorAll('.accordion-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const target = (btn as HTMLElement).dataset.target
      if (!target) return
      const panel = document.getElementById(target)!
      const isOpen = panel.style.display !== 'none'
      panel.style.display = isOpen ? 'none' : 'block'
      btn.textContent = isOpen ? 'How to add us ›' : 'Hide ‹'
    })
  })

  // ── Green validation on blur ──────────────────────────────────────────────
  document.querySelectorAll<HTMLInputElement>('#onboarding-root input[type="text"], #onboarding-root input[type="email"], #onboarding-root input[type="tel"], #onboarding-root input[type="url"]').forEach(input => {
    input.addEventListener('blur', () => {
      if (input.value.trim().length > 0) {
        input.classList.add('field-valid')
        input.classList.remove('field-error')
      } else {
        input.classList.remove('field-valid')
      }
    })
  })

  // ── Enter key navigation ──────────────────────────────────────────────────
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Enter') return
    const target = e.target as HTMLElement
    // Don't intercept Enter in textareas
    if (target.tagName === 'TEXTAREA') return
    // Don't intercept Enter on buttons (let them click naturally)
    if (target.tagName === 'BUTTON') return
    // In the wizard, Enter on an input advances to next step (or submits)
    if (wizardCard.style.display !== 'none') {
      e.preventDefault()
      if (state.step < state.total) {
        btnNext.click()
      } else {
        btnSubmit.click()
      }
    }
  })

  // ── Step chips ────────────────────────────────────────────────────────────
  function updateChips() {
    document.querySelectorAll('[data-chip]').forEach(el => {
      const chip = el as HTMLElement
      const n = parseInt(chip.dataset.chip || '0')
      if (n < state.step) {
        // Completed — green checkmark
        chip.innerHTML = '✓'
        chip.style.cssText = 'width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;border:2px solid #34c759;color:#fff;background:#34c759;transition:background 0.2s,border-color 0.2s,color 0.2s;'
        chip.classList.add('chip-check-animate')
        setTimeout(() => chip.classList.remove('chip-check-animate'), 400)
      } else if (n === state.step) {
        // Active — blue
        chip.innerHTML = String(n)
        chip.style.cssText = 'width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;border:2px solid #0071e3;color:#fff;background:#0071e3;transition:background 0.2s,border-color 0.2s,color 0.2s;'
      } else {
        // Upcoming — gray
        chip.innerHTML = String(n)
        chip.style.cssText = 'width:36px;height:36px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;border:2px solid #d6d6d6;color:#707070;background:#fff;transition:background 0.2s,border-color 0.2s,color 0.2s;'
      }
    })
    stepLabel.textContent = `Step ${state.step} of ${state.total}`
    timeRemaining.textContent = TIME_MAP[state.step] || ''
  }

  // ── Responsive chip visibility ────────────────────────────────────────────
  function updateChipVisibility() {
    const chips = document.getElementById('step-chips')!
    if (window.innerWidth >= 640) {
      chips.style.display = 'flex'
      stepLabel.style.display = 'none'
    } else {
      chips.style.display = 'none'
      stepLabel.style.display = 'block'
    }
  }
  window.addEventListener('resize', updateChipVisibility)
  updateChipVisibility()

  // ── Show step with animation ───────────────────────────────────────────────
  function showStep(n: number, animate = true) {
    const animClass = state.direction === 'forward' ? 'step-animate-forward' : 'step-animate-backward'
    document.querySelectorAll('[data-step]').forEach(el => {
      const stepEl = el as HTMLElement
      const stepN = parseInt(stepEl.dataset.step || '0')
      if (stepN === n) {
        stepEl.style.display = 'block'
        if (animate) {
          stepEl.classList.remove('step-animate-forward', 'step-animate-backward')
          void (stepEl as HTMLElement).offsetWidth // force reflow
          stepEl.classList.add(animClass)
        }
      } else {
        stepEl.style.display = 'none'
      }
    })
    btnBack.style.display = n === 1 ? 'none' : 'block'
    btnNext.style.display = n === state.total ? 'none' : 'block'
    btnSubmit.style.display = n === state.total ? 'block' : 'none'
    updateChips()

    // Autofocus first focusable input
    requestAnimationFrame(() => {
      const stepEl = document.querySelector<HTMLElement>(`[data-step="${n}"]`)
      const first = stepEl?.querySelector<HTMLInputElement>('input[type="text"], input[type="email"], input[type="tel"], input[type="url"], input[type="password"]')
      first?.focus()
    })

    window.scrollTo({ top: 0, behavior: 'smooth' })
  }

  // ── Collect / restore ─────────────────────────────────────────────────────
  function collectCurrentStep() {
    const stepEl = document.querySelector(`[data-step="${state.step}"]`)!
    stepEl.querySelectorAll('input, textarea').forEach(el => {
      const input = el as HTMLInputElement | HTMLTextAreaElement
      if (!input.name) return
      if (input.type === 'file') {
        const f = (input as HTMLInputElement).files?.[0]
        if (f) state.files[input.name] = f
      } else if (input.type === 'checkbox') {
        state.data[input.name] = (input as HTMLInputElement).checked
      } else if (input.type === 'radio') {
        if ((input as HTMLInputElement).checked) state.data[input.name] = input.value
      } else {
        state.data[input.name] = input.value.trim()
      }
    })
  }

  function restoreCurrentStep() {
    const stepEl = document.querySelector(`[data-step="${state.step}"]`)!
    stepEl.querySelectorAll('input, textarea').forEach(el => {
      const input = el as HTMLInputElement | HTMLTextAreaElement
      if (!input.name) return
      if (input.type === 'file') {
        if (input.name in state.files) {
          const nameEl = input.closest('label')?.querySelector('.file-name')
          if (nameEl) nameEl.textContent = state.files[input.name].name
        }
      } else if (input.type === 'checkbox') {
        if (input.name in state.data) (input as HTMLInputElement).checked = state.data[input.name] === true
      } else if (input.type === 'radio') {
        if (input.name in state.data) (input as HTMLInputElement).checked = input.value === state.data[input.name]
      } else {
        if (input.name in state.data) {
          input.value = state.data[input.name] as string
          // Restore green valid state on pre-filled fields
          if (input.value.trim() && input.type !== 'password') input.classList.add('field-valid')
        }
      }
    })
  }

  // ── Error helpers ─────────────────────────────────────────────────────────
  function showFieldError(input: HTMLElement, msg: string) {
    input.classList.add('field-error')
    input.classList.remove('field-valid')
    const errEl = input.nextElementSibling as HTMLElement
    if (errEl?.classList.contains('error-msg')) {
      errEl.style.display = 'block'
      const msgEl = errEl.querySelector('.msg-text')
      if (msgEl) msgEl.textContent = msg
    }
  }

  function clearErrors() {
    document.querySelectorAll('.error-msg').forEach(el => (el as HTMLElement).style.display = 'none')
    document.querySelectorAll('.field-error').forEach(el => {
      (el as HTMLElement).classList.remove('field-error')
    })
  }

  // ── Validate ──────────────────────────────────────────────────────────────
  function validateStep(n: number): boolean {
    clearErrors()
    let valid = true
    let firstError: HTMLElement | null = null

    if (n === 1) {
      const fields = [
        { id: 'clientName',    msg: 'We need your name to get started' },
        { id: 'clientEmail',   msg: 'We need your email to send you a confirmation' },
        { id: 'businessName',  msg: 'Business name is required' },
        { id: 'phone',         msg: 'We need a phone number to reach you' },
        { id: 'address',       msg: 'Business address is required' },
      ]
      fields.forEach(({ id, msg }) => {
        const el = document.getElementById(id) as HTMLInputElement
        if (!el.value.trim()) {
          showFieldError(el, msg)
          if (!firstError) firstError = el
          valid = false
        }
      })
      const emailEl = document.getElementById('clientEmail') as HTMLInputElement
      if (emailEl.value.trim() && !emailEl.value.includes('@')) {
        showFieldError(emailEl, 'That doesn\'t look like a valid email address')
        if (!firstError) firstError = emailEl
        valid = false
      }
    }

    if (n === 2) {
      const fileInput = document.querySelector<HTMLInputElement>('input[name="w9File"]')
      const hasFile = state.files['w9File'] || (fileInput?.files?.[0])
      if (!hasFile) {
        const uploadField = document.querySelector('.upload-field[data-field="w9File"]')
        const errEl = uploadField?.querySelector('.error-msg') as HTMLElement
        if (errEl) {
          errEl.style.display = 'block'
          const m = errEl.querySelector('.msg-text')
          if (m) m.textContent = 'Please upload your completed W-9'
        }
        const btn = uploadField?.querySelector('.upload-btn') as HTMLElement | null
        if (btn) btn.style.borderColor = '#d70015'
        valid = false
      }
    }

    if (!valid && firstError) {
      (firstError as HTMLElement).focus()
    }
    return valid
  }

  // ── Button handlers ───────────────────────────────────────────────────────
  btnNext.addEventListener('click', () => {
    if (!validateStep(state.step)) return
    collectCurrentStep()
    state.direction = 'forward'
    state.step++
    saveDraft()
    showStep(state.step)
    restoreCurrentStep()
  })

  btnBack.addEventListener('click', () => {
    collectCurrentStep()
    state.direction = 'backward'
    state.step--
    saveDraft()
    showStep(state.step)
    restoreCurrentStep()
  })

  function launchWizard() {
    introCard.style.display = 'none'
    resumeBanner.style.display = 'none'
    wizardCard.style.display = 'block'
    stepIndicator.style.display = 'block'
    updateChipVisibility()
    showStep(state.step, false)
    if (state.step > 1) restoreCurrentStep()
  }

  document.getElementById('btn-get-started')!.addEventListener('click', launchWizard)
  btnResume.addEventListener('click', launchWizard)

  btnStartOver.addEventListener('click', () => {
    clearDraft()
    state.step = 1
    state.data = {}
    state.files = {}
    resumeBanner.style.display = 'none'
    document.getElementById('btn-get-started')!.textContent = 'Let\'s Go →'
  })

  btnSubmit.addEventListener('click', async () => {
    if (!validateStep(state.step)) return
    collectCurrentStep()
    btnSubmit.disabled = true
    btnSubmit.textContent = 'Submitting...'
    btnSubmit.style.opacity = '0.7'
    submitError.style.display = 'none'
    try {
      const fd = new FormData()
      for (const [k,v] of Object.entries(state.data)) fd.append(k, String(v))
      for (const [k,f] of Object.entries(state.files)) fd.append(k, f)
      const res = await fetch('/api/onboarding', { method: 'POST', body: fd })
      const json = await res.json() as { ok: boolean; error?: string }
      if (json.ok) {
        clearDraft()
        wizardCard.style.display = 'none'
        wizardHeader.style.display = 'none'
        stepIndicator.style.display = 'none'
        successCard.style.display = 'block'
        window.scrollTo({ top: 0, behavior: 'smooth' })
      } else {
        submitError.textContent = json.error || 'Something went wrong. Please try again or email robert@marketingperformance.net.'
        submitError.style.display = 'block'
        btnSubmit.disabled = false
        btnSubmit.textContent = 'Submit →'
        btnSubmit.style.opacity = '1'
      }
    } catch {
      submitError.textContent = 'Network error. Please check your connection and try again.'
      submitError.style.display = 'block'
      btnSubmit.disabled = false
      btnSubmit.textContent = 'Submit →'
      btnSubmit.style.opacity = '1'
    }
  })

  // ── Init ──────────────────────────────────────────────────────────────────
  wizardCard.style.display = 'none'
  stepIndicator.style.display = 'none'

  const draft = loadDraft()
  if (draft && draft.step > 1 && Object.keys(draft.data).length > 0) {
    state.data = draft.data
    state.step = draft.step
    resumeBanner.style.display = 'flex'
    const btn = document.getElementById('btn-get-started')!
    btn.textContent = 'Resume Where I Left Off →'
  }
</script>
