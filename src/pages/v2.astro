---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
---
<Base
  title="Marketing Performance Group — Find the Buyers Already In Your Market"
  description="We already know who's searching for your services in your market. A free 30-second snapshot shows you exactly how many — and whether a competitor has already pulled this data. Built for service businesses doing $500K–$5M/year."
>
  <Nav />
  <main class="v2">

    <!-- ═══ 1. HERO ═══ -->
    <section class="v2-hero">
      <div class="v2-hero-wrap">
        <div class="v2-hero-left">
          <p class="v2-eyebrow">The Demand Visibility Engine</p>
          <h1 class="v2-h1">
            <span class="hero-word">Right </span>
            <span class="hero-word">Now, </span>
            <span class="hero-word">Buyers </span>
            <span class="hero-word">in </span>
            <span class="hero-word">Your </span>
            <span class="hero-word">Market </span>
            <span class="hero-word">Are </span>
            <span class="hero-word">Searching </span>
            <span class="hero-word">for </span>
            <span class="hero-word">Exactly </span>
            <span class="hero-word">What </span>
            <span class="hero-word">You </span>
            <span class="hero-word">Offer.</span>
          </h1>
          <p class="v2-punch hero-sub">None of them are calling you.</p>
          <p class="v2-sub hero-sub">We already know who's searching for your services in your market. See how many — and whether a competitor has already pulled this data.</p>

          <div class="hero-cta v2-cta-block">
            <a href="/snapshot" class="btn btn-blue v2-cta">Show Me Who's Searching in My Market →</a>
            <p class="v2-micro">Free · No email required · Results in seconds</p>
            <p class="v2-cred-line"><strong>31 years in business. Zero refunds.</strong> Not because we don't offer them — because we don't need to.</p>
            <div class="v2-guarantee-chip">
              <span class="v2-check">✓</span>
              <span>Backed by our <strong>2X Revenue Guarantee</strong> — or we keep working. Free.</span>
            </div>
          </div>
        </div>

        <!-- Snapshot artifact -->
        <div class="v2-artifact">
          <div class="v2-artifact-head">
            <span class="v2-artifact-label">Sample snapshot</span>
            <span class="v2-artifact-loc">Columbia, SC · Fencing</span>
          </div>
          <div class="v2-artifact-count">
            <span class="v2-count-num">847</span>
            <span class="v2-count-l">in-market buyers in the last 72 hours</span>
          </div>
          <div class="v2-artifact-table">
            <div class="v2-row v2-row-head">
              <span>BUYER</span><span>ZIP</span><span>SIGNAL</span>
            </div>
            <div class="v2-row">
              <span>J█████ M█████</span><span>29209</span><span>2h ago</span>
            </div>
            <div class="v2-row">
              <span>S█████ K█████</span><span>29063</span><span>4h ago</span>
            </div>
            <div class="v2-row">
              <span>R█████ T█████</span><span>29212</span><span>7h ago</span>
            </div>
            <div class="v2-row">
              <span>A█████ B█████</span><span>29229</span><span>11h ago</span>
            </div>
            <div class="v2-row v2-row-more">+ 843 more</div>
          </div>
          <div class="v2-artifact-warn">
            <span class="v2-warn-dot"></span>
            <span><strong>3 of your competitors</strong> are already running ads to this audience.</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 2. HERO-ANCHOR TESTIMONIAL ═══ -->
    <section class="v2-anchor-proof">
      <div class="v2-anchor-card" data-animate>
        <div class="v2-anchor-photo">RG</div>
        <div class="v2-anchor-body">
          <p class="v2-anchor-quote">"We were running ads, getting clicks, and losing people. They found the problem. Appointments jumped 170%. I haven't touched the budget since."</p>
          <p class="v2-anchor-attr"><strong>George Rogerson</strong> · McClintock HVAC · Charlotte, NC</p>
          <p class="v2-anchor-meta">170% more booked appointments · same ad budget · 90 days</p>
        </div>
      </div>
    </section>

    <!-- ═══ 3. PRODUCT CLARITY ═══ -->
    <section class="v2-section">
      <div class="v2-wrap">
        <p class="v2-section-eye" data-animate>What This Is</p>
        <h2 class="v2-section-h2" data-animate data-delay="0.05">EngageEngine™ Is a Fully Managed Service.</h2>
        <p class="v2-section-lead" data-animate data-delay="0.1">Not software. Not a dashboard. Not another platform for you to learn. We do the work. You tell us your market and your service — we handle audience building, ad placement, optimization, and reporting.</p>

        <div class="v2-do-grid" data-animate data-delay="0.15">
          <div class="v2-do-col v2-do-col-yes">
            <p class="v2-do-h">Here's what you do</p>
            <ul>
              <li><span>✓</span> Tell us your service area</li>
              <li><span>✓</span> Tell us what a good job looks like</li>
              <li><span>✓</span> Answer the calls</li>
            </ul>
          </div>
          <div class="v2-do-col v2-do-col-no">
            <p class="v2-do-h">Here's what you don't</p>
            <ul>
              <li><span>✕</span> Manage campaigns</li>
              <li><span>✕</span> Build audiences</li>
              <li><span>✕</span> Touch the platform</li>
              <li><span>✕</span> Learn another dashboard</li>
            </ul>
          </div>
        </div>

        <p class="v2-fit-line" data-animate data-delay="0.2">Built for service businesses doing <strong>$500K–$5M/year in revenue</strong>.</p>
      </div>
    </section>

    <!-- ═══ 4. HOW IT WORKS ═══ -->
    <section class="v2-section v2-section-alt">
      <div class="v2-wrap">
        <p class="v2-section-eye" data-animate>How It Works</p>
        <h2 class="v2-section-h2" data-animate data-delay="0.05">We Find Buyers Before They Call Anyone.</h2>
        <div class="v2-mechanism" data-animate data-delay="0.1">
          <p>Before a homeowner calls anyone, they're already searching. Reading reviews. Comparing options. Looking at maps.</p>
          <p>We identify those <strong>specific people</strong> — by name and address — and put your ads in front of them, and only them, across Google, Facebook, YouTube, and every other platform they use.</p>
          <p>No wasted spend on people who'll never call. No guessing who's in market. Just the buyers who are actually deciding right now.</p>
        </div>

        <div class="v2-modules" data-animate data-delay="0.15">
          <div class="v2-module">
            <div class="v2-mod-num">01</div>
            <div class="v2-mod-name">We find them</div>
            <div class="v2-mod-desc">45,000+ data sources tell us who in your market is searching for your service this week.</div>
          </div>
          <div class="v2-module">
            <div class="v2-mod-num">02</div>
            <div class="v2-mod-name">We match them</div>
            <div class="v2-mod-desc">Custom audiences built daily — matched to your service, your geography, and the kind of job you actually want.</div>
          </div>
          <div class="v2-module">
            <div class="v2-mod-num">03</div>
            <div class="v2-mod-name">We reach them</div>
            <div class="v2-mod-desc">Your ads run on Google, Meta, and programmatic — in front of the same people, across every channel they use.</div>
          </div>
          <div class="v2-module">
            <div class="v2-mod-num">04</div>
            <div class="v2-mod-name">We learn from them</div>
            <div class="v2-mod-desc">Every closed job feeds back in. The system gets sharper every week about what a real customer looks like.</div>
          </div>
          <div class="v2-module">
            <div class="v2-mod-num">05</div>
            <div class="v2-mod-name">We prove it</div>
            <div class="v2-mod-desc">Every lead traced from first signal to closed job. You always see exactly what's working — and what it cost.</div>
          </div>
        </div>

        <p class="v2-timeline" data-animate data-delay="0.2"><strong>Most clients are live within 72 hours of the diagnostic.</strong></p>

        <div class="v2-status" data-animate data-delay="0.25">
          <p class="v2-status-cap">Live system performance — across all active client accounts</p>
          <div class="v2-status-rows">
            <div class="v2-status-row"><span>System Status</span><span class="v2-status-v">ACTIVE</span></div>
            <div class="v2-status-row"><span>Cost Reduction vs. Platform-Native</span><span class="v2-status-v">67–90%</span></div>
            <div class="v2-status-row"><span>Attribution</span><span class="v2-status-v">CLOSED LOOP</span></div>
            <div class="v2-status-row"><span>Audiences</span><span class="v2-status-v">REFRESHED DAILY</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 5. HOW-IT-WORKS ANCHOR TESTIMONIAL ═══ -->
    <section class="v2-anchor-proof">
      <div class="v2-anchor-card" data-animate>
        <div class="v2-anchor-photo">LG</div>
        <div class="v2-anchor-body">
          <p class="v2-anchor-quote">"Our call volume went down. Our sales went up. We're getting better customers — people who are actually ready to buy."</p>
          <p class="v2-anchor-attr"><strong>Larry Gates</strong> · Floor Pro · Columbia, SC</p>
          <p class="v2-anchor-meta">Same ad budget · fewer junk calls · higher close rate</p>
        </div>
      </div>
    </section>

    <!-- ═══ 6. RESULTS ═══ -->
    <section class="v2-section">
      <div class="v2-wrap-wide">
        <p class="v2-section-eye v2-center" data-animate>Real Results from Real Businesses</p>
        <h2 class="v2-section-h2 v2-center" data-animate data-delay="0.05">Four more service businesses. Same system. Different verticals.</h2>
        <p class="v2-section-lead v2-center" data-animate data-delay="0.1">These are working businesses you can verify. Ask us for contact info — they've agreed to talk to qualified prospects.</p>

        <div class="v2-results-grid">
          <div class="v2-result" data-animate>
            <p class="v2-result-headline">$440K in sales. One week.</p>
            <p class="v2-result-quote">"We diagnosed the problem — buyers found us but didn't trust what they saw. We tightened the trust signals. A hundred and twenty days later, we did $440,000 in sales in one week. Same traffic. Different result."</p>
            <p class="v2-result-attr"><strong>Bob Farnsworth</strong> · Landscape Charleston · Charleston, SC</p>
          </div>
          <div class="v2-result" data-animate data-delay="0.1">
            <p class="v2-result-headline">Monthly sales tripled. Ad spend cut 60%.</p>
            <p class="v2-result-quote">"We fixed the right problem. Monthly sales tripled. We're spending 60% less than before."</p>
            <p class="v2-result-attr"><strong>Bobby Wood</strong> · King's Fencing · Nashville, TN</p>
          </div>
          <div class="v2-result" data-animate data-delay="0.2">
            <p class="v2-result-headline">No more seasonal slowdowns.</p>
            <p class="v2-result-quote">"The phones ring. The jobs book. We don't have seasonal slowdowns anymore. And we're not spending any more than we were."</p>
            <p class="v2-result-attr"><strong>Ethan Del Priore</strong> · Carolina Stone Craftsman · Columbia, SC</p>
          </div>
          <div class="v2-result" data-animate data-delay="0.1">
            <p class="v2-result-headline">Close rates up. Price objections gone.</p>
            <p class="v2-result-quote">"Our close rates jumped. The price conversations got easier. Buyers just stopped pushing back."</p>
            <p class="v2-result-attr"><strong>John Raz</strong> · Orange County Garage Doors · Tustin, CA</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 7. MARKET EXCLUSIVITY ═══ -->
    <section class="v2-exclusivity-section">
      <div class="v2-wrap">
        <div class="v2-exclusivity" data-animate>
          <p class="v2-excl-eye">Market Exclusivity</p>
          <h2 class="v2-excl-h">One business per service category per market.</h2>
          <p class="v2-excl-body">Once that slot is taken in your area, it's closed — until the current client leaves or the market is reopened.</p>
          <p class="v2-excl-warn"><strong>Your competitor may have already pulled this snapshot.</strong> If they did, they're already in front of your buyers.</p>
        </div>
      </div>
    </section>

    <!-- ═══ 8. GUARANTEE ═══ -->
    <section class="v2-section v2-guarantee-section">
      <div class="v2-wrap">
        <p class="v2-section-eye v2-center" data-animate>The Guarantee</p>
        <h2 class="v2-section-h2 v2-center" data-animate data-delay="0.05">The Guarantee Nobody Else in This Industry Will Make.</h2>

        <div class="v2-guarantee-card" data-animate data-delay="0.1">
          <div class="v2-guarantee-badge">
            <span class="v2-check-lg">✓</span>
            <span>2X Revenue Guarantee</span>
          </div>
          <p class="v2-guarantee-body">If EngageEngine™ doesn't deliver at least <strong>2X our fee in closed revenue within 90 days</strong> — we keep working until it does. Free.</p>
          <p class="v2-guarantee-body">We don't refund you and disappear. We stay. We fix. We run it until it works. Because if we can't find the buyers, we don't deserve to get paid.</p>
        </div>

        <div class="v2-founder" data-animate data-delay="0.15">
          <img src="/img/robbie-butt.jpg" alt="Robbie Butt, Founder of EngageEngine™" class="v2-founder-photo" />
          <div class="v2-founder-body">
            <p class="v2-founder-name">Robbie Butt</p>
            <p class="v2-founder-title">Founder, EngageEngine™ · 41 years in this industry</p>
            <p class="v2-founder-quote">"I personally sign every client. If it doesn't work, I keep working. That's been the deal for 31 years."</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 9. FINAL CLOSE ═══ -->
    <section class="v2-close">
      <h2 class="v2-close-h1" data-animate>The buyers are already in your market.</h2>
      <p class="v2-close-h2" data-animate data-delay="0.05">The only question is who gets to them first.</p>
      <p class="v2-close-body" data-animate data-delay="0.1">Every day this runs without you, a competitor is capturing demand that should be yours. Your competitor may have already pulled the snapshot for your market. The snapshot takes 30 seconds. No email. No sales call. Just your data.</p>
      <div data-animate data-delay="0.2">
        <a href="/snapshot" class="btn btn-blue v2-cta">Show Me Who's Searching in My Market →</a>
        <p class="v2-micro">Free · No email required · Results in seconds</p>
      </div>
    </section>

  </main>
  <Footer />
</Base>

<style>
  /* ─── Base ─── */
  .v2 { background: var(--canvas); }
  .v2-wrap { max-width: 880px; margin: 0 auto; padding: 0 22px; }
  .v2-wrap-wide { max-width: 1100px; margin: 0 auto; padding: 0 22px; }
  .v2-center { text-align: center; }

  /* ─── Hero ─── */
  .v2-hero { padding: 64px 0 56px; background: var(--canvas); }
  .v2-hero-wrap {
    max-width: 1180px; margin: 0 auto; padding: 0 22px;
    display: grid; grid-template-columns: 1fr; gap: 48px;
  }
  @media (min-width: 960px) {
    .v2-hero-wrap { grid-template-columns: 1.05fr 0.95fr; gap: 64px; align-items: start; }
  }
  .v2-hero-left { max-width: 620px; }
  .v2-eyebrow {
    font-size: 12px; font-weight: 600; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--blue); margin-bottom: 18px;
  }
  .v2-h1 {
    font-family: var(--font-d);
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 600; line-height: 1.07; letter-spacing: -0.01em;
    color: var(--graphite); margin-bottom: 12px;
  }
  .v2-punch {
    font-family: var(--font-d);
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 600; line-height: 1.07; letter-spacing: -0.01em;
    color: var(--blue); margin-bottom: 24px;
  }
  .v2-sub {
    font-size: 18px; line-height: 1.55; color: var(--mid-gray);
    margin-bottom: 32px; max-width: 540px;
  }
  .v2-cta-block { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .v2-cta {
    font-size: 16px; padding: 14px 26px; border-radius: 980px;
    background: var(--blue); color: #fff; font-weight: 500;
    text-decoration: none; display: inline-block;
  }
  .v2-cta:hover { background: #0066cc; }
  .v2-micro {
    font-size: 13px; color: var(--light-gray); letter-spacing: 0.01em;
  }
  .v2-cred-line {
    font-size: 14px; line-height: 1.5; color: var(--mid-gray);
    max-width: 460px; margin-top: 8px;
  }
  .v2-cred-line strong { color: var(--graphite); font-weight: 600; }
  .v2-guarantee-chip {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 8px 14px; border: 1px solid rgba(0,113,227,0.3);
    background: rgba(0,113,227,0.05); border-radius: 999px;
    font-size: 13px; color: var(--graphite); margin-top: 4px;
  }
  .v2-check {
    width: 16px; height: 16px; border-radius: 50%;
    background: var(--blue); color: #fff;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 10px; font-weight: 700;
  }

  /* ─── Snapshot artifact ─── */
  .v2-artifact {
    background: #fff; border: 1px solid var(--border);
    border-radius: 12px; padding: 22px;
    box-shadow: rgba(0,0,0,0.06) 0 6px 24px;
    max-width: 460px;
  }
  .v2-artifact-head {
    display: flex; justify-content: space-between; align-items: center;
    padding-bottom: 12px; border-bottom: 1px solid var(--border);
    margin-bottom: 16px;
  }
  .v2-artifact-label {
    font-size: 11px; font-weight: 600; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--light-gray);
  }
  .v2-artifact-loc { font-size: 12px; color: var(--mid-gray); font-family: 'SF Mono', monospace; }
  .v2-artifact-count { margin-bottom: 18px; }
  .v2-count-num {
    font-family: var(--font-d);
    font-size: 44px; font-weight: 600;
    color: var(--blue); display: block; line-height: 1;
    letter-spacing: -0.02em;
  }
  .v2-count-l { font-size: 13px; color: var(--mid-gray); margin-top: 4px; display: block; }
  .v2-artifact-table {
    display: flex; flex-direction: column; gap: 8px;
    font-family: 'SF Mono', monospace; font-size: 12px;
    margin-bottom: 16px;
  }
  .v2-row {
    display: grid; grid-template-columns: 2fr 1fr 1fr;
    gap: 8px; padding: 8px 0;
    border-bottom: 1px solid var(--canvas);
    color: var(--graphite);
  }
  .v2-row-head {
    font-size: 10px; font-weight: 600; letter-spacing: 0.08em;
    color: var(--light-gray);
  }
  .v2-row-more {
    display: block; text-align: center; color: var(--mid-gray);
    font-size: 11px; padding-top: 8px; border: none;
  }
  .v2-artifact-warn {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 14px; background: rgba(214,40,40,0.06);
    border: 1px solid rgba(214,40,40,0.18); border-radius: 8px;
    font-size: 13px; color: var(--graphite);
  }
  .v2-warn-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: #d62828; flex-shrink: 0;
    animation: pulseDot 1.6s ease-in-out infinite;
  }
  @keyframes pulseDot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.3); }
  }

  /* ─── Anchor proof (single testimonial blocks) ─── */
  .v2-anchor-proof {
    background: #fff;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 36px 22px;
  }
  .v2-anchor-card {
    max-width: 840px; margin: 0 auto;
    display: flex; align-items: center; gap: 24px;
  }
  .v2-anchor-photo {
    width: 64px; height: 64px; border-radius: 50%;
    background: var(--canvas); border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-d); font-weight: 600;
    font-size: 18px; color: var(--mid-gray);
    flex-shrink: 0;
  }
  .v2-anchor-quote {
    font-family: var(--font-d);
    font-size: 18px; line-height: 1.4; color: var(--graphite);
    font-style: italic; margin-bottom: 8px;
  }
  .v2-anchor-attr { font-size: 13px; color: var(--mid-gray); }
  .v2-anchor-attr strong { color: var(--graphite); font-weight: 600; }
  .v2-anchor-meta {
    font-size: 12px; color: var(--blue);
    margin-top: 6px; letter-spacing: 0.02em;
  }
  @media (max-width: 600px) {
    .v2-anchor-card { flex-direction: column; align-items: flex-start; }
  }

  /* ─── Section ─── */
  .v2-section { padding: 80px 0; border-top: 1px solid var(--border); background: var(--canvas); }
  .v2-section-alt { background: #fff; }
  .v2-section-eye {
    font-size: 12px; font-weight: 600; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--blue); margin-bottom: 14px;
  }
  .v2-section-h2 {
    font-family: var(--font-d);
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 600; line-height: 1.1; letter-spacing: -0.005em;
    color: var(--graphite); margin-bottom: 18px;
    max-width: 720px;
  }
  .v2-section-h2.v2-center { margin-left: auto; margin-right: auto; }
  .v2-section-lead {
    font-size: 18px; line-height: 1.6; color: var(--mid-gray);
    max-width: 640px; margin-bottom: 32px;
  }
  .v2-section-lead.v2-center { margin-left: auto; margin-right: auto; text-align: center; }

  /* ─── DO/DON'T grid ─── */
  .v2-do-grid {
    display: grid; grid-template-columns: 1fr; gap: 16px;
    margin-bottom: 28px;
  }
  @media (min-width: 720px) { .v2-do-grid { grid-template-columns: 1fr 1fr; } }
  .v2-do-col {
    background: #fff; border: 1px solid var(--border);
    border-radius: 12px; padding: 24px 26px;
  }
  .v2-do-col-yes { border-left: 3px solid var(--blue); }
  .v2-do-col-no { border-left: 3px solid var(--light-gray); }
  .v2-do-h {
    font-size: 12px; font-weight: 600; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--mid-gray); margin-bottom: 14px;
  }
  .v2-do-col ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .v2-do-col li {
    font-size: 15px; line-height: 1.5; color: var(--graphite);
    display: flex; align-items: flex-start; gap: 10px;
  }
  .v2-do-col-yes li span {
    color: var(--blue); font-weight: 700; flex-shrink: 0;
  }
  .v2-do-col-no li span {
