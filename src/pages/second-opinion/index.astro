---
// /second-opinion — the $497 paid entry offer, on the homepage layout.
// Copy approved in Dropbox/EngageEngine/Client Reports/Marketing Performance/Second Opinion — Offer Page Copy 2026-10-09.md
import Base from '../../layouts/Base.astro'
import Footer from '../../components/Footer.astro'
import CaseStudyCards from '../../components/CaseStudyCards.astro'

// Stripe Buy Button (Robbie, 2026-10-10). The publishable key is public by design.
// Its Payment Link must redirect after payment to
//   https://marketingperformance.net/second-opinion/thanks/?session_id={CHECKOUT_SESSION_ID}
// so the sale is recorded on /second-opinion/thanks/.
const STRIPE_BUTTON_ID = 'buy_btn_1UP6npEXtQdTAS0pg5gD2O2a'
const STRIPE_PK = 'pk_live_NCHTemOvjLeYzr0ZrsGcdQEp00k1AiMZ2F'
const PHONE = '803-386-8337'
const TEL = 'tel:+18033868337'

const caseStudies = [
  { client: 'The Guttermen', headline: 'Twice the estimate bookings. Within 45 days.',
    summary: 'Advertising, intent-based email follow-up, and a connected website and inquiry system supported a doubling of estimate bookings within the first 45 days of working together.',
    href: '/case-studies/the-guttermen/' },
  { client: 'Punch List Pros', headline: '$5.20 in booked work per Google Ads dollar.',
    summary: 'August 2026 reporting connected Google advertising to uploaded closed-job values. Alongside search, the Meta program generated 97 lead-form submissions at approximately $29 each over the April–September reporting window.',
    href: '/case-studies/punch-list-pros/' },
  { client: 'Midlands Landscape', headline: '20% growth. In a market that grew 6%.',
    summary: 'A coordinated marketing program connected intent-based audiences, advertising, and email follow-up across landscaping, hardscaping, and landscape supply.',
    href: '/case-studies/midlands-landscape/' },
];
---
<Base
  title="Second Opinion — Marketing Performance"
  description="In three days we show you where your market is choosing someone else, with proof you can check yourself. $497, credited if you hire us.">

  <nav class="mp-nav">
    <div class="mp-nav-inner">
      <a href="/" class="mp-logo">
        <img src="/mp-logo-v3.png" alt="Marketing Performance — Powered by EngageEngine™" width="217" height="44" />
      </a>
      <a href={TEL} class="mp-nav-phone" data-track="call">{PHONE}</a>
    </div>
  </nav>

  <main class="mp">

    <!-- ═══ HERO: copy left, video right (same grid as the homepage) ═══ -->
    <section class="mp-hero">
      <div class="mp-hero-grid">
        <div class="mp-hero-copy">
          <p class="mp-eye">The Second Opinion · $497</p>
          <h1 class="mp-h1">
            <span class="hero-word">You </span>
            <span class="hero-word">already </span>
            <span class="hero-word">have </span>
            <span class="hero-word">the </span>
            <span class="hero-word">demand. </span>
            <br />
            <span class="hero-word hero-dim">You're </span>
            <span class="hero-word hero-dim">losing </span>
            <span class="hero-word hero-dim">it </span>
            <span class="hero-word hero-dim">before </span>
            <span class="hero-word hero-dim">they </span>
            <span class="hero-word hero-dim">hire </span>
            <span class="hero-word hero-dim">you. </span>
          </h1>
          <div class="mp-hero-prose hero-sub">
            <p>Some customers never found you. Some found you and called someone else. Some got your quote and went quiet. Some said yes and never booked. In three days we'll show you which ones, and why.</p>
          </div>

          <div class="hero-cta mp-hero-cta-block">
            <div class="so-stripe" data-pos="hero"><stripe-buy-button buy-button-id={STRIPE_BUTTON_ID} publishable-key={STRIPE_PK}></stripe-buy-button></div>
            <p class="mp-micro">Or call. <a href={TEL} data-track="call"><strong>{PHONE}</strong></a>. I answer.</p>
          </div>
        </div>

        <!-- Autoplays muted; burned-in captions carry it, controls allow unmute. -->
        <figure class="mp-artifact mp-artifact-video">
          <div class="mp-hero-video">
            <video autoplay muted loop playsinline controls preload="metadata" poster="/video/hub/second-opinion-poster.jpg">
              <source src="/video/hub/second-opinion.mp4" type="video/mp4" />
            </video>
          </div>
          <figcaption class="mp-artifact-cap">Two and a half minutes. Where your jobs are going.</figcaption>
        </figure>
      </div>
    </section>

    <!-- ═══ THE FREE AUDIT ═══ -->
    <section class="mp-problem">
      <div class="mp-problem-inner">
        <p class="mp-eye">Not a free audit</p>
        <h2 class="mp-h2">You've been offered a free audit before.</h2>
        <div class="mp-problem-prose">
          <p>Probably this month.</p>
          <p>You know what a free audit is. It's a sales call with a PDF stapled to it. Somebody runs your website through a tool, finds twelve things wrong, and every one of them happens to be something they sell.</p>
          <p><strong>This isn't that.</strong> Nothing in this report is a reason to hire us. It's a list of where your market is choosing someone else right now, with proof you can check yourself in about thirty seconds.</p>
        </div>
      </div>
    </section>

    <!-- ═══ WHAT'S IN IT ═══ -->
    <section class="mp-breaks">
      <div class="mp-breaks-inner">
        <p class="mp-eye">What's in it</p>
        <h2 class="mp-h2">We don't look at your marketing. We look at your market.</h2>
        <div class="mp-breaks-list so-list">
          <div class="mp-break">
            <h3><span class="so-n">1</span>Who shows up instead of you.</h3>
            <p>We search your service in your town the way a customer does. Google. The map. And now ChatGPT. We screenshot who gets named. If it isn't you, you'll see exactly who it is.</p>
          </div>
          <div class="mp-break">
            <h3><span class="so-n">2</span>Why customers pick the other guy.</h3>
            <p>We read what your customers say about you. Then we read what your competitors' customers say about them. In their words, not ours. Every market has three or four reasons people choose. You'll know which ones you're losing on.</p>
          </div>
          <div class="mp-break">
            <h3><span class="so-n">3</span>Whether anyone answers at 7pm.</h3>
            <p>We call. We fill out your quote form and time the reply. Then we do the same thing to your top three competitors. You'll see the stopwatch.</p>
          </div>
          <div class="mp-break">
            <h3><span class="so-n">4</span>What it's worth to you.</h3>
            <p>You give us three numbers. Your average job. How many quotes you send a month. How many you book. We'll show you what the gap is costing you. We'd rather be low and right.</p>
          </div>
          <div class="mp-break">
            <h3><span class="so-n">5</span>The three things to fix this week.</h3>
            <p>Not twelve. Three. In order. With the tool for each one, already built.</p>
          </div>
        </div>
        <p class="mp-breaks-foot">Then we get on the phone for thirty minutes and walk through it. That's the part people tell us was worth the money.</p>
      </div>
    </section>

    <!-- ═══ WHO IT'S FOR ═══ -->
    <section class="mp-problem">
      <div class="mp-problem-inner">
        <p class="mp-eye">Who it's for</p>
        <h2 class="mp-h2">Any business that lives on local customers.</h2>
        <div class="mp-problem-prose">
          <p>A roofer. A plastic surgeon. A law firm. A gutter company. A preschool. The names on the report change. The four places a sale breaks don't.</p>
          <p>Doing less than $500,000 a year? <a href="/diagnostic/" class="so-link">Take the free diagnostic instead.</a> It gets you most of the way there and it costs nothing.</p>
        </div>
      </div>
    </section>

    <!-- ═══ PRICE, GUARANTEE, EXCLUSIVITY ═══ -->
    <section class="mp-breaks">
      <div class="mp-breaks-inner">
        <p class="mp-eye">What it costs</p>
        <p class="so-amount">$497</p>
        <div class="mp-problem-prose so-tight">
          <p><strong>Hire us inside 30 days and it comes off your first invoice.</strong></p>
          <p>Not ready to hire anyone? Keep the report. Fix the three things yourself. We'll have told you how.</p>
        </div>

        <div class="so-terms">
          <div class="so-term">
            <h3>You decide if it was worth it.</h3>
            <p>If it doesn't show you one thing you didn't know, and can check yourself, we refund the $497. You keep the report. You don't have to argue with us about it.</p>
          </div>
          <div class="so-term">
            <h3>One more thing.</h3>
            <p>We never work with your competitors. One company per trade, per town. If we already work for someone in your trade in your market, we tell you before you pay.</p>
          </div>
        </div>

        <div class="mp-hero-cta-block so-mid-cta">
          <div class="so-stripe" data-pos="price"><stripe-buy-button buy-button-id={STRIPE_BUTTON_ID} publishable-key={STRIPE_PK}></stripe-buy-button></div>
        </div>
      </div>
    </section>

    <!-- ═══ FROM ROBBIE (homepage portrait block) ═══ -->
    <section class="mp-creds">
      <div class="mp-creds-inner">
        <figure class="mp-creds-photo">
          <img src="/img/robbie-butt.jpg" alt="Robbie Butt, Marketing Performance, Columbia, South Carolina" width="560" height="1054" loading="lazy" />
          <figcaption>Robbie Butt &middot; Columbia, South Carolina</figcaption>
        </figure>
        <div class="so-letter">
          <p class="mp-eye">From Robbie</p>
          <p>I've been in advertising 41 years. I've owned this company for 31 of them. In all that time I never saw a free audit that wasn't a sales pitch, including the ones we used to give. So we quit.</p>
          <p>What we do instead is charge you a little, tell you the truth, and let you decide. Most people who buy this don't hire us. That's fine. Three fixed problems is three fixed problems. The ones who do hire us already know what we found, so we skip the pitch and go to work.</p>
          <p>Does that help? Call me and ask anything. <a href={TEL} data-track="call" class="so-link">{PHONE}</a>.</p>
          <p class="so-sig">Robbie</p>
        </div>
      </div>
    </section>

    <!-- ═══ PROOF ═══ -->
    <section class="so-proof-head">
      <p class="mp-eye">Results</p>
      <h2 class="mp-h2">What happened for people who did hire us</h2>
    </section>
    <CaseStudyCards cards={caseStudies} />

    <!-- ═══ CLOSE ═══ -->
    <section class="mp-close">
      <h2 class="mp-close-h1">Already took the free diagnostic?</h2>
      <p class="mp-close-body">That told you where you think you're losing jobs. This checks it from the outside, against the people actually taking them.</p>
      <div class="mp-close-cta">
        <div class="so-stripe" data-pos="close"><stripe-buy-button buy-button-id={STRIPE_BUTTON_ID} publishable-key={STRIPE_PK}></stripe-buy-button></div>
        <p class="mp-micro">Three days. Report, screenshots, call. <a href={TEL} data-track="call"><strong>{PHONE}</strong></a>.</p>
      </div>
    </section>

  </main>
  <Footer ctaHref="/diagnostic/" />
</Base>

<script is:inline async src="https://js.stripe.com/v3/buy-button.js"></script>
<script is:inline>
  // The Stripe button lives in its own frame, so a click on it never reaches this page.
  // When the window loses focus to that frame, count it once per button as checkout started.
  (function () {
    var seen = {};
    window.addEventListener('blur', function () {
      setTimeout(function () {
        var el = document.activeElement;
        var host = el && el.closest ? el.closest('.so-stripe') : null;
        if (!host) return;
        var pos = host.getAttribute('data-pos') || '';
        if (seen[pos]) return; seen[pos] = 1;
        if (typeof gtag === 'function') gtag('event', 'begin_checkout', { value: 497, currency: 'USD', items: [{ item_name: 'Second Opinion' }], position: pos });
        if (typeof fbq === 'function') fbq('track', 'InitiateCheckout', { value: 497, currency: 'USD', content_name: 'Second Opinion' });
        window.focus();
      }, 0);
    });
  })();
</script>
<script is:inline>
  // One measured action per click. "buy" = checkout started; the sale itself fires on /second-opinion/thanks/.
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('[data-track]');
    if (!a) return;
    var kind = a.getAttribute('data-track');
    if (kind === 'buy') {
      if (typeof gtag === 'function') gtag('event', 'begin_checkout', { value: 497, currency: 'USD', items: [{ item_name: 'Second Opinion' }], position: a.getAttribute('data-pos') || '' });
      if (typeof fbq === 'function') fbq('track', 'InitiateCheckout', { value: 497, currency: 'USD', content_name: 'Second Opinion' });
    } else if (kind === 'call') {
      if (typeof gtag === 'function') gtag('event', 'phone_click', { page: 'second-opinion' });
      if (typeof fbq === 'function') fbq('track', 'Contact', { content_name: 'Second Opinion' });
    }
  });
</script>

<style>
  /* Homepage classes, copied from src/pages/index.astro so this page matches it exactly. */
  .mp-nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(255,255,255,0.72);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .mp-nav-inner {
    max-width: 1280px; margin: 0 auto; padding: 0 32px; height: 56px;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
  }
  .mp-logo { display: flex; align-items: center; min-height: 44px; text-decoration: none; }
  .mp-logo img { height: 44px; width: auto; display: block; }
  .mp-logo:hover { text-decoration: none; }
  .mp-nav-phone {
    font-family: var(--font-t); font-size: 15px; font-weight: 600; letter-spacing: -0.01em;
    color: var(--graphite); text-decoration: none; white-space: nowrap;
  }
  .mp-nav-phone:hover { color: var(--blue-link); text-decoration: none; }
  @media (max-width: 600px) { .mp-nav-inner { padding: 0 20px; } .mp-logo img { height: 34px; } }

  .mp { background: var(--canvas); color: var(--graphite); }
  .mp h1, .mp h2 { font-family: var(--font-d); color: var(--graphite); }
  .mp p { color: var(--graphite); }

  .mp-btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--blue); color: #fff;
    font-family: var(--font-t); font-size: 17px; font-weight: 400; letter-spacing: -0.022em;
    padding: 12px 24px; border-radius: 980px; text-decoration: none; transition: background 0.2s; line-height: 1.2;
  }
  .mp-btn-primary:hover { background: var(--blue-link); text-decoration: none; color: #fff; }
  .mp-btn-primary::after { content: "→"; font-size: 17px; line-height: 1; transition: transform 0.2s; }
  .mp-btn-primary:hover::after { transform: translateX(3px); }
  .mp-btn-primary:focus-visible, .mp-nav-phone:focus-visible, .so-link:focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; }

  .mp-eye {
    font-family: var(--font-t); font-size: 12px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--blue); margin-bottom: 16px;
  }
  .mp-h1 {
    font-family: var(--font-d); font-size: clamp(36px, 4.4vw, 56px);
    font-weight: 600; line-height: 1.05; letter-spacing: -0.022em; color: var(--graphite); margin-bottom: 14px;
  }
  .mp-h2 {
    font-family: var(--font-d); font-size: clamp(30px, 3.8vw, 44px);
    font-weight: 600; line-height: 1.1; letter-spacing: -0.018em; color: var(--graphite);
    margin-bottom: 20px; max-width: 780px; text-wrap: balance;
  }
  .mp-micro { font-family: var(--font-t); font-size: 13px; color: var(--light-gray); letter-spacing: -0.015em; }
  .mp-micro strong { color: var(--graphite); font-weight: 600; }
  .mp-micro a { text-decoration: none; }
  .hero-dim { color: var(--mid-gray); }

  .mp-hero { padding: 80px 32px 100px; background: var(--canvas); }
  .mp-hero-grid {
    max-width: 1320px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr; gap: 56px; align-items: center;
  }
  @media (min-width: 1024px) {
    .mp-hero-grid { grid-template-columns: minmax(360px, 520px) minmax(0, 1fr); gap: 64px; }
  }
  .mp-hero-copy { max-width: 540px; min-width: 0; }
  .mp-hero-prose { display: flex; flex-direction: column; gap: 14px; max-width: 540px; margin-bottom: 32px; }
  .mp-hero-prose p { font-family: var(--font-t); font-size: 18px; line-height: 1.55; letter-spacing: -0.022em; color: var(--mid-gray); }
  .mp-hero-cta-block { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }

  .mp-artifact { margin: 0; justify-self: stretch; width: 100%; display: flex; flex-direction: column; gap: 14px; }
  .mp-artifact-cap {
    font-family: var(--font-t); font-size: 12px; font-weight: 400; letter-spacing: -0.015em;
    color: var(--light-gray); text-align: center;
  }
  .mp-hero-video {
    width: 100%; max-width: 280px; margin: 0 auto;
    background: #1d1d1f; border-radius: 8px; overflow: hidden; aspect-ratio: 9 / 16;
    box-shadow: var(--shadow-xl, rgba(0,0,0,0.22) 3px 5px 30px 0px);
  }
  .mp-hero-video video { width: 100%; height: 100%; display: block; object-fit: cover; }

  .mp-problem { padding: 112px 32px; background: var(--white); border-top: 1px solid var(--border); }
  .mp-problem-inner { max-width: 780px; margin: 0 auto; }
  .mp-problem-prose { display: flex; flex-direction: column; gap: 20px; margin: 28px 0 0; }
  .mp-problem-prose p { font-family: var(--font-t); font-size: 18px; line-height: 1.6; letter-spacing: -0.018em; color: var(--mid-gray); }
  .mp-problem-prose p strong { color: var(--graphite); font-weight: 600; }

  .mp-breaks { padding: 112px 32px; background: var(--canvas); border-top: 1px solid var(--border); }
  .mp-breaks-inner { max-width: 780px; margin: 0 auto; }
  .mp-breaks-list { display: flex; flex-direction: column; gap: 34px; margin-top: 40px; }
  .mp-break h3 {
    font-family: var(--font-d); font-size: 21px; font-weight: 600;
    letter-spacing: -0.02em; color: var(--graphite); margin-bottom: 8px;
    display: flex; align-items: baseline; gap: 14px;
  }
  .mp-break p { font-family: var(--font-t); font-size: 17px; line-height: 1.55; color: var(--mid-gray); padding-left: 32px; }
  .so-n { font-family: var(--font-d); font-size: 21px; font-weight: 600; color: var(--blue); min-width: 18px; }
  .mp-breaks-foot {
    font-family: var(--font-t); font-size: 17px; line-height: 1.55; color: var(--graphite);
    margin-top: 44px; padding-top: 32px; border-top: 1px solid var(--border); font-weight: 600;
  }

  .so-amount {
    font-family: var(--font-d) !important; font-size: clamp(64px, 9vw, 96px);
    font-weight: 600; line-height: 1; letter-spacing: -0.04em; color: var(--graphite);
  }
  .so-tight { margin-top: 20px; }
  .so-terms {
    display: grid; grid-template-columns: 1fr; gap: 28px;
    margin-top: 48px; padding-top: 40px; border-top: 1px solid var(--border);
  }
  @media (min-width: 760px) { .so-terms { grid-template-columns: 1fr 1fr; gap: 40px; } }
  .so-term { min-width: 0; }
  .so-term h3 { font-family: var(--font-d); font-size: 21px; font-weight: 600; letter-spacing: -0.02em; color: var(--graphite); margin-bottom: 8px; }
  .so-term p { font-family: var(--font-t); font-size: 17px; line-height: 1.55; color: var(--mid-gray); }
  .so-mid-cta { margin-top: 44px; }
  .so-stripe { min-height: 44px; }
  .mp-close-cta .so-stripe { display: flex; justify-content: center; }

  .so-link { color: var(--blue-link) !important; text-decoration: none; font-weight: 500; }
  .so-link:hover { text-decoration: underline; }

  .mp-creds { padding: 96px 32px; background: var(--white); border-top: 1px solid var(--border); }
  .mp-creds-inner {
    max-width: 900px; margin: 0 auto;
    display: grid; grid-template-columns: 260px 1fr; gap: 56px; align-items: center;
  }
  .mp-creds-photo { margin: 0; }
  .mp-creds-photo img { width: 100%; height: auto; display: block; border-radius: 8px; box-shadow: rgba(0,0,0,0.22) 3px 5px 30px 0px; }
  .mp-creds-photo figcaption { font-family: var(--font-t); font-size: 13px; color: var(--mid-gray); margin-top: 12px; }
  .so-letter { min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .so-letter p:not(.mp-eye) { font-family: var(--font-t); font-size: 19px; line-height: 1.55; letter-spacing: -0.02em; color: var(--graphite); }
  .so-letter .mp-eye { margin-bottom: 0; }
  .so-sig { font-family: var(--font-d) !important; font-size: 24px !important; font-weight: 600; }
  @media (max-width: 720px) {
    .mp-creds-inner { grid-template-columns: 1fr; gap: 34px; }
    .mp-creds-photo { max-width: 220px; }
  }

  .so-proof-head { max-width: 1160px; margin: 0 auto; padding: 96px 32px 24px; }
  .so-proof-head .mp-h2 { margin-bottom: 8px; }

  .mp-close { padding: 140px 32px 128px; background: var(--canvas); border-top: 1px solid var(--border); text-align: center; }
  .mp-close-h1 {
    font-family: var(--font-d); font-size: clamp(32px, 4.6vw, 48px);
    font-weight: 600; line-height: 1.1; letter-spacing: -0.018em; color: var(--graphite);
    margin: 0 auto 24px; max-width: 780px; text-wrap: balance;
  }
  .mp-close-body {
    font-family: var(--font-t); font-size: 19px; line-height: 1.5; letter-spacing: -0.022em;
    color: var(--mid-gray) !important; max-width: 640px; margin: 0 auto 36px;
  }
  .mp-close-cta { display: flex; flex-direction: column; align-items: center; gap: 10px; }

  @media (max-width: 768px) {
    .mp-hero { padding: 56px 22px 72px; }
    .mp-problem, .mp-breaks { padding: 72px 22px; }
    .mp-creds { padding: 72px 22px; }
    .so-proof-head { padding: 72px 22px 16px; }
    .mp-close { padding: 88px 22px 80px; }
    .mp-break p { padding-left: 0; }
  }
</style>
