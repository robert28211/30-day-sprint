---
import Base from '../layouts/Base.astro'
import Footer from '../components/Footer.astro'
import DemandEngine from '../components/DemandEngine.astro'
import CaseStudyCards from '../components/CaseStudyCards.astro'

// Home case-study wall. Full stories live at /case-studies/*.
const caseStudies = [
  { client: 'The Guttermen', headline: 'Twice the estimate bookings. Within 45 days.',
    summary: 'Advertising, intent-based email follow-up, and a connected website and inquiry system supported a doubling of estimate bookings within the first 45 days of working together.',
    href: '/case-studies/the-guttermen/' },
  { client: 'Punch List Pros', headline: '$5.20 in booked work per Google Ads dollar.',
    summary: 'August 2026 reporting connected Google advertising to uploaded closed-job values. Alongside search, the Meta program generated 97 lead-form submissions at approximately $29 each over the April–September reporting window.',
    href: '/case-studies/punch-list-pros/' },
  { client: 'Midlands Landscape', headline: '20% growth. In a market that grew 6%.',
    summary: 'A coordinated marketing program connected intent-based audiences, advertising, and email follow-up across landscaping, hardscaping, and landscape supply.',
    href: '/case-studies/midlands-landscape/' },
];
---
<Base
  title="Marketing Performance Group — Your Market's Jobs, Minus Your Competitor"
  description="The home-services market barely added a job in three years. The growth was price, not more work. Yet our clients booked double-digit more jobs, taken off their competitors' schedules. One company per trade, per market. 41 years in the industry, 31 running Marketing Performance."
>
  <!-- Minimal top nav. Logo only. Everything else moved to footer. -->
  <nav class="mp-nav">
    <div class="mp-nav-inner">
      <a href="/" class="mp-logo">
        <img src="/mp-logo-v3.png" alt="Marketing Performance — Powered by EngageEngine™" width="217" height="44" />
      </a>
    </div>
  </nav>

  <main class="mp">

    <!-- ═══ 1. HERO ═══ -->
    <section class="mp-hero">
      <div class="mp-hero-grid">
        <div class="mp-hero-copy">
          <h1 class="mp-h1">
            <span class="hero-word">You </span>
            <span class="hero-word">already </span>
            <span class="hero-word">have </span>
            <span class="hero-word">the </span>
            <span class="hero-word">demand. </span>
            <br />
            <span class="hero-word hero-dim">You're </span>
            <span class="hero-word hero-dim">losing </span>
            <span class="hero-word hero-dim">it </span>
            <span class="hero-word hero-dim">on </span>
            <span class="hero-word hero-dim">the </span>
            <span class="hero-word hero-dim">way </span>
            <span class="hero-word hero-dim">to </span>
            <span class="hero-word hero-dim">the </span>
            <span class="hero-word hero-dim">decision. </span>
          </h1>
          <div class="mp-hero-prose hero-sub">
            <p>There are only a few places a sale can break. Most companies are losing work in one of them &mdash; and it's usually the one they can't see from the inside.</p>
          </div>

          <div class="mp-only">
            <p class="mp-only-line">Every agency you've ever hired also works for your competition.<br /><strong>I only work for one of you.</strong></p>
            <p class="mp-only-rule">One company per trade, per market. That is the product, not a bonus.</p>
          </div>

          <div class="hero-cta mp-hero-cta-block">
            <a href="/diagnostic/" class="mp-btn-primary">See where you stand</a>
            <p class="mp-micro">Ten minutes. Your result on screen. No call, no salesperson, nothing scheduled.</p>
          </div>
        </div>

        <!-- Hero VSL. Autoplays muted; burned-in captions carry it, controls allow unmute. -->
        <figure class="mp-artifact mp-artifact-video">
          <div class="mp-hero-video">
            <video autoplay muted loop playsinline controls poster="/video/hub/hero-vsl-poster.jpg">
              <source src="/video/hub/hero-vsl.mp4" type="video/mp4" />
            </video>
          </div>
          <figcaption class="mp-artifact-cap">60 seconds. Why your phone isn't ringing.</figcaption>
        </figure>
      </div>
    </section>

    <!-- ═══ 1b. CASE STUDIES ═══ -->
    <CaseStudyCards cards={caseStudies} />

    <!-- ═══ 1c. WHO YOU'RE DEALING WITH ═══ -->
    <section class="mp-creds">
      <div class="mp-creds-inner">
        <figure class="mp-creds-photo" data-animate>
          <img src="/img/robbie-butt.jpg" alt="Robbie Butt, Marketing Performance, Columbia, South Carolina" width="560" height="1054" loading="lazy" />
          <figcaption>Robbie Butt &middot; Columbia, South Carolina</figcaption>
        </figure>
        <div class="mp-creds-list" data-animate data-delay="0.05">
          <div class="mp-cred"><span class="mp-cred-n">41 <em>years</em></span><span class="mp-cred-l">In advertising and public relations</span></div>
          <div class="mp-cred"><span class="mp-cred-n">31 <em>years</em></span><span class="mp-cred-l">Owner, Marketing Performance</span></div>
          <div class="mp-cred"><span class="mp-cred-n">22 <em>years</em></span><span class="mp-cred-l">Adjunct professor, University of South Carolina</span></div>
        </div>
      </div>
    </section>

    <!-- ═══ 2. WHERE IT ACTUALLY GOES WRONG ═══ -->
    <section class="mp-problem">
      <div class="mp-problem-inner">
        <p class="mp-eye" data-animate>The Problem</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">Most businesses don't lose work because people aren't interested.</h2>
        <div class="mp-problem-prose" data-animate data-delay="0.1">
          <p>They lose it when confidence collapses <em>after</em> interest &mdash; under decision pressure. It usually looks like plenty of activity with no predictable outcome, results that swing month to month with nobody able to explain why, and advice to add more &mdash; more ads, more posts, more spend &mdash; without anyone telling you what's actually broken.</p>
          <p>That isn't a tactics problem. It's a confidence problem. And it happens in a small number of specific places, which is the useful part: if there are only a few places it can break, you can go find out which one it is instead of guessing.</p>
        </div>
        <p class="mp-problem-punch" data-animate data-delay="0.15">That's the first thing I do. Not execution. Not a campaign. Identifying where confidence is collapsing between interest and decision. Once that's clear the correction is usually straightforward. Until it's clear, everything else is guessing.</p>
      </div>
    </section>

    <!-- ═══ 3. SOLUTION ═══ -->
    <section class="mp-solution">
      <div class="mp-solution-inner">
        <p class="mp-eye" data-animate>The Solution</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">We lock your market. Then we point the work at you.</h2>
        <div class="mp-solution-prose" data-animate data-delay="0.1">
          <p><strong>One company per trade, per market.</strong> The day you claim yours, your competitor can't. That is the product, not a bonus.</p>
          <p>Here's how we deliver it. Every homeowner leaves a trail before they call anyone: the searches, the review pages, the three sites they check in a week. <strong>EngageEngine™</strong> reads who in your area is actually deciding right now and puts your ads in front of only them, on Google, on Facebook, on YouTube. You stop paying to reach the 97 who were never going to call and reach the few who will.</p>
          <p>And because the seat is yours alone, every job it produces is a job the guy across town didn't get. That is what taking your market looks like.</p>
        </div>
      </div>
    </section>

    <!-- ═══ 4. THE ENGINE (interactive mechanism reveal) ═══ -->
    <DemandEngine />

    <!-- Founder block removed 2026-07-17: off-aesthetic, belongs to a deeper page. -->
    <!-- Value Stack removed 2026-07-17: discounty price-anchor + names pitch, off the new positioning. -->

    <!-- ═══ 4a. WHERE A SALE BREAKS ═══ -->
    <section class="mp-breaks">
      <div class="mp-breaks-inner">
        <p class="mp-eye" data-animate>The Four Moments</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">There are only a few places a sale can break.</h2>
        <p class="mp-breaks-lede" data-animate data-delay="0.1">Nearly every revenue problem I see comes down to one of four moments.</p>
        <div class="mp-breaks-list" data-animate data-delay="0.15">
          <div class="mp-break"><h3>You weren't there when they decided.</h3><p>People were looking for what you do. You just weren't in front of them at the moment they picked somebody.</p></div>
          <div class="mp-break"><h3>They found you and didn't trust you yet.</h3><p>They looked, and they left. The interest was real. The confidence wasn't.</p></div>
          <div class="mp-break"><h3>They trusted you and shopped you anyway.</h3><p>You gave the estimate, they compared, and you lost some you should have won &mdash; usually on price, because the difference between you and the other fellow never got made clear.</p></div>
          <div class="mp-break"><h3>They meant to hire you and never got to it.</h3><p>They said they'd call back, and they meant it. Most of those jobs aren't lost. They're stuck.</p></div>
        </div>
        <p class="mp-breaks-foot" data-animate data-delay="0.2">Different problems, different fixes, and the fix for one does nothing for the other three.</p>
        <div class="mp-breaks-turn" data-animate data-delay="0.25">
          <p><strong>Here's the trouble.</strong> From where you sit, you can only see one of the four. You know about the estimates you lost. You don't know about the people who never came back, never called, or never found you at all.</p>
          <p class="mp-couplet">I don't guess who might buy from you.<br />I already know who's looking.</p>
          <p>I can see all four &mdash; not by asking you, but by reading what your own numbers already say: where you land when somebody nearby is choosing, what people do on your site before they leave, what they type before they hire, and who came looking and never called.</p>
        </div>
      </div>
    </section>

    <!-- ═══ 4b. WE CATCH IT BEFORE IT COSTS YOU ═══ -->
    <section class="mp-catch">
      <div class="mp-catch-inner">
        <p class="mp-eye" data-animate>After the Launch</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">We catch it before it costs you.</h2>
        <p class="mp-catch-lede" data-animate data-delay="0.1">Campaigns don't fail loudly. They fail quietly, in ways you'd never see on an invoice. Every account gets watched every week. Recent catches:</p>
        <ul class="mp-catch-list" data-animate data-delay="0.15">
          <li>A plumbing client's campaign delivery collapsed 90% overnight. Caught the same day, diagnosed as a campaign issue, not a market issue, and restored — conversions never dipped.</li>
          <li>An email campaign started silently dropping one in four sends. Caught before the next send went out, fixed before the client ever saw it.</li>
          <li>Visitors on three client sites were clicking buttons that didn't respond — at the exact moment they were trying to act. Found it in the behavior recordings. Fixed it.</li>
        </ul>
        <p class="mp-catch-foot" data-animate data-delay="0.2">The launch is the easy part. The watching is what you're paying for.</p>
      </div>
    </section>

    <!-- Guarantee section removed 2026-08-18 at Robbie's instruction. -->

    <!-- ═══ 7. FINAL CTA ═══ -->
    <section class="mp-close">
      <h2 class="mp-close-h1" data-animate>One company per trade, per market.</h2>
      <p class="mp-close-h2" data-animate data-delay="0.05">Is your territory still open?</p>
      <p class="mp-close-body" data-animate data-delay="0.1">Our clients buy clicks for nine cents in an industry that averages $7.85. That's what in-market data does.</p>
      <p class="mp-close-body" data-animate data-delay="0.15">We can't sell your market twice. That's the whole point. If your competitor claims it first, we start sending <em>him</em> the work.</p>
      <div class="mp-close-cta" data-animate data-delay="0.2">
        <a href="/diagnostic/" class="mp-btn-primary">See where you stand</a>
        <p class="mp-micro">Free. No email required. Takes ten minutes.</p>
      </div>
    </section>

  </main>
  <Footer ctaHref="/diagnostic/" />
</Base>

<style>
  /* ═══════════════════════════════════════════════════════
     APPLE-FIDELITY HOMEPAGE. Hormozi rewrite v2.
     Tokens: Canvas White #f5f5f7 / Pure White #ffffff /
     Midnight Graphite #1d1d1f / Mid Gray #707070 /
     Interactive Blue #0071e3 / Border Silver #d6d6d6.
     Cards 0px radius. Images 8px. Buttons 980px pill.
     Shadow XL: rgba(0,0,0,0.22) 3px 5px 30px 0px.
     ═══════════════════════════════════════════════════════ */

  /* ─── Top nav (logo only) ─── */
  .mp-nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(255,255,255,0.72);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .mp-nav-inner {
    max-width: 1280px; margin: 0 auto;
    padding: 0 32px; height: 56px;
    display: flex; align-items: center;
  }
  .mp-logo {
    display: flex; align-items: center;
    min-height: 44px; text-decoration: none;
  }
  .mp-logo img { height: 44px; width: auto; display: block; }
  .mp-logo:hover { text-decoration: none; }
  @media (max-width: 600px) {
    .mp-logo img { height: 34px; }
  }

  /* ─── Page base ─── */
  .mp { background: var(--canvas); color: var(--graphite); }
  .mp h1, .mp h2 { font-family: var(--font-d); color: var(--graphite); }
  .mp p { color: var(--graphite); }
  .mp em { font-style: italic; }

  /* ─── Primary button (Apple Interactive Blue pill) ─── */
  .mp-btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--blue); color: #fff;
    font-family: var(--font-t); font-size: 17px;
    font-weight: 400; letter-spacing: -0.022em;
    padding: 12px 24px; border-radius: 980px;
    text-decoration: none; transition: background 0.2s;
    line-height: 1.2;
  }
  .mp-btn-primary:hover { background: var(--blue-link); text-decoration: none; color: #fff; }
  .mp-btn-primary::after {
    content: "→"; font-size: 17px; line-height: 1;
    transition: transform 0.2s;
  }
  .mp-btn-primary:hover::after { transform: translateX(3px); }

  /* ─── Eyebrows + headings ─── */
  .mp-eye {
    font-family: var(--font-t);
    font-size: 12px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--blue); margin-bottom: 16px;
  }
  .mp-h1 {
    font-family: var(--font-d);
    font-size: clamp(36px, 4.4vw, 56px);
    font-weight: 600; line-height: 1.05;
    letter-spacing: -0.022em; color: var(--graphite);
    margin-bottom: 14px;
  }
  .mp-h2 {
    font-family: var(--font-d);
    font-size: clamp(30px, 3.8vw, 44px);
    font-weight: 600; line-height: 1.1;
    letter-spacing: -0.018em; color: var(--graphite);
    margin-bottom: 20px;
    max-width: 780px;
  }
  .mp-lede {
    font-family: var(--font-t);
    font-size: 21px; line-height: 1.4;
    letter-spacing: -0.022em; color: var(--mid-gray);
    max-width: 680px;
  }
  .mp-micro {
    font-family: var(--font-t);
    font-size: 13px; color: var(--light-gray);
    letter-spacing: -0.015em;
  }
  .mp-micro strong { color: var(--graphite); font-weight: 600; }
  .mp-section-head { margin-bottom: 48px; }
  .mp-section-head.mp-center,
  .mp-h2.mp-center,
  .mp-eye.mp-center { text-align: center; }
  .mp-section-head.mp-center .mp-h2,
  .mp-section-head.mp-center .mp-lede { margin-left: auto; margin-right: auto; }
  .mp-h2.mp-center { margin-left: auto; margin-right: auto; }

  /* ─── 1. HERO ─── */
  .mp-hero {
    padding: 80px 32px 100px;
    background: var(--canvas);
  }
  .mp-hero-grid {
    max-width: 1320px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr; gap: 56px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .mp-hero-grid {
      grid-template-columns: minmax(360px, 520px) minmax(0, 1fr);
      gap: 64px;
    }
  }
  .mp-hero-copy { max-width: 540px; }
  .mp-hero-prose {
    display: flex; flex-direction: column;
    gap: 14px;
    max-width: 540px;
    margin-bottom: 32px;
  }
  .mp-hero-prose p {
    font-family: var(--font-t);
    font-size: 18px; line-height: 1.55;
    letter-spacing: -0.022em;
    color: var(--mid-gray);
  }
  .mp-hero-cta-block {
    display: flex; flex-direction: column;
    gap: 12px; align-items: flex-start;
  }

  /* Snapshot artifact. Actual product screenshot, framed Apple-style. */
  .mp-artifact {
    margin: 0;
    justify-self: stretch; width: 100%;
    display: flex; flex-direction: column; gap: 14px;
  }
  .mp-artifact-img {
    width: 100%; height: auto; display: block;
    border-radius: 8px;
    box-shadow: var(--shadow-xl, rgba(0,0,0,0.22) 3px 5px 30px 0px);
    background: var(--white);
  }
  .mp-artifact-cap {
    font-family: var(--font-t);
    font-size: 12px; font-weight: 400;
    letter-spacing: -0.015em;
    color: var(--light-gray);
    text-align: center;
  }
  @media (max-width: 1023px) {
    .mp-artifact { max-width: 100%; }
  }

  /* Hero VSL (replaces the divergence chart) */
  .mp-hero-video {
    width: 100%;
    background: #1d1d1f;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    box-shadow: var(--shadow-xl, rgba(0,0,0,0.22) 3px 5px 30px 0px);
  }
  .mp-hero-video video { width: 100%; height: 100%; display: block; }

  /* Proof-card styles now live in ProofCards.astro (shared by / and /snapshot). */
  @media (max-width: 768px) {
    /* Unlike the old chart, the video stays on mobile — 16:9 is short enough
       not to bury the proof cards. */
    .mp-hero { padding-bottom: 8px; }
  }

  /* ─── 4b. CATCH ─── */
  .mp-catch { padding: 110px 32px; background: var(--white); border-top: 1px solid var(--border); }
  .mp-catch-inner { max-width: 760px; margin: 0 auto; }
  .mp-catch-lede {
    font-family: var(--font-t); font-size: 19px; line-height: 1.5;
    letter-spacing: -0.02em; color: var(--mid-gray); margin-bottom: 34px;
  }
  .mp-catch-list { list-style: none; padding: 0; margin: 0 0 34px; }
  .mp-catch-list li {
    font-family: var(--font-t); font-size: 17px; line-height: 1.55;
    letter-spacing: -0.015em; color: var(--graphite);
    padding: 20px 0 20px 34px; position: relative;
    border-top: 1px solid var(--border);
  }
  .mp-catch-list li:last-child { border-bottom: 1px solid var(--border); }
  .mp-catch-list li::before {
    content: ''; position: absolute; left: 4px; top: 29px;
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--blue, #0071e3);
  }
  .mp-catch-foot {
    font-family: var(--font-t); font-size: 17px; font-weight: 600;
    letter-spacing: -0.015em; color: var(--graphite);
  }

  /* ─── 2. PROBLEM ─── */
  .mp-problem {
    padding: 112px 32px;
    background: var(--white);
    border-top: 1px solid var(--border);
  }
  .mp-problem-inner {
    max-width: 780px; margin: 0 auto;
  }
  .mp-problem-prose {
    display: flex; flex-direction: column; gap: 20px;
    margin: 28px 0 36px;
  }
  .mp-problem-prose p {
    font-family: var(--font-t);
    font-size: 18px; line-height: 1.6;
    letter-spacing: -0.018em;
    color: var(--mid-gray);
  }
  .mp-problem-prose p strong {
    color: var(--graphite); font-weight: 600;
  }
  .mp-problem-punch {
    font-family: var(--font-d);
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 500; line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--graphite);
    border-left: 3px solid var(--blue);
    padding-left: 20px;
    margin-top: 8px;
  }

  /* ─── 3. SOLUTION ─── */
  .mp-solution {
    padding: 112px 32px;
    background: var(--canvas);
    border-top: 1px solid var(--border);
  }
  .mp-solution-inner {
    max-width: 780px; margin: 0 auto;
  }
  .mp-solution-prose {
    display: flex; flex-direction: column; gap: 20px;
    margin-top: 28px;
  }
  .mp-solution-prose p {
    font-family: var(--font-t);
    font-size: 18px; line-height: 1.6;
    letter-spacing: -0.018em;
    color: var(--graphite);
  }
  .mp-solution-prose p strong {
    color: var(--blue); font-weight: 600;
  }
  .mp-solution-more {
    margin-top: 32px;
    font-family: var(--font-t);
    font-size: 15px;
    letter-spacing: -0.015em;
  }
  .mp-text-link {
    display: inline-flex;
    align-items: baseline; gap: 6px;
    color: var(--blue-link);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.15s;
  }
  .mp-text-link:hover { color: var(--blue); }
  .mp-text-link-arrow {
    display: inline-block;
    transition: transform 0.2s;
  }
  .mp-text-link:hover .mp-text-link-arrow {
    transform: translateX(3px);
  }

  /* ─── 4. PROOF ─── */
  .mp-proof-section {
    padding: 112px 32px;
    background: var(--white);
    border-top: 1px solid var(--border);
  }
  .mp-proof-block {
    max-width: 780px; margin: 0 auto;
  }
  .mp-proof-feature {
    display: flex; align-items: center; gap: 24px;
    padding: 28px 32px;
    background: var(--canvas);
    margin: 32px 0 40px;
    border-left: 2px solid var(--blue);
  }
  .mp-anchor-photo {
    width: 80px; height: 80px;
    border-radius: 50%;
    background: var(--canvas);
    border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-d);
    font-size: 22px; font-weight: 600;
    color: var(--mid-gray);
    flex-shrink: 0;
    overflow: hidden;
  }
  .mp-anchor-photo img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .mp-anchor-attr {
    font-family: var(--font-t);
    font-size: 14px; color: var(--mid-gray);
    margin-bottom: 8px; letter-spacing: -0.018em;
  }
  .mp-anchor-attr strong { color: var(--graphite); font-weight: 600; }
  .mp-anchor-stats {
    font-family: var(--font-t);
    font-size: 13px; color: var(--blue-link);
    letter-spacing: -0.015em;
    display: flex; flex-wrap: wrap; gap: 8px;
  }
  .mp-anchor-stats strong { font-weight: 600; }
  .mp-dot { color: var(--light-gray); }
  .mp-proof-stack {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 22px;
  }
  .mp-proof-stack > li {
    font-family: var(--font-t);
    font-size: 17px; line-height: 1.55;
    letter-spacing: -0.018em;
    color: var(--graphite);
    padding-left: 24px;
    position: relative;
  }
  .mp-proof-stack > li::before {
    content: "→";
    position: absolute; left: 0; top: 0;
    color: var(--blue); font-weight: 700;
  }
  .mp-proof-stack > li strong { font-weight: 600; }
  .mp-proof-founder {
