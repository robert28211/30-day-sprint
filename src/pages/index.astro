---
import Base from '../layouts/Base.astro'
import Footer from '../components/Footer.astro'
---
<Base
  title="Marketing Performance Group — Your Market's Jobs, Minus Your Competitor"
  description="The home-services market barely added a job in three years. The growth was price, not more work. Yet our clients booked double-digit more jobs, taken off their competitors' schedules. One company per trade, per market. 41 years in the industry, 31 running Marketing Performance."
>
  <!-- Minimal top nav. Logo only. Everything else moved to footer. -->
  <nav class="mp-nav">
    <div class="mp-nav-inner">
      <a href="/" class="mp-logo">
        Marketing Performance Group
        <span class="mp-logo-sub">Powered by EngageEngine™</span>
      </a>
    </div>
  </nav>

  <main class="mp">

    <!-- ═══ 1. HERO ═══ -->
    <section class="mp-hero">
      <div class="mp-hero-grid">
        <div class="mp-hero-copy">
          <h1 class="mp-h1">
            <span class="hero-word">Your </span>
            <span class="hero-word">market </span>
            <span class="hero-word">didn't </span>
            <span class="hero-word">grow </span>
            <span class="hero-word">last </span>
            <span class="hero-word">year.</span><br />
            <span class="hero-word">Somebody's </span>
            <span class="hero-word">schedule </span>
            <span class="hero-word">did.</span>
          </h1>
          <div class="mp-hero-prose hero-sub">
            <p>The growth everyone talks about is just prices going up. The number of actual jobs barely moved.</p>
            <p>So when the guy across town gets busier, that work is coming off your schedule. We put it back on yours, and lock him out. One company per trade, per market.</p>
          </div>

          <div class="hero-cta mp-hero-cta-block">
            <a href="/snapshot" class="mp-btn-primary">See if your trade is still open</a>
            <p class="mp-micro"><strong>41 years in the industry. 31 running Marketing Performance.</strong></p>
          </div>
        </div>

        <!-- Divergence chart. Market flat, one contractor climbing. -->
        <figure class="mp-artifact">
          <div class="mp-chart" role="img" aria-label="Chart. Over three years the market stays flat while one contractor's completed jobs climb about 40 percent higher.">
            <svg viewBox="0 0 680 470" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
              <!-- title -->
              <text x="34" y="42" class="mp-c-title">RELATIVE JOBS COMPLETED</text>
              <text x="34" y="62" class="mp-c-sub">Indexed to start = 100</text>
              <!-- legend -->
              <line x1="34" y1="92" x2="66" y2="92" class="mp-c-line-you" />
              <text x="74" y="97" class="mp-c-leg">THIS CONTRACTOR</text>
              <line x1="250" y1="92" x2="282" y2="92" class="mp-c-line-mkt" />
              <text x="290" y="97" class="mp-c-leg mp-c-leg-mkt">THE MARKET</text>
              <!-- gridlines -->
              <line x1="90" y1="140" x2="646" y2="140" class="mp-c-grid" />
              <line x1="90" y1="252" x2="646" y2="252" class="mp-c-grid mp-c-grid-base" />
              <line x1="90" y1="364" x2="646" y2="364" class="mp-c-grid" />
              <!-- market line: flat -->
              <polyline points="90,252 275,254 460,258 620,252" class="mp-c-line-mkt" fill="none" />
              <circle cx="620" cy="252" r="4" class="mp-c-dot-mkt" />
              <!-- contractor line: climbing -->
              <polyline points="90,252 275,196 460,156 620,124" class="mp-c-line-you" fill="none" />
              <circle cx="620" cy="124" r="5" class="mp-c-dot-you" />
              <!-- callout -->
              <g class="mp-c-callout">
                <rect x="452" y="70" width="196" height="46" rx="6" />
                <text x="466" y="93" class="mp-c-call-1">+40% more jobs.</text>
                <text x="466" y="108" class="mp-c-call-2">Same market. Same prices.</text>
              </g>
              <!-- x labels -->
              <text x="90" y="404" class="mp-c-x">START</text>
              <text x="275" y="404" class="mp-c-x" text-anchor="middle">YEAR 1</text>
              <text x="460" y="404" class="mp-c-x" text-anchor="middle">YEAR 2</text>
              <text x="620" y="404" class="mp-c-x" text-anchor="end">YEAR 3</text>
            </svg>
          </div>
          <figcaption class="mp-artifact-cap">Verified client. Jobs completed, not revenue.</figcaption>
        </figure>
      </div>
    </section>

    <!-- ═══ 1a. HERO VSL ═══ -->
    <section class="mp-vsl">
      <div class="mp-vsl-inner">
        <p class="mp-vsl-kicker">60 seconds</p>
        <h2 class="mp-vsl-title">Watch: why your phone isn't ringing</h2>
        <div class="mp-vsl-frame">
          <video poster="/video/hub/hero-vsl-poster.jpg" preload="none" playsinline controls>
            <source src="/video/hub/hero-vsl.mp4" type="video/mp4" />
          </video>
        </div>
        <p class="mp-vsl-more"><a href="/videos">Watch the full series →</a></p>
      </div>
    </section>

    <!-- ═══ 1b. PROOF CARDS (Share Line) ═══ -->
    <section class="mp-proofband">
      <div class="mp-proofband-inner">
        <article class="mp-pcard" data-animate>
          <p class="mp-pcard-trade">Landscaping</p>
          <p class="mp-pcard-city">Columbia, SC</p>
          <p class="mp-pcard-market mp-flat">Market flat</p>
          <p class="mp-pcard-num">+40%</p>
          <p class="mp-pcard-unit">jobs completed</p>
        </article>
        <article class="mp-pcard" data-animate data-delay="0.05">
          <p class="mp-pcard-trade">Pools</p>
          <p class="mp-pcard-city">Midlands</p>
          <p class="mp-pcard-market mp-down">&#8595; Market down ~50%</p>
          <p class="mp-pcard-num">+26%</p>
          <p class="mp-pcard-unit">installs</p>
        </article>
        <article class="mp-pcard" data-animate data-delay="0.1">
          <p class="mp-pcard-trade">Metal roofing</p>
          <p class="mp-pcard-city">SC &amp; GA</p>
          <p class="mp-pcard-market mp-down">&#8595; Market down 15&#8211;25%</p>
          <p class="mp-pcard-num">+30%</p>
          <p class="mp-pcard-unit">material sold</p>
        </article>
      </div>
      <p class="mp-proofband-foot">Every job they booked came off a competitor's schedule. One company per trade, per market.</p>
    </section>

    <!-- ═══ 2. PROBLEM ═══ -->
    <section class="mp-problem">
      <div class="mp-problem-inner">
        <p class="mp-eye" data-animate>The Problem</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">You don't have a lead problem. You have a shared-lead problem.</h2>
        <div class="mp-problem-prose" data-animate data-delay="0.1">
          <p>You've run the gauntlet. Angi, HomeAdvisor, Thumbtack. You pay for a "lead" that already sold to four competitors before your phone stopped ringing. So you race to dial first, quote against three guys who'll always go cheaper, and close maybe one in five. And the one you close is the price-shopper who walks the second someone undercuts you.</p>
          <p>Or you went the old-ad route. You blast a whole zip code and pay Google and Facebook to put your ad in front of renters, tire-kickers, and the guy who replaced his roof last spring.</p>
          <p>Here's the math nobody puts on the sales call. In a typical service market, fewer than <strong>3 in 100</strong> households will hire your trade this quarter. Old-way advertising pays to reach all 100. Shared-lead platforms make you knife-fight over the 3.</p>
        </div>
        <p class="mp-problem-punch" data-animate data-delay="0.15">Both models are built so the platform gets paid whether you close a job or not. You're not their customer. You're their inventory.</p>
      </div>
    </section>

    <!-- ═══ 3. SOLUTION ═══ -->
    <section class="mp-solution">
      <div class="mp-solution-inner">
        <p class="mp-eye" data-animate>The Solution</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">We stopped guessing who might buy. We find who's already deciding.</h2>
        <div class="mp-solution-prose" data-animate data-delay="0.1">
          <p>Every homeowner leaves a trail before they call anyone. The searches. The review pages. The three websites they check in a week. That trail used to be invisible. It isn't anymore.</p>
          <p><strong>EngageEngine™</strong> reads that activity and resolves it to real, named people in your service area. Then it puts your ads in front of those people and nobody else, on Google, on Facebook, on YouTube, everywhere they scroll. You stop paying to reach the 97 households that were never going to call, and start reaching the 3 that will.</p>
          <p><strong>Why it works:</strong> a homeowner who's about to hire behaves nothing like one who isn't. They binge reviews. They compare maps. They pull up competitor sites back to back. We buy only that behavior, and refuse to spend a dollar of yours on anyone not showing it.</p>
          <p>And they're <strong>yours alone.</strong> One company per trade, per market. The day you lock your territory is the day your competitor can't. That isn't a bonus. It's the product.</p>
        </div>
        <p class="mp-solution-more" data-animate data-delay="0.2">
          <a href="/how-it-works" class="mp-text-link">Look inside the engine <span class="mp-text-link-arrow">→</span></a>
        </p>
      </div>
    </section>

    <!-- ═══ 4. PROOF ═══ -->
    <section class="mp-proof-section">
      <div class="mp-proof-block">
        <p class="mp-eye mp-center" data-animate>The Proof</p>
        <h2 class="mp-h2 mp-center" data-animate data-delay="0.05">"In 30 days we doubled our booked appointments."</h2>
        <div class="mp-proof-feature" data-animate data-delay="0.1">
          <div class="mp-anchor-photo">
            <img src="/img/rogerson.jpg" alt="McClintock HVAC" width="80" height="80" loading="lazy" decoding="async" />
          </div>
          <div class="mp-anchor-body">
            <p class="mp-anchor-attr"><strong>McClintock HVAC</strong> · Charlotte, NC</p>
            <div class="mp-anchor-stats">
              <span><strong>70%</strong> lower cost per click</span>
              <span class="mp-dot">·</span>
              <span><strong>2×</strong> booked appointments</span>
              <span class="mp-dot">·</span>
              <span>30 days</span>
            </div>
          </div>
        </div>
        <ul class="mp-proof-stack" data-animate data-delay="0.15">
          <li><strong>31 years</strong> in this industry. <strong>Zero refunds ever issued.</strong></li>
          <li>Serving service businesses across HVAC, plumbing, roofing, fencing, drilling, landscaping and more. <strong>$500K–$10M revenue.</strong></li>
          <li class="mp-proof-founder">
            <img src="/img/robbie-butt.jpg" alt="Robbie Butt, Founder" class="mp-proof-founder-photo" loading="lazy" decoding="async" />
            <div>
              <p class="mp-proof-founder-quote">"I personally sign every client. If it doesn't work, I keep working. That's been the deal for 31 years."</p>
              <p class="mp-proof-founder-attr"><strong>Robbie Butt</strong>, Founder</p>
            </div>
          </li>
        </ul>
      </div>
    </section>

    <!-- ═══ 5. VALUE STACK ═══ -->
    <section class="mp-offer">
      <div class="mp-offer-inner">
        <p class="mp-eye mp-center" data-animate>What You Get</p>
        <h2 class="mp-h2 mp-center" data-animate data-delay="0.05">What you get when you take your market.</h2>
        <ul class="mp-stack" data-animate data-delay="0.1">
          <li class="mp-stack-item">
            <div class="mp-stack-head">Engine 1. Your Buyer List, refreshed daily.</div>
            <p class="mp-stack-body">Every in-market homeowner in your territory by name, phone, and address. Rebuilt every morning, so you're always working today's buyers, not a list that went cold three weeks ago.</p>
            <p class="mp-stack-body mp-stack-emphasis"><strong><em>This is the same compliant identity data Fortune 500 brands buy. You just couldn't access it until now.</em></strong></p>
            <p class="mp-stack-body">Data brokers sell this exact feed for $5,000/mo. We'll show you the invoice.</p>
            <figure class="mp-stack-invoice">
              <img src="/img/broker-invoice.png" alt="Redacted Zeta Residential Leads invoice — one month of compliant residential consumer identity data at $5,400." class="mp-stack-invoice-img" loading="lazy" decoding="async" />
              <figcaption class="mp-stack-invoice-cap">Redacted vendor invoice. Real spend, monthly.</figcaption>
            </figure>
            <div class="mp-stack-anchor">Value: <strong>$5,000/mo</strong></div>
          </li>
          <li class="mp-stack-item">
            <div class="mp-stack-head">Done-for-you campaigns, pointed only at those buyers.</div>
            <p class="mp-stack-body">We build, run, and optimize your Google, Facebook, and YouTube, aimed at the named people on your list instead of everyone inside a 20-mile circle. You approve, we execute, you answer the phone.</p>
            <div class="mp-stack-anchor">Value: <strong>$6,500/mo</strong></div>
          </li>
          <li class="mp-stack-item">
            <div class="mp-stack-head">Engine 2. The Invisible-Visitor Pixel.</div>
            <p class="mp-stack-body">97 of every 100 people who hit your site leave without calling. We tell you who they were and follow up automatically, before they book the other guy. This is a second engine, not a feature of the first. It works on the people already on your site, not the ones searching your market.</p>
            <div class="mp-stack-anchor">Sold on its own: <strong>$1,500/mo</strong></div>
          </li>
          <li class="mp-stack-item">
            <div class="mp-stack-head">Market Exclusivity.</div>
            <p class="mp-stack-body">Your trade, your territory, locked. One operator per market. When your competitor calls us, we tell them the seat's taken.</p>
            <div class="mp-stack-anchor"><em>Priceless. Ask the guy who called too late.</em></div>
          </li>
          <li class="mp-stack-item">
            <div class="mp-stack-head">One number that matters.</div>
            <p class="mp-stack-body">Leads, source, and cost per booked job. One monthly report. No dashboard to learn.</p>
          </li>
        </ul>

        <div class="mp-stack-total" data-animate data-delay="0.2">
          <p class="mp-stack-total-head">This is what you'd pay to build it yourself.</p>
          <p class="mp-stack-total-body">
            Buyer List broker: <strong>$5,000</strong>. Agency retainer: <strong>$6,500</strong>. Pixel tool: <strong>$1,500</strong>. That's <span class="mp-stack-total-strike">$13,000/mo</span> to assemble &mdash; and you'd still be missing the one thing your competitors can't buy: your market.
          </p>
          <p class="mp-stack-total-close"><strong>Your fee is a fraction of that.</strong> We'll show you on the call.</p>
        </div>
      </div>
    </section>

    <!-- ═══ 6. GUARANTEE ═══ -->
    <section class="mp-guarantee">
      <div class="mp-section-head mp-center">
        <p class="mp-eye" data-animate>The Guarantee</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">The 2X Revenue Guarantee.</h2>
      </div>

      <div class="mp-guarantee-card" data-animate data-delay="0.1">
        <div class="mp-guarantee-badge">
          <span class="mp-badge-check">✓</span>
          <span>2X Revenue Guarantee</span>
        </div>
        <p class="mp-guarantee-lead">If the system doesn't put at least twice your investment back in your pocket as closed revenue within 30 days, we keep working for free until it does. The guarantee is on our fee, not your ad spend.</p>
        <p class="mp-guarantee-body">You risk nothing but the 30 seconds it takes to look at your market.</p>
      </div>
    </section>

    <!-- ═══ 7. FINAL CTA ═══ -->
    <section class="mp-close">
      <h2 class="mp-close-h1" data-animate>One company per trade, per market.</h2>
      <p class="mp-close-h2" data-animate data-delay="0.05">Is your territory still open?</p>
      <p class="mp-close-body" data-animate data-delay="0.1">We can't sell your market twice. That's the whole point. If your competitor claims it first, we'll be sending <em>them</em> the buyers.</p>
      <div class="mp-close-cta" data-animate data-delay="0.2">
        <a href="/snapshot" class="mp-btn-primary">See Who's Buying in My Market</a>
        <p class="mp-micro">Free. No email required. Takes 30 seconds.</p>
      </div>
    </section>

  </main>
  <Footer />
</Base>

<style>
  /* ═══════════════════════════════════════════════════════
     APPLE-FIDELITY HOMEPAGE. Hormozi rewrite v2.
     Tokens: Canvas White #f5f5f7 / Pure White #ffffff /
     Midnight Graphite #1d1d1f / Mid Gray #707070 /
     Interactive Blue #0071e3 / Border Silver #d6d6d6.
     Cards 0px radius. Images 8px. Buttons 980px pill.
     Shadow XL: rgba(0,0,0,0.22) 3px 5px 30px 0px.
     ═══════════════════════════════════════════════════════ */

  /* ─── Top nav (logo only) ─── */
  .mp-nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(255,255,255,0.72);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .mp-nav-inner {
    max-width: 1280px; margin: 0 auto;
    padding: 0 32px; height: 56px;
    display: flex; align-items: center;
  }
  .mp-logo {
    font-family: var(--font-t);
    font-size: 13px; font-weight: 600;
    letter-spacing: -0.01em; color: var(--graphite);
    text-decoration: none;
    display: flex; flex-direction: column; gap: 1px;
    min-height: 44px; justify-content: center;
  }
  .mp-logo:hover { color: var(--graphite); text-decoration: none; }
  .mp-logo-sub {
    font-size: 10px; font-weight: 400;
    letter-spacing: 0.02em; color: var(--mid-gray);
  }

  /* ─── Page base ─── */
  .mp { background: var(--canvas); color: var(--graphite); }
  .mp h1, .mp h2 { font-family: var(--font-d); color: var(--graphite); }
  .mp p { color: var(--graphite); }
  .mp em { font-style: italic; }

  /* ─── Primary button (Apple Interactive Blue pill) ─── */
  .mp-btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--blue); color: #fff;
    font-family: var(--font-t); font-size: 17px;
    font-weight: 400; letter-spacing: -0.022em;
    padding: 12px 24px; border-radius: 980px;
    text-decoration: none; transition: background 0.2s;
    line-height: 1.2;
  }
  .mp-btn-primary:hover { background: var(--blue-link); text-decoration: none; color: #fff; }
  .mp-btn-primary::after {
    content: "→"; font-size: 17px; line-height: 1;
    transition: transform 0.2s;
  }
  .mp-btn-primary:hover::after { transform: translateX(3px); }

  /* ─── Eyebrows + headings ─── */
  .mp-eye {
    font-family: var(--font-t);
    font-size: 12px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--blue); margin-bottom: 16px;
  }
  .mp-h1 {
    font-family: var(--font-d);
    font-size: clamp(36px, 4.4vw, 56px);
    font-weight: 600; line-height: 1.05;
    letter-spacing: -0.022em; color: var(--graphite);
    margin-bottom: 14px;
  }
  .mp-h2 {
    font-family: var(--font-d);
    font-size: clamp(30px, 3.8vw, 44px);
    font-weight: 600; line-height: 1.1;
    letter-spacing: -0.018em; color: var(--graphite);
    margin-bottom: 20px;
    max-width: 780px;
  }
  .mp-lede {
    font-family: var(--font-t);
    font-size: 21px; line-height: 1.4;
    letter-spacing: -0.022em; color: var(--mid-gray);
    max-width: 680px;
  }
  .mp-micro {
    font-family: var(--font-t);
    font-size: 13px; color: var(--light-gray);
    letter-spacing: -0.015em;
  }
  .mp-micro strong { color: var(--graphite); font-weight: 600; }
  .mp-section-head { margin-bottom: 48px; }
  .mp-section-head.mp-center,
  .mp-h2.mp-center,
  .mp-eye.mp-center { text-align: center; }
  .mp-section-head.mp-center .mp-h2,
  .mp-section-head.mp-center .mp-lede { margin-left: auto; margin-right: auto; }
  .mp-h2.mp-center { margin-left: auto; margin-right: auto; }

  /* ─── 1. HERO ─── */
  .mp-hero {
    padding: 80px 32px 100px;
    background: var(--canvas);
  }
  .mp-hero-grid {
    max-width: 1320px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr; gap: 56px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .mp-hero-grid {
      grid-template-columns: minmax(360px, 520px) minmax(0, 1fr);
      gap: 64px;
    }
  }
  .mp-hero-copy { max-width: 540px; }
  .mp-hero-prose {
    display: flex; flex-direction: column;
    gap: 14px;
    max-width: 540px;
    margin-bottom: 32px;
  }
  .mp-hero-prose p {
    font-family: var(--font-t);
    font-size: 18px; line-height: 1.55;
    letter-spacing: -0.022em;
    color: var(--mid-gray);
  }
  .mp-hero-cta-block {
    display: flex; flex-direction: column;
    gap: 12px; align-items: flex-start;
  }

  /* Snapshot artifact. Actual product screenshot, framed Apple-style. */
  .mp-artifact {
    margin: 0;
    justify-self: stretch; width: 100%;
    display: flex; flex-direction: column; gap: 14px;
  }
  .mp-artifact-img {
    width: 100%; height: auto; display: block;
    border-radius: 8px;
    box-shadow: var(--shadow-xl, rgba(0,0,0,0.22) 3px 5px 30px 0px);
    background: var(--white);
  }
  .mp-artifact-cap {
    font-family: var(--font-t);
    font-size: 12px; font-weight: 400;
    letter-spacing: -0.015em;
    color: var(--light-gray);
    text-align: center;
  }
  @media (max-width: 1023px) {
    .mp-artifact { max-width: 100%; }
  }

  /* Divergence chart (replaces snapshot image) */
  .mp-chart {
    width: 100%;
    background: var(--white);
    border-radius: 8px;
    box-shadow: var(--shadow-xl, rgba(0,0,0,0.22) 3px 5px 30px 0px);
    padding: 20px 24px 8px;
  }
  .mp-chart svg { width: 100%; height: auto; display: block; }
  .mp-c-title { font-family: var(--font-t); font-size: 13px; font-weight: 600; letter-spacing: 0.06em; fill: var(--graphite); }
  .mp-c-sub   { font-family: var(--font-t); font-size: 12px; fill: var(--light-gray); }
  .mp-c-leg   { font-family: var(--font-t); font-size: 12px; font-weight: 600; letter-spacing: 0.04em; fill: var(--graphite); }
  .mp-c-leg-mkt { fill: var(--mid-gray); font-weight: 500; }
  .mp-c-x     { font-family: var(--font-t); font-size: 11px; letter-spacing: 0.04em; fill: var(--light-gray); }
  .mp-c-grid  { stroke: #ececec; stroke-width: 1; }
  .mp-c-grid-base { stroke: #dedede; stroke-dasharray: 3 4; }
  .mp-c-line-you { stroke: var(--graphite); stroke-width: 2.75; stroke-linecap: round; stroke-linejoin: round; }
  .mp-c-line-mkt { stroke: #c4c4c4; stroke-width: 2.75; stroke-linecap: round; stroke-linejoin: round; }
  .mp-c-dot-you { fill: var(--graphite); }
  .mp-c-dot-mkt { fill: #c4c4c4; }
  .mp-c-callout rect { fill: var(--white); stroke: var(--border); stroke-width: 1; }
  .mp-c-call-1 { font-family: var(--font-t); font-size: 14px; font-weight: 700; fill: var(--graphite); }
