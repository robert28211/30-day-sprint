---
import Base from '../layouts/Base.astro'
import Footer from '../components/Footer.astro'
---
<Base
  title="Marketing Performance Group — Find the Buyers Already In Your Market"
  description="Right now, buyers in your market are calling your competitors. We already know who's searching for your services — by name and address. A free 30-second snapshot shows you exactly how many. $3,500/month + ad spend. 2X revenue guarantee or we keep working free."
>
  <!-- Minimal top nav — logo only; everything else moved to footer -->
  <nav class="mp-nav">
    <div class="mp-nav-inner">
      <a href="/" class="mp-logo">
        Marketing Performance Group
        <span class="mp-logo-sub">Powered by EngageEngine™</span>
      </a>
    </div>
  </nav>

  <main class="mp">

    <!-- ═══ 1. HERO ═══ -->
    <section class="mp-hero">
      <div class="mp-hero-grid">
        <div class="mp-hero-copy">
          <h1 class="mp-h1">
            <span class="hero-word">We </span>
            <span class="hero-word">find </span>
            <span class="hero-word">buyers </span>
            <span class="hero-word">before </span>
            <span class="hero-word">they </span>
            <span class="hero-word">call </span>
            <span class="hero-word">anyone.</span>
          </h1>
          <div class="mp-hero-prose hero-sub">
            <p>Before a homeowner calls anyone, they're already searching. Reading reviews. Comparing options. Looking at maps.</p>
            <p>We identify those <strong>specific people</strong> — by name, email, telephone, and address — and put your ads in front of them, and only them, across Google, Facebook, YouTube, and every other platform they use.</p>
            <p class="mp-hero-prose-close mobile-hide">No wasted spend on people who'll never call. No guessing who's in market. Just the buyers who are actually deciding right now.</p>
          </div>

          <div class="hero-cta mp-hero-cta-block">
            <a href="/snapshot" class="mp-btn-primary">Show Me Who's Searching in My Market</a>
            <p class="mp-micro">No email required</p>
          </div>

          <div class="mp-hero-trust mobile-hide">
            <div class="mp-guarantee-chip">
              <span class="mp-chip-check">✓</span>
              <span>Backed by our <strong>2X Revenue Guarantee</strong> — or we keep working. Free.</span>
            </div>
            <p class="mp-cred-line"><strong>31 years in business. Zero refunds.</strong> Not because we don't offer them — because we don't need to.</p>
          </div>
        </div>

        <!-- Snapshot artifact — actual buyer intent pull -->
        <figure class="mp-artifact">
          <img
            src="/img/intent-snapshot-hvac.png"
            alt="Buyer intent pull — Columbia, SC HVAC, May 25 2026: 233 active searchers identified, 85 multi-site visitors, 85 uncaptured (no contact made), competitor exposure locked until activation. Contact data preview blurred."
            class="mp-artifact-img"
            loading="eager"
          />
          <figcaption class="mp-artifact-cap">Actual buyer intent pull · Columbia, SC HVAC · Last 72 hours</figcaption>
        </figure>
      </div>
    </section>

    <!-- ═══ 2. HERO-ANCHOR TESTIMONIAL ═══ -->
    <section class="mp-anchor">
      <div class="mp-anchor-inner" data-animate>
        <div class="mp-anchor-photo">
          <img src="/img/rogerson.jpg" alt="George Rogerson, McClintock HVAC" width="80" height="80" loading="lazy" decoding="async" />
        </div>
        <div class="mp-anchor-body">
          <p class="mp-anchor-quote">"Our cost per click dropped over 70%, clicks and engagement went up on our website, and in 30 days we doubled our booked appointments."</p>
          <p class="mp-anchor-attr"><strong>George Rogerson</strong> · McClintock HVAC · Charlotte, NC</p>
          <div class="mp-anchor-stats">
            <span><strong>70%</strong> lower cost per click</span>
            <span class="mp-dot">·</span>
            <span><strong>2×</strong> booked appointments</span>
            <span class="mp-dot">·</span>
            <span>30 days</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 3. FOUNDER — moved up per revisions ═══ -->
    <section class="mp-founder">
      <div class="mp-founder-inner" data-animate>
        <img src="/img/robbie-butt.jpg" alt="Robbie Butt, Founder of EngageEngine™" class="mp-founder-photo" />
        <div class="mp-founder-body">
          <p class="mp-founder-eye">The Founder</p>
          <h2 class="mp-founder-name">Robbie Butt</h2>
          <p class="mp-founder-title">Founder, EngageEngine™ · 41 years in this industry</p>
          <p class="mp-founder-quote">"I personally sign every client. If it doesn't work, I keep working. That's been the deal for 31 years."</p>
          <p class="mp-founder-cred"><strong>31 years in business. Zero refunds.</strong> Not because we don't offer them — because we don't need to.</p>
        </div>
      </div>
    </section>

    <!-- ═══ 4. PRODUCT CLARITY ═══ -->
    <section class="mp-clarity">
      <div class="mp-section-head">
        <p class="mp-eye" data-animate>What This Is</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">EngageEngine™ is a fully managed service.</h2>
        <p class="mp-lede" data-animate data-delay="0.1">Not software. Not a dashboard. Not another platform to learn. We do the work. You tell us your market and your service — we handle audience building, ad placement, optimization, and reporting.</p>
      </div>

      <!-- The Intelligence Layer — the system visualized -->
      <div class="mp-intel-wrap" data-animate data-delay="0.15">
        <img src="/img/intelligence-layer.webp" alt="The Intelligence Layer — input data, the engine, and the outputs that find buyers before they call" class="mp-intel" />
      </div>

      <div class="mp-do-grid" data-animate data-delay="0.2">
        <div class="mp-do-col mp-do-yes">
          <p class="mp-do-h">Here's what you do</p>
          <ul>
            <li><span class="mp-do-mark">✓</span> Tell us your service area</li>
            <li><span class="mp-do-mark">✓</span> Tell us what a good job looks like</li>
            <li><span class="mp-do-mark">✓</span> Answer the calls</li>
          </ul>
        </div>
        <div class="mp-do-col mp-do-no">
          <p class="mp-do-h">Here's what you don't</p>
          <ul>
            <li><span class="mp-do-mark mp-mark-x">✕</span> Manage campaigns</li>
            <li><span class="mp-do-mark mp-mark-x">✕</span> Build audiences</li>
            <li><span class="mp-do-mark mp-mark-x">✕</span> Touch the platform</li>
            <li><span class="mp-do-mark mp-mark-x">✕</span> Learn another dashboard</li>
          </ul>
        </div>
      </div>

      <p class="mp-fit-line" data-animate data-delay="0.25">Built for service businesses doing <strong>$500K–$5M/year in revenue</strong>.</p>
    </section>

    <!-- ═══ 5. HOW IT WORKS ═══ -->
    <section class="mp-engine">
      <div class="mp-section-head">
        <p class="mp-eye" data-animate>How It Works</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">We find buyers before they call anyone.</h2>
      </div>

      <div class="mp-mechanism" data-animate data-delay="0.1">
        <p>Before a homeowner calls anyone, they're already searching. Reading reviews. Comparing options. Looking at maps.</p>
        <p>We identify those <strong>specific people</strong> — by name and address — and put your ads in front of them, and only them, across Google, Facebook, YouTube, and every other platform they use.</p>
        <p>No wasted spend on people who'll never call. No guessing who's in market. Just the buyers who are actually deciding right now.</p>
      </div>

      <!-- Exploded diagram — the system architecture -->
      <img src="/ee-explode.webp" alt="EngageEngine — five-layer system" class="mp-explode" width="1536" height="1024" loading="lazy" decoding="async" data-animate data-delay="0.15" />

      <div class="mp-modules" data-animate data-delay="0.2">
        <div class="mp-mod">
          <div class="mp-mod-num">01</div>
          <div class="mp-mod-name">We find them</div>
          <div class="mp-mod-desc">45,000+ data sources tell us who in your market is searching for your service this week.</div>
        </div>
        <div class="mp-mod">
          <div class="mp-mod-num">02</div>
          <div class="mp-mod-name">We match them</div>
          <div class="mp-mod-desc">Custom audiences built daily — matched to your service, geography, and the kind of job you want.</div>
        </div>
        <div class="mp-mod">
          <div class="mp-mod-num">03</div>
          <div class="mp-mod-name">We reach them</div>
          <div class="mp-mod-desc">Your ads run on Google, Meta, and programmatic — in front of the same people, across every channel.</div>
        </div>
        <div class="mp-mod">
          <div class="mp-mod-num">04</div>
          <div class="mp-mod-name">We learn from them</div>
          <div class="mp-mod-desc">Every closed job feeds back in. The system gets sharper every week about what a real customer looks like.</div>
        </div>
        <div class="mp-mod">
          <div class="mp-mod-num">05</div>
          <div class="mp-mod-name">We prove it</div>
          <div class="mp-mod-desc">Every lead traced from first signal to closed job. You always see exactly what's working — and what it cost.</div>
        </div>
      </div>

      <p class="mp-timeline" data-animate data-delay="0.25"><strong>Most clients are live within 72 hours of the diagnostic.</strong></p>

      <div class="mp-status" data-animate data-delay="0.3">
        <p class="mp-status-cap">Live system performance — across all active client accounts</p>
        <div class="mp-status-rows">
          <div class="mp-status-row"><span>System Status</span><span class="mp-status-v">ACTIVE</span></div>
          <div class="mp-status-row"><span>Cost Reduction vs. Platform-Native</span><span class="mp-status-v">67–90%</span></div>
          <div class="mp-status-row"><span>Attribution</span><span class="mp-status-v">CLOSED LOOP</span></div>
          <div class="mp-status-row"><span>Audiences</span><span class="mp-status-v">REFRESHED DAILY</span></div>
        </div>
      </div>
    </section>

    <!-- ═══ 6. MECHANISM TESTIMONIAL — removed pending replacement ═══ -->

    <!-- ═══ 7. RESULTS ═══ -->
    <section class="mp-results">
      <div class="mp-section-head mp-center">
        <p class="mp-eye" data-animate>Results</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">Four service businesses. Same system. Different verticals.</h2>
        <p class="mp-lede" data-animate data-delay="0.1">These are working businesses you can verify. Ask us for contact info — they've agreed to talk to qualified prospects.</p>
      </div>

      <div class="mp-results-grid">
        <article class="mp-result" data-animate>
          <p class="mp-result-headline">$440K in sales. One week.</p>
          <p class="mp-result-quote">"We diagnosed the problem — buyers found us but didn't trust what they saw. We tightened the trust signals. A hundred and twenty days later, we did $440,000 in sales in one week. Same traffic. Different result."</p>
          <p class="mp-result-attr"><strong>Landscape Charleston</strong> · Charleston, SC</p>
        </article>
        <article class="mp-result" data-animate data-delay="0.1">
          <p class="mp-result-headline">Monthly sales tripled. Ad spend cut 60%.</p>
          <p class="mp-result-quote">"We fixed the right problem. Monthly sales tripled. We're spending 60% less than before."</p>
          <p class="mp-result-attr"><strong>King's Fencing</strong> · Nashville, TN</p>
        </article>
        <article class="mp-result" data-animate data-delay="0.2">
          <p class="mp-result-headline">Phones ring year-round. Zero extra spend.</p>
          <p class="mp-result-quote">"The phones ring. The jobs book. We don't have seasonal slowdowns anymore. And we're not spending any more than we were."</p>
          <p class="mp-result-attr"><strong>Carolina Stone Craftsman</strong> · Columbia, SC</p>
        </article>
        <article class="mp-result" data-animate data-delay="0.1">
          <p class="mp-result-headline">Close rate jumped. Price resistance disappeared.</p>
          <p class="mp-result-quote">"Our close rates jumped. The price conversations got easier. Buyers just stopped pushing back."</p>
          <p class="mp-result-attr"><strong>Orange County Garage Doors</strong> · Tustin, CA</p>
        </article>
      </div>
    </section>

    <!-- ═══ 8. MARKET EXCLUSIVITY ═══ -->
    <section class="mp-exclusivity">
      <div class="mp-exclusivity-inner" data-animate>
        <p class="mp-excl-eye">Market Exclusivity</p>
        <h2 class="mp-excl-h">One business per service category per market.</h2>
        <p class="mp-excl-body">We only take one roofing company in Columbia. One HVAC company. One landscaper. One fencing company. When that slot closes, it closes — until the current client leaves or the market is reopened.</p>
        <div class="mp-excl-warn">
          <p class="mp-excl-warn-h">Your competitor may have already pulled this snapshot.</p>
          <p>If they did, they're already running ads to the buyers who were supposed to call you. The snapshot takes 30 seconds. No email. No call.</p>
        </div>
      </div>
    </section>

    <!-- ═══ 9. GUARANTEE + PRICING ═══ -->
    <section class="mp-guarantee">
      <div class="mp-section-head mp-center">
        <p class="mp-eye" data-animate>The Guarantee</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">The guarantee nobody else in this industry will make.</h2>
      </div>

      <div class="mp-guarantee-card" data-animate data-delay="0.1">
        <div class="mp-guarantee-badge">
          <span class="mp-badge-check">✓</span>
          <span>2X Revenue Guarantee</span>
        </div>
        <p class="mp-guarantee-lead">We stay until it works. That's the deal.</p>
        <p class="mp-guarantee-body">If EngageEngine™ doesn't deliver at least <strong>2X our fee in closed revenue within 90 days</strong> — we keep working until it does. Free. No refund and disappear. We stay. We fix. We run it until the number is there.</p>
        <p class="mp-guarantee-closer">Because if we can't find the buyers, we don't deserve to get paid.</p>

        <div class="mp-pricing">
          <p class="mp-pricing-eye">Pricing</p>
          <p class="mp-pricing-headline">
            <span class="mp-pricing-num">$3,500</span><span class="mp-pricing-per">/month</span>
            <span class="mp-pricing-plus">+ ad spend</span>
          </p>
          <p class="mp-pricing-body">The guarantee is on our fee — not your ad spend. <strong>$3,500 in → at least $7,000/month in closed revenue within 90 days</strong>, or we keep working until it does. Free.</p>
        </div>
      </div>
    </section>

    <!-- ═══ 10. CLOSE ═══ -->
    <section class="mp-close">
      <h2 class="mp-close-h1" data-animate>The buyers are already in your market.</h2>
      <p class="mp-close-h2" data-animate data-delay="0.05">The only question is who gets to them first.</p>
      <p class="mp-close-body" data-animate data-delay="0.1">Every day this runs without you, a competitor is capturing demand that should be yours. Your slot may already be gone. Pull the snapshot now — 30 seconds, no email, just your data.</p>
      <div class="mp-close-cta" data-animate data-delay="0.2">
        <a href="/snapshot" class="mp-btn-primary">Show Me Who's Searching in My Market</a>
        <p class="mp-micro">No email required</p>
      </div>
    </section>

  </main>
  <Footer />
</Base>

<style>
  /* ═══════════════════════════════════════════════════════
     APPLE-FIDELITY HOMEPAGE
     Tokens used:
       • Canvas White #f5f5f7        — page background (Surface 0)
       • Pure White #ffffff           — elevated surfaces (Surface 1)
       • Lightest Gray #e2e2e5        — recessed/grouped blocks (Surface 2)
       • Pale Blue #9fc6f4            — accent surface (Surface 3)
       • Midnight Graphite #1d1d1f    — primary text
       • Deep Gray #333333            — secondary text
       • Medium Gray #707070          — tertiary text
       • Light Gray #858585           — muted labels
       • Border Silver #d6d6d6        — divider lines
       • Interactive Blue #0071e3     — primary CTA
       • Action Blue #0066cc          — links/outline
       • Cards: 0px radius (per spec)
       • Images: 8px radius
       • Buttons: 980px pill
       • Shadow XL: rgba(0,0,0,0.22) 3px 5px 30px 0px
     ═══════════════════════════════════════════════════════ */

  /* ─── Top nav (logo only) ─── */
  .mp-nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(255,255,255,0.72);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .mp-nav-inner {
    max-width: 1280px; margin: 0 auto;
    padding: 0 32px; height: 56px;
    display: flex; align-items: center;
  }
  .mp-logo {
    font-family: var(--font-t);
    font-size: 13px; font-weight: 600;
    letter-spacing: -0.01em; color: var(--graphite);
    text-decoration: none;
    display: flex; flex-direction: column; gap: 1px;
    min-height: 44px; justify-content: center;
  }
  .mp-logo:hover { color: var(--graphite); text-decoration: none; }
  .mp-logo-sub {
    font-size: 10px; font-weight: 400;
    letter-spacing: 0.02em; color: var(--mid-gray);
  }

  /* ─── Page base ─── */
  .mp { background: var(--canvas); color: var(--graphite); }
  .mp h1, .mp h2 { font-family: var(--font-d); color: var(--graphite); }
  .mp p { color: var(--graphite); }

  /* ─── Primary button (Apple Interactive Blue pill) ─── */
  .mp-btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--blue); color: #fff;
    font-family: var(--font-t); font-size: 17px;
    font-weight: 400; letter-spacing: -0.022em;
    padding: 12px 24px; border-radius: 980px;
    text-decoration: none; transition: background 0.2s;
    line-height: 1;
  }
  .mp-btn-primary:hover { background: var(--blue-link); text-decoration: none; color: #fff; }
  .mp-btn-primary::after {
    content: "→"; font-size: 17px; line-height: 1;
    transition: transform 0.2s;
  }
  .mp-btn-primary:hover::after { transform: translateX(3px); }

  /* ─── Eyebrows + headings ─── */
  .mp-eye {
    font-family: var(--font-t);
    font-size: 12px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--blue); margin-bottom: 16px;
  }
  .mp-h1 {
    font-family: var(--font-d);
    font-size: clamp(36px, 4.2vw, 52px);
    font-weight: 600; line-height: 1.05;
    letter-spacing: -0.022em; color: var(--graphite);
    margin-bottom: 14px;
  }
  .mp-h2 {
    font-family: var(--font-d);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600; line-height: 1.07;
    letter-spacing: -0.018em; color: var(--graphite);
    margin-bottom: 20px;
    max-width: 760px;
  }
  .mp-lede {
    font-family: var(--font-t);
    font-size: 21px; line-height: 1.4;
    letter-spacing: -0.022em; color: var(--mid-gray);
    max-width: 680px;
  }
  .mp-micro {
    font-family: var(--font-t);
    font-size: 13px; color: var(--light-gray);
    letter-spacing: -0.015em;
  }
  .mp-section-head { margin-bottom: 48px; }
  .mp-section-head.mp-center { text-align: center; }
  .mp-section-head.mp-center .mp-h2,
  .mp-section-head.mp-center .mp-lede { margin-left: auto; margin-right: auto; }

  /* ─── 1. HERO ─── */
  .mp-hero {
    padding: 80px 32px 100px;
    background: var(--canvas);
  }
  .mp-hero-grid {
    max-width: 1320px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr; gap: 56px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .mp-hero-grid {
      grid-template-columns: minmax(360px, 460px) minmax(0, 1fr);
      gap: 64px;
    }
  }
  .mp-hero-copy { max-width: 460px; }
  .mp-hero-punch {
    font-family: var(--font-d);
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 500; line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--blue); margin-bottom: 24px;
  }
  .mp-hero-sub {
    font-family: var(--font-t);
    font-size: 19px; line-height: 1.5;
    letter-spacing: -0.022em;
    color: var(--mid-gray);
    max-width: 540px; margin-bottom: 36px;
  }
  .mp-hero-prose {
    display: flex; flex-direction: column;
    gap: 14px;
    max-width: 540px;
    margin-bottom: 32px;
  }
  .mp-hero-prose p {
    font-family: var(--font-t);
    font-size: 17px; line-height: 1.55;
    letter-spacing: -0.022em;
    color: var(--mid-gray);
  }
  .mp-hero-prose p strong {
    color: var(--blue); font-weight: 600;
  }
  .mp-hero-prose-close {
    color: var(--graphite) !important;
    font-weight: 500;
  }
  .mp-hero-cta-block {
    display: flex; flex-direction: column;
    gap: 10px; align-items: flex-start;
    margin-bottom: 28px;
  }
  .mp-hero-trust {
    display: flex; flex-direction: column; gap: 14px;
    padding-top: 24px; border-top: 1px solid var(--border);
  }
  .mp-guarantee-chip {
    display: inline-flex; align-items: center; gap: 10px;
    align-self: flex-start;
    padding: 8px 14px;
    background: var(--white); border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-t);
    font-size: 13px; color: var(--graphite);
    letter-spacing: -0.01em;
  }
  .mp-guarantee-chip strong { font-weight: 600; }
  .mp-chip-check {
    width: 18px; height: 18px; border-radius: 50%;
    background: var(--blue); color: #fff;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 700;
  }
  .mp-cred-line {
    font-family: var(--font-t);
    font-size: 14px; line-height: 1.5;
    letter-spacing: -0.015em;
    color: var(--mid-gray); max-width: 500px;
  }
  .mp-cred-line strong { color: var(--graphite); font-weight: 600; }

  /* Snapshot artifact — actual product screenshot, framed Apple-style */
  .mp-artifact {
    margin: 0;
    justify-self: stretch; width: 100%;
    display: flex; flex-direction: column; gap: 14px;
  }
  .mp-artifact-img {
    width: 100%; height: auto; display: block;
    border-radius: 8px;
    box-shadow: var(--shadow-xl, rgba(0,0,0,0.22) 3px 5px 30px 0px);
    background: var(--white);
  }
  .mp-artifact-cap {
    font-family: var(--font-t);
    font-size: 12px; font-weight: 400;
    letter-spacing: -0.015em;
    color: var(--light-gray);
    text-align: center;
  }
  @media (max-width: 1023px) {
    .mp-artifact { max-width: 100%; }
  }

  /* ─── 2 & 6. ANCHOR TESTIMONIALS ─── */
  .mp-anchor {
    background: var(--white);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 48px 32px;
  }
  .mp-anchor-alt { background: var(--canvas); }
  .mp-anchor-inner {
    max-width: 960px; margin: 0 auto;
    display: flex; align-items: center; gap: 32px;
  }
  .mp-anchor-photo {
    width: 80px; height: 80px;
    border-radius: 50%;
    background: var(--canvas);
    border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-d);
    font-size: 22px; font-weight: 600;
    color: var(--mid-gray);
    flex-shrink: 0;
