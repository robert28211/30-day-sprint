---
import Base from '../layouts/Base.astro'
import Footer from '../components/Footer.astro'
---
<Base
  title="Marketing Performance Group — Find the Buyers Already In Your Market"
  description="Right now, buyers in your market are calling your competitors. We already know who's searching for your services — by name and address. A free 30-second snapshot shows you exactly how many. $3,500/month + ad spend. 2X revenue guarantee or we keep working free."
>
  <!-- Minimal top nav — logo only; everything else moved to footer -->
  <nav class="mp-nav">
    <div class="mp-nav-inner">
      <a href="/" class="mp-logo">
        Marketing Performance Group
        <span class="mp-logo-sub">Powered by EngageEngine™</span>
      </a>
    </div>
  </nav>

  <main class="mp">

    <!-- ═══ 1. HERO ═══ -->
    <section class="mp-hero">
      <div class="mp-hero-grid">
        <div class="mp-hero-copy">
          <h1 class="mp-h1">
            <span class="hero-word">We </span>
            <span class="hero-word">find </span>
            <span class="hero-word">buyers </span>
            <span class="hero-word">before </span>
            <span class="hero-word">they </span>
            <span class="hero-word">call </span>
            <span class="hero-word">anyone.</span>
          </h1>
          <div class="mp-hero-prose hero-sub">
            <p>Before a homeowner calls anyone, they're already searching. Reading reviews. Comparing options. Looking at maps.</p>
            <p>We identify those <strong>specific people</strong> — by name, email, telephone, and address — and put your ads in front of them, and only them, across Google, Facebook, YouTube, and every other platform they use.</p>
            <p class="mp-hero-prose-close mobile-hide">No wasted spend on people who'll never call. No guessing who's in market. Just the buyers who are actually deciding right now.</p>
          </div>

          <div class="hero-cta mp-hero-cta-block">
            <a href="/snapshot" class="mp-btn-primary">Show Me Who's Searching in My Market</a>
            <p class="mp-micro">No email required</p>
          </div>

          <div class="mp-hero-trust mobile-hide">
            <div class="mp-guarantee-chip">
              <span class="mp-chip-check">✓</span>
              <span>Backed by our <strong>2X Revenue Guarantee</strong> — or we keep working. Free.</span>
            </div>
            <p class="mp-cred-line"><strong>31 years in business. Zero refunds.</strong> Not because we don't offer them — because we don't need to.</p>
          </div>
        </div>

        <!-- Snapshot artifact — actual buyer intent pull -->
        <figure class="mp-artifact">
          <img
            src="/img/intent-snapshot-hvac.png"
            alt="Buyer intent pull — Columbia, SC HVAC, May 25 2026: 233 active searchers identified, 85 multi-site visitors, 85 uncaptured (no contact made), competitor exposure locked until activation. Contact data preview blurred."
            class="mp-artifact-img"
            loading="eager"
          />
          <figcaption class="mp-artifact-cap">Actual buyer intent pull · Columbia, SC HVAC · Last 72 hours</figcaption>
        </figure>
      </div>
    </section>

    <!-- ═══ 2. HERO-ANCHOR TESTIMONIAL ═══ -->
    <section class="mp-anchor">
      <div class="mp-anchor-inner" data-animate>
        <div class="mp-anchor-photo">
          <img src="/img/rogerson.jpg" alt="McClintock HVAC" width="80" height="80" loading="lazy" decoding="async" />
        </div>
        <div class="mp-anchor-body">
          <p class="mp-anchor-quote">"Our cost per click dropped over 70%, clicks and engagement went up on our website, and in 30 days we doubled our booked appointments."</p>
          <p class="mp-anchor-attr"><strong>McClintock HVAC</strong> · Charlotte, NC</p>
          <div class="mp-anchor-stats">
            <span><strong>70%</strong> lower cost per click</span>
            <span class="mp-dot">·</span>
            <span><strong>2×</strong> booked appointments</span>
            <span class="mp-dot">·</span>
            <span>30 days</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 3. FOUNDER — moved up per revisions ═══ -->
    <section class="mp-founder">
      <div class="mp-founder-inner" data-animate>
        <img src="/img/robbie-butt.jpg" alt="Robbie Butt, Founder of EngageEngine™" class="mp-founder-photo" />
        <div class="mp-founder-body">
          <p class="mp-founder-eye">The Founder</p>
          <h2 class="mp-founder-name">Robbie Butt</h2>
          <p class="mp-founder-title">Founder, EngageEngine™ · 41 years in this industry</p>
          <p class="mp-founder-quote">"I personally sign every client. If it doesn't work, I keep working. That's been the deal for 31 years."</p>
          <p class="mp-founder-cred"><strong>31 years in business. Zero refunds.</strong> Not because we don't offer them — because we don't need to.</p>
        </div>
      </div>
    </section>

    <!-- ═══ 4. PRODUCT CLARITY ═══ -->
    <section class="mp-clarity">
      <div class="mp-section-head">
        <p class="mp-eye" data-animate>What This Is</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">EngageEngine™ is a fully managed service.</h2>
        <p class="mp-lede" data-animate data-delay="0.1">Not software. Not a dashboard. Not another platform to learn. We do the work. You tell us your market and your service — we handle audience building, ad placement, optimization, and reporting.</p>
      </div>

      <!-- The Intelligence Layer — the system visualized -->
      <div class="mp-intel-wrap" data-animate data-delay="0.15">
        <img src="/img/intelligence-layer.webp" alt="The Intelligence Layer — input data, the engine, and the outputs that find buyers before they call" class="mp-intel" />
      </div>

      <div class="mp-do-grid" data-animate data-delay="0.2">
        <div class="mp-do-col mp-do-yes">
          <p class="mp-do-h">Here's what you do</p>
          <ul>
            <li><span class="mp-do-mark">✓</span> Tell us your service area</li>
            <li><span class="mp-do-mark">✓</span> Tell us what a good job looks like</li>
            <li><span class="mp-do-mark">✓</span> Answer the calls</li>
          </ul>
        </div>
        <div class="mp-do-col mp-do-no">
          <p class="mp-do-h">Here's what you don't</p>
          <ul>
            <li><span class="mp-do-mark mp-mark-x">✕</span> Manage campaigns</li>
            <li><span class="mp-do-mark mp-mark-x">✕</span> Build audiences</li>
            <li><span class="mp-do-mark mp-mark-x">✕</span> Touch the platform</li>
            <li><span class="mp-do-mark mp-mark-x">✕</span> Learn another dashboard</li>
          </ul>
        </div>
      </div>

      <p class="mp-fit-line" data-animate data-delay="0.25">Built for service businesses doing <strong>$500K–$5M/year in revenue</strong>.</p>
    </section>

    <!-- ═══ 5. HOW IT WORKS (interactive engine) ═══ -->
  <style is:global>
    .ds-band{
      --ds-blue:#0071e3; --ds-blue-soft:#3a93ee; --ds-aiv:#f25dad; --ds-att:#2e8bff; --ds-con:#1fb6a6; --ds-cap:#ff7a3d; --ds-mea:#9b7bff;
      --ds-txt:#eef2f8; --ds-mut:#8a93a6; --ds-line:rgba(255,255,255,.08);
      position:relative;overflow:hidden;
      background:radial-gradient(1100px 760px at 50% 36%, #12203a 0%, #0a1019 42%, #06080d 80%),#06080d;
    }
    .ds-band .ds-grid{position:absolute;inset:0;pointer-events:none;opacity:.32;
      background-image:linear-gradient(var(--ds-line) 1px,transparent 1px),linear-gradient(90deg,var(--ds-line) 1px,transparent 1px);
      background-size:46px 46px;
      -webkit-mask-image:radial-gradient(900px 640px at 50% 42%, #000 0%, transparent 72%);
              mask-image:radial-gradient(900px 640px at 50% 42%, #000 0%, transparent 72%)}
    .ds-band .ds-bookend{position:absolute;left:0;right:0;height:120px;z-index:4;pointer-events:none}
    .ds-band .ds-bookend.top{top:0;background:linear-gradient(180deg,#ffffff 0%,rgba(6,8,13,.55) 55%,rgba(6,8,13,0) 100%)}
    .ds-band .ds-bookend.bottom{bottom:0;background:linear-gradient(0deg,#ffffff 0%,rgba(6,8,13,.55) 55%,rgba(6,8,13,0) 100%)}
    .ds-band .ds-inner{max-width:1040px;margin:0 auto;padding:118px 22px 132px;position:relative;z-index:1;
      font-family:var(--font-t),'SF Pro Text',system-ui,sans-serif;color:var(--ds-txt)}
    .ds-band .ds-head{text-align:center;margin-bottom:14px}
    .ds-band .ds-eyebrow{font-size:13px;font-weight:600;letter-spacing:.4px;color:var(--ds-blue-soft);text-transform:uppercase}
    .ds-band .ds-h2{font-size:clamp(28px,4vw,42px);font-weight:600;letter-spacing:-.6px;line-height:1.08;margin:12px 0 4px;color:#fff}
    .ds-band .ds-h2 .b{color:var(--ds-blue-soft)}
    .ds-band .ds-sub{color:var(--ds-mut);font-size:16px;line-height:1.5;max-width:580px;margin:10px auto 0}
    .ds-band .ds-stage{position:relative;width:100%;height:600px;margin:30px auto 0;perspective:1200px}
    .ds-band .ds-field{position:absolute;inset:0;transform-style:preserve-3d;transition:transform .25s ease-out}
    .ds-band .ds-orbit{position:absolute;top:50%;left:50%;border-radius:50%;border:1px solid var(--ds-line);transform:translate(-50%,-50%)}
    .ds-band .ds-orbit.o1{width:480px;height:480px}
    .ds-band .ds-orbit.o2{width:368px;height:368px;border-style:dashed;border-color:rgba(58,147,238,.22);animation:dsspin 38s linear infinite}
    @keyframes dsspin{to{transform:translate(-50%,-50%) rotate(360deg)}}
    .ds-band .ds-loop{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:480px;height:480px;overflow:visible}
    .ds-band .ds-loop circle{fill:none;stroke:url(#dsflow);stroke-width:2;stroke-linecap:round;stroke-dasharray:6 16;filter:drop-shadow(0 0 6px rgba(0,113,227,.55));animation:dsfl 5.5s linear infinite}
    @keyframes dsfl{to{stroke-dashoffset:-220}}
    .ds-band .ds-core{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:188px;height:188px;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:6;cursor:pointer}
    .ds-band .ds-disc{position:absolute;inset:24px;border-radius:50%;background:radial-gradient(circle at 50% 38%, #15233d 0%, #0b1220 70%);border:1px solid rgba(120,170,255,.30);
      box-shadow:0 0 0 1px rgba(0,113,227,.25),0 18px 50px rgba(0,0,0,.6),inset 0 1px 0 rgba(255,255,255,.10),inset 0 0 42px rgba(0,113,227,.30);
      display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
    .ds-band .ds-disc b{font-size:21px;font-weight:600;letter-spacing:-.4px;line-height:1}
    .ds-band .ds-disc .tag{font-size:10px;letter-spacing:2.5px;text-transform:uppercase;color:var(--ds-blue-soft);margin-top:7px}
    .ds-band .ds-dot{width:8px;height:8px;border-radius:50%;background:var(--ds-blue);box-shadow:0 0 12px 3px rgba(0,113,227,.9);margin-bottom:8px;animation:dsbeat 2.2s ease-in-out infinite}
    @keyframes dsbeat{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(.55);opacity:.45}}
    .ds-band .ds-halo{position:absolute;inset:6px;border-radius:50%;background:conic-gradient(from 0deg, transparent 0deg, rgba(0,113,227,0) 40%, rgba(58,147,238,.85) 80%, rgba(120,190,255,1) 92%, transparent 100%);
      -webkit-mask:radial-gradient(farthest-side,transparent calc(100% - 6px),#000 calc(100% - 5px));mask:radial-gradient(farthest-side,transparent calc(100% - 6px),#000 calc(100% - 5px));animation:dsspin2 4.4s linear infinite;opacity:.9}
    @keyframes dsspin2{to{transform:rotate(360deg)}}
    .ds-band .ds-pulse{position:absolute;top:50%;left:50%;width:188px;height:188px;border-radius:50%;border:1.5px solid rgba(0,113,227,.55);transform:translate(-50%,-50%) scale(1);opacity:0;animation:dspulse 3.4s ease-out infinite}
    .ds-band .ds-pulse.p2{animation-delay:1.13s}.ds-band .ds-pulse.p3{animation-delay:2.26s}
    @keyframes dspulse{0%{transform:translate(-50%,-50%) scale(.62);opacity:.7}70%{opacity:.18}100%{transform:translate(-50%,-50%) scale(2.55);opacity:0}}
    .ds-band .ds-node{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:118px;height:118px;border-radius:22px;
      background:linear-gradient(180deg, rgba(20,26,38,.92), rgba(11,15,23,.92));border:1px solid rgba(255,255,255,.10);
      box-shadow:0 16px 38px rgba(0,0,0,.5), inset 0 1px 0 rgba(255,255,255,.07);-webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);
      display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;cursor:pointer;z-index:5;
      transition:transform .22s cubic-bezier(.2,.8,.2,1),box-shadow .22s,border-color .22s;color:var(--ds-txt)}
    .ds-band .ds-node .ic{width:42px;height:42px;border-radius:12px;display:flex;align-items:center;justify-content:center;background:color-mix(in srgb,var(--nc) 18%, transparent);border:1px solid color-mix(in srgb,var(--nc) 45%,transparent);color:var(--nc)}
    .ds-band .ds-node .ic svg{width:22px;height:22px;stroke:currentColor;fill:none;stroke-width:1.8}
    .ds-band .ds-node .lbl{font-size:13px;font-weight:600;letter-spacing:-.2px}
    .ds-band .ds-node .sub{font-size:10px;color:var(--ds-mut);margin-top:-4px}
    .ds-band .ds-node .badge{position:absolute;top:-8px;right:-8px;font-size:8.5px;font-weight:700;letter-spacing:.6px;padding:3px 7px;border-radius:7px;background:var(--nc);color:#0a0a12;box-shadow:0 5px 14px color-mix(in srgb,var(--nc) 60%,transparent)}
    .ds-band .ds-node:hover{transform:translate(-50%,-50%) translateY(-4px) scale(1.05);border-color:color-mix(in srgb,var(--nc) 55%,transparent);box-shadow:0 22px 48px rgba(0,0,0,.55), 0 0 26px color-mix(in srgb,var(--nc) 40%,transparent), inset 0 1px 0 rgba(255,255,255,.1)}
    .ds-band .ds-node.on{border-color:var(--nc);box-shadow:0 22px 52px rgba(0,0,0,.6), 0 0 34px color-mix(in srgb,var(--nc) 60%,transparent), inset 0 1px 0 rgba(255,255,255,.12)}
    .ds-band .ds-node.on .ic{background:color-mix(in srgb,var(--nc) 30%,transparent)}
    .ds-band .ds-field.dim .ds-node:not(.on){opacity:.42;filter:saturate(.6)}
    .ds-band .n-aiv{margin-top:-240px}.ds-band .n-att{margin-left:228px;margin-top:-74px}.ds-band .n-con{margin-left:141px;margin-top:194px}.ds-band .n-cap{margin-left:-141px;margin-top:194px}.ds-band .n-mea{margin-left:-228px;margin-top:-74px}
    .ds-band .ds-panel{max-width:780px;margin:26px auto 0;border-radius:22px;position:relative;z-index:2;text-align:left;
      background:linear-gradient(180deg, rgba(18,24,36,.80), rgba(10,14,22,.80));border:1px solid var(--ds-line);
      box-shadow:0 24px 60px rgba(0,0,0,.45), inset 0 1px 0 rgba(255,255,255,.06);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);padding:30px 34px;transition:border-color .3s, box-shadow .3s}
    .ds-band .elabel{font-size:11px;font-weight:700;letter-spacing:1.6px;text-transform:uppercase;color:var(--pc,var(--ds-blue))}
    .ds-band .ds-panel h3{font-size:25px;font-weight:600;letter-spacing:-.5px;margin:6px 0 2px;color:var(--ds-txt)}
    .ds-band .lead{color:var(--ds-mut);font-size:14.5px;line-height:1.55;margin:8px 0 0;max-width:630px}
    .ds-band .stat{display:flex;align-items:center;gap:18px;margin:20px 0 18px;padding:16px 20px;border-radius:16px;background:color-mix(in srgb,var(--pc,var(--ds-blue)) 9%, transparent);border:1px solid color-mix(in srgb,var(--pc,var(--ds-blue)) 24%, transparent)}
    .ds-band .stat .num{font-size:48px;font-weight:700;line-height:.9;letter-spacing:-1.5px;color:var(--pc,var(--ds-blue));text-shadow:0 0 24px color-mix(in srgb,var(--pc,var(--ds-blue)) 55%, transparent);min-width:118px}
    .ds-band .stat .cap{font-size:13.5px;color:var(--ds-txt);line-height:1.5}
    .ds-band .ask{font-size:17px;line-height:1.55;font-weight:500;color:#fff;border-left:3px solid var(--pc,var(--ds-blue));padding-left:16px;margin:0 0 20px}
    .ds-band .svc-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .ds-band .svc{padding:15px 17px;border-radius:14px;background:rgba(255,255,255,.028);border:1px solid var(--ds-line);transition:.2s;position:relative}
    .ds-band .svc.wide{grid-column:1/-1}
    .ds-band .svc.hero{background:color-mix(in srgb,var(--pc) 10%, transparent);border-color:color-mix(in srgb,var(--pc) 38%, transparent)}
    .ds-band .svc.hero::after{content:attr(data-badge);position:absolute;top:13px;right:14px;font-size:9px;font-weight:700;letter-spacing:.5px;color:var(--pc)}
    .ds-band .svc:hover{border-color:color-mix(in srgb,var(--pc,var(--ds-blue)) 40%, transparent);background:rgba(255,255,255,.05);transform:translateY(-2px)}
    .ds-band .svc h4{font-size:14.5px;font-weight:600;margin:0 0 6px;letter-spacing:-.2px;color:var(--ds-txt)}
    .ds-band .svc p{font-size:12.5px;color:var(--ds-mut);line-height:1.5;margin:0 0 9px}
    .ds-band .svc .out{font-size:12.5px;color:var(--ds-txt);line-height:1.45;display:flex;gap:8px;font-weight:500}
    .ds-band .svc .out .a{color:var(--pc,var(--ds-blue));font-weight:700;margin-top:-1px}
    .ds-band .svc .inside{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px;align-items:center}
    .ds-band .svc .inside .il{font-size:10.5px;color:var(--ds-mut);font-weight:600;letter-spacing:.3px;text-transform:uppercase}
    .ds-band .svc .ichip{font-size:11px;padding:4px 10px;border-radius:999px;background:color-mix(in srgb,var(--pc,var(--ds-blue)) 14%,transparent);border:1px solid color-mix(in srgb,var(--pc,var(--ds-blue)) 28%,transparent);color:var(--ds-txt)}
    .ds-band .pay{margin-top:18px;font-size:14px;color:var(--ds-mut);line-height:1.6;display:flex;gap:10px;align-items:flex-start}
    .ds-band .pay .arr{color:var(--pc,var(--ds-blue));font-weight:700;margin-top:1px}
    .ds-band .cta{display:inline-flex;align-items:center;gap:8px;margin-top:20px;padding:13px 24px;border-radius:999px;background:var(--pc,var(--ds-blue));color:#fff;font-weight:600;font-size:14px;letter-spacing:-.1px;text-decoration:none;box-shadow:0 10px 30px color-mix(in srgb,var(--pc,var(--ds-blue)) 45%,transparent);transition:transform .2s, box-shadow .2s}
    .ds-band .cta:hover{transform:translateY(-2px);box-shadow:0 16px 40px color-mix(in srgb,var(--pc,var(--ds-blue)) 62%,transparent)}
    .ds-band .cta-wrap{text-align:center}
    .ds-band .ov{display:grid;grid-template-columns:repeat(auto-fit,minmax(228px,1fr));gap:12px;margin:20px 0 6px}
    .ds-band .ov .c{padding:16px 18px;border-radius:15px;background:rgba(255,255,255,.03);border:1px solid var(--ds-line);transition:.2s;cursor:pointer}
    .ds-band .ov .c:hover{transform:translateY(-2px);border-color:color-mix(in srgb,var(--oc) 50%, transparent);background:rgba(255,255,255,.055)}
    .ds-band .ov .c .t{display:flex;align-items:center;gap:9px;font-size:14.5px;font-weight:600;margin-bottom:5px;color:var(--ds-txt)}
    .ds-band .ov .c .d{width:9px;height:9px;border-radius:50%;background:var(--oc);box-shadow:0 0 10px 1px var(--oc)}
    .ds-band .ov .c .stg{font-size:10px;color:var(--ds-mut);font-weight:500;margin-left:auto;letter-spacing:.4px}
    .ds-band .ov .c p{margin:0;font-size:12.5px;color:var(--ds-mut);line-height:1.5}
    .ds-band .loopline{margin-top:16px;text-align:center;font-size:13px;color:var(--ds-mut);letter-spacing:.2px}
    .ds-band .loopline b{color:var(--ds-blue-soft);font-weight:600}
    .ds-band .ds-foot{text-align:center;color:var(--ds-mut);font-size:12.5px;margin-top:34px;letter-spacing:.4px;line-height:1.7}
    .ds-band .ds-foot b{color:var(--ds-txt);font-weight:600}
    @media(max-width:760px){
      .ds-band .ds-stage{height:auto;display:flex;flex-direction:column;align-items:center;gap:16px;padding-top:10px}
      .ds-band .ds-orbit,.ds-band .ds-loop{display:none}
      .ds-band .ds-field{position:relative;display:flex;flex-direction:column;align-items:center;gap:14px;transform:none!important}
      .ds-band .ds-core,.ds-band .ds-node{position:relative;top:auto;left:auto;transform:none;margin:0!important}
      .ds-band .ds-node{width:100%;max-width:340px;height:auto;flex-direction:row;justify-content:flex-start;gap:14px;padding:14px 18px;border-radius:16px}
      .ds-band .ds-pulse{display:none}.ds-band .svc-grid,.ds-band .ov{grid-template-columns:1fr}
      .ds-band .stat{flex-direction:column;align-items:flex-start;gap:8px}.ds-band .stat .num{min-width:0}
      .ds-band .ds-inner{padding:96px 20px 110px}
    }
  </style>
  <section class="engine ds-band" id="ds-engine">
    <div class="ds-grid"></div>
    <div class="ds-bookend top"></div>
    <div class="ds-inner">
      <div class="ds-head">
        <span class="ds-eyebrow">How It Works</span>
        <h2 class="ds-h2">We don't guess who might buy from you.<br><span class="b">We already know who's looking.</span></h2>
        <p class="ds-sub">Your marketing isn't one tactic. It's a system — five layers that close the gap where you're losing customers, then keep the loop running.</p>
      </div>

      <div class="ds-stage">
        <div class="ds-field">
          <div class="ds-orbit o1"></div>
          <div class="ds-orbit o2"></div>
          <svg class="ds-loop" viewBox="0 0 480 480" aria-hidden="true">
            <defs><linearGradient id="dsflow" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#f25dad"/><stop offset="0.4" stop-color="#2e8bff"/><stop offset="0.7" stop-color="#1fb6a6"/><stop offset="1" stop-color="#9b7bff"/>
            </linearGradient></defs>
            <circle cx="240" cy="240" r="240"/>
          </svg>
          <div class="ds-pulse"></div><div class="ds-pulse p2"></div><div class="ds-pulse p3"></div>
          <div class="ds-core" role="button" tabindex="0" aria-label="EngageEngine overview">
            <div class="ds-halo"></div>
