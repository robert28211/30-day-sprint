---
import Base from '../layouts/Base.astro'
import Footer from '../components/Footer.astro'
import CaseStudyCards from '../components/CaseStudyCards.astro'

// Home case-study wall. Full stories live at /case-studies/*.
const caseStudies = [
  { client: 'The Guttermen', headline: '70 estimate bookings to 140 in 45 days.',
    summary: 'Advertising, intent-based email follow-up, and a connected website and inquiry system supported a doubling of estimate bookings within the first 45 days of working together.',
    href: '/case-studies/the-guttermen/' },
  { client: 'Punch List Pros', headline: '$5.20 in booked work per Google Ads dollar.',
    summary: 'August 2026 reporting connected Google advertising to uploaded closed-job values. Alongside search, the Meta program generated 97 lead-form submissions at approximately $29 each over the April–September reporting window.',
    href: '/case-studies/punch-list-pros/' },
  { client: 'Midlands Landscape', headline: '20% growth. In a market that grew 6%.',
    summary: 'A coordinated marketing program connected intent-based audiences, advertising, and email follow-up across landscaping, hardscaping, and landscape supply.',
    href: '/case-studies/midlands-landscape/' },
];

// Hero video slot. Territory Check VSL removed 2026-10-25 (offer paused).
// To add the new video: drop the .mp4 + poster .jpg in public/video/hub/ and fill this in.
// shape: 'vertical' (9:16, phone-shot) or 'wide' (16:9). While null, the preview shows a
// labeled placeholder frame. Never ship to production with HERO_VIDEO = null.
const HERO_VIDEO: null | { src: string; poster: string; caption: string; shape: 'vertical' | 'wide' } = {
  // Source: Robbie's "Find Your Failure Point_1080p_caption.mp4" (1080x1920, 1:45, 68 MB),
  // re-encoded 2026-10-25 to 720x1280 H.264 (7.7 MB, under the 25 MB asset limit).
  // Captions are burned in, so it works muted. Poster = frame at 0:21.6 ("Diagnose before you prescribe.").
  src: '/video/hub/find-your-failure-point.mp4',
  poster: '/video/hub/find-your-failure-point-poster.jpg',
  caption: 'Diagnose before you prescribe.',
  shape: 'vertical',
};
---
<Base
  title="Marketing Performance Group | Turn Existing Demand Into Booked Work"
  description="EngageEngine™ is a demand diagnostics and recovery system for home-service companies, built by Marketing Performance Group in Columbia, South Carolina. Start with the 12-question Demand Collapse Diagnostic™."
>
  <!-- Minimal top nav. Logo only. Everything else moved to footer. -->
  <nav class="mp-nav">
    <div class="mp-nav-inner">
      <a href="/" class="mp-logo">
        <img src="/mp-logo-v3.png" alt="Marketing Performance, Powered by EngageEngine™" width="217" height="44" />
      </a>
    </div>
  </nav>

  <main class="mp">

    <!-- ═══ 1. HOOK (Hormozi §1): outcome headline, proof element, one CTA ═══ -->
    <section class="mp-hero">
      <div class="mp-hero-grid">
        <div class="mp-hero-copy">
          <p class="mp-eye mp-hero-eye">A demand-recovery system for established home-service companies</p>
          <h1 class="mp-h1">
            <span class="hero-word">Turn </span>
            <span class="hero-word">more </span>
            <span class="hero-word">of </span>
            <span class="hero-word">your </span>
            <span class="hero-word">market's </span>
            <span class="hero-word">existing </span>
            <span class="hero-word">demand </span>
            <span class="hero-word hero-dim">into </span>
            <span class="hero-word hero-dim">booked </span>
            <span class="hero-word hero-dim">work. </span>
          </h1>
          <div class="mp-hero-prose hero-sub">
            <p>Most agencies start by selling you more advertising. We start by finding where the work you should be winning is disappearing.</p>
            <p>The Demand Collapse Diagnostic&trade; identifies the failure point. EngageEngine&trade; uses enterprise-grade buyer-signal intelligence to help recover the opportunity before a competitor wins the job.</p>
          </div>

          <div class="hero-cta mp-hero-cta-block">
            <a href="/diagnostic/" class="mp-btn-primary" data-plan-cta="hero">Get Your Five-Part Demand Recovery Plan</a>
            <p class="mp-micro">Start with twelve questions. See your preliminary failure mode immediately. Qualified home-service companies can receive a personalized recovery plan at no cost.</p>
          </div>

          <div class="mp-only">
            <p class="mp-only-line">Every agency you've ever hired also works for your competition.<br /><strong>I only work for one of you.</strong></p>
            <p class="mp-only-rule"><em>One company per trade, per market.</em></p>
          </div>
        </div>

        <!-- Hero video. Autoplays muted; burned-in captions carry it, controls allow unmute. -->
        {HERO_VIDEO ? (
          <figure class="mp-artifact mp-artifact-video">
            <div class:list={['mp-hero-video', HERO_VIDEO.shape === 'wide' && 'mp-hero-video--wide']}>
              <video autoplay muted loop playsinline controls preload="metadata" poster={HERO_VIDEO.poster}>
                <source src={HERO_VIDEO.src} type="video/mp4" />
              </video>
            </div>
            <div class="mp-hero-creds">
              <p class="mp-hero-creds-who">Robbie Butt &middot; Columbia, South Carolina</p>
              <div class="mp-hero-creds-row">
                <div class="mp-hc"><span class="mp-hc-n">41 <em>years</em></span><span class="mp-hc-l">Advertising and public relations</span></div>
                <div class="mp-hc"><span class="mp-hc-n">31 <em>years</em></span><span class="mp-hc-l">Owner, Marketing Performance</span></div>
                <div class="mp-hc"><span class="mp-hc-n">22 <em>years</em></span><span class="mp-hc-l">Adjunct professor, University of South Carolina</span></div>
              </div>
            </div>
            {HERO_VIDEO.caption && <figcaption class="mp-artifact-cap">{HERO_VIDEO.caption}</figcaption>}
          </figure>
        ) : (
          <figure class="mp-artifact mp-artifact-video" data-placeholder="hero-video">
            <div class="mp-hero-video mp-hero-video--slot">
              <span>New hero video<br />goes here</span>
            </div>
            <div class="mp-hero-creds">
              <p class="mp-hero-creds-who">Robbie Butt &middot; Columbia, South Carolina</p>
              <div class="mp-hero-creds-row">
                <div class="mp-hc"><span class="mp-hc-n">41 <em>years</em></span><span class="mp-hc-l">Advertising and public relations</span></div>
                <div class="mp-hc"><span class="mp-hc-n">31 <em>years</em></span><span class="mp-hc-l">Owner, Marketing Performance</span></div>
                <div class="mp-hc"><span class="mp-hc-n">22 <em>years</em></span><span class="mp-hc-l">Adjunct professor, University of South Carolina</span></div>
              </div>
            </div>
            <figcaption class="mp-artifact-cap">Preview only. Swapped for the new video before launch.</figcaption>
          </figure>
        )}
      </div>
    </section>

    <!-- 1b. Case studies directly under the hero. Robbie's call 2026-10-25: proof at the top, ahead of Hormozi's order. -->
    <CaseStudyCards cards={caseStudies} />

    <!-- Trimmed 2026-10-30 (Robbie): Problem, Solution, How EngageEngine works, After the Launch and FAQ cut; Four Moments one line each; scarcity moved up. Copy unchanged. -->

    <!-- ═══ 7. SCARCITY (Hormozi §7): one company per trade, per market ═══ -->
    <section class="mp-solution">
      <div class="mp-solution-inner">
        <p class="mp-eye" data-animate>One company per trade, per market</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">We lock your market. Then we point the work at you.</h2>
        <div class="mp-solution-prose" data-animate data-delay="0.1">
          <p><strong>One company per trade, per market.</strong> The day you claim yours, your competitor can't. That is the product, not a bonus.</p>
          <p>And because the seat is yours alone, every job it produces is a job the guy across town didn't get. That is what taking your market looks like.</p>
          <p>Because every plan is researched and prepared individually, Marketing Performance Group accepts a limited number of qualified companies each month.</p>
        </div>
      </div>
    </section>

    <!-- 2b. The four places demand disappears -->
    <section class="mp-breaks">
      <div class="mp-breaks-inner">
        <p class="mp-eye" data-animate>The Four Moments</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">There are only a few places a sale can break.</h2>
        <p class="mp-breaks-lede" data-animate data-delay="0.1">Nearly every revenue problem I see comes down to one of four moments.</p>
        <div class="mp-breaks-list" data-animate data-delay="0.15">
          <div class="mp-break"><p class="mp-break-fm">Not Seen When the Decision Is Made</p><h3>You weren't there when they decided.</h3></div>
          <div class="mp-break"><p class="mp-break-fm">Seen But Not Trusted</p><h3>They found you and didn't trust you yet.</h3></div>
          <div class="mp-break"><p class="mp-break-fm">Trusted But Still Compared</p><h3>They trusted you and shopped you anyway.</h3></div>
          <div class="mp-break"><p class="mp-break-fm">Selected But No Action</p><h3>They meant to hire you and never got to it.</h3></div>
        </div>
        <div class="mp-breaks-turn" data-animate data-delay="0.25">
          <p class="mp-couplet">More advertising doesn't fix lost demand.<br />Finding the failure point does.</p>
          <p><a href="/how-it-works/">See how it works &rarr;</a></p>
        </div>
      </div>
    </section>

    <!-- ═══ 5. OFFER (Hormozi §5): the Five-Part Demand Recovery Plan ═══ -->
    <section class="mp-plan" id="plan">
      <div class="mp-plan-inner">
        <p class="mp-eye" data-animate>Five-Part Demand Recovery Plan&trade;</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">Take the diagnostic. Get the plan. Implement it yourself or have EngageEngine&trade; do it for you.</h2>
        <p class="mp-plan-lede" data-animate data-delay="0.1">Start with the 12-question Demand Collapse Diagnostic&trade;. See your primary failure mode immediately. Qualified home-service companies can receive a personalized diagnosis, market snapshot, fix sequence, prescription and recovery sprint at no cost.</p>
        <ol class="mp-plan-list" data-animate data-delay="0.15">
          <li><strong>Demand Collapse Diagnosis.</strong> Which failure mode is costing you the most work, and why.</li>
          <li><strong>Market Demand and Buyer-Signal Snapshot.</strong> How demand is forming in your service area and where your marketing fails to connect.</li>
          <li><strong>Fix Sequence Priority Matrix.</strong> What to fix first, what comes next and what should wait.</li>
          <li><strong>Prescription.</strong> The recommended correction, including what not to do.</li>
          <li><strong>30-Day Recovery Sprint.</strong> Week-by-week actions, checkpoints and measurable targets.</li>
        </ol>
        <p class="mp-plan-keep" data-animate data-delay="0.2">You keep the plan whether or not you hire Marketing Performance Group.</p>
        <div class="mp-plan-cta" data-animate data-delay="0.25">
          <a href="/diagnostic/" class="mp-btn-primary" data-plan-cta="offer">Get Your Five-Part Demand Recovery Plan</a>
        </div>
      </div>
    </section>

    <!-- ═══ 6. RISK REVERSAL (Hormozi §6). No guarantee is offered; every line below is a stated term of the free plan. ═══ -->
    <section class="mp-risk">
      <div class="mp-risk-inner">
        <p class="mp-eye" data-animate>Your risk</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">You carry none of it.</h2>
        <ul class="mp-risk-list" data-animate data-delay="0.1">
          <li><strong>It costs nothing.</strong> Qualified companies receive the plan at no cost. No payment information.</li>
          <li><strong>No obligation.</strong> You don't have to hire Marketing Performance Group. That conversation happens only after you've seen the plan.</li>
          <li><strong>You keep it.</strong> All five documents are yours, whether you implement them yourself or ask us to.</li>
          <li><strong>No wasted time.</strong> If a direct competitor has already claimed your territory, Robbie tells you before preparing the full plan.</li>
        </ul>
      </div>
    </section>

    <!-- ═══ 8. CALL TO ACTION (Hormozi §8): one action ═══ -->
    <section class="mp-close">
      <h2 class="mp-close-h1" data-animate>Is your territory still open?</h2>
      <p class="mp-close-h2" data-animate data-delay="0.05">Find out in twelve questions.</p>
      <p class="mp-close-body" data-animate data-delay="0.15">We can't sell your market twice. That's the whole point. If your competitor claims it first, we start sending <em>him</em> the work.</p>
      <div class="mp-close-cta" data-animate data-delay="0.2">
        <a href="/diagnostic/" class="mp-btn-primary" data-plan-cta="close">Get Your Five-Part Demand Recovery Plan</a>
        <p class="mp-micro">Twelve questions. About ten minutes. Your preliminary result on screen, no email required.</p>
      </div>
    </section>

  </main>
  <Footer ctaHref="/diagnostic/" />
</Base>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-plan-cta]').forEach(a => a.addEventListener('click', () => {
    const w = window as any;
    if (typeof w.gtag === 'function') w.gtag('event', 'homepage_plan_cta_click', { location: a.dataset.planCta });
  }));
</script>

<script is:inline>
  // Muted-autoplay nudge for the hero video: start silent, retry once it can play.
  (function () {
    var v = document.querySelector('.mp-hero-video video');
    if (!v) return;
    v.muted = true;
    function go() { if (v.paused && !v.dataset.userPaused) { var p = v.play(); if (p && p.catch) p.catch(function () {}); } }
    v.addEventListener('canplay', go, { once: true });
    v.addEventListener('pause', function () { if (document.hasFocus && v.currentTime > 0.5) v.dataset.userPaused = '1'; });
    setTimeout(go, 1500);
  })();
</script>

<style>
  /* ═══════════════════════════════════════════════════════
     APPLE-FIDELITY HOMEPAGE. Hormozi rewrite v2.
     Tokens: Canvas White #f5f5f7 / Pure White #ffffff /
     Midnight Graphite #1d1d1f / Mid Gray #707070 /
     Interactive Blue #0071e3 / Border Silver #d6d6d6.
     Cards 0px radius. Images 8px. Buttons 980px pill.
     Shadow XL: rgba(0,0,0,0.22) 3px 5px 30px 0px.
     ═══════════════════════════════════════════════════════ */

  /* ─── Top nav (logo only) ─── */
  .mp-nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(255,255,255,0.72);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .mp-nav-inner {
    max-width: 1280px; margin: 0 auto;
    padding: 0 32px; height: 56px;
    display: flex; align-items: center;
  }
  .mp-logo {
    display: flex; align-items: center;
    min-height: 44px; text-decoration: none;
  }
  .mp-logo img { height: 44px; width: auto; display: block; }
  .mp-logo:hover { text-decoration: none; }
  @media (max-width: 600px) {
    .mp-logo img { height: 34px; }
  }

  /* ─── Page base ─── */
  .mp { background: var(--canvas); color: var(--graphite); }
  .mp h1, .mp h2 { font-family: var(--font-d); color: var(--graphite); }
  .mp p { color: var(--graphite); }
  .mp em { font-style: italic; }

  /* ─── Primary button (Apple Interactive Blue pill) ─── */
  .mp-btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--blue); color: #fff;
    font-family: var(--font-t); font-size: 17px;
    font-weight: 400; letter-spacing: -0.022em;
    padding: 12px 24px; border-radius: 980px;
    text-decoration: none; transition: background 0.2s;
    line-height: 1.2;
  }
  .mp-btn-primary:hover { background: var(--blue-link); text-decoration: none; color: #fff; }
  .mp-btn-primary::after {
    content: "→"; font-size: 17px; line-height: 1;
    transition: transform 0.2s;
  }
  .mp-btn-primary:hover::after { transform: translateX(3px); }

  /* ─── Eyebrows + headings ─── */
  .mp-eye {
    font-family: var(--font-t);
    font-size: 12px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--blue); margin-bottom: 16px;
  }
  .mp-h1 {
    font-family: var(--font-d);
    font-size: clamp(36px, 4.4vw, 56px);
    font-weight: 600; line-height: 1.05;
    letter-spacing: -0.022em; color: var(--graphite);
    margin-bottom: 14px;
  }
  .mp-h2 {
    font-family: var(--font-d);
    font-size: clamp(30px, 3.8vw, 44px);
    font-weight: 600; line-height: 1.1;
    letter-spacing: -0.018em; color: var(--graphite);
    margin-bottom: 20px;
    max-width: 780px;
  }
  .mp-lede {
    font-family: var(--font-t);
    font-size: 21px; line-height: 1.4;
    letter-spacing: -0.022em; color: var(--mid-gray);
    max-width: 680px;
  }
  .mp-micro {
    font-family: var(--font-t);
    font-size: 13px; color: var(--light-gray);
    letter-spacing: -0.015em;
  }
  .mp-micro strong { color: var(--graphite); font-weight: 600; }
  .mp-section-head { margin-bottom: 48px; }
  .mp-section-head.mp-center,
  .mp-h2.mp-center,
  .mp-eye.mp-center { text-align: center; }
  .mp-section-head.mp-center .mp-h2,
  .mp-section-head.mp-center .mp-lede { margin-left: auto; margin-right: auto; }
  .mp-h2.mp-center { margin-left: auto; margin-right: auto; }

  /* ─── 1. HERO ─── */
  .mp-hero {
    padding: 80px 32px 100px;
    background: var(--canvas);
  }
  .mp-hero-grid {
    max-width: 1320px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr; gap: 56px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .mp-hero-grid {
      grid-template-columns: minmax(360px, 520px) minmax(0, 1fr);
      gap: 64px;
    }
  }
  .mp-hero-copy { max-width: 540px; }
  .mp-hero-prose {
    display: flex; flex-direction: column;
    gap: 14px;
    max-width: 540px;
    margin-bottom: 32px;
  }
  .mp-hero-prose p {
    font-family: var(--font-t);
    font-size: 18px; line-height: 1.55;
    letter-spacing: -0.022em;
    color: var(--mid-gray);
  }
  .mp-hero-cta-block {
    display: flex; flex-direction: column;
    gap: 12px; align-items: flex-start;
  }

  /* Snapshot artifact. Actual product screenshot, framed Apple-style. */
  .mp-artifact {
    margin: 0;
    justify-self: stretch; width: 100%;
    display: flex; flex-direction: column; gap: 14px;
  }
  .mp-artifact-img {
    width: 100%; height: auto; display: block;
    border-radius: 8px;
    box-shadow: var(--shadow-xl, rgba(0,0,0,0.22) 3px 5px 30px 0px);
    background: var(--white);
  }
  .mp-artifact-cap {
    font-family: var(--font-t);
    font-size: 12px; font-weight: 400;
    letter-spacing: -0.015em;
    color: var(--light-gray);
    text-align: center;
  }
  @media (max-width: 1023px) {
    .mp-artifact { max-width: 100%; }
  }

  /* Hero VSL — vertical 9:16 (2026-10-01), capped so it never towers over the hero copy */
  .mp-hero-video {
    width: 100%;
    max-width: 280px;
    margin: 0 auto;
    background: #1d1d1f;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 9 / 16;
    box-shadow: var(--shadow-xl, rgba(0,0,0,0.22) 3px 5px 30px 0px);
  }
  .mp-hero-video video { width: 100%; height: 100%; display: block; object-fit: cover; }
  .mp-hero-video--wide { max-width: 640px; aspect-ratio: 16 / 9; }
  .mp-hero-video--slot {
    display: flex; align-items: center; justify-content: center; text-align: center;
    background: repeating-linear-gradient(45deg, #f5f5f7 0 12px, #e8e8ed 12px 24px);
    border: 2px dashed #b0b0b5; box-shadow: none;
    font-family: var(--font-t); font-size: 15px; font-weight: 600; color: var(--mid-gray);
  }
  @media (max-width: 768px) { .mp-hero-video { max-width: 280px; } }

  /* Proof-card styles now live in ProofCards.astro (shared by / and /snapshot). */
  @media (max-width: 768px) {
    /* The video stays on mobile, capped at 280px wide so it does not bury the case studies. */
    .mp-hero { padding-bottom: 8px; }
  }

  /* ─── 4b. CATCH ─── */
  .mp-catch { padding: 110px 32px; background: var(--white); border-top: 1px solid var(--border); }
  .mp-catch-inner { max-width: 760px; margin: 0 auto; }
  .mp-catch-lede {
    font-family: var(--font-t); font-size: 19px; line-height: 1.5;
    letter-spacing: -0.02em; color: var(--mid-gray); margin-bottom: 34px;
  }
  .mp-catch-list { list-style: none; padding: 0; margin: 0 0 34px; }
  .mp-catch-list li {
    font-family: var(--font-t); font-size: 17px; line-height: 1.55;
    letter-spacing: -0.015em; color: var(--graphite);
    padding: 20px 0 20px 34px; position: relative;
    border-top: 1px solid var(--border);
  }
  .mp-catch-list li:last-child { border-bottom: 1px solid var(--border); }
  .mp-catch-list li::before {
    content: ''; position: absolute; left: 4px; top: 29px;
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--blue, #0071e3);
  }
  .mp-catch-foot {
    font-family: var(--font-t); font-size: 17px; font-weight: 600;
    letter-spacing: -0.015em; color: var(--graphite);
  }

  /* ─── 2. PROBLEM ─── */
  .mp-problem {
    padding: 112px 32px;
    background: var(--white);
    border-top: 1px solid var(--border);
  }
  .mp-problem-inner {
    max-width: 780px; margin: 0 auto;
  }
  .mp-problem-prose {
    display: flex; flex-direction: column; gap: 20px;
    margin: 28px 0 36px;
  }
  .mp-problem-prose p {
    font-family: var(--font-t);
    font-size: 18px; line-height: 1.6;
    letter-spacing: -0.018em;
    color: var(--mid-gray);
  }
  .mp-problem-prose p strong {
    color: var(--graphite); font-weight: 600;
  }
  .mp-problem-punch {
    font-family: var(--font-d);
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 500; line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--graphite);
    border-left: 3px solid var(--blue);
    padding-left: 20px;
    margin-top: 8px;
  }

  /* ─── 3. SOLUTION ─── */
  .mp-solution {
    padding: 112px 32px;
    background: var(--canvas);
    border-top: 1px solid var(--border);
  }
  .mp-solution-inner {
    max-width: 780px; margin: 0 auto;
  }
  .mp-solution-prose {
    display: flex; flex-direction: column; gap: 20px;
    margin-top: 28px;
  }
  .mp-solution-prose p {
    font-family: var(--font-t);
    font-size: 18px; line-height: 1.6;
    letter-spacing: -0.018em;
    color: var(--graphite);
  }
  .mp-solution-prose p strong {
    color: var(--blue); font-weight: 600;
  }
  .mp-solution-more {
    margin-top: 32px;
    font-family: var(--font-t);
    font-size: 15px;
    letter-spacing: -0.015em;
  }
  .mp-text-link {
    display: inline-flex;
    align-items: baseline; gap: 6px;
    color: var(--blue-link);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.15s;
  }
  .mp-text-link:hover { color: var(--blue); }
  .mp-text-link-arrow {
