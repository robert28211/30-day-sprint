---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
---
<Base
  title="Find Your Profit Leak — EngageEngine™"
  description="You're losing the demand you already paid for before it becomes revenue. Free diagnostic finds exactly where. 2,401 businesses diagnosed. $529M+ in profit leaks found."
>
  <Nav />
  <main>

    <!-- ═══ HERO ═══ -->
    <section class="hero">
      <h1>The in-market buyers in your backyard are being served ads right now.</h1>
      <p class="hero-punch">None of them are yours.</p>
      <p class="hero-sub">We already know who's searching for your services in your market. Find out how many — and whether a competitor has already pulled this data.</p>
      <a href="https://marketingperformance.net/snapshot" class="btn btn-blue">See Who's Searching →</a>
      <p class="hero-micro">Free · No email required · Results in seconds</p>
    </section>

    <!-- ═══ PRODUCT VIDEO ═══ -->
    <div class="product-reveal">
      <p class="product-reveal-eyebrow">The System</p>
      <h2 class="product-reveal-headline">Inside the engine.</h2>
      <video autoplay muted loop playsinline>
        <source src="/ee-spin.mp4" type="video/mp4">
        <img src="/ee-explode.png" alt="EngageEngine">
      </video>
    </div>

    <!-- ═══ PROOF BAR ═══ -->
    <div class="proof-bar">
      <div class="proof-grid">
        <div class="proof-item">
          <div class="proof-label">Audience Segments</div>
          <div class="proof-value">45,000+</div>
          <div class="proof-unit">Intent signals, daily refresh</div>
        </div>
        <div class="proof-item">
          <div class="proof-label">Audience Refresh</div>
          <div class="proof-value">Daily</div>
          <div class="proof-unit">New segments every 24 hours</div>
        </div>
        <div class="proof-item">
          <div class="proof-label">Wasted Ad Spend</div>
          <div class="proof-value">67–90%</div>
          <div class="proof-unit">Less vs. platform-native targeting</div>
        </div>
        <div class="proof-item">
          <div class="proof-label">Attribution</div>
          <div class="proof-value">Closed<br>Loop</div>
          <div class="proof-unit">Conversion data feeds back in</div>
        </div>
      </div>
    </div>

    <!-- ═══ HOW IT WORKS ═══ -->
    <section class="engine">
      <div class="engine-header">
        <span class="engine-eyebrow">How It Works</span>
        <h2 class="engine-h2-gray">We don't guess who might buy from you.</h2>
        <p class="engine-h2-blue">We already know who's looking.</p>
        <div class="engine-prose">
          <p>Every day, homeowners in your market are searching for exactly what you do. Most of them haven't called anyone yet. They're still in the window.</p>
          <p>EngageEngine™ identifies those buyers by name and address while they're still deciding — and routes your ad spend directly to them across every channel before your competitors know they exist.</p>
        </div>
      </div>

      <p class="engine-bridge">The system runs five layers. Each one feeds the next.<br>The longer it runs, the harder it is to beat.</p>

      <img src="/ee-explode.png" alt="EngageEngine — Exploded View" class="engine-explode">

      <div class="modules">
        <div class="module">
          <div class="module-num">01</div>
          <div class="module-name">Intent Signal Engine</div>
          <div class="module-desc">45,000+ audience segments. We identify in-market buyers before they raise their hand.</div>
        </div>
        <div class="module">
          <div class="module-num">02</div>
          <div class="module-name">Audience Modeling</div>
          <div class="module-desc">Custom segments built daily. Matched to your service, geography, and buyer profile.</div>
        </div>
        <div class="module">
          <div class="module-num">03</div>
          <div class="module-name">Campaign Execution</div>
          <div class="module-desc">Google. Meta. Programmatic. Your ads in front of the right people across every channel simultaneously.</div>
        </div>
        <div class="module">
          <div class="module-num">04</div>
          <div class="module-name">Conversion Append</div>
          <div class="module-desc">Every closed job feeds back in. The system learns what a real customer looks like and gets sharper every week.</div>
        </div>
        <div class="module">
          <div class="module-num">05</div>
          <div class="module-name">Attribution Layer</div>
          <div class="module-desc">Full-funnel visibility. Every lead traced from first intent signal to closed job. You always know exactly what's working.</div>
        </div>
      </div>

      <div class="status-panel">
        <div class="status-head">// engageengine · system status</div>
        <div class="status-row">
          <span class="status-k">System Status</span>
          <span class="status-v">ACTIVE</span>
        </div>
        <div class="status-row">
          <span class="status-k">Cost Reduction</span>
          <span class="status-v">67–90%</span>
        </div>
        <div class="status-row">
          <span class="status-k">Attribution</span>
          <span class="status-v">CLOSED LOOP</span>
        </div>
        <div class="status-row">
          <span class="status-k">Audiences</span>
          <span class="status-v">REFRESHED DAILY</span>
        </div>
        <div class="status-row">
          <span class="status-k">Network</span>
          <span class="status-v status-v-accent">SYNCED</span>
        </div>
      </div>

      <p class="engine-stat-line">
        <strong>67–90% reduction</strong> in wasted ad spend &nbsp;·&nbsp;
        <strong>Closed-loop</strong> attribution &nbsp;·&nbsp;
        Audiences <strong>refreshed daily</strong>
      </p>
    </section>

    <!-- ═══ RESULTS ═══ -->
    <section class="results">
      <div class="wrap-wide">
        <div class="results-header">
          <h2 class="results-h2-line1">Six businesses. Six different problems.</h2>
          <p class="results-h2-line2">One system. Same result.</p>
        </div>
        <div class="results-grid">
          <div class="result-card">
            <p class="result-headline">$440K in sales. One week.</p>
            <p class="result-quote">"We diagnosed the problem — buyers found us but didn't trust what they saw. We tightened the trust signals. A hundred and twenty days later, we did $440,000 in sales in one week. Same traffic. Different result."</p>
            <p class="result-attr">— <strong>Bob Farnsworth</strong>, Landscape Charleston · Charleston, SC</p>
          </div>
          <div class="result-card">
            <p class="result-headline">170% more booked appointments. Same ad budget.</p>
            <p class="result-quote">"We were running ads, getting clicks, and losing people. They found the problem. Appointments jumped 170%. I haven't touched the budget since."</p>
            <p class="result-attr">— <strong>George Rogerson</strong>, McClintock HVAC · Charlotte, NC</p>
          </div>
          <div class="result-card">
            <p class="result-headline">Monthly sales tripled. Ad spend cut 60%.</p>
            <p class="result-quote">"We fixed the right problem. Monthly sales tripled. We're spending 60% less than before."</p>
            <p class="result-attr">— <strong>Bobby Wood</strong>, King's Fencing · Nashville, TN</p>
          </div>
          <div class="result-card">
            <p class="result-headline">No more seasonal slowdowns.</p>
            <p class="result-quote">"The phones ring. The jobs book. We don't have seasonal slowdowns anymore. And we're not spending any more than we were."</p>
            <p class="result-attr">— <strong>Ethan Del Priore</strong>, Carolina Stone Craftsman · Columbia, SC</p>
          </div>
          <div class="result-card">
            <p class="result-headline">Call volume down. Sales actually up.</p>
            <p class="result-quote">"Our call volume went down. Our sales went up. We're getting better customers — people who are actually ready to buy."</p>
            <p class="result-attr">— <strong>Larry Gates</strong>, Floor Pro · Columbia, SC</p>
          </div>
          <div class="result-card">
            <p class="result-headline">Close rates up. Price objections gone.</p>
            <p class="result-quote">"Our close rates jumped. The price conversations got easier. Buyers just stopped pushing back."</p>
            <p class="result-attr">— <strong>John Raz</strong>, Orange County Garage Doors · Tustin, CA</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ GUARANTEE ═══ -->
    <section class="guarantee">
      <div class="guarantee-inner">
        <span class="guarantee-eyebrow">The Guarantee</span>
        <h2>The guarantee nobody else in this industry will make.</h2>
        <div class="guarantee-body">
          <p>If EngageEngine™ doesn't deliver at least 2X our fee in closed revenue within 90 days — we keep working until it does. Free.</p>
          <p>We don't refund you and disappear. We stay. We fix. We run it until it works. Because if we can't find the buyers, we don't deserve to get paid.</p>
        </div>
        <p class="guarantee-track">31 years. Zero refunds.<br>That's not a pitch. That's a track record.</p>
        <a href="https://marketingperformance.net/snapshot" class="btn btn-blue">See Who's Searching in Your Market →</a>
      </div>
    </section>

    <!-- ═══ THE CLOSE ═══ -->
    <section class="close-section">
      <h2 class="close-h2-line1">The buyers are already in your market.</h2>
      <p class="close-h2-line2">The only question is who gets to them first.</p>
      <p class="close-body">Every day this runs without you, a competitor is capturing demand that should be yours. The snapshot takes ten seconds. No email. No sales call. Just your data.</p>
      <a href="https://marketingperformance.net/snapshot" class="btn btn-blue">See Who's Searching →</a>
      <p class="close-micro">Free · No email required · Results in seconds</p>
    </section>

  </main>
  <Footer />
</Base>

<style>
  /* ─── Hero ─── */
  .hero {
    background: var(--canvas);
    padding: 80px 22px 72px;
    text-align: center;
  }
  .hero h1 {
    font-family: var(--font-d);
    font-size: clamp(36px, 5.5vw, 52px);
    font-weight: 600;
    line-height: 1.07;
    letter-spacing: -0.005em;
    color: var(--graphite);
    max-width: 680px;
    margin: 0 auto 6px;
  }
  .hero-punch {
    font-family: var(--font-d);
    font-size: clamp(36px, 5.5vw, 52px);
    font-weight: 600;
    line-height: 1.07;
    letter-spacing: -0.005em;
    color: var(--blue);
    max-width: 680px;
    margin: 0 auto 28px;
  }
  .hero-sub {
    font-size: 19px;
    font-weight: 400;
    line-height: 1.47;
    letter-spacing: -0.022em;
    color: var(--mid-gray);
    max-width: 500px;
    margin: 0 auto 36px;
  }
  .hero-micro {
    font-size: 13px;
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.015em;
    color: var(--light-gray);
    margin-top: 14px;
  }

  /* ─── Product reveal ─── */
  .product-reveal {
    background: var(--canvas);
    padding: 52px 22px 70px;
    text-align: center;
  }
  .product-reveal-eyebrow {
    font-size: 11px; font-weight: 600; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--blue);
    margin-bottom: 10px;
  }
  .product-reveal-headline {
    font-family: var(--font-d); font-size: clamp(28px, 3.5vw, 40px);
    font-weight: 600; letter-spacing: -0.005em; line-height: 1.1;
    color: var(--graphite); margin-bottom: 36px;
  }
  .product-reveal video,
  .product-reveal img {
    width: 100%; max-width: 860px; margin: 0 auto;
    border-radius: var(--r-img);
  }

  /* ─── Proof bar ─── */
  .proof-bar {
    background: var(--white);
    border-top: 1px solid var(--silver);
    border-bottom: 1px solid var(--silver);
    padding: 40px 22px;
  }
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--silver);
    max-width: 980px;
    margin: 0 auto;
  }
  .proof-item {
    background: var(--white);
    padding: 28px 22px;
    text-align: center;
  }
  .proof-label {
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--mid-gray); margin-bottom: 10px;
  }
  .proof-value {
    font-family: var(--font-d);
    font-size: 32px; font-weight: 600;
    letter-spacing: -0.005em; line-height: 1.1;
    color: var(--blue);
  }
  .proof-unit {
    font-size: 13px; font-weight: 400;
    letter-spacing: -0.015em; color: var(--mid-gray);
    margin-top: 8px; line-height: 1.4;
  }

  /* ─── Engine / How it works ─── */
  .engine {
    background: var(--canvas);
    padding: 120px 22px;
    border-top: 1px solid var(--silver);
  }
  .engine-header { text-align: center; margin-bottom: 72px; }
  .engine-eyebrow {
    font-size: 17px; font-weight: 600;
    letter-spacing: -0.022em; color: var(--blue);
    display: block; margin-bottom: 8px;
  }
  .engine-h2-gray {
    font-family: var(--font-d);
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 600; line-height: 1.08;
    letter-spacing: -0.005em;
    color: var(--mid-gray); margin-bottom: 4px;
  }
  .engine-h2-blue {
    font-family: var(--font-d);
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 600; line-height: 1.08;
    letter-spacing: -0.005em;
    color: var(--graphite); margin-bottom: 40px;
  }
  .engine-prose {
    max-width: 620px; margin: 0 auto;
    display: flex; flex-direction: column; gap: 20px;
  }
  .engine-prose p {
    font-size: 17px; font-weight: 400;
    line-height: 1.6; letter-spacing: -0.022em;
    color: var(--mid-gray);
  }
  .engine-bridge {
    font-family: var(--font-d);
    font-size: 24px; font-weight: 600;
    line-height: 1.19; letter-spacing: -0.01em;
    color: var(--graphite);
    max-width: 620px; margin: 0 auto 64px;
    text-align: center;
  }
  .engine-explode {
    width: 100%;
    max-width: 900px; margin: 0 auto 64px;
    border-radius: var(--r-img);
  }
  .modules {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px; background: var(--silver);
    max-width: 980px; margin: 0 auto 64px;
  }
  .module {
    background: var(--white);
    padding: 32px 22px; text-align: left;
  }
  .module-num {
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--blue); margin-bottom: 10px;
  }
  .module-name {
    font-size: 14px; font-weight: 600;
    letter-spacing: -0.018em; color: var(--graphite);
    margin-bottom: 8px; line-height: 1.3;
  }
  .module-desc {
    font-size: 13px; font-weight: 400;
    letter-spacing: -0.015em; color: var(--mid-gray);
    line-height: 1.5;
  }
  .status-panel {
    background: var(--white);
    border: 1px solid var(--silver);
    border-radius: 16px;
    padding: 36px 44px;
    max-width: 480px; margin: 0 auto 52px;
    text-align: left; font-family: var(--font-m);
  }
  .status-head {
    font-size: 10px; letter-spacing: 0.15em; text-transform: uppercase;
    color: var(--light-gray);
    margin-bottom: 20px; padding-bottom: 16px;
    border-bottom: 1px solid var(--silver);
  }
  .status-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 11px 0; border-bottom: 1px solid var(--silver);
  }
  .status-row:last-child { border-bottom: none; }
  .status-k {
    font-size: 11px; letter-spacing: 0.08em;
    color: var(--mid-gray); text-transform: uppercase;
  }
  .status-v {
    font-size: 13px; font-weight: 600;
    color: var(--blue); letter-spacing: 0.06em;
  }
  .status-v-accent { color: #ec893c; }
  .engine-stat-line {
    font-size: 17px; font-weight: 400;
    letter-spacing: -0.022em; color: var(--mid-gray);
    text-align: center; max-width: 560px; margin: 0 auto;
  }
  .engine-stat-line strong { font-weight: 600; color: var(--graphite); }

  /* ─── Results ─── */
  .results {
    background: var(--white);
    padding: var(--gap) 22px;
    border-top: 1px solid var(--silver);
  }
  .results-header {
    margin-bottom: 60px;
    text-align: center;
  }
  .results-h2-line1 {
    font-family: var(--font-d);
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 600; line-height: 1.08;
    letter-spacing: -0.005em;
    color: var(--graphite); margin-bottom: 4px;
  }
  .results-h2-line2 {
    font-family: var(--font-d);
    font-size: clamp(32px, 4.5vw, 48px);
    font-weight: 600; line-height: 1.08;
    letter-spacing: -0.005em;
    color: var(--blue);
  }
  .results-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px; background: var(--silver);
  }
  .result-card {
    background: var(--white);
    padding: 40px 36px;
    display: flex; flex-direction: column;
  }
  .result-headline {
    font-family: var(--font-d);
    font-size: 19px; font-weight: 600;
    line-height: 1.19; letter-spacing: -0.022em;
    color: var(--graphite); margin-bottom: 18px;
  }
  .result-quote {
    font-size: 15px; font-weight: 400;
    line-height: 1.53; letter-spacing: -0.018em;
    color: var(--mid-gray); font-style: italic;
    flex: 1; margin-bottom: 20px;
  }
  .result-attr {
    font-size: 13px; font-weight: 400;
    letter-spacing: -0.015em; color: var(--light-gray);
    border-top: 1px solid var(--silver); padding-top: 16px;
  }
  .result-attr strong { font-weight: 600; color: var(--graphite); }

  /* ─── Guarantee ─── */
  .guarantee {
    background: #9fc6f4;
    padding: var(--gap) 22px;
  }
  .guarantee-inner { max-width: 680px; margin: 0 auto; }
  .guarantee-eyebrow {
    font-size: 17px; font-weight: 600;
    letter-spacing: -0.022em; color: var(--blue-link);
    display: block; margin-bottom: 8px;
  }
  .guarantee h2 {
    font-family: var(--font-d);
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 600; line-height: 1.08;
    letter-spacing: -0.005em;
    color: var(--graphite); margin-bottom: 32px;
  }
  .guarantee-body {
    display: flex; flex-direction: column; gap: 18px;
    margin-bottom: 36px;
  }
  .guarantee-body p {
    font-size: 17px; font-weight: 400;
    line-height: 1.6; letter-spacing: -0.022em;
    color: var(--graphite);
  }
  .guarantee-track {
    font-family: var(--font-d);
    font-size: 21px; font-weight: 600;
    letter-spacing: -0.01em; color: var(--graphite);
    margin-bottom: 36px;
  }

  /* ─── The Close ─── */
  .close-section {
    background: var(--canvas);
    padding: 120px 22px;
    border-top: 1px solid var(--silver);
    text-align: center;
  }
  .close-h2-line1 {
    font-family: var(--font-d);
    font-size: clamp(36px, 5.5vw, 56px);
    font-weight: 600; line-height: 1.07;
    letter-spacing: -0.005em;
    color: var(--graphite); margin-bottom: 4px;
  }
  .close-h2-line2 {
    font-family: var(--font-d);
    font-size: clamp(36px, 5.5vw, 56px);
    font-weight: 600; line-height: 1.07;
    letter-spacing: -0.005em;
    color: var(--blue); margin-bottom: 28px;
  }
  .close-body {
    font-size: 19px; font-weight: 400;
    line-height: 1.47; letter-spacing: -0.022em;
    color: var(--mid-gray);
    max-width: 500px; margin: 0 auto 44px;
  }
  .close-micro {
    font-size: 13px; font-weight: 400;
    letter-spacing: -0.015em; color: var(--light-gray);
    margin-top: 14px;
  }

  /* ─── Responsive ─── */
  @media (max-width: 900px) {
    .modules { grid-template-columns: repeat(3, 1fr); }
    .proof-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .results-grid { grid-template-columns: 1fr; }
    .engine { padding: 80px 22px; }
    .status-panel { padding: 28px; }
  }
  @media (max-width: 600px) {
    .modules { grid-template-columns: repeat(2, 1fr); }
    .proof-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .hero { padding: 52px 16px 52px; }
    .modules { grid-template-columns: 1fr; }
    .result-card { padding: 28px 20px; }
  }
</style>
