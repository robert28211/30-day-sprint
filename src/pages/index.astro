---
import Base from '../layouts/Base.astro'
import Footer from '../components/Footer.astro'
import DemandEngine from '../components/DemandEngine.astro'
import ProofCards from '../components/ProofCards.astro'

// Share-Line proof wall (home). Numbers sourced from share-line-job-counts-variable-growth.csv
// (jobs 2023 -> 2025 total growth). Verified, market-volume comparator flat-to-contracting.
const homeCards = [
  { trade: 'Landscaping',      loc: 'Columbia',              num: '+40%', unit: 'more jobs',     market: 'in a flat market', down: false },
  { trade: 'Roofing',          loc: 'Columbia',              num: '+23%', unit: 'more jobs',     market: 'in a flat market', down: false },
  { trade: 'Plumbing',         loc: 'Columbia',              num: '+29%', unit: 'more jobs',     market: 'in a flat market', down: false },
  { trade: 'Fencing',          loc: 'Columbia & Charleston', num: '+25%', unit: 'more jobs',     market: 'in a flat market', down: false },
  { trade: 'Gutters',          loc: 'Columbia & Florence',   num: '+22%', unit: 'more jobs',     market: 'in a flat market', down: false },
  { trade: 'Painting',         loc: 'Columbia',              num: '+20%', unit: 'more jobs',     market: 'in a flat market', down: false },
  { trade: 'Windows & doors',  loc: 'Columbia',              num: '+16%', unit: 'more jobs',     market: 'while the market shrank', down: true },
  { trade: 'Pools',            loc: 'Midlands',              num: '+26%', unit: 'more installs', market: 'while pools fell 50%', down: true },
  { trade: 'Metal roofing',    loc: 'SC & GA',               num: '+30%', unit: 'more sold',     market: 'while the market shrank 15–25%', down: true },
];
---
<Base
  title="Marketing Performance Group — Your Market's Jobs, Minus Your Competitor"
  description="The home-services market barely added a job in three years. The growth was price, not more work. Yet our clients booked double-digit more jobs, taken off their competitors' schedules. One company per trade, per market. 41 years in the industry, 31 running Marketing Performance."
>
  <!-- Minimal top nav. Logo only. Everything else moved to footer. -->
  <nav class="mp-nav">
    <div class="mp-nav-inner">
      <a href="/" class="mp-logo">
        Marketing Performance Group
        <span class="mp-logo-sub">Powered by EngageEngine™</span>
      </a>
    </div>
  </nav>

  <main class="mp">

    <!-- ═══ 1. HERO ═══ -->
    <section class="mp-hero">
      <div class="mp-hero-grid">
        <div class="mp-hero-copy">
          <h1 class="mp-h1">
            <span class="hero-word">Your </span>
            <span class="hero-word">market </span>
            <span class="hero-word">didn't </span>
            <span class="hero-word">grow </span>
            <span class="hero-word">last </span>
            <span class="hero-word">year.</span><br />
            <span class="hero-word">Somebody's </span>
            <span class="hero-word">schedule </span>
            <span class="hero-word">did.</span>
          </h1>
          <div class="mp-hero-prose hero-sub">
            <p>The growth everyone talks about is just prices going up. The number of actual jobs barely moved.</p>
            <p>So when the guy across town gets busier, that work is coming off your schedule. We put it back on yours, and lock him out. One company per trade, per market.</p>
          </div>

          <div class="hero-cta mp-hero-cta-block">
            <a href="/snapshot" class="mp-btn-primary">See if your trade is still open</a>
            <p class="mp-micro"><strong>41 years in the industry. 31 running Marketing Performance.</strong></p>
          </div>
        </div>

        <!-- Divergence chart. Market flat, one contractor climbing. -->
        <figure class="mp-artifact">
          <div class="mp-chart" role="img" aria-label="Chart. Over three years the market stays flat while one contractor's completed jobs climb about 40 percent higher.">
            <svg viewBox="0 0 680 470" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
              <defs>
                <linearGradient id="mpYouFill" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#0071e3" stop-opacity="0.16" />
                  <stop offset="100%" stop-color="#0071e3" stop-opacity="0" />
                </linearGradient>
              </defs>
              <!-- title -->
              <text x="34" y="42" class="mp-c-title">RELATIVE JOBS COMPLETED</text>
              <text x="34" y="62" class="mp-c-sub">Indexed to start = 100</text>
              <!-- legend -->
              <line x1="34" y1="92" x2="66" y2="92" class="mp-c-line-you" />
              <text x="74" y="97" class="mp-c-leg">THIS CONTRACTOR</text>
              <line x1="250" y1="92" x2="282" y2="92" class="mp-c-line-mkt" />
              <text x="290" y="97" class="mp-c-leg mp-c-leg-mkt">THE MARKET</text>
              <!-- gridlines -->
              <line x1="90" y1="140" x2="646" y2="140" class="mp-c-grid" />
              <line x1="90" y1="252" x2="646" y2="252" class="mp-c-grid mp-c-grid-base" />
              <line x1="90" y1="364" x2="646" y2="364" class="mp-c-grid" />
              <!-- market line: flat -->
              <polyline points="90,252 275,254 460,258 620,252" class="mp-c-line-mkt" fill="none" />
              <circle cx="620" cy="252" r="4" class="mp-c-dot-mkt" />
              <!-- area fill under contractor line -->
              <polygon points="90,252 275,196 460,156 620,124 620,364 90,364" fill="url(#mpYouFill)" />
              <!-- contractor line: climbing -->
              <polyline points="90,252 275,196 460,156 620,124" class="mp-c-line-you" fill="none" />
              <circle cx="620" cy="124" r="5" class="mp-c-dot-you" />
              <!-- callout -->
              <g class="mp-c-callout">
                <rect x="452" y="70" width="196" height="46" rx="6" />
                <text x="466" y="93" class="mp-c-call-1">+40% more jobs.</text>
                <text x="466" y="108" class="mp-c-call-2">Same market. Same prices.</text>
              </g>
              <!-- x labels -->
              <text x="90" y="404" class="mp-c-x">START</text>
              <text x="275" y="404" class="mp-c-x" text-anchor="middle">YEAR 1</text>
              <text x="460" y="404" class="mp-c-x" text-anchor="middle">YEAR 2</text>
              <text x="620" y="404" class="mp-c-x" text-anchor="end">YEAR 3</text>
            </svg>
          </div>
          <figcaption class="mp-artifact-cap">Verified client. Jobs completed, not revenue.</figcaption>
        </figure>
      </div>
    </section>

    <!-- ═══ 1b. PROOF CARDS (Share Line) ═══ -->
    <ProofCards
      cards={homeCards}
      video={{ src: '/video/hub/hero-vsl.mp4', poster: '/video/hub/hero-vsl-poster.jpg', label: 'Watch: why your phone isn’t ringing · 60 seconds' }}
      foot="Every one of those jobs came off a competitor's schedule. One company per trade, per market."
    />

    <!-- ═══ 2. PROBLEM ═══ -->
    <section class="mp-problem">
      <div class="mp-problem-inner">
        <p class="mp-eye" data-animate>The Problem</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">The market isn't making new work. Everyone's fighting over the same jobs.</h2>
        <div class="mp-problem-prose" data-animate data-delay="0.1">
          <p>The number of homeowners hiring your trade barely moved in three years. The growth everyone talks about was just prices going up. So the work is basically fixed, and everybody is scrambling for the same slice.</p>
          <p>Angi and HomeAdvisor sell the same lead to four of you at once, so you race to dial first and quote against three guys who'll always go cheaper. Zip-code ads pay Google and Facebook to put you in front of renters, tire-kickers, and the guy who replaced his roof last spring.</p>
          <p>Here's the math nobody puts on the sales call. Fewer than <strong>3 in 100</strong> households will hire your trade this quarter. Old-way ads pay to reach all 100. Shared-lead platforms make you knife-fight over the 3.</p>
        </div>
        <p class="mp-problem-punch" data-animate data-delay="0.15">Both models get paid whether you close a job or not. You're not their customer. You're their inventory. Meanwhile the contractor who locked his market is quietly booking the jobs off everyone else's schedule.</p>
      </div>
    </section>

    <!-- ═══ 3. SOLUTION ═══ -->
    <section class="mp-solution">
      <div class="mp-solution-inner">
        <p class="mp-eye" data-animate>The Solution</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">We lock your market. Then we point the work at you.</h2>
        <div class="mp-solution-prose" data-animate data-delay="0.1">
          <p><strong>One company per trade, per market.</strong> The day you claim yours, your competitor can't. That is the product, not a bonus.</p>
          <p>Here's how we deliver it. Every homeowner leaves a trail before they call anyone: the searches, the review pages, the three sites they check in a week. <strong>EngageEngine™</strong> reads who in your area is actually deciding right now and puts your ads in front of only them, on Google, on Facebook, on YouTube. You stop paying to reach the 97 who were never going to call and reach the few who will.</p>
          <p>And because the seat is yours alone, every job it produces is a job the guy across town didn't get. That is what taking your market looks like.</p>
        </div>
      </div>
    </section>

    <!-- ═══ 4. THE ENGINE (interactive mechanism reveal) ═══ -->
    <DemandEngine />

    <!-- Founder block removed 2026-07-17: off-aesthetic, belongs to a deeper page. -->
    <!-- Value Stack removed 2026-07-17: discounty price-anchor + names pitch, off the new positioning. -->

    <!-- ═══ 5. GUARANTEE ═══ -->
    <section class="mp-guarantee">
      <div class="mp-section-head mp-center">
        <p class="mp-eye" data-animate>The Guarantee</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">The 2X Revenue Guarantee.</h2>
      </div>

      <div class="mp-guarantee-card" data-animate data-delay="0.1">
        <div class="mp-guarantee-badge">
          <span class="mp-badge-check">✓</span>
          <span>2X Revenue Guarantee</span>
        </div>
        <p class="mp-guarantee-lead">If the system doesn't put at least twice your investment back in your pocket as closed revenue within 30 days, we keep working for free until it does. The guarantee is on our fee, not your ad spend.</p>
        <p class="mp-guarantee-body">You risk nothing but the 30 seconds it takes to look at your market.</p>
      </div>
    </section>

    <!-- ═══ 7. FINAL CTA ═══ -->
    <section class="mp-close">
      <h2 class="mp-close-h1" data-animate>One company per trade, per market.</h2>
      <p class="mp-close-h2" data-animate data-delay="0.05">Is your territory still open?</p>
      <p class="mp-close-body" data-animate data-delay="0.1">We can't sell your market twice. That's the whole point. If your competitor claims it first, we start sending <em>him</em> the work.</p>
      <div class="mp-close-cta" data-animate data-delay="0.2">
        <a href="/snapshot" class="mp-btn-primary">See If My Trade Is Still Open</a>
        <p class="mp-micro">Free. No email required. Takes 30 seconds.</p>
      </div>
    </section>

  </main>
  <Footer />
</Base>

<style>
  /* ═══════════════════════════════════════════════════════
     APPLE-FIDELITY HOMEPAGE. Hormozi rewrite v2.
     Tokens: Canvas White #f5f5f7 / Pure White #ffffff /
     Midnight Graphite #1d1d1f / Mid Gray #707070 /
     Interactive Blue #0071e3 / Border Silver #d6d6d6.
     Cards 0px radius. Images 8px. Buttons 980px pill.
     Shadow XL: rgba(0,0,0,0.22) 3px 5px 30px 0px.
     ═══════════════════════════════════════════════════════ */

  /* ─── Top nav (logo only) ─── */
  .mp-nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(255,255,255,0.72);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .mp-nav-inner {
    max-width: 1280px; margin: 0 auto;
    padding: 0 32px; height: 56px;
    display: flex; align-items: center;
  }
  .mp-logo {
    font-family: var(--font-t);
    font-size: 13px; font-weight: 600;
    letter-spacing: -0.01em; color: var(--graphite);
    text-decoration: none;
    display: flex; flex-direction: column; gap: 1px;
    min-height: 44px; justify-content: center;
  }
  .mp-logo:hover { color: var(--graphite); text-decoration: none; }
  .mp-logo-sub {
    font-size: 10px; font-weight: 400;
    letter-spacing: 0.02em; color: var(--mid-gray);
  }

  /* ─── Page base ─── */
  .mp { background: var(--canvas); color: var(--graphite); }
  .mp h1, .mp h2 { font-family: var(--font-d); color: var(--graphite); }
  .mp p { color: var(--graphite); }
  .mp em { font-style: italic; }

  /* ─── Primary button (Apple Interactive Blue pill) ─── */
  .mp-btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--blue); color: #fff;
    font-family: var(--font-t); font-size: 17px;
    font-weight: 400; letter-spacing: -0.022em;
    padding: 12px 24px; border-radius: 980px;
    text-decoration: none; transition: background 0.2s;
    line-height: 1.2;
  }
  .mp-btn-primary:hover { background: var(--blue-link); text-decoration: none; color: #fff; }
  .mp-btn-primary::after {
    content: "→"; font-size: 17px; line-height: 1;
    transition: transform 0.2s;
  }
  .mp-btn-primary:hover::after { transform: translateX(3px); }

  /* ─── Eyebrows + headings ─── */
  .mp-eye {
    font-family: var(--font-t);
    font-size: 12px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--blue); margin-bottom: 16px;
  }
  .mp-h1 {
    font-family: var(--font-d);
    font-size: clamp(36px, 4.4vw, 56px);
    font-weight: 600; line-height: 1.05;
    letter-spacing: -0.022em; color: var(--graphite);
    margin-bottom: 14px;
  }
  .mp-h2 {
    font-family: var(--font-d);
    font-size: clamp(30px, 3.8vw, 44px);
    font-weight: 600; line-height: 1.1;
    letter-spacing: -0.018em; color: var(--graphite);
    margin-bottom: 20px;
    max-width: 780px;
  }
  .mp-lede {
    font-family: var(--font-t);
    font-size: 21px; line-height: 1.4;
    letter-spacing: -0.022em; color: var(--mid-gray);
    max-width: 680px;
  }
  .mp-micro {
    font-family: var(--font-t);
    font-size: 13px; color: var(--light-gray);
    letter-spacing: -0.015em;
  }
  .mp-micro strong { color: var(--graphite); font-weight: 600; }
  .mp-section-head { margin-bottom: 48px; }
  .mp-section-head.mp-center,
  .mp-h2.mp-center,
  .mp-eye.mp-center { text-align: center; }
  .mp-section-head.mp-center .mp-h2,
  .mp-section-head.mp-center .mp-lede { margin-left: auto; margin-right: auto; }
  .mp-h2.mp-center { margin-left: auto; margin-right: auto; }

  /* ─── 1. HERO ─── */
  .mp-hero {
    padding: 80px 32px 100px;
    background: var(--canvas);
  }
  .mp-hero-grid {
    max-width: 1320px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr; gap: 56px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .mp-hero-grid {
      grid-template-columns: minmax(360px, 520px) minmax(0, 1fr);
      gap: 64px;
    }
  }
  .mp-hero-copy { max-width: 540px; }
  .mp-hero-prose {
    display: flex; flex-direction: column;
    gap: 14px;
    max-width: 540px;
    margin-bottom: 32px;
  }
  .mp-hero-prose p {
    font-family: var(--font-t);
    font-size: 18px; line-height: 1.55;
    letter-spacing: -0.022em;
    color: var(--mid-gray);
  }
  .mp-hero-cta-block {
    display: flex; flex-direction: column;
    gap: 12px; align-items: flex-start;
  }

  /* Snapshot artifact. Actual product screenshot, framed Apple-style. */
  .mp-artifact {
    margin: 0;
    justify-self: stretch; width: 100%;
    display: flex; flex-direction: column; gap: 14px;
  }
  .mp-artifact-img {
    width: 100%; height: auto; display: block;
    border-radius: 8px;
    box-shadow: var(--shadow-xl, rgba(0,0,0,0.22) 3px 5px 30px 0px);
    background: var(--white);
  }
  .mp-artifact-cap {
    font-family: var(--font-t);
    font-size: 12px; font-weight: 400;
    letter-spacing: -0.015em;
    color: var(--light-gray);
    text-align: center;
  }
  @media (max-width: 1023px) {
    .mp-artifact { max-width: 100%; }
  }

  /* Divergence chart (replaces snapshot image) */
  .mp-chart {
    width: 100%;
    background: var(--white);
    border-radius: 8px;
    box-shadow: var(--shadow-xl, rgba(0,0,0,0.22) 3px 5px 30px 0px);
    padding: 20px 24px 8px;
  }
  .mp-chart svg { width: 100%; height: auto; display: block; }
  .mp-c-title { font-family: var(--font-t); font-size: 13px; font-weight: 600; letter-spacing: 0.06em; fill: var(--graphite); }
  .mp-c-sub   { font-family: var(--font-t); font-size: 12px; fill: var(--light-gray); }
  .mp-c-leg   { font-family: var(--font-t); font-size: 12px; font-weight: 600; letter-spacing: 0.04em; fill: var(--graphite); }
  .mp-c-leg-mkt { fill: var(--mid-gray); font-weight: 500; }
  .mp-c-x     { font-family: var(--font-t); font-size: 11px; letter-spacing: 0.04em; fill: var(--light-gray); }
  .mp-c-grid  { stroke: #ececec; stroke-width: 1; }
  .mp-c-grid-base { stroke: #dedede; stroke-dasharray: 3 4; }
  .mp-c-line-you { stroke: var(--blue); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .mp-c-line-mkt { stroke: #c4c4c4; stroke-width: 2.75; stroke-linecap: round; stroke-linejoin: round; }
  .mp-c-dot-you { fill: var(--blue); }
  .mp-c-dot-mkt { fill: #c4c4c4; }
  .mp-c-callout rect { fill: var(--white); stroke: var(--border); stroke-width: 1; }
  .mp-c-call-1 { font-family: var(--font-t); font-size: 14px; font-weight: 700; fill: var(--graphite); }
  .mp-c-call-2 { font-family: var(--font-t); font-size: 12px; fill: var(--mid-gray); }

  /* Proof-card styles now live in ProofCards.astro (shared by / and /snapshot). */
  @media (max-width: 768px) {
    /* Chart is too tall on phones and buries the cards below the fold.
       Drop it on mobile; the cards carry the proof there. */
    .mp-artifact { display: none; }
    .mp-hero { padding-bottom: 8px; }
  }

  /* ─── 2. PROBLEM ─── */
  .mp-problem {
    padding: 112px 32px;
    background: var(--white);
    border-top: 1px solid var(--border);
  }
  .mp-problem-inner {
    max-width: 780px; margin: 0 auto;
  }
  .mp-problem-prose {
    display: flex; flex-direction: column; gap: 20px;
    margin: 28px 0 36px;
  }
  .mp-problem-prose p {
    font-family: var(--font-t);
    font-size: 18px; line-height: 1.6;
    letter-spacing: -0.018em;
    color: var(--mid-gray);
  }
  .mp-problem-prose p strong {
    color: var(--graphite); font-weight: 600;
  }
  .mp-problem-punch {
    font-family: var(--font-d);
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 500; line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--graphite);
    border-left: 3px solid var(--blue);
    padding-left: 20px;
    margin-top: 8px;
  }

  /* ─── 3. SOLUTION ─── */
  .mp-solution {
    padding: 112px 32px;
    background: var(--canvas);
    border-top: 1px solid var(--border);
  }
  .mp-solution-inner {
    max-width: 780px; margin: 0 auto;
  }
  .mp-solution-prose {
    display: flex; flex-direction: column; gap: 20px;
    margin-top: 28px;
  }
  .mp-solution-prose p {
    font-family: var(--font-t);
    font-size: 18px; line-height: 1.6;
    letter-spacing: -0.018em;
    color: var(--graphite);
  }
  .mp-solution-prose p strong {
    color: var(--blue); font-weight: 600;
  }
  .mp-solution-more {
    margin-top: 32px;
    font-family: var(--font-t);
    font-size: 15px;
    letter-spacing: -0.015em;
  }
  .mp-text-link {
    display: inline-flex;
    align-items: baseline; gap: 6px;
    color: var(--blue-link);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.15s;
  }
  .mp-text-link:hover { color: var(--blue); }
  .mp-text-link-arrow {
    display: inline-block;
    transition: transform 0.2s;
  }
  .mp-text-link:hover .mp-text-link-arrow {
    transform: translateX(3px);
  }

  /* ─── 4. PROOF ─── */
  .mp-proof-section {
    padding: 112px 32px;
    background: var(--white);
    border-top: 1px solid var(--border);
  }
  .mp-proof-block {
    max-width: 780px; margin: 0 auto;
  }
  .mp-proof-feature {
    display: flex; align-items: center; gap: 24px;
    padding: 28px 32px;
    background: var(--canvas);
    margin: 32px 0 40px;
    border-left: 2px solid var(--blue);
  }
  .mp-anchor-photo {
    width: 80px; height: 80px;
    border-radius: 50%;
    background: var(--canvas);
    border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-d);
    font-size: 22px; font-weight: 600;
    color: var(--mid-gray);
    flex-shrink: 0;
    overflow: hidden;
  }
  .mp-anchor-photo img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .mp-anchor-attr {
    font-family: var(--font-t);
    font-size: 14px; color: var(--mid-gray);
    margin-bottom: 8px; letter-spacing: -0.018em;
  }
  .mp-anchor-attr strong { color: var(--graphite); font-weight: 600; }
  .mp-anchor-stats {
    font-family: var(--font-t);
    font-size: 13px; color: var(--blue-link);
    letter-spacing: -0.015em;
    display: flex; flex-wrap: wrap; gap: 8px;
  }
  .mp-anchor-stats strong { font-weight: 600; }
  .mp-dot { color: var(--light-gray); }
  .mp-proof-stack {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 22px;
  }
  .mp-proof-stack > li {
    font-family: var(--font-t);
    font-size: 17px; line-height: 1.55;
    letter-spacing: -0.018em;
    color: var(--graphite);
    padding-left: 24px;
    position: relative;
  }
  .mp-proof-stack > li::before {
    content: "→";
    position: absolute; left: 0; top: 0;
    color: var(--blue); font-weight: 700;
  }
  .mp-proof-stack > li strong { font-weight: 600; }
  .mp-proof-founder {
