---
import Base from '../../layouts/Base.astro'
import Nav from '../../components/Nav.astro'
import Footer from '../../components/Footer.astro'
---
<Base
  title="AI Visibility Score — Is AI Sending Your Customers Somewhere Else?"
  description="Find out your AI Visibility Score in 60 seconds. Free diagnostic for home service businesses. See exactly where AI is sending the buyers you already paid to reach."
>
  <Nav />

  <!-- ══════════════════════════════════════════════════════
       LANDING VIEW — Hormozi framework
       ══════════════════════════════════════════════════════ -->
  <div id="landing-view">
    <main>

      <!-- ═══ SECTION 1: HOOK ═══ -->
      <section class="s-hook">
        <div class="hook-wrap">
          <p class="eyebrow" data-animate>DVS™ — AI Visibility Diagnostic</p>
          <h1 class="hook-h1" data-animate data-delay="0.05">
            <span>AI just gave your competitor</span>
            <span class="hook-h1-blue">the job you paid to win.</span>
          </h1>
          <p class="hook-sub" data-animate data-delay="0.12">
            Find out your AI Visibility Score — and exactly which gap is costing you the most business right now.
          </p>
          <div class="hook-cta" data-animate data-delay="0.2">
            <a href="#score-form" class="btn btn-blue hook-btn">Get My Free Score →</a>
            <p class="hook-micro">Free &nbsp;·&nbsp; 60 seconds &nbsp;·&nbsp; No pitch</p>
          </div>
          <div class="hook-proof" data-animate data-delay="0.28">
            <div class="hook-proof-inner">
              <span class="hook-proof-num">2,400+</span>
              <span class="hook-proof-label">businesses diagnosed &nbsp;·&nbsp; same engine</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══ SECTION 2: PROBLEM ═══ -->
      <section class="s-problem">
        <div class="wrap">
          <p class="eyebrow" data-animate>The Problem</p>
          <h2 class="prob-h2" data-animate data-delay="0.05">
            You've done everything the old playbook said.
            <span class="prob-h2-blue">It's not enough anymore.</span>
          </h2>

          <div class="prob-symptoms" data-animate data-delay="0.1">
            <div class="symptom">
              <div class="symptom-label">What you see</div>
              <div class="symptom-text">Ads running. Clicks coming in. Phone rings sometimes.</div>
            </div>
            <div class="symptom">
              <div class="symptom-label">What you don't see</div>
              <div class="symptom-text">Every buyer who asked ChatGPT, Perplexity, or a Google AI Overview — and got a competitor's name instead of yours.</div>
            </div>
            <div class="symptom">
              <div class="symptom-label">What it's costing you</div>
              <div class="symptom-text">AI recommendations convert at 3–5x the rate of a Google click. They're unprompted. They feel trusted. And they go to one business per search.</div>
            </div>
          </div>

          <div class="prob-body" data-animate data-delay="0.15">
            <p>
              You've got reviews. A website that works. You're running ads. The old playbook is checked off.
              But AI systems don't rank pages — <strong>they answer questions.</strong> And most local business websites
              don't answer specific buyer questions. They describe services.
            </p>
            <p>
              There's a difference. AI knows the difference. Your customers are learning it.
            </p>
          </div>

          <div class="prob-enemy" data-animate data-delay="0.2">
            <p class="prob-enemy-label">The real problem</p>
            <p class="prob-enemy-text">The conventional marketing playbook was built for the search era. The search era is ending. ChatGPT has 200 million weekly active users. Perplexity is the fastest-growing search product in history. Google AI Overviews now appear above organic results on most high-intent searches. The businesses that earn AI citations first will own their category for years. First mover advantage in AI closes fast.</p>
          </div>
        </div>
      </section>

      <!-- ═══ SECTION 3: SOLUTION ═══ -->
      <section class="s-solution">
        <div class="wrap">
          <p class="eyebrow" data-animate>The Mechanism</p>
          <h2 class="sol-h2-gray" data-animate data-delay="0.05">We reverse-engineered how AI decides who to recommend.</h2>
          <p class="sol-h2-blue" data-animate data-delay="0.08">There are exactly four gates.</p>

          <!-- TODO: Drop your DVS™ layer-stack image into /public/dvs-stack.png -->
          <div class="sol-image-wrap" data-animate data-delay="0.12">
            <img src="/dvs-stack.png" alt="DVS™ — Demand Visibility Score — Four-Gate Architecture" class="sol-image" onerror="this.parentElement.style.display='none'" />
          </div>

          <div class="sol-gates" data-animate data-delay="0.15">
            <div class="gate">
              <div class="gate-num">01</div>
              <div class="gate-name">Citation Readiness</div>
              <div class="gate-desc">Can AI actually cite your content when a buyer asks a specific question? Generic service pages can't be cited. Specific, structured, buyer-question-answering content can.</div>
            </div>
            <div class="gate">
              <div class="gate-num">02</div>
              <div class="gate-name">Presence Architecture</div>
              <div class="gate-desc">Does your digital presence signal the authority AI looks for before recommending a business? Quality and consistency — not volume — determine this score.</div>
            </div>
            <div class="gate">
              <div class="gate-num">03</div>
              <div class="gate-name">Conversion Architecture</div>
              <div class="gate-desc">When AI sends a buyer to you, do you convert them? Conversion signals also influence how AI scores your credibility as a recommendation.</div>
            </div>
            <div class="gate">
              <div class="gate-num">04</div>
              <div class="gate-name">Brand Authority</div>
              <div class="gate-desc">Are people searching for your business by name? Named search volume is a primary AI citation signal. Zero named search means zero brand authority.</div>
            </div>
          </div>

          <div class="sol-explain" data-animate data-delay="0.2">
            <p>DVS™ — Demand Visibility Score — measures all four. You get a 0–100 score, a visibility profile, a head-to-head competitor comparison, and the single highest-leverage gap to close right now.</p>
          </div>

          <!-- TODO: Drop second DVS™ image into /public/dvs-layers.png -->
          <div class="sol-image2-wrap" data-animate data-delay="0.1">
            <img src="/dvs-layers.png" alt="DVS™ Demand Visibility Score — Layer Detail" class="sol-image" onerror="this.parentElement.style.display='none'" />
          </div>

          <div class="sol-profiles" data-animate data-delay="0.15">
            <div class="sol-profiles-label">Your score places you in one of five visibility profiles</div>
            <div class="profiles-row">
              <div class="profile-chip" style="--pc: #991b1b">DARK <span>0–30</span></div>
              <div class="profile-chip" style="--pc: #c2410c">EXPOSED <span>31–50</span></div>
              <div class="profile-chip" style="--pc: #b45309">EMERGING <span>51–70</span></div>
              <div class="profile-chip" style="--pc: #2e6b3e">VISIBLE <span>71–85</span></div>
              <div class="profile-chip" style="--pc: #1a7340">DEFENDED <span>86–100</span></div>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══ SECTION 4: PROOF ═══ -->
      <section class="s-proof">
        <div class="wrap-wide">
          <div class="proof-header" data-animate>
            <h2 class="proof-h2-gray">Six businesses. Six different gaps found.</h2>
            <p class="proof-h2-blue">One system. Same result.</p>
          </div>
          <div class="proof-grid">
            <div class="proof-card" data-animate>
              <p class="proof-headline">$440K in sales. One week.</p>
              <p class="proof-quote">"We diagnosed the problem — buyers found us but didn't trust what they saw. We tightened the trust signals. A hundred and twenty days later, we did $440,000 in sales in one week. Same traffic. Different result."</p>
              <p class="proof-attr">— <strong>Bob Farnsworth</strong>, Landscape Charleston · Charleston, SC</p>
            </div>
            <div class="proof-card" data-animate data-delay="0.1">
              <p class="proof-headline">170% more booked appointments. Same ad budget.</p>
              <p class="proof-quote">"We were running ads, getting clicks, and losing people. They found the problem. Appointments jumped 170%. I haven't touched the budget since."</p>
              <p class="proof-attr">— <strong>George Rogerson</strong>, McClintock HVAC · Charlotte, NC</p>
            </div>
            <div class="proof-card" data-animate data-delay="0.2">
              <p class="proof-headline">Monthly sales tripled. Ad spend cut 60%.</p>
              <p class="proof-quote">"We fixed the right problem. Monthly sales tripled. We're spending 60% less than before."</p>
              <p class="proof-attr">— <strong>Bobby Wood</strong>, King's Fencing · Nashville, TN</p>
            </div>
            <div class="proof-card" data-animate data-delay="0.1">
              <p class="proof-headline">No more seasonal slowdowns.</p>
              <p class="proof-quote">"The phones ring. The jobs book. We don't have seasonal slowdowns anymore. And we're not spending any more than we were."</p>
              <p class="proof-attr">— <strong>Ethan Del Priore</strong>, Carolina Stone Craftsman · Columbia, SC</p>
            </div>
            <div class="proof-card" data-animate data-delay="0.2">
              <p class="proof-headline">Call volume down. Sales actually up.</p>
              <p class="proof-quote">"Our call volume went down. Our sales went up. We're getting better customers — people who are actually ready to buy."</p>
              <p class="proof-attr">— <strong>Larry Gates</strong>, Floor Pro · Columbia, SC</p>
            </div>
            <div class="proof-card" data-animate data-delay="0.3">
              <p class="proof-headline">Close rates up. Price objections gone.</p>
              <p class="proof-quote">"Our close rates jumped. The price conversations got easier. Buyers just stopped pushing back."</p>
              <p class="proof-attr">— <strong>John Raz</strong>, Orange County Garage Doors · Tustin, CA</p>
            </div>
          </div>
        </div>
      </section>

      <!-- ═══ SECTION 5: OFFER / FORM ═══ -->
      <section class="s-form" id="score-form">
        <div class="form-wrap">

          <div class="form-left">
            <p class="eyebrow" data-animate>Your Free AI Visibility Score</p>
            <h2 class="form-h2" data-animate data-delay="0.05">
              Find out where you stand —<br>
              <span class="form-h2-blue">before your competitor does.</span>
            </h2>
            <ul class="form-value" data-animate data-delay="0.1">
              <li><span class="fv-check">✓</span> Overall AI Visibility Score (0–100)</li>
              <li><span class="fv-check">✓</span> Your visibility profile (DARK → DEFENDED)</li>
              <li><span class="fv-check">✓</span> Head-to-head competitor comparison</li>
              <li><span class="fv-check">✓</span> Four-gate breakdown + your highest-leverage gap</li>
            </ul>
          </div>

          <div class="form-right" data-animate data-delay="0.1">
            <form id="dvs-form" novalidate>
              <div class="field-group">
                <label class="field-label" for="f-name">Business Name</label>
                <input type="text" id="f-name" name="businessName" class="field-input" placeholder="" required autocomplete="organization" />
              </div>
              <div class="field-group">
                <label class="field-label" for="f-url">Website URL</label>
                <input type="url" id="f-url" name="url" class="field-input" placeholder="https://" required autocomplete="url" />
              </div>
              <div class="field-group">
                <label class="field-label" for="f-niche">Service Category</label>
                <select id="f-niche" name="niche" class="field-input field-select" required>
                  <option value="">Select your service…</option>
                  <option>HVAC</option>
                  <option>Plumbing</option>
                  <option>Roofing</option>
                  <option>Electrical</option>
                  <option>Landscaping</option>
                  <option>Gutters</option>
                  <option>Fencing</option>
                  <option>Flooring</option>
                  <option>Painting</option>
                  <option>Concrete &amp; Flatwork</option>
                  <option>Pool Service</option>
                  <option>Pest Control</option>
                  <option>Garage Doors</option>
                  <option>General Contracting</option>
                  <option>Windows &amp; Doors</option>
                  <option>Cleaning Services</option>
                  <option>Other</option>
                </select>
              </div>
              <div class="field-group">
                <label class="field-label" for="f-location">Service Area</label>
                <input type="text" id="f-location" name="location" class="field-input" placeholder="" required autocomplete="off" />
              </div>
              <div id="form-error" class="form-error" hidden></div>
              <button type="submit" class="btn btn-blue form-cta" id="form-submit">
                Run My AI Visibility Score →
              </button>
              <p class="form-trust">Free &nbsp;·&nbsp; No pitch &nbsp;·&nbsp; Results in ~60 seconds</p>
            </form>
          </div>

        </div>
      </section>

    </main>
  </div>

  <!-- ══════════════════════════════════════════════════════
       LOADING OVERLAY — terminal diagnostic feel
       ══════════════════════════════════════════════════════ -->
  <div id="loading-view" hidden aria-hidden="true">
    <div class="load-inner">
      <div class="load-ref" id="load-ref"></div>
      <div class="load-query" id="load-query"></div>
      <div class="load-bar-wrap">
        <div class="load-bar-track">
          <div class="load-bar" id="load-bar"></div>
        </div>
        <div class="load-pct" id="load-pct">0%</div>
      </div>
      <div class="load-log" id="load-log"></div>
      <div class="load-footnote">This diagnostic takes ~60 seconds — AI systems take time to evaluate properly.</div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════
       RESULTS VIEW — score + competitor + gate
       ══════════════════════════════════════════════════════ -->
  <div id="results-view" hidden>

    <!-- Score Banner — always visible -->
    <section class="r-banner" id="r-banner">
      <div class="wrap">
        <div class="banner-inner">
          <div class="banner-left">
            <div class="banner-profile-chip" id="banner-profile-chip">—</div>
            <div class="banner-score-row">
              <span class="banner-score-num" id="banner-score">—</span>
              <span class="banner-score-denom">/100</span>
              <span class="banner-score-label">AI Visibility Score</span>
            </div>
            <div class="banner-profile-label" id="banner-profile-label">—</div>
            <div class="banner-biz" id="banner-biz">—</div>
          </div>
          <div class="banner-right">
            <div class="banner-context">Powered by DVS™ — Demand Visibility Score<br><span>Marketing Performance Group</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Competitor Comparison — always visible -->
    <section class="r-competitors">
      <div class="wrap">
        <p class="eyebrow">Competitor Comparison</p>
        <p class="comp-subtitle">Your score vs. top competitors in your market. Competitor scores reflect AI-critical dimensions (Citation + Presence).</p>
        <div class="comp-bars" id="comp-bars">
          <!-- populated by JS -->
        </div>
      </div>
    </section>

    <!-- Breakdown — BLURRED until gate -->
    <section class="r-breakdown" id="r-breakdown">
      <div class="wrap">
        <div class="breakdown-header">
          <p class="eyebrow">The Four Gates</p>
          <p class="breakdown-subtitle">Where you're strong, where you're leaking, and what to fix first.</p>
        </div>
        <div class="breakdown-dims" id="breakdown-dims">
          <!-- populated by JS -->
        </div>
        <div class="breakdown-gap" id="breakdown-gap">
          <!-- populated by JS -->
        </div>
      </div>
    </section>

    <!-- Gate — shown until email submitted -->
    <section class="r-gate" id="r-gate">
      <div class="gate-wrap">
        <p class="gate-eyebrow">Your full breakdown is ready</p>
        <h2 class="gate-h2">Enter your name and email to unlock.</h2>
        <p class="gate-sub">We'll send a link to your full report. No sales call required — though you can book one if you want help fixing it.</p>
        <form id="gate-form" novalidate class="gate-form">
          <div class="gate-fields">
            <input type="text" name="gateName" placeholder="Your name" class="field-input" autocomplete="name" />
            <input type="email" name="gateEmail" placeholder="Work email" class="field-input" required autocomplete="email" />
          </div>
          <div id="gate-error" class="form-error" hidden></div>
          <button type="submit" class="btn btn-blue gate-cta" id="gate-submit">
            Unlock My Full Report →
          </button>
          <p class="gate-trust">No spam. We'll email you one report. That's it.</p>
        </form>
      </div>
    </section>

    <!-- Post-unlock — hidden until gate clears -->
    <section class="r-unlocked" id="r-unlocked" hidden>
      <div class="wrap">
        <div class="unlock-inner">
          <p class="unlock-eyebrow">Ready to fix your highest-leverage gap?</p>
          <h2 class="unlock-h2">We find the gap. You decide what to do next.</h2>
          <p class="unlock-body">Most businesses we diagnose have one gap that accounts for 70%+ of their AI visibility problem. Our job is to show you exactly what it is. What you do with it is up to you.</p>
          <div class="unlock-ctas">
            <a href="https://calendly.com/robert-marketingperformance/strategy" class="btn btn-blue" target="_blank" rel="noopener">Book a Free 20-Min Strategy Call →</a>
            <a id="report-link" href="#" class="btn btn-outline" target="_blank" rel="noopener">View Detailed Technical Report →</a>
          </div>
          <p class="unlock-guarantee">31 years. 2X revenue guarantee or we work free until we deliver. Zero refunds. That's not a pitch — it's a track record.</p>
        </div>
      </div>
    </section>

    <Footer />
  </div>
</Base>

<script>
// ══════════════════════════════════════════════════════════
// DVS™ Score Page — State Machine
// States: landing → loading → results → unlocked
// ══════════════════════════════════════════════════════════

const DVS_API = 'https://engageengine-dvs.robertlbutt.workers.dev/api/audit';

const PROFILE_COLORS: Record<string, string> = {
  DEFENDED: '#1a7340',
  VISIBLE:  '#2e6b3e',
  EMERGING: '#b45309',
  EXPOSED:  '#c2410c',
  DARK:     '#991b1b',
};

const DIM_LABELS: Record<string, string> = {
  citation_readiness:       'Citation Readiness',
  presence_architecture:    'Presence Architecture',
  conversion_architecture:  'Conversion Architecture',
  brand_authority:          'Brand Authority',
};

const DIM_RECS: Record<string, string> = {
  citation_readiness:       'Your content is too generic for AI systems to cite. The fix: add specific local context, FAQ structure, and buyer-question answers that only you can give.',
  presence_architecture:    'Your digital presence lacks the authority signals AI uses before making citations. Focus on review quality, answered Q&As, and named expert content.',
  conversion_architecture:  'Visitors who find you can\'t easily convert. Conversion architecture also influences AI recommendation confidence for high-intent queries.',
  brand_authority:          'No one is searching for your business by name. Named brand search volume directly increases AI citation frequency — it\'s a primary trust signal.',
};

// ── Elements ─────────────────────────────────────────────
const landingView  = document.getElementById('landing-view')!;
const loadingView  = document.getElementById('loading-view')!;
const resultsView  = document.getElementById('results-view')!;
const loadBar      = document.getElementById('load-bar')!;
const loadPct      = document.getElementById('load-pct')!;
const loadLog      = document.getElementById('load-log')!;
const loadRef      = document.getElementById('load-ref')!;
const loadQuery    = document.getElementById('load-query')!;
const formEl       = document.getElementById('dvs-form') as HTMLFormElement;
const formSubmit   = document.getElementById('form-submit')!;
const formError    = document.getElementById('form-error')!;
const gateForm     = document.getElementById('gate-form') as HTMLFormElement;
const gateSubmit   = document.getElementById('gate-submit')!;
const gateError    = document.getElementById('gate-error')!;

// ── State ────────────────────────────────────────────────
let scoreData: any = null;
let businessInfo: any = {};
let apiDone = false;
let animDone = false;

// ── Smooth scroll to form ────────────────────────────────
document.querySelectorAll('a[href="#score-form"]').forEach(a => {
  a.addEventListener('click', e => {
    e.preventDefault();
    document.getElementById('score-form')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
});

// ── Main form submit ─────────────────────────────────────
formEl?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const fd = new FormData(formEl);
  const url          = (fd.get('url')          as string || '').trim();
  const businessName = (fd.get('businessName') as string || '').trim();
  const niche        = (fd.get('niche')        as string || '').trim();
  const location     = (fd.get('location')     as string || '').trim();

  if (!url || !businessName || !niche || !location) {
    showFormError('Please fill in all four fields.');
    return;
  }

  // Normalise URL
  let cleanUrl = url;
  if (!/^https?:\/\//i.test(cleanUrl)) cleanUrl = 'https://' + cleanUrl;

  businessInfo = { url: cleanUrl, businessName, niche, location };

  // GA4 + Meta events
  if (typeof (window as any).gtag !== 'undefined') {
    (window as any).gtag('event', 'dvs_form_submit', { business: businessName, niche, location });
  }
  if (typeof (window as any).fbq !== 'undefined') {
    (window as any).fbq('track', 'Lead', { content_name: 'DVS Score Request', content_category: niche });
  }

  // Transition to loading
  landingView.hidden = true;
  loadingView.hidden = false;
  window.scrollTo(0, 0);

  const refNum = 'DVS-' + Date.now().toString(36).toUpperCase().slice(-6);
  loadRef.textContent   = 'REF: ' + refNum + '  ·  ' + new Date().toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  loadQuery.textContent = 'QUERY: ' + cleanUrl + '  ·  ' + niche + '  ·  ' + location;

  // Start animation + API in parallel
  startLoadAnimation(cleanUrl, niche, location);
  startApiCall(cleanUrl, businessName, niche, location);
});

// ── Loading animation ─────────────────────────────────────
function startLoadAnimation(url: string, niche: string, location: string) {
  const domain = url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/.*$/, '');
  const steps = [
    'INIT      connecting to demand visibility engine...',
    'FETCH     downloading content: ' + domain,
    'ANALYZE   scanning citation readiness...',
    'ANALYZE   evaluating presence architecture...',
    'CHECK     fetching Google Business Profile data...',
    'ANALYZE   scoring conversion signals...',
    'ANALYZE   measuring brand authority...',
    'SEARCH    identifying competitors: ' + niche + ' — ' + location + '...',
    'SCORE     benchmarking against local competitors...',
    'COMPILE   generating visibility profile...',
    'READY     AI Visibility Score compiled.',
  ];

  loadLog.innerHTML = '';
  loadBar.style.width = '0%';
  loadPct.textContent = '0%';

  const STEP_MS = 5200;
  let i = 0;

  function nextStep() {
    if (i >= steps.length) {
      animDone = true;
      checkBothDone();
      return;
    }
    const el = document.createElement('div');
    el.className = 'log-line' + (i === steps.length - 1 ? ' log-ready' : '');
    el.textContent = steps[i];
    loadLog.appendChild(el);
    loadLog.scrollTop = loadLog.scrollHeight;

    const pct = Math.round(((i + 1) / steps.length) * 100);
    loadBar.style.width = pct + '%';
    loadPct.textContent = pct + '%';
    i++;

    if (i < steps.length) setTimeout(nextStep, STEP_MS);
    else {
      // Hold on READY until API is done too
      const waitForApi = setInterval(() => {
        if (apiDone) {
          clearInterval(waitForApi);
          animDone = true;
          checkBothDone();
        }
      }, 300);
    }
  }

  nextStep();
}

// ── API call ──────────────────────────────────────────────
async function startApiCall(url: string, businessName: string, niche: string, location: string) {
  try {
    const res = await fetch(DVS_API, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ url, businessName, location, niche, isProspect: true }),
    });

    if (!res.ok) throw new Error('Score engine returned ' + res.status);

    scoreData = await res.json();
    apiDone = true;
    checkBothDone();
  } catch (err: any) {
    // Surface error gracefully
    apiDone = true;
    scoreData = { error: err.message };
    checkBothDone();
  }
}

// ── Gate check — show results only when BOTH done ─────────
function checkBothDone() {
  if (!apiDone || !animDone) return;

  if (scoreData?.error || !scoreData?.total_score) {
    showLoadingError(scoreData?.error || 'Scoring failed. Please try again.');
    return;
  }

  showResults();
}

// ── Populate + reveal results ─────────────────────────────
function showResults() {
  loadingView.hidden = true;
  resultsView.hidden = false;
  window.scrollTo(0, 0);

  const { total_score, profile, profile_label, dimensions, competitors, id: reportId } = scoreData;
  const profileColor = PROFILE_COLORS[profile] || '#707070';

  // Banner
  const chip = document.getElementById('banner-profile-chip')!;
  chip.textContent = profile;
  chip.style.background = profileColor;

  document.getElementById('banner-score')!.textContent = String(total_score);
  document.getElementById('banner-profile-label')!.textContent = profile_label || '';
  document.getElementById('banner-biz')!.textContent =
    businessInfo.businessName + '  ·  ' + businessInfo.niche + '  ·  ' + businessInfo.location;

  // Competitor bars
  buildCompetitorBars(total_score, competitors || []);

  // Dimension breakdown (blurred)
  buildDimensionBreakdown(dimensions || {});

  // Report link
  if (reportId) {
    const link = document.getElementById('report-link') as HTMLAnchorElement;
    if (link) link.href = 'https://engageengine-dvs.robertlbutt.workers.dev/reports/' + reportId;
  }

  // Store reportId for gate
  (window as any)._dvsReportId = reportId;

  // Animate score number
  animateScore(total_score);
}

function animateScore(target: number) {
  const el = document.getElementById('banner-score')!;
  let current = 0;
  const step = () => {
    current = Math.min(current + Math.ceil((target - current) / 8 + 1), target);
    el.textContent = String(current);
    if (current < target) requestAnimationFrame(step);
  };
  requestAnimationFrame(step);
}

// ── Build competitor bars ─────────────────────────────────
function buildCompetitorBars(myScore: number, competitors: any[]) {
  const container = document.getElementById('comp-bars')!;
  container.innerHTML = '';

  const rows: { label: string; score: number; isYou: boolean }[] = [
    { label: businessInfo.businessName, score: myScore, isYou: true },
    ...competitors
      .filter(c => c.citation_score !== null && c.presence_score !== null)
      .slice(0, 4)
      .map(c => ({
        label: c.name || 'Competitor',
        score: Math.round((c.citation_score + c.presence_score) * 2),
        isYou: false,
      }))
  ];

  rows.sort((a, b) => b.score - a.score);
  const maxScore = Math.max(...rows.map(r => r.score), 100);

  rows.forEach(row => {
    const pct = Math.round((row.score / maxScore) * 100);
    const barColor = row.isYou ? '#0071e3' : (row.score >= 71 ? '#1a7340' : row.score >= 51 ? '#b45309' : '#c2410c');
    const div = document.createElement('div');
    div.className = 'comp-row' + (row.isYou ? ' comp-row-you' : '');
    div.innerHTML = `
      <div class="comp-name">${row.label}${row.isYou ? ' <span class="you-badge">YOU</span>' : ''}</div>
      <div class="comp-bar-wrap">
        <div class="comp-bar-track">
          <div class="comp-bar-fill" style="width:0%;background:${barColor}" data-target="${pct}"></div>
        </div>
        <div class="comp-score">${row.score}</div>
      </div>
    `;
    container.appendChild(div);
  });

  // Animate bars in
  setTimeout(() => {
    container.querySelectorAll('.comp-bar-fill').forEach((bar: Element) => {
      const el = bar as HTMLElement;
      el.style.width = el.dataset.target + '%';
    });
  }, 100);
}

// ── Build dimension breakdown ─────────────────────────────
function buildDimensionBreakdown(dimensions: Record<string, any>) {
  const container = document.getElementById('breakdown-dims')!;
  const gapContainer = document.getElementById('breakdown-gap')!;
  container.innerHTML = '';

  const dimOrder = ['citation_readiness', 'presence_architecture', 'conversion_architecture', 'brand_authority'];
  let lowestKey = dimOrder[0];
  let lowestScore = 999;

  dimOrder.forEach(key => {
    const dim = dimensions[key] || { score: 0, max: 25 };
    if (dim.score < lowestScore) { lowestScore = dim.score; lowestKey = key; }
    const pct = Math.round((dim.score / (dim.max || 25)) * 100);
    const barColor = pct >= 72 ? '#0071e3' : pct >= 48 ? '#b45309' : '#c2410c';
    const div = document.createElement('div');
    div.className = 'dim-row';
    div.innerHTML = `
      <div class="dim-meta">
        <span class="dim-name">${DIM_LABELS[key] || key}</span>
        <span class="dim-score">${dim.score}<span class="dim-max">/${dim.max || 25}</span></span>
      </div>
      <div class="dim-bar-track">
        <div class="dim-bar-fill" style="width:0%;background:${barColor}" data-target="${pct}"></div>
      </div>
    `;
    container.appendChild(div);
  });

  // Gap callout
  gapContainer.innerHTML = `
    <div class="gap-callout">
      <div class="gap-label">Highest-leverage gap</div>
      <div class="gap-name">${DIM_LABELS[lowestKey]}</div>
      <div class="gap-rec">${DIM_RECS[lowestKey]}</div>
    </div>
  `;

  // Apply blur
  const breakdown = document.getElementById('r-breakdown')!;
  breakdown.classList.add('is-blurred');

  // Animate bars when unlocked
  (window as any)._revealDimBars = () => {
    container.querySelectorAll('.dim-bar-fill').forEach((bar: Element) => {
      const el = bar as HTMLElement;
      el.style.width = el.dataset.target + '%';
    });
  };
}

// ── Gate form submit ──────────────────────────────────────
gateForm?.addEventListener('submit', async (e) => {
  e.preventDefault();
  const fd = new FormData(gateForm);
  const name  = (fd.get('gateName')  as string || '').trim();
  const email = (fd.get('gateEmail') as string || '').trim();

  if (!email || !email.includes('@')) {
    gateError.hidden = false;
    gateError.textContent = 'Please enter a valid email address.';
    return;
  }

  gateSubmit.textContent = 'Unlocking…';
  (gateSubmit as HTMLButtonElement).disabled = true;
  gateError.hidden = true;

  try {
    await fetch('/api/score-gate', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name, email,
        businessName: businessInfo.businessName,
        url:          businessInfo.url,
        location:     businessInfo.location,
        niche:        businessInfo.niche,
        score:        scoreData?.total_score,
        profile:      scoreData?.profile,
        reportId:     (window as any)._dvsReportId || '',
      }),
    });
  } catch (_) {
    // Fire and forget — even if network fails, still unlock
  }

  // Unlock
  const breakdown = document.getElementById('r-breakdown')!;
  breakdown.classList.remove('is-blurred');
  if (typeof (window as any)._revealDimBars === 'function') (window as any)._revealDimBars();

  document.getElementById('r-gate')!.hidden  = true;
  document.getElementById('r-unlocked')!.hidden = false;

  // Track event
  if (typeof (window as any).gtag !== 'undefined') {
    (window as any).gtag('event', 'dvs_gate_unlock', {
      business: businessInfo.businessName,
      score: scoreData?.total_score,
      profile: scoreData?.profile,
    });
  }
  if (typeof (window as any).fbq !== 'undefined') {
    (window as any).fbq('track', 'CompleteRegistration', {
      content_name: 'DVS Score Unlock',
      value: scoreData?.total_score,
    });
  }

  document.getElementById('r-unlocked')!.scrollIntoView({ behavior: 'smooth', block: 'start' });
});

// ── Error states ──────────────────────────────────────────
function showFormError(msg: string) {
  formError.hidden = false;
  formError.textContent = msg;
}

function showLoadingError(msg: string) {
  loadingView.hidden = true;
  landingView.hidden = false;
  showFormError('Score engine error: ' + msg + '. Please try again.');
  document.getElementById('score-form')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// ── Print blocking ────────────────────────────────────────
window.addEventListener('keydown', (e) => {
  if ((e.ctrlKey || e.metaKey) && (e.key === 'p' || e.key === 'P')) {
    e.preventDefault();
    e.stopPropagation();
  }
});
window.addEventListener('beforeprint', (e) => {
  e.preventDefault();
});
