}
.gate-name {
  font-family: var(--font-d);
  font-size: 16px;
  font-weight: 600;
  letter-spacing: -0.018em;
  color: var(--graphite);
  margin-bottom: 10px;
  line-height: 1.2;
}
.gate-desc {
  font-size: 13px;
  line-height: 1.55;
  color: var(--mid-gray);
  letter-spacing: -0.015em;
}
.sol-explain {
  max-width: 680px;
  margin: 0 auto 52px;
}
.sol-explain p {
