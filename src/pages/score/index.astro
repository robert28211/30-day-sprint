}
.banner-profile-chip {
  display: inline-block;
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 5px 14px;
  border-radius: 980px;
  margin-bottom: 14px;
}
.banner-score-row {
  display: flex;
  align-items: baseline;
  gap: 4px;
  margin-bottom: 8px;
}
.banner-score-num {
  font-family: var(--font-d);
  font-size: clamp(60px, 10vw, 88px);
  font-weight: 600;
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--graphite);
}
.banner-score-denom {
  font-family: var(--font-d);
  font-size: 28px;
  font-weight: 400;
  color: var(--mid-gray);
  letter-spacing: -0.01em;
}
.banner-score-label {
  font-size: 14px;
  color: var(--mid-gray);
  letter-spacing: -0.01em;
  margin-left: 6px;
}
.banner-profile-label {
  font-family: var(--font-d);
  font-size: 20px;
  font-weight: 600;
  color: var(--graphite);
  letter-spacing: -0.01em;
  margin-bottom: 8px;
}
.banner-biz {
  font-size: 13px;
  color: var(--mid-gray);
  letter-spacing: 0.01em;
}
.banner-right {
  text-align: right;
  align-self: center;
}
.banner-context {
  font-size: 12px;
  color: var(--mid-gray);
  line-height: 1.6;
  letter-spacing: 0.01em;
}
.banner-context span { color: var(--mid-gray); }

/* ═══ RESULTS — Competitors ════════════════════════════════ */
.r-blocked {
  background: #fff8f0;
  border-top: 2px solid #c2410c;
  border-bottom: 1px solid #f5d0b0;
  padding: 20px 22px;
}
.blocked-inner {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  max-width: 780px;
  margin: 0 auto;
}
.blocked-icon {
  font-size: 20px;
  line-height: 1.4;
  flex-shrink: 0;
}
.blocked-body {
  font-size: 14px;
  color: #7c2d12;
  line-height: 1.6;
  letter-spacing: -0.01em;
}
.blocked-body strong {
  display: block;
  margin-bottom: 4px;
  font-size: 15px;
  color: #9a3412;
}
.r-disclaimer {
  background: var(--canvas);
  border-top: 1px solid var(--silver);
  border-bottom: 1px solid var(--silver);
  padding: 20px 22px;
}
.disclaimer-inner {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  max-width: 780px;
  margin: 0 auto;
}
.disclaimer-icon {
  font-size: 18px;
  line-height: 1.5;
  flex-shrink: 0;
}
.disclaimer-body {
  font-size: 13px;
  color: var(--mid-gray);
  line-height: 1.6;
  letter-spacing: -0.01em;
}
.disclaimer-body strong {
  color: var(--graphite);
  font-weight: 600;
}
.disclaimer-cta-inline {
  display: block;
  margin-top: 6px;
  color: var(--blue);
  font-weight: 500;
}
.r-competitors {
  background: var(--white);
  padding: 52px 22px;
  border-bottom: 1px solid var(--silver);
}
.comp-subtitle {
  font-size: 13px;
  color: var(--light-gray);
  letter-spacing: -0.01em;
  margin-bottom: 28px;
}
.comp-bars { display: flex; flex-direction: column; gap: 16px; max-width: 680px; }
.comp-row { display: flex; flex-direction: column; gap: 6px; }
.comp-row-you .comp-name { font-weight: 600; color: var(--blue); }
.comp-name {
  font-size: 13px;
  color: var(--mid-gray);
  letter-spacing: -0.01em;
  display: flex;
  align-items: center;
  gap: 8px;
}
.you-badge {
  background: var(--blue);
  color: #fff;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.08em;
  padding: 2px 7px;
  border-radius: 980px;
}
.comp-bar-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}
.comp-bar-track {
  flex: 1;
  height: 8px;
  background: var(--canvas);
  border-radius: 980px;
  overflow: hidden;
}
.comp-bar-fill {
  height: 8px;
  border-radius: 980px;
  width: 0%;
  transition: width 0.9s cubic-bezier(0.23,1,0.32,1);
}
.comp-score {
  font-family: var(--font-d);
  font-size: 15px;
  font-weight: 600;
  color: var(--graphite);
  min-width: 32px;
  text-align: right;
}

/* ═══ RESULTS — Breakdown (blurred) ═══════════════════════ */
.r-breakdown {
  background: var(--canvas);
  padding: 52px 22px;
  border-bottom: 1px solid var(--silver);
  transition: filter 0.5s ease;
}
.r-breakdown.is-blurred {
  filter: blur(8px);
  user-select: none;
  pointer-events: none;
}
.breakdown-header { margin-bottom: 32px; }
.breakdown-subtitle {
  font-size: 14px;
  color: var(--mid-gray);
  letter-spacing: -0.015em;
}
.breakdown-dims {
  display: flex;
  flex-direction: column;
  gap: 20px;
  max-width: 680px;
  margin-bottom: 36px;
}
.dim-row { display: flex; flex-direction: column; gap: 8px; }
.dim-meta {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.dim-name {
  font-size: 14px;
  font-weight: 600;
  color: var(--graphite);
  letter-spacing: -0.015em;
}
.dim-score {
  font-family: var(--font-d);
  font-size: 17px;
  font-weight: 600;
  color: var(--graphite);
}
.dim-max {
  font-size: 12px;
  font-weight: 400;
  color: var(--light-gray);
}
.dim-bar-track {
  height: 6px;
  background: var(--silver);
  border-radius: 980px;
  overflow: hidden;
}
.dim-bar-fill {
  height: 6px;
  border-radius: 980px;
  width: 0%;
  transition: width 0.9s cubic-bezier(0.23,1,0.32,1);
}
.gap-callout {
  background: var(--white);
  border: 1px solid var(--silver);
  border-left: 3px solid var(--blue);
  border-radius: 0 10px 10px 0;
  padding: 22px 24px;
  max-width: 680px;
}
.gap-label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--blue);
  margin-bottom: 6px;
}
.gap-name {
  font-family: var(--font-d);
  font-size: 18px;
  font-weight: 600;
  color: var(--graphite);
  margin-bottom: 8px;
  letter-spacing: -0.01em;
}
.gap-rec {
  font-size: 14px;
  line-height: 1.55;
  color: var(--mid-gray);
  letter-spacing: -0.015em;
}

/* ═══ RESULTS — Gate ═══════════════════════════════════════ */
.r-gate {
  background: var(--white);
  padding: 72px 22px;
  border-bottom: 1px solid var(--silver);
}
.gate-wrap { max-width: 480px; margin: 0 auto; text-align: center; }
.gate-eyebrow {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--blue);
  margin-bottom: 12px;
}
.gate-h2 {
  font-family: var(--font-d);
  font-size: clamp(24px, 3.5vw, 34px);
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -0.005em;
  color: var(--graphite);
  margin-bottom: 16px;
}
.gate-sub {
  font-size: 15px;
  line-height: 1.55;
  color: var(--mid-gray);
  letter-spacing: -0.018em;
  margin-bottom: 28px;
}
.gate-form { text-align: left; }
.gate-fields {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 10px;
}
.gate-cta {
  width: 100%;
  display: block;
  border-radius: 10px;
  font-size: 17px;
  padding: 16px;
  margin-bottom: 10px;
}
.gate-trust {
  font-size: 12px;
  color: var(--light-gray);
  text-align: center;
  letter-spacing: 0.02em;
}

/* ═══ RESULTS — Post-Unlock ════════════════════════════════ */
.r-unlocked {
  background: var(--canvas);
  padding: 72px 22px;
  border-top: 1px solid var(--silver);
}
.r-unlocked[hidden] { display: none; }
.unlock-inner { max-width: 560px; margin: 0 auto; }
.unlock-profile-chip {
  display: inline-block;
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  padding: 5px 14px;
  border-radius: 980px;
  margin-bottom: 20px;
}
.unlock-h2 {
  font-family: var(--font-d);
  font-size: clamp(24px, 3.5vw, 36px);
  font-weight: 600;
  line-height: 1.12;
  letter-spacing: -0.005em;
  color: var(--graphite);
  margin-bottom: 16px;
}
.unlock-body {
  font-size: 16px;
  line-height: 1.65;
  color: var(--mid-gray);
  letter-spacing: -0.018em;
  margin-bottom: 32px;
}
.unlock-download-wrap {
  background: var(--white);
  border: 1px solid var(--silver);
  border-radius: 14px;
  padding: 28px;
  margin-bottom: 32px;
}
.unlock-dl-btn {
  width: 100%;
  display: block;
  text-align: center;
  border-radius: 10px;
  font-size: 17px;
  padding: 16px;
  margin-bottom: 10px;
}
.unlock-dl-note {
  font-size: 12px;
  color: var(--light-gray);
  text-align: center;
  letter-spacing: 0.01em;
}
.unlock-divider {
  height: 1px;
  background: var(--silver);
  margin-bottom: 28px;
}
.unlock-call-label {
  font-size: 15px;
  font-weight: 600;
  color: var(--graphite);
  letter-spacing: -0.015em;
  margin-bottom: 14px;
}
.unlock-call-btn {
  display: block;
  width: 100%;
  text-align: center;
  border-radius: 10px;
  font-size: 16px;
  padding: 14px;
  margin-bottom: 20px;
}
.unlock-report-row {
  text-align: center;
  margin-bottom: 24px;
}
.unlock-report-link {
  font-size: 13px;
