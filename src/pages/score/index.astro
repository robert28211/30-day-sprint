.unlock-guarantee {
  font-size: 13px;
  color: var(--light-gray);
  letter-spacing: -0.01em;
  line-height: 1.55;
  text-align: center;
}

/* ═══ Responsive ═══════════════════════════════════════════ */
@media (max-width: 900px) {
  .prob-symptoms { grid-template-columns: 1fr; }
  .sol-gates { grid-template-columns: repeat(2, 1fr); }
  .proof-grid { grid-template-columns: repeat(2, 1fr); }
  .form-wrap { grid-template-columns: 1fr; gap: 40px; }
}
@media (max-width: 640px) {
  .proof-grid { grid-template-columns: 1fr; }
  .sol-gates { grid-template-columns: repeat(2, 1fr); }
  .gate-desc { display: none; }
  .gate { padding: 20px 16px; }
  .s-hook { padding: 60px 16px 52px; }
  .banner-inner { flex-direction: column; }
  .unlock-ctas { flex-direction: column; }
}

/* ── Free: market demand + seat availability ──────────────────────── */
.r-market { padding: 44px 0; border-top: 1px solid var(--border); }
.mkt-grid { display: grid; grid-template-columns: minmax(140px, 210px) 1fr; gap: 32px; align-items: start; }
.mkt-num {
  font-family: var(--font-d);
  font-size: clamp(40px, 6vw, 62px);
  font-weight: 700; letter-spacing: -0.03em; line-height: 1;
  color: var(--graphite); font-variant-numeric: tabular-nums;
}
.mkt-unit { font-size: 13.5px; color: var(--mid-gray); margin-top: 8px; line-height: 1.45; }
.mkt-line { font-size: 16px; line-height: 1.6; color: var(--mid-gray); margin-bottom: 16px; }
.mkt-terms { display: flex; flex-direction: column; gap: 6px; }
.mkt-term {
  display: flex; gap: 14px; align-items: baseline;
  padding: 7px 0; border-bottom: 1px solid var(--border);
}
.mkt-term:last-child { border-bottom: 0; }
.mkt-term-v {
  font-family: var(--font-d); font-weight: 700; font-size: 14px;
  color: var(--graphite); min-width: 54px; text-align: right;
  font-variant-numeric: tabular-nums;
}
.mkt-term-k { font-size: 14px; color: var(--mid-gray); }
.mkt-seat {
  margin-top: 26px; padding: 18px 20px; border-radius: 10px;
  background: var(--canvas); border: 1px solid var(--border);
