  padding: 6px 14px;
  border-radius: 980px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.04em;
  display: flex;
  align-items: center;
  gap: 6px;
}
.profile-chip span {
  font-weight: 400;
  opacity: 0.75;
  font-size: 11px;
}

/* ═══ PROOF ════════════════════════════════════════════════ */
.s-proof {
  background: var(--canvas);
  padding: 100px 22px;
  border-bottom: 1px solid var(--silver);
}
.proof-header {
  text-align: center;
  margin-bottom: 60px;
}
.proof-h2-gray {
  font-family: var(--font-d);
  font-size: clamp(28px, 4vw, 44px);
  font-weight: 600;
  line-height: 1.08;
  letter-spacing: -0.005em;
  color: var(--graphite);
  margin-bottom: 4px;
}
.proof-h2-blue {
  font-family: var(--font-d);
  font-size: clamp(28px, 4vw, 44px);
  font-weight: 600;
  line-height: 1.08;
  letter-spacing: -0.005em;
  color: var(--blue);
}
.proof-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--silver);
}
.proof-card {
  background: var(--white);
  padding: 36px 32px;
  display: flex;
  flex-direction: column;
}
.proof-headline {
  font-family: var(--font-d);
  font-size: 17px;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.018em;
  color: var(--graphite);
  margin-bottom: 16px;
}
.proof-quote {
  font-size: 14px;
  font-weight: 400;
  line-height: 1.55;
  letter-spacing: -0.015em;
  color: var(--mid-gray);
  font-style: italic;
  flex: 1;
  margin-bottom: 18px;
}
.proof-attr {
  font-size: 12px;
  color: var(--light-gray);
  border-top: 1px solid var(--silver);
  padding-top: 14px;
  letter-spacing: -0.01em;
}
.proof-attr strong { color: var(--graphite); font-weight: 600; }

/* ═══ FORM ═════════════════════════════════════════════════ */
.s-form {
  background: var(--white);
  padding: 100px 22px;
}
.form-wrap {
  max-width: 980px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 72px;
  align-items: start;
}
.form-h2 {
  font-family: var(--font-d);
  font-size: clamp(26px, 3.5vw, 38px);
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -0.005em;
  color: var(--graphite);
  margin-bottom: 28px;
}
.form-h2-blue { color: var(--blue); }
.form-value {
  list-style: none;
  padding: 0;
  margin: 0 0 28px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.form-value li {
  font-size: 15px;
  color: var(--mid-gray);
  letter-spacing: -0.018em;
  display: flex;
  align-items: flex-start;
  gap: 10px;
  line-height: 1.4;
}
.fv-check { color: var(--blue); font-weight: 700; flex-shrink: 0; }
/* Field styles (reuse snap patterns) */
.field-group { margin-bottom: 14px; }
.field-label {
  display: block;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--mid-gray);
  margin-bottom: 6px;
}
.field-input {
  width: 100%;
  background: var(--canvas);
  border: 1px solid var(--border);
  border-radius: 10px;
  color: var(--graphite);
  font-family: var(--font-t);
  font-size: 16px;
  padding: 14px;
  outline: none;
  -webkit-appearance: none;
  transition: border-color 0.15s;
}
.field-input::placeholder { color: var(--light-gray); }
.field-input:focus { border-color: var(--blue); }
.form-error {
  background: rgba(192,57,43,0.06);
  border: 1px solid rgba(192,57,43,0.2);
  border-radius: 8px;
  padding: 10px 14px;
  font-size: 13px;
  color: #8b2e22;
  margin-bottom: 12px;
}
.form-cta {
  width: 100%;
  display: block;
  border-radius: 10px;
  font-size: 17px;
  padding: 16px;
  margin-bottom: 10px;
}
.form-trust {
  font-size: 12px;
  color: var(--light-gray);
  text-align: center;
  letter-spacing: 0.02em;
}

/* ═══ LOADING ══════════════════════════════════════════════ */
#loading-view {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: var(--white);
  display: flex;
  align-items: center;
  justify-content: center;
}
#loading-view[hidden] { display: none; }
.load-inner {
  width: 100%;
  max-width: 540px;
  padding: 0 28px;
  display: flex;
  flex-direction: column;
  gap: 22px;
}
.load-ref {
  font-family: var(--font-t);
  font-size: 11px;
  color: var(--mid-gray);
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.load-query {
  font-family: var(--font-d);
  font-size: 20px;
  font-weight: 600;
  color: var(--graphite);
  border-left: 3px solid var(--blue);
  padding-left: 16px;
  line-height: 1.35;
  letter-spacing: -0.02em;
}
.load-bar-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
}
.load-bar-track {
  flex: 1;
  height: 3px;
  background: var(--silver);
  overflow: hidden;
  border-radius: 980px;
}
.load-bar {
  height: 3px;
  background: var(--blue);
  width: 0%;
  transition: width 1.2s linear;
  border-radius: 980px;
}
.load-pct {
  font-family: var(--font-t);
  font-size: 12px;
  color: var(--mid-gray);
  min-width: 40px;
  text-align: right;
}
.load-log {
  font-family: var(--font-t);
  font-size: 13px;
  line-height: 2.1;
  display: flex;
  flex-direction: column;
  max-height: 280px;
  overflow: hidden;
  color: var(--mid-gray);
}
.log-line { color: var(--mid-gray); }
.log-ready { color: var(--blue); font-weight: 600; }
.load-footnote {
  font-size: 12px;
  color: var(--mid-gray);
  letter-spacing: -0.01em;
}

/* ═══ RESULTS — Score Banner ═══════════════════════════════ */
#results-view[hidden] { display: none; }
.r-banner {
  background: var(--canvas);
  padding: 52px 22px;
  border-bottom: 1px solid var(--silver);
}
.banner-inner {
  display: flex;
  justify-content: space-between;
