---
import Base from '../layouts/Base.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'

// The twelve questions, three per failure mode. Order matters: question i belongs
// to section Math.floor(i / 3). Scoring lives in src/lib/diagnostic-score.mjs.
const SECTIONS = [
  { name: 'Not Seen When the Decision Is Made', symptom: '"Your Google reviews are 4.8 stars but your phone stopped ringing."' },
  { name: 'Seen But Not Trusted',               symptom: '"You\'re getting website traffic but nobody books."' },
  { name: 'Trusted But Still Compared',         symptom: '"You won the estimate but they picked someone cheaper."' },
  { name: 'Selected But No Action',             symptom: '"They said yes, then disappeared."' },
];
const QUESTIONS = [
  { title: 'Visibility Where Decisions Are Made', main: 'Are you present when people are choosing?', think: ['Google Maps visibility', 'Search results for your brand name', 'Competitors appearing above you'] },
  { title: 'Demand Protection', main: 'Are you losing people who already want you?', think: ['Competitor ads on your name', 'Review sites outranking you', 'Marketplaces intercepting traffic'] },
  { title: "Relevance in Today's Market", main: "Do you still feel current to today's buyer?", think: ['Website quality on mobile', 'Google Business Profile activity', 'Whether your brand feels dated or modern'] },
  { title: 'Trust Signals', main: 'Do you look trustworthy before anyone calls?', think: ['Reviews quantity and quality', 'Photos, credentials, licenses', 'First impressions'] },
  { title: 'Message Consistency', main: 'Does everything sound like the same company?', think: ['Old logos or slogans still floating around', 'Different tones across platforms', 'Conflicting promises'] },
  { title: 'Customer Value & Experience', main: 'Do customers clearly understand why they should choose you?', think: ['Trust and professionalism mentioned in reviews', 'Repeat customers and referrals', 'Whether people explain why they chose you'] },
  { title: 'Comparison Justification', main: 'Do customers still compare other options even after they trust you?', think: ['How often customers ask for multiple quotes', 'Whether price comparisons come up late in the process', 'If customers say they like you but want to "check a few others"'] },
  { title: 'Clear Local Positioning', main: 'Are you clearly different from competitors?', think: ['Can your office staff answer "Why you?"', 'Do your ads and website say something specific?', "Or could your name be swapped with a competitor's?"] },
  { title: 'Perceived Value (Not Just Price)', main: "Do customers believe you're worth it?", think: ['Pushback on pricing', '"Too expensive" objections', 'Whether people compare you to "cheaper guys"'] },
  { title: 'Follow-Through Confidence', main: 'Do customers stall or drop off after showing clear interest in moving forward?', think: ['Prospects who go quiet after a strong first conversation', 'Delays between "yes" signals and actual commitment', 'How often momentum dies at the last step'] },
  { title: 'Next-Step Clarity', main: 'Is it obvious what to do next?', think: ['Confusing websites', 'Too many competing buttons and offers', 'Missed calls or slow follow-ups'] },
  { title: 'Overall Brand Control', main: 'Do you feel in control of your growth?', think: ['How your brand shows up', 'How inquiries come in', 'How customers choose you'] },
];
const FLAGS = [
  "We're getting impressions and clicks but not enough calls",
  "People visit our website but don't reach out",
  'Prospects show interest then go quiet',
  'We win on quality but lose on price',
  "Proposals and follow-ups aren't closing the gap",
  'Our response time could be faster',
];
// Diagnostic page video slot. Sits UNDER the "Find My Failure Point" button and never
// autoplays (brief: no autoplay video above the primary CTA). To add the video: drop the
// .mp4 + poster .jpg in public/video/hub/ and fill this in. shape: 'vertical' (9:16) or
// 'wide' (16:9). While null, the preview shows a labeled placeholder frame.
// Never ship to production with DIAG_VIDEO = null.
const DIAG_VIDEO: null | { src: string; poster: string; caption: string; shape: 'vertical' | 'wide' } = null;
const REVENUE = ['Under $500,000', '$500,000 to $1 million', '$1 million to $3 million', '$3 million to $5 million', '$5 million to $10 million', 'More than $10 million'];
---
<Base
  title="Demand Collapse Diagnostic™ | Marketing Performance Group"
  description="Twelve questions, approximately ten minutes. See where demand is collapsing in your home-service business, then apply for a complimentary Five-Part Demand Recovery Plan™."
>
  <Nav />
  <main>

    <style>
      /* ─── Progress bar ─── */
      #sticky-bar {
        position: fixed; top: 56px; left: 0; right: 0; z-index: 90;
        background: rgba(255,255,255,0.92);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border);
        display: flex; align-items: center; justify-content: space-between;
        padding: 0 24px; height: 44px; font-size: 13px;
        transform: translateY(-100%); opacity: 0; pointer-events: none;
        transition: transform .25s ease, opacity .25s ease;
      }
      #sticky-bar.on { transform: none; opacity: 1; pointer-events: auto; }
      .bar-brand { font-family: var(--font-t); font-size: 12px; font-weight: 600; color: var(--graphite); opacity: 0.7; }
      .bar-right { display: flex; align-items: center; gap: 14px; }
      .bar-answered { color: var(--mid-gray); font-size: 12px; }
      .progress-track { width: 120px; height: 4px; background: var(--border); border-radius: 2px; overflow: hidden; }
      .progress-fill { height: 100%; background: var(--blue); border-radius: 2px; width: 0%; transition: width 0.3s ease; }

      .diag-wrap { max-width: 820px; margin: 0 auto; padding: 0 24px 100px; }
      .eyebrow {
        font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
        color: var(--blue); margin-bottom: 14px;
      }
      .h2 {
        font-family: var(--font-d); font-size: clamp(26px, 3.4vw, 36px); font-weight: 600;
        line-height: 1.12; letter-spacing: -0.015em; color: var(--graphite); margin-bottom: 14px;
      }
      .lede { font-size: 17px; line-height: 1.6; color: var(--mid-gray); letter-spacing: -0.015em; }
      .block { padding: 64px 0; border-top: 1px solid var(--border); }

      /* ─── Hero ─── */
      .hero { text-align: center; padding: 72px 0 48px; }
      .hero h1 {
        font-family: var(--font-d); font-size: clamp(32px, 4.6vw, 50px); font-weight: 600;
        line-height: 1.06; letter-spacing: -0.02em; color: var(--graphite);
        max-width: 760px; margin: 0 auto 22px;
      }
      .hero-copy { max-width: 620px; margin: 0 auto; display: flex; flex-direction: column; gap: 14px; }
      .hero-copy p { font-size: 18px; line-height: 1.55; color: var(--mid-gray); letter-spacing: -0.02em; }
      .hero-copy p strong { color: var(--graphite); font-weight: 600; }
      .btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        min-height: 48px; padding: 13px 26px; border-radius: var(--r-btn);
        background: var(--blue); color: #fff; border: 0; cursor: pointer;
        font-family: var(--font-t); font-size: 17px; font-weight: 500; letter-spacing: -0.02em;
        text-decoration: none; transition: background .15s;
      }
      .btn::after { content: "→"; transition: transform .2s; }
      .btn:hover { background: var(--blue-link); color: #fff; text-decoration: none; }
      .btn:hover::after { transform: translateX(3px); }
      .btn:focus-visible, .score-btn:focus-visible, .nav-btn:focus-visible, .field input:focus-visible,
      .field select:focus-visible, .field textarea:focus-visible, .link-btn:focus-visible {
        outline: 3px solid rgba(0,113,227,.45); outline-offset: 2px;
      }
      .btn[disabled] { opacity: .6; cursor: progress; }
      .btn-wide { width: 100%; }
      .hero-cta { margin-top: 30px; display: flex; flex-direction: column; align-items: center; gap: 12px; }
      .micro { font-size: 13px; color: var(--light-gray); letter-spacing: -0.01em; }

      /* ─── Diagnostic video slot (below the primary button, click to play) ─── */
      .d-video { margin: 36px auto 0; max-width: 300px; display: flex; flex-direction: column; gap: 10px; }
      .d-video--wide { max-width: 640px; }
      .d-video-frame {
        width: 100%; aspect-ratio: 9 / 16; background: #1d1d1f; border-radius: 8px; overflow: hidden;
        box-shadow: rgba(0,0,0,0.22) 3px 5px 30px 0px;
      }
      .d-video--wide .d-video-frame { aspect-ratio: 16 / 9; }
      .d-video-frame video { width: 100%; height: 100%; display: block; object-fit: cover; }
      .d-video-slot {
        display: flex; align-items: center; justify-content: center; text-align: center; box-shadow: none;
        background: repeating-linear-gradient(45deg, #f5f5f7 0 12px, #e8e8ed 12px 24px);
        border: 2px dashed #b0b0b5; font-size: 15px; font-weight: 600; color: var(--mid-gray);
      }
      .d-video figcaption { font-size: 12px; color: var(--light-gray); text-align: center; }

      /* ─── Proof strip ─── */
      .proof { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding: 8px 0 56px; }
      .proof a {
        display: block; background: var(--white); border: 1px solid var(--border); border-radius: 8px;
        padding: 20px 22px; text-decoration: none; transition: border-color .15s;
      }
      .proof a:hover { border-color: var(--blue); text-decoration: none; }
      .proof-client { font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--mid-gray); margin-bottom: 6px; }
      .proof-claim { font-family: var(--font-d); font-size: 18px; font-weight: 600; line-height: 1.3; color: var(--graphite); letter-spacing: -0.015em; }
      .proof-more { display: block; font-size: 13px; color: var(--blue-link); margin-top: 10px; }

      /* ─── Steps ─── */
      .steps { list-style: none; counter-reset: s; display: flex; flex-direction: column; gap: 22px; margin-top: 28px; }
      .steps li { counter-increment: s; display: grid; grid-template-columns: 40px 1fr; gap: 14px; }
      .steps li::before {
        content: counter(s); width: 34px; height: 34px; border-radius: 50%;
        border: 1.5px solid var(--blue); color: var(--blue); font-weight: 600; font-size: 15px;
        display: flex; align-items: center; justify-content: center;
      }
      .steps h3 { font-size: 17px; font-weight: 600; color: var(--graphite); margin-bottom: 3px; letter-spacing: -0.015em; }
      .steps p { font-size: 15px; line-height: 1.55; color: var(--mid-gray); }

      /* ─── Assessment ─── */
      #assessment { scroll-margin-top: 120px; }
      .instr {
        font-size: 14px; color: var(--mid-gray); background: var(--white);
        border: 1px solid var(--border); border-left: 3px solid var(--blue);
        padding: 12px 16px; border-radius: 0 6px 6px 0; margin: 22px 0 20px;
      }
      .instr strong { color: var(--graphite); }
      .q-card { background: var(--white); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
      .q-head { padding: 22px 28px 18px; border-bottom: 1px solid var(--border); background: var(--canvas); }
      .q-count { font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--mid-gray); margin-bottom: 10px; }
      .q-symptom { font-family: var(--font-d); font-size: 18px; font-weight: 600; color: var(--graphite); line-height: 1.3; letter-spacing: -0.02em; margin-bottom: 10px; }
      .q-fm {
        display: inline-block; font-size: 12px; font-weight: 600; color: var(--blue);
        background: rgba(0,113,227,0.08); border: 1px solid rgba(0,113,227,0.2);
        padding: 4px 11px; border-radius: 20px;
      }
      .q-body { padding: 24px 28px 26px; }
      .q-title { font-size: 19px; font-weight: 600; color: var(--graphite); margin-bottom: 4px; letter-spacing: -0.015em; }
      .q-main { font-size: 16px; color: var(--mid-gray); margin-bottom: 12px; }
      .think { list-style: none; margin-bottom: 20px; }
      .think li { font-size: 14px; color: var(--mid-gray); padding: 3px 0 3px 16px; position: relative; }
      .think li::before { content: '·'; position: absolute; left: 4px; color: var(--light-gray); font-weight: 700; }
      .score-row { display: grid; grid-template-columns: repeat(10, 1fr); gap: 6px; }
      .score-btn {
        min-width: 0; height: 48px; border: 1.5px solid var(--border); background: var(--canvas);
        color: var(--graphite); font-family: var(--font-t); font-size: 16px; font-weight: 600;
        border-radius: 8px; cursor: pointer; transition: all .12s ease;
      }
      .score-btn:hover { border-color: var(--blue); color: var(--blue); background: rgba(0,113,227,0.06); }
      .score-btn[aria-checked="true"] { background: var(--blue); border-color: var(--blue); color: #fff; box-shadow: inset 0 0 0 2px #fff; }
      .score-labels { display: flex; justify-content: space-between; margin-top: 8px; font-size: 12px; color: var(--mid-gray); }
      .q-nav { display: flex; justify-content: space-between; align-items: center; margin-top: 22px; gap: 12px; }
      .nav-btn {
        min-height: 44px; padding: 10px 20px; border-radius: var(--r-btn); cursor: pointer;
        font-family: var(--font-t); font-size: 15px; font-weight: 500;
        border: 1px solid var(--border); background: var(--white); color: var(--graphite);
      }
      .nav-btn.primary { background: var(--blue); border-color: var(--blue); color: #fff; }
      .nav-btn[disabled] { opacity: .4; cursor: default; }
      .q-saved { font-size: 12px; color: var(--light-gray); }

      /* ─── Result + application ─── */
      #result { margin-top: 28px; scroll-margin-top: 120px; }
      .panel {
        background: var(--white); border: 1px solid var(--border); border-top: 3px solid var(--blue);
        border-radius: 8px; padding: 36px;
      }
      .result-label { font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--blue); margin-bottom: 10px; }
      .result-fm { font-family: var(--font-d); font-size: clamp(26px, 3.6vw, 34px); font-weight: 600; line-height: 1.15; letter-spacing: -0.02em; color: var(--graphite); margin-bottom: 16px; }
      .result-p { font-size: 16px; line-height: 1.65; color: var(--mid-gray); margin-bottom: 14px; }
      .result-p strong { color: var(--graphite); }
      .secondary-note {
        font-size: 15px; line-height: 1.55; color: var(--graphite); background: var(--canvas);
        border: 1px solid var(--border); border-radius: 6px; padding: 14px 16px; margin: 6px 0 16px;
      }
      .offer { margin-top: 28px; padding-top: 28px; border-top: 1px solid var(--border); }
      .offer h3 { font-family: var(--font-d); font-size: 24px; font-weight: 600; line-height: 1.2; letter-spacing: -0.02em; color: var(--graphite); margin-bottom: 10px; }
      .five { list-style: none; margin: 14px 0 18px; display: flex; flex-direction: column; gap: 8px; }
      .five li { font-size: 16px; color: var(--graphite); padding-left: 26px; position: relative; }
      .five li::before { content: '✓'; position: absolute; left: 2px; color: var(--blue); font-weight: 700; }
      .keep { font-size: 15px; color: var(--graphite); font-weight: 600; margin-bottom: 22px; }
      .alt-row { margin-top: 18px; font-size: 14px; color: var(--mid-gray); text-align: center; line-height: 1.6; }
      .alt-row a { color: var(--blue-link); }

      /* ─── Form ─── */
      #apply { margin-top: 28px; padding-top: 28px; border-top: 1px solid var(--border); scroll-margin-top: 120px; }
      #apply h3 { font-family: var(--font-d); font-size: 22px; font-weight: 600; color: var(--graphite); margin-bottom: 6px; letter-spacing: -0.02em; }
      .form-intro { font-size: 15px; line-height: 1.55; color: var(--mid-gray); margin-bottom: 22px; }
      .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
      .field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
      .field label, .field legend { font-size: 14px; font-weight: 600; color: var(--graphite); }
      .field .opt { font-weight: 400; color: var(--mid-gray); }
      .field input, .field select, .field textarea {
        font-family: var(--font-t); font-size: 16px; color: var(--graphite);
        border: 1px solid var(--border); border-radius: 8px; background: var(--white);
        padding: 12px 14px; min-height: 48px; width: 100%;
      }
      .field textarea { min-height: 96px; resize: vertical; }
      .field.invalid input, .field.invalid select, .field.invalid textarea { border-color: #b3261e; }
      .err { font-size: 13px; color: #b3261e; display: none; }
      .err::before { content: '! '; font-weight: 700; }
      .field.invalid .err { display: block; }
      fieldset.field { border: 0; padding: 0; }
      .checks { display: flex; flex-direction: column; gap: 8px; margin-top: 4px; }
      .check { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; color: var(--graphite); line-height: 1.45; cursor: pointer; }
      .check input { width: 20px; height: 20px; min-height: 0; flex-shrink: 0; margin-top: 1px; accent-color: var(--blue); }
      .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
      .form-micro { font-size: 13px; color: var(--mid-gray); line-height: 1.55; margin-top: 12px; text-align: center; }
      .form-error { display: none; font-size: 14px; color: #b3261e; margin-top: 12px; text-align: center; }
      .form-error.on { display: block; }
      #success { margin-top: 28px; padding-top: 28px; border-top: 1px solid var(--border); text-align: center; }
      #success h3 { font-family: var(--font-d); font-size: 26px; font-weight: 600; color: var(--graphite); margin-bottom: 10px; }
      #success p { font-size: 16px; line-height: 1.6; color: var(--mid-gray); max-width: 560px; margin: 0 auto 22px; }

      /* ─── Value stack / why free / fit ─── */
      .docs { display: flex; flex-direction: column; gap: 14px; margin-top: 26px; }
      .doc { background: var(--white); border: 1px solid var(--border); border-radius: 8px; padding: 20px 22px; }
      .doc h3 { font-size: 17px; font-weight: 600; color: var(--graphite); margin-bottom: 4px; letter-spacing: -0.015em; }
      .doc p { font-size: 15px; line-height: 1.55; color: var(--mid-gray); }
      .keep-line { font-size: 16px; font-weight: 600; color: var(--graphite); margin-top: 22px; }
      .prose { display: flex; flex-direction: column; gap: 14px; margin-top: 18px; }
      .prose p { font-size: 17px; line-height: 1.6; color: var(--mid-gray); }
      .bul { list-style: none; display: flex; flex-direction: column; gap: 8px; margin: 4px 0; }
      .bul li { font-size: 17px; line-height: 1.5; color: var(--graphite); padding-left: 22px; position: relative; }
      .bul li::before { content: ''; position: absolute; left: 4px; top: 10px; width: 7px; height: 7px; border-radius: 50%; background: var(--blue); }
      .center-cta { text-align: center; margin-top: 30px; }

      @media (max-width: 640px) {
        .diag-wrap { padding: 0 16px 80px; }
        .hero { padding: 48px 0 36px; }
        .hero-copy p { font-size: 17px; }
        .proof { grid-template-columns: 1fr; }
        .q-head, .q-body { padding-left: 18px; padding-right: 18px; }
        .score-row { grid-template-columns: repeat(5, 1fr); gap: 8px; }
        .score-btn { height: 52px; font-size: 17px; }
        .panel { padding: 24px 18px; }
        .grid2 { grid-template-columns: 1fr; gap: 0; }
        #sticky-bar { padding: 0 16px; }
        .bar-brand { display: none; }
        .bar-right { width: 100%; justify-content: space-between; }
        .progress-track { flex: 1; }
      }
    </style>

    <!-- Progress bar (appears once the visitor reaches the assessment) -->
    <div id="sticky-bar" aria-hidden="true">
      <span class="bar-brand">Demand Collapse Diagnostic™</span>
      <div class="bar-right">
        <span class="bar-answered" id="bar-answered">0 of 12 answered</span>
        <div class="progress-track"><div class="progress-fill" id="progress-fill"></div></div>
      </div>
    </div>

    <div class="diag-wrap">

      <!-- 1. HERO -->
      <header class="hero">
        <div class="eyebrow">Complimentary for qualified home-service companies</div>
        <h1>Find where your demand is collapsing. Get the five-part plan to recover it.</h1>
        <div class="hero-copy">
          <p>Complete the 12-question Demand Collapse Diagnostic™ and see your primary failure mode immediately.</p>
          <p>If your company qualifies, Robbie will review your business, market and buyer journey and prepare a personalized Five-Part Demand Recovery Plan™ at no cost.</p>
          <p><strong>Not another automated score.</strong> Five working documents showing what is breaking, what to fix first and what to do over the next 30 to 120 days.</p>
        </div>
        <div class="hero-cta">
          <a href="#assessment" class="btn" id="hero-start">Find My Failure Point</a>
          <p class="micro">12 questions. Approximately 10 minutes. Your initial result appears immediately. No credit card.</p>
        </div>
        {DIAG_VIDEO ? (
          <figure class:list={['d-video', DIAG_VIDEO.shape === 'wide' && 'd-video--wide']}>
            <div class="d-video-frame">
              <video controls playsinline preload="metadata" poster={DIAG_VIDEO.poster}>
                <source src={DIAG_VIDEO.src} type="video/mp4" />
              </video>
            </div>
            {DIAG_VIDEO.caption && <figcaption>{DIAG_VIDEO.caption}</figcaption>}
          </figure>
        ) : (
          <figure class="d-video d-video--wide" data-placeholder="diagnostic-video">
            <div class="d-video-frame d-video-slot"><span>Diagnostic page video<br />goes here</span></div>
            <figcaption>Preview only. Plays on click, never autoplays. Swapped for the new video before launch.</figcaption>
          </figure>
        )}
      </header>

      <!-- 2. PROOF -->
      <div class="proof" aria-label="Client results">
        <a href="/case-studies/the-guttermen/">
          <div class="proof-client">The Guttermen</div>
          <div class="proof-claim">70 estimate bookings to 140 in 45 days.</div>
          <span class="proof-more">Read the full case study</span>
        </a>
        <a href="/case-studies/punch-list-pros/">
          <div class="proof-client">Punch List Pros</div>
          <div class="proof-claim">$5.20 in booked work for each Google Ads dollar in August 2026, based on uploaded closed-job values.</div>
          <span class="proof-more">Read the full case study</span>
        </a>
      </div>

      <!-- 3. HOW IT WORKS -->
      <section class="block">
        <div class="eyebrow">What happens next</div>
        <h2 class="h2">Start with the failure point. Then build the recovery plan.</h2>
        <p class="lede">The scorecard tells us where to investigate first. The personalized review confirms what is happening and turns it into a plan your company can execute.</p>
        <ol class="steps">
          <li><div><h3>Complete the diagnostic</h3><p>Score twelve questions across the four places demand can collapse.</p></div></li>
          <li><div><h3>See your preliminary result</h3><p>Your primary failure mode appears immediately.</p></div></li>
          <li><div><h3>Apply for your personalized plan</h3><p>If your company qualifies and your territory is available, Robbie reviews the business, market and buyer journey.</p></div></li>
          <li><div><h3>Receive the five-part recovery plan</h3><p>Walk through the diagnosis, market snapshot, fix sequence, prescription and recovery sprint with Robbie.</p></div></li>
          <li><div><h3>Choose how to implement it</h3><p>Use the plan yourself or ask Marketing Performance Group to implement it through EngageEngine™.</p></div></li>
        </ol>
      </section>

      <!-- 4. ASSESSMENT -->
      <section class="block" id="assessment" aria-labelledby="assess-h">
        <div class="eyebrow">Demand Collapse Diagnostic™</div>
        <h2 class="h2" id="assess-h">Twelve questions. One at a time.</h2>
        <div class="instr">Score what is <strong>consistently true</strong>, not your best day. 1 is lowest, 10 is highest.</div>

        <div class="q-card">
          {QUESTIONS.map((q, i) => {
            const s = SECTIONS[Math.floor(i / 3)];
            return (
              <div class="q-step" data-q={i} hidden={i !== 0}>
                <div class="q-head">
                  <div class="q-count">Question {i + 1} of 12</div>
                  <div class="q-symptom">{s.symptom}</div>
                  <span class="q-fm">Failure Mode {Math.floor(i / 3) + 1}: {s.name}</span>
                </div>
                <div class="q-body">
                  <div class="q-title" id={`q${i}-t`}>{q.title}</div>
                  <div class="q-main">{q.main}</div>
                  <ul class="think" aria-label="Think about">
                    {q.think.map(t => <li>{t}</li>)}
                  </ul>
                  <div class="score-row" role="radiogroup" aria-labelledby={`q${i}-t`} data-row={i}>
                    {Array.from({ length: 10 }, (_, k) => (
                      <button type="button" class="score-btn" role="radio" aria-checked="false" data-v={k + 1} tabindex={k === 0 ? 0 : -1} aria-label={`${k + 1} of 10`}>{k + 1}</button>
                    ))}
                  </div>
                  <div class="score-labels"><span>1, lowest</span><span>10, highest</span></div>
                  <div class="q-nav">
                    <button type="button" class="nav-btn" data-back disabled={i === 0}>Back</button>
                    <span class="q-saved">Answers are kept as you go.</span>
                    <button type="button" class="nav-btn primary" data-next disabled>{i === 11 ? 'See my result' : 'Next'}</button>
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        <!-- 5–6, 10–11. RESULT, BRIDGE, OFFER, APPLICATION, SUCCESS (revealed at 12 of 12) -->
        <div id="result" hidden>
          <div class="panel">
            <div class="result-label">Your preliminary failure mode</div>
            <h2 class="result-fm" id="result-fm" tabindex="-1"></h2>
            <p class="result-p">Based on your answers, this is the first place we would investigate. Your score identifies the likely failure point. It does not yet examine your company, market, competitive position or buyer-signal data.</p>
            <p class="secondary-note" id="secondary-note" hidden></p>
            <p class="result-p" id="bridge"></p>

            <div class="offer">
              <h3>Get the five-part plan built for your company and market.</h3>
              <p class="result-p">Robbie will review the evidence, confirm or correct the preliminary diagnosis and prepare your:</p>
              <ul class="five">
                <li>Demand Collapse Diagnosis</li>
                <li>Market Demand and Buyer-Signal Snapshot</li>
                <li>Fix Sequence Priority Matrix</li>
                <li>Prescription</li>
                <li>30-, 90- or 120-Day Recovery Sprint</li>
              </ul>
              <p class="keep">You keep the plan whether you implement it yourself or ask Marketing Performance Group to help.</p>
              <button type="button" class="btn btn-wide" id="open-apply" aria-expanded="false" aria-controls="apply">Apply for My Complimentary Plan</button>
              <p class="alt-row" id="alt-row">Not ready to apply? <a href="#" id="kit-link" download>Download the free toolkit for this failure mode</a> or <a href="#" id="fm-page-link">read more about it</a>.<br /><button type="button" class="link-btn" id="review-answers" style="background:none;border:0;color:var(--blue-link);cursor:pointer;font:inherit;padding:4px 0;">Review my answers</button></p>
            </div>

            <!-- APPLICATION -->
            <form id="apply" hidden novalidate>
              <h3>Tell us where to investigate.</h3>
              <p class="form-intro">The information below helps Robbie determine whether the plan is appropriate, whether the territory is available and what to review before the Demand Recovery Review.</p>

              <div class="grid2">
                <div class="field"><label for="f-name">Full name</label><input id="f-name" name="name" autocomplete="name" required /><span class="err">Enter your name.</span></div>
                <div class="field"><label for="f-email">Business email</label><input id="f-email" name="email" type="email" autocomplete="email" required /><span class="err">Enter a valid email address.</span></div>
                <div class="field"><label for="f-company">Company name</label><input id="f-company" name="company" autocomplete="organization" required /><span class="err">Enter your company name.</span></div>
                <div class="field"><label for="f-website">Website URL</label><input id="f-website" name="website" inputmode="url" autocomplete="url" placeholder="yourcompany.com" required /><span class="err">Enter your website address.</span></div>
                <div class="field"><label for="f-trade">Trade or primary service</label><input id="f-trade" name="trade" placeholder="HVAC, plumbing, roofing..." required /><span class="err">Enter your trade.</span></div>
                <div class="field"><label for="f-area">Primary service area</label><input id="f-area" name="service_area" placeholder="City, state or region" required /><span class="err">Enter your service area.</span></div>
                <div class="field">
                  <label for="f-revenue">Approximate annual revenue</label>
                  <select id="f-revenue" name="revenue_range" required>
                    <option value="">Select a range</option>
                    {REVENUE.map(r => <option value={r}>{r}</option>)}
                  </select>
                  <span class="err">Choose a revenue range.</span>
                </div>
                <div class="field"><label for="f-role">Your role in the company</label><input id="f-role" name="role" placeholder="Owner, GM, marketing lead..." required /><span class="err">Enter your role.</span></div>
              </div>
              <div class="field"><label for="f-problem">Largest current marketing or growth problem</label><textarea id="f-problem" name="largest_problem" required></textarea><span class="err">Tell us the problem you most want solved.</span></div>

              <fieldset class="field">
                <legend>Anything else that feels familiar? <span class="opt">(optional)</span></legend>
                <div class="checks">
                  {FLAGS.map(f => <label class="check"><input type="checkbox" name="flags" value={f} />{f}</label>)}
                </div>
              </fieldset>

              <div class="field" id="consent-field">
                <label class="check"><input type="checkbox" id="f-consent" name="review_permission" value="yes" required />I give Marketing Performance Group permission to review publicly available information about my business.</label>
                <span class="err">Permission is needed to prepare the plan.</span>
              </div>

              <div class="hp" aria-hidden="true"><label>Leave this empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label></div>

              <button type="submit" class="btn btn-wide" id="apply-submit">Request My Five-Part Plan</button>
              <p class="form-micro">No payment information. No obligation to hire Marketing Performance Group. Plans are prepared for qualified companies in available territories. <a href="/privacy">Privacy Policy</a></p>
              <p class="form-error" id="form-error" role="alert">That didn't go through. Try again, or email <a href="mailto:robert@marketingperformance.net">robert@marketingperformance.net</a>.</p>
            </form>

            <!-- SUCCESS -->
            <div id="success" hidden tabindex="-1">
              <h3>Your request has been received.</h3>
              <p>The next step is to reserve a Demand Recovery Review. Robbie will use the information you provided to prepare for the conversation and confirm whether a personalized plan is appropriate.</p>
              <a href="#" class="btn" id="schedule-btn" target="_blank" rel="noopener">Schedule My Demand Recovery Review</a>
            </div>
          </div>
        </div>
      </section>

      <!-- 7. VALUE STACK -->
      <section class="block">
        <div class="eyebrow">Five-Part Demand Recovery Plan™</div>
        <h2 class="h2">Five working documents. One clear order of attack.</h2>
        <div class="docs">
          <div class="doc"><h3>1. Your Demand Collapse Diagnosis</h3><p>See which of the four failure modes is costing you the most work and why the loss may not appear clearly in your reports.</p></div>
          <div class="doc"><h3>2. Your Market Demand and Buyer-Signal Snapshot</h3><p>See how demand is forming in your service area, where buyers appear to be in the decision journey and where your current marketing is failing to connect.</p></div>
          <div class="doc"><h3>3. Your Fix Sequence Priority Matrix</h3><p>Know what to fix first, what comes next and which tempting marketing projects should wait.</p></div>
          <div class="doc"><h3>4. Your Prescription</h3><p>Get the recommended correction for your primary failure mode, including what to do and what not to do.</p></div>
          <div class="doc"><h3>5. Your 30-, 90- or 120-Day Recovery Sprint</h3><p>Receive a week-by-week plan with actions, checkpoints and measurable targets.</p></div>
        </div>
        <p class="keep-line">You keep the complete plan whether or not you hire Marketing Performance Group to implement it.</p>
      </section>

      <!-- 8. WHY FREE -->
      <section class="block">
        <h2 class="h2">Why would we prepare this at no cost?</h2>
        <div class="prose">
          <p>Marketing Performance Group works with only one company per trade, per market.</p>
          <p>Before either of us commits to working together, we need to know three things:</p>
          <ul class="bul">
            <li>Where your demand is actually breaking down.</li>
            <li>Whether EngageEngine™ can materially improve it.</li>
            <li>Whether your territory is still available.</li>
          </ul>
          <p>The plan gives you a real answer. It also lets us determine whether we should work together.</p>
          <p>If you want to implement it yourself, it is yours. If you want us to implement it through EngageEngine™, we can discuss that after you have seen the plan.</p>
        </div>
      </section>

      <!-- 9. QUALIFICATION -->
      <section class="block">
        <h2 class="h2">Is this for you?</h2>
        <div class="prose">
          <p>The complimentary plan is designed for established HVAC, plumbing, roofing, landscaping and other home-service companies that:</p>
          <ul class="bul">
            <li>Generate approximately $500,000 to $10 million in annual revenue.</li>
            <li>Have a proven service and operating history.</li>
            <li>Want more booked work, not more marketing activity.</li>
            <li>Are prepared to act when the correct failure point is identified.</li>
            <li>Operate in a trade and market that remain available.</li>
          </ul>
          <p>Because every plan is researched and prepared individually, Marketing Performance Group accepts a limited number of qualified companies each month.</p>
        </div>
        <div class="center-cta"><a href="#assessment" class="btn" id="bottom-start">Find My Failure Point</a></div>
      </section>

    </div>
  </main>

  <Footer />

  <script>
    import { scoreDiagnostic } from '../lib/diagnostic-score.mjs';

    // Robbie's Cal.com booking page (replaced Calendly), 30-minute meeting.
    const SCHEDULE_URL = 'https://cal.com/robert-butt-xbwcl7/30min';
    const FORM_ENDPOINT = 'https://formspree.io/f/mnjlkyjo';

    const BRIDGE = [
      'Your answers suggest buyers may not be finding you at the moment they choose who to contact. The personalized review examines where your company appears, where competitors are intercepting demand and what must change first.',
      'Your answers suggest prospects are finding you but confidence is not forming quickly enough. The personalized review examines the signals that create doubt, inconsistency or hesitation before contact.',
      'Your answers suggest prospects believe you can do the work but still see competing companies as interchangeable. The personalized review examines why price and comparison remain in control of the decision.',
      'Your answers suggest prospects are choosing you mentally but failing to complete the next step. The personalized review examines response time, follow-up, calls to action and the friction between selection and booking.',
    ];
    const FM_PAGE = ['/diagnosis/not-seen/', '/diagnosis/not-trusted/', '/diagnosis/still-compared/', '/diagnosis/no-action/'];
    const FM_KIT  = ['fm1-toolkit.zip', 'fm2-toolkit.zip', 'fm3-toolkit.zip', 'fm4-toolkit.zip'];

    // Analytics: event names and the failure-mode label only. Never form fields.
    const fired = new Set<string>();
    function track(name: string, params: Record<string, unknown> = {}, once = true) {
      if (once && fired.has(name)) return;
      fired.add(name);
      const w = window as any;
      if (typeof w.gtag === 'function') w.gtag('event', name, params);
      if (typeof w.clarity === 'function') w.clarity('event', name);
    }

    const answers: (number | null)[] = new Array(12).fill(null);
    const steps = Array.from(document.querySelectorAll<HTMLElement>('.q-step'));
    const bar = document.getElementById('sticky-bar')!;
    const resultEl = document.getElementById('result')!;
    let current = 0;
    let result: ReturnType<typeof scoreDiagnostic> = null;

    track('diagnostic_view');

    function answeredCount() { return answers.filter(v => v !== null).length; }

    function updateProgress() {
      const n = answeredCount();
      document.getElementById('bar-answered')!.textContent = n + ' of 12 answered';
      (document.getElementById('progress-fill') as HTMLElement).style.width = (n / 12 * 100) + '%';
    }

    function show(i: number, focus = true) {
      current = i;
      steps.forEach((s, k) => { s.hidden = k !== i; });
      if (focus) {
        const sel = steps[i].querySelector<HTMLElement>('.score-btn[aria-checked="true"]')
          || steps[i].querySelector<HTMLElement>('.score-btn');
        sel?.focus({ preventScroll: true });
      }
    }

    function select(i: number, v: number) {
      const firstAnswer = answeredCount() === 0;
      answers[i] = v;
      const row = steps[i].querySelector('.score-row')!;
      row.querySelectorAll<HTMLButtonElement>('.score-btn').forEach(b => {
        const on = +b.dataset.v! === v;
        b.setAttribute('aria-checked', String(on));
        b.tabIndex = on ? 0 : -1;
      });
      (steps[i].querySelector('[data-next]') as HTMLButtonElement).disabled = false;
      updateProgress();
      if (firstAnswer) track('diagnostic_start', { via: 'first_answer' });
      if (answeredCount() >= 6) track('diagnostic_halfway');
      if (answeredCount() === 12) { finish(); return; }
      // Auto-advance to the next unanswered question.
      if (i < 11) setTimeout(() => show(i + 1), 220);
    }

    steps.forEach((step, i) => {
      const btns = Array.from(step.querySelectorAll<HTMLButtonElement>('.score-btn'));
      btns.forEach((b, k) => {
        b.addEventListener('click', () => select(i, +b.dataset.v!));
        b.addEventListener('keydown', e => {
          const dir = (e.key === 'ArrowRight' || e.key === 'ArrowDown') ? 1 : (e.key === 'ArrowLeft' || e.key === 'ArrowUp') ? -1 : 0;
          if (!dir) return;
          e.preventDefault();
          btns[(k + dir + 10) % 10].focus();
        });
      });
      step.querySelector('[data-back]')!.addEventListener('click', () => { if (i > 0) show(i - 1); });
      step.querySelector('[data-next]')!.addEventListener('click', () => {
        if (answers[i] === null) return;
        if (answeredCount() === 12) { finish(); return; }
        const next = answers.findIndex((v, k) => v === null && k > i);
        show(next === -1 ? answers.findIndex(v => v === null) : next);
      });
    });

    function finish() {
      result = scoreDiagnostic(answers as number[]);
      if (!result) return;
      const p = result.primary;
      document.getElementById('result-fm')!.textContent = p.name;
      document.getElementById('bridge')!.textContent = BRIDGE[p.idx];
      const sec = document.getElementById('secondary-note')!;
      if (result.secondary) {
        sec.textContent = result.tied
          ? `Your answers tie with ${result.secondary.name}. We would review both. ${p.name} is listed first because ${result.tieBrokenBy === 'lowest_answer' ? 'it holds your single lowest answer' : 'it happens earlier in the buyer journey, and demand lost there never reaches the later stages'}.`
          : `Close second: ${result.secondary.name}. Your scores for these two are within a couple of points, so the review would look at both.`;
        sec.hidden = false;
      } else {
        sec.hidden = true;
      }
      (document.getElementById('kit-link') as HTMLAnchorElement).href = '/downloads/' + FM_KIT[p.idx];
      (document.getElementById('fm-page-link') as HTMLAnchorElement).href = FM_PAGE[p.idx] + '?src=diagnostic';

      const wasHidden = resultEl.hidden;
      resultEl.hidden = false;
      if (wasHidden) {
        resultEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        (document.getElementById('result-fm') as HTMLElement).focus({ preventScroll: true });
      }
      const label = { failure_mode: p.name, secondary_mode: result.secondary?.name || 'none' };
      if (!fired.has('diagnostic_complete')) {
        track('diagnostic_complete', { ...label, fm1_score: result.sections[0].total, fm2_score: result.sections[1].total, fm3_score: result.sections[2].total, fm4_score: result.sections[3].total });
        // Completion notice to Robbie (scores only, no contact details exist yet).
        fetch(FORM_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({
            _subject: 'Diagnostic Completed: ' + p.name,
            primary_fm: p.name,
            secondary_fm: result.secondary?.name || 'none',
            fm1_not_seen: result.sections[0].total + ' / 30',
            fm2_not_trusted: result.sections[1].total + ' / 30',
            fm3_still_compared: result.sections[2].total + ' / 30',
            fm4_selected_no_action: result.sections[3].total + ' / 30',
          }),
        }).catch(() => {});
      }
      track('failure_mode_result_view', label);
    }

    // Hero / bottom "Find My Failure Point"
    ['hero-start', 'bottom-start'].forEach(id => document.getElementById(id)!.addEventListener('click', () => {
      track('diagnostic_start', { via: id });
      setTimeout(() => show(answers.findIndex(v => v === null) === -1 ? 11 : answers.findIndex(v => v === null)), 400);
    }));

    // Sticky progress bar only while the assessment is on screen.
    const assess = document.getElementById('assessment')!;
    new IntersectionObserver(([e]) => bar.classList.toggle('on', e.isIntersecting), { rootMargin: '-100px 0px -40% 0px' }).observe(assess);

    document.getElementById('review-answers')!.addEventListener('click', () => {
      show(0);
      assess.scrollIntoView({ behavior: 'smooth' });
    });
    document.getElementById('kit-link')!.addEventListener('click', () => track('toolkit_download', { failure_mode: result?.primary.name }, false));

    // ── Application ──
    const form = document.getElementById('apply') as HTMLFormElement;
    const openBtn = document.getElementById('open-apply') as HTMLButtonElement;
    openBtn.addEventListener('click', () => {
      form.hidden = false;
      openBtn.setAttribute('aria-expanded', 'true');
      openBtn.hidden = true;
      document.getElementById('alt-row')!.hidden = true;
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setTimeout(() => (document.getElementById('f-name') as HTMLInputElement).focus({ preventScroll: true }), 350);
      track('plan_application_start', { failure_mode: result?.primary.name });
    });

    function validate(): boolean {
      let firstBad: HTMLElement | null = null;
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[required]').forEach(el => {
        let ok: boolean;
        if (el instanceof HTMLInputElement && el.type === 'checkbox') ok = el.checked;
        else if (el.name === 'email') ok = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(el.value.trim());
        else if (el.name === 'website') ok = /^(https?:\/\/)?[^\s.]+\.[^\s]{2,}$/i.test(el.value.trim());
        else ok = el.value.trim().length > 0;
        const field = el.closest('.field') as HTMLElement;
        field.classList.toggle('invalid', !ok);
        el.setAttribute('aria-invalid', String(!ok));
        if (!ok && !firstBad) firstBad = el;
      });
      if (firstBad) (firstBad as HTMLElement).focus();
      return !firstBad;
    }
    form.addEventListener('input', e => {
      const f = (e.target as HTMLElement).closest('.field.invalid');
      if (f) { f.classList.remove('invalid'); }
    });

    form.addEventListener('submit', async e => {
      e.preventDefault();
      document.getElementById('form-error')!.classList.remove('on');
      if (!validate()) return;
      const btn = document.getElementById('apply-submit') as HTMLButtonElement;
      btn.disabled = true; btn.textContent = 'Sending...';
      const fd = new FormData(form);
      const payload: Record<string, unknown> = {
        _subject: 'Plan Application: ' + fd.get('company') + ' (' + result?.primary.name + ')',
        _replyto: fd.get('email'),
        name: fd.get('name'), email: fd.get('email'), company: fd.get('company'),
        website: fd.get('website'), trade: fd.get('trade'), service_area: fd.get('service_area'),
        revenue_range: fd.get('revenue_range'), role: fd.get('role'),
        largest_problem: fd.get('largest_problem'),
        familiar: fd.getAll('flags').join('; ') || 'none',
        review_permission: fd.get('review_permission') ? 'yes' : 'no',
        preliminary_fm: result?.primary.name,
        secondary_fm: result?.secondary?.name || 'none',
        section_scores: result ? result.sections.map(s => s.name + ' ' + s.total + '/30').join(' | ') : '',
        answers: answers.join(','),
        _gotcha: fd.get('_gotcha') || '',
      };
      try {
        const r = await fetch(FORM_ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!r.ok) throw new Error(String(r.status));
        form.hidden = true;
        const ok = document.getElementById('success')!;
        ok.hidden = false;
        ok.focus();
        ok.scrollIntoView({ behavior: 'smooth', block: 'center' });
        track('plan_application_submit', { failure_mode: result?.primary.name });
      } catch {
        document.getElementById('form-error')!.classList.add('on');
        btn.disabled = false; btn.textContent = 'Request My Five-Part Plan';
      }
    });

    const sched = document.getElementById('schedule-btn') as HTMLAnchorElement;
    sched.href = SCHEDULE_URL;
    sched.addEventListener('click', () => track('recovery_review_schedule_click', { failure_mode: result?.primary.name }));

    updateProgress();
  </script>

</Base>
