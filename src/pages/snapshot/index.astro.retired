---
export const prerender = false
import Base from '../../layouts/Base.astro'
import Footer from '../../components/Footer.astro'
import ProofCards from '../../components/ProofCards.astro'

// The OTHER 9 trades (not shown on the home page), so a cold visitor sees the
// whole book winning, not the same nine. Numbers = jobs 2023 -> 2025 total growth
// from share-line-job-counts-variable-growth.csv (verified; market-volume comparator).
const snapshotCards = [
  { trade: 'Pools',            loc: 'Columbia',            num: '+26%', unit: 'more installs', market: 'while pools fell 50%',      down: true },
  { trade: 'Docks & decks',    loc: 'Santee Cooper',       num: '+23%', unit: 'more builds',   market: 'while the market shrank',   down: true },
  { trade: 'Masonry',          loc: 'Columbia',            num: '+18%', unit: 'more jobs',      market: 'in a flat market',         down: false },
  { trade: 'Landscape design', loc: 'Columbia',            num: '+21%', unit: 'more jobs',      market: 'in a flat market',         down: false },
  { trade: 'Water-well',       loc: 'Columbia',            num: '+14%', unit: 'more jobs',      market: 'in a flat market',         down: false },
  { trade: 'Handyman',         loc: 'Columbia',            num: '+23%', unit: 'more jobs',      market: 'in a flat market',         down: false },
  { trade: 'Plumbing',         loc: 'Columbia',            num: '+27%', unit: 'more jobs',      market: 'in a slow market',         down: false },
  { trade: 'Glass',            loc: 'Columbia',            num: '+16%', unit: 'more jobs',      market: 'in a slow market',         down: false },
  { trade: 'Dumpster rental',  loc: 'Columbia & Augusta',  num: '+23%', unit: 'more hauls',     market: 'in a flat market',         down: false },
];

const cf = (Astro.locals as any).runtime?.cf
const detectedCity   = cf?.city   || ''
const detectedRegion = cf?.region || cf?.regionCode || ''
const detectedLocation = detectedCity
  ? (detectedRegion ? `${detectedCity}, ${detectedRegion}` : detectedCity)
  : ''
const displayMarket = detectedLocation || 'your market'
---
<Base
  title="See If Your Trade Is Still Open — Marketing Performance Group"
  description="One company per trade, per market. Type your trade and your city to see the work moving in your market and whether your seat is still open. 41 years in the industry, 31 running Marketing Performance."
>
  <!-- Minimal top nav — logo only -->
  <nav class="mp-nav">
    <div class="mp-nav-inner">
      <a href="/" class="mp-logo">
        <img src="/mp-logo-v3.png" alt="Marketing Performance — Powered by EngageEngine™" width="217" height="44" />
      </a>
    </div>
  </nav>

  <main class="mp">

    <!-- ═══ 1. HERO — copy left, LIVE FORM right ═══ -->
    <section class="mp-hero">
      <div class="mp-hero-grid">
        <div class="mp-hero-copy">
          <h1 class="mp-h1">
            One company per trade in {displayMarket}.<br />See if yours is still open.
          </h1>
          <p class="mp-hero-punch">
            Type your trade. We'll show you the work moving in your market, and whether the seat is still yours to take.
          </p>

        </div>

        <!-- SEAT-CHECK TOOL — market size + seat status, computed live -->
        <div class="snap-card" id="snap-form-card">
          <div class="snap-card-head">
            <span class="snap-card-eye">Free Market Check</span>
            <span class="snap-card-loc">{detectedLocation ? `Detected: ${detectedLocation}` : 'Enter your market'}</span>
          </div>

          <form id="snapshot-form" class="snap-form" novalidate>
            <label class="snap-field-label" for="service-input">Your trade</label>
            <input
              type="text"
              name="trade"
              id="service-input"
              placeholder="Roofing, plumbing, landscaping…"
              required
              class="snap-input"
              autocomplete="off"
              inputmode="text"
            />

            <label class="snap-field-label" for="city-input">Your market</label>
            <input
              type="text"
              name="city"
              id="city-input"
              placeholder="City, state"
              required
              class="snap-input"
              autocomplete="off"
              value={detectedLocation}
            />

            <button type="submit" class="snap-btn" id="snap-submit">
              <span>Check my market</span>
              <span class="snap-btn-arrow">→</span>
            </button>

            <div class="snap-scarcity">
              <span class="snap-scarcity-dot"></span>
              <span><strong>One company per trade, per market.</strong> Once your competitor locks it, you can't.</span>
            </div>
          </form>

          <!-- Result, filled by JS after Check my market -->
          <div class="snap-result" id="snap-result" hidden></div>
        </div>
      </div>
    </section>

    <!-- ═══ 1.5 PROOF — Share-Line wall (the other 9 trades, not the home page's) ═══ -->
    <section class="mp-proof">
      <header class="mp-proof-head" data-animate>
        <h2 class="mp-proof-h">The market didn't grow. Our clients did.</h2>
      </header>
    </section>
    <ProofCards cards={snapshotCards} foot="Nine different trades. Same story: the market isn't making new jobs, so every extra one came off a competitor's schedule." />

    <!-- Sections 2-9 removed 2026-07-17: this is a lean landing page supporting the home page, not a second site. Proof/founder/engine/results/guarantee/pricing all live on / now. -->

    <!-- ═══ 10. CLOSE — CTA scrolls to top form ═══ -->
    <section class="mp-close">
      <h2 class="mp-close-h1" data-animate>One company per trade. Per market.</h2>
      <p class="mp-close-h2" data-animate data-delay="0.05">The only question is whether yours is still open.</p>
      <p class="mp-close-body" data-animate data-delay="0.1">Every month this runs without you, the contractor across town is booking the jobs the market isn't creating. The day he locks your trade, we start sending him the work. Check your market now.</p>
      <div class="mp-close-cta" data-animate data-delay="0.2">
        <a href="#snap-form-card" class="mp-btn-primary" id="close-cta">See If My Trade Is Still Open</a>
        <p class="mp-micro">30 seconds. No email.</p>
      </div>
    </section>

  </main>
  <Footer />

  <script define:vars={{ detectedLocation }}>
    // ── Market model (Census households x per-trade rate x avg job value) ──
    const TRADES = {
      'metal roof': { rate: 0.04, job: 12000, label: 'metal roofing' },
      roofing:      { rate: 0.04,  job: 10000, label: 'roofing' },
      roof:         { rate: 0.04,  job: 10000, label: 'roofing' },
      gutter:       { rate: 0.035, job: 1850,  label: 'gutter' },
      plumb:        { rate: 0.18,  job: 425,   label: 'plumbing' },
      hvac:         { rate: 0.10,  job: 900,   label: 'HVAC' },
      'landscape design': { rate: 0.035, job: 7000, label: 'landscape design' },
      landscap:     { rate: 0.25,  job: 1400,  label: 'landscaping' },
      lawn:         { rate: 0.25,  job: 1400,  label: 'lawn care' },
      irrigation:   { rate: 0.10,  job: 1600,  label: 'irrigation' },
      window:       { rate: 0.05,  job: 6500,  label: 'window & door' },
      door:         { rate: 0.05,  job: 6500,  label: 'window & door' },
      fenc:         { rate: 0.03,  job: 4200,  label: 'fencing' },
      well:         { rate: 0.015, job: 7500,  label: 'water-well drilling' },
      drill:        { rate: 0.015, job: 7500,  label: 'water-well drilling' },
      paint:        { rate: 0.08,  job: 2600,  label: 'painting' },
      mason:        { rate: 0.04,  job: 6500,  label: 'masonry' },
      stone:        { rate: 0.04,  job: 6500,  label: 'stone & masonry' },
      pool:         { rate: 0.008, job: 55000, label: 'pool' },
      glass:        { rate: 0.07,  job: 425,   label: 'glass' },
      dumpster:     { rate: 0.02,  job: 475,   label: 'dumpster rental' },
      handyman:     { rate: 0.40,  job: 650,   label: 'handyman' },
      deck:         { rate: 0.03,  job: 8000,  label: 'deck & dock' },
      dock:         { rate: 0.03,  job: 8000,  label: 'deck & dock' },
    };
    const DEFAULT_TRADE = { rate: 0.06, job: 3000, label: '' };

    // Owner-occupied single-family households by metro (Census-derived).
    const METROS = {
      'columbia':     { hh: 195000,  label: 'Columbia' },
      'charleston':   { hh: 219000,  label: 'Charleston' },
      'greenville':   { hh: 247000,  label: 'Greenville' },
      'myrtle':       { hh: 166000,  label: 'Myrtle Beach' },
      'florence':     { hh: 120000,  label: 'Florence' },
      'augusta':      { hh: 143000,  label: 'Augusta' },
      'atlanta':      { hh: 1361000, label: 'Atlanta' },
      'charlotte':    { hh: 620000,  label: 'Charlotte' },
      'raleigh':      { hh: 520000,  label: 'Raleigh' },
      'savannah':     { hh: 130000,  label: 'Savannah' },
    };
    const DEFAULT_METRO_HH = 180000;

    // Seats already held (trade label | metro key) — the real book.
    const TAKEN = {
      'roofing|columbia':1,'gutter|columbia':1,'plumbing|columbia':1,'landscaping|columbia':1,
      'lawn care|columbia':1,'landscape design|columbia':1,'fencing|columbia':1,
      'water-well drilling|columbia':1,'masonry|columbia':1,'stone & masonry|columbia':1,
      'pool|columbia':1,'glass|columbia':1,'painting|columbia':1,'window & door|columbia':1,
      'dumpster rental|columbia':1,'handyman|columbia':1,'deck & dock|columbia':1,
      'fencing|charleston':1,'masonry|charleston':1,'stone & masonry|charleston':1,
      'water-well drilling|greenville':1,'pool|myrtle':1,'pool|florence':1,
      'dumpster rental|augusta':1,'metal roofing|atlanta':1,
    };

    const form    = document.getElementById('snapshot-form');
    const tInput  = document.getElementById('service-input');
    const cInput  = document.getElementById('city-input');
    const result  = document.getElementById('snap-result');
    const closeCta = document.getElementById('close-cta');

    const params = new URLSearchParams(window.location.search);
    const pTrade = params.get('trade') || params.get('service') || '';
    if (pTrade && tInput) tInput.value = pTrade;
    const pCity = params.get('city_state') || params.get('city') || '';
    if (pCity && cInput && !cInput.value) cInput.value = pCity;

    closeCta?.addEventListener('click', (e) => {
      e.preventDefault();
      document.getElementById('snap-form-card')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setTimeout(() => tInput?.focus(), 500);
    });

    function matchTrade(s) {
      s = s.toLowerCase();
      for (const k in TRADES) { if (s.includes(k)) return TRADES[k]; }
      return { ...DEFAULT_TRADE, label: s.trim() };
    }
    function matchMetro(s) {
      const low = s.toLowerCase();
      for (const k in METROS) { if (low.includes(k)) return { ...METROS[k], key: k }; }
      const label = (s.split(',')[0] || 'your market').trim().replace(/\b\w/g, c => c.toUpperCase());
      return { hh: DEFAULT_METRO_HH, label, key: label.toLowerCase(), est: true };
    }
    function fmtMoney(n) {
      if (n >= 1e6) return '$' + (n / 1e6).toFixed(n >= 1e7 ? 0 : 1) + 'M';
      return '$' + Math.round(n / 1000) + 'K';
    }
    const esc = (v) => (v || '').replace(/[<>"]/g, '');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const tv = (tInput.value || '').trim();
      const cv = (cInput.value || '').trim();
      if (!tv) { tInput.focus(); return; }
      if (!cv) { cInput.focus(); return; }

      const trade = matchTrade(tv);
      const metro = matchMetro(cv);
      const tl = trade.label || tv.toLowerCase();
      const jobs = Math.round((metro.hh * trade.rate) / 100) * 100;
      const value = jobs * trade.job;
      const taken = !!TAKEN[tl + '|' + metro.key];

      if (typeof gtag !== 'undefined') gtag('event', 'market_check', { market: cv, trade: tv });
      if (typeof fbq !== 'undefined') fbq('track', 'Lead', { content_name: 'Market Check', content_category: tv });

      const status = taken
        ? '<div class="snap-r-status snap-r-taken"><strong>This seat is taken.</strong> A ' + tl + ' company already holds ' + metro.label + '. That is the whole point. When the other guy calls, we tell him it is gone.</div>'
        : '<div class="snap-r-status snap-r-open"><strong>Your trade is still open in ' + metro.label + '.</strong> Lock it, and the guy across town can\'t.</div>';

      const btnLabel = taken ? 'Get on the list for ' + metro.label : 'Lock ' + metro.label;

      result.innerHTML =
        '<p class="snap-r-eye">' + metro.label + (metro.est ? ' (est.)' : '') + ' &middot; ' + tl + '</p>' +
        '<p class="snap-r-num">~' + jobs.toLocaleString() + '</p>' +
        '<p class="snap-r-unit">' + tl + ' jobs a year in this market</p>' +
        '<p class="snap-r-val">About ' + fmtMoney(value) + ' in ' + tl + ' work a year. The market isn\'t making more of it. It is getting split.</p>' +
        status +
        '<form id="lock-form" class="snap-lock">' +
          '<input type="hidden" name="trade" value="' + esc(tv) + '" />' +
          '<input type="hidden" name="market" value="' + esc(cv) + '" />' +
          '<input type="hidden" name="request_type" value="lock_market" />' +
          '<input type="text" name="name" placeholder="Your name" required class="snap-input" autocomplete="name" />' +
          '<input type="email" name="email" placeholder="Email" required class="snap-input" autocomplete="email" />' +
          '<input type="tel" name="phone" placeholder="Phone" required class="snap-input" autocomplete="tel" />' +
          '<button type="submit" class="snap-btn"><span>' + btnLabel + '</span><span class="snap-btn-arrow">&rarr;</span></button>' +
          '<p class="snap-micro">We confirm availability and call you. No obligation.</p>' +
        '</form>';
      result.hidden = false;
      result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

      const lockForm = document.getElementById('lock-form');
      lockForm?.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const btn = lockForm.querySelector('button');
        const span = btn.querySelector('span');
        btn.disabled = true; span.textContent = 'Sending…';
        try {
          await fetch('https://formspree.io/f/mgodnjje', {
            method: 'POST', headers: { 'Accept': 'application/json' }, body: new FormData(lockForm),
          });
          if (typeof gtag !== 'undefined') gtag('event', 'lock_market_submit', { market: cv, trade: tv });
          if (typeof fbq !== 'undefined') fbq('track', 'Lead', { content_name: 'Lock Market', content_category: tv });
          result.innerHTML = '<p class="snap-r-eye">' + metro.label + ' &middot; ' + tl + '</p><p class="snap-r-num">&check;</p><p class="snap-r-unit">You are in. We confirm ' + metro.label + ' is open and call you.</p>';
        } catch (err) {
          btn.disabled = false; span.textContent = 'Try again';
        }
      });
    });
  </script>
</Base>

<style>
  /* ═══════════════════════════════════════════════════════
     /snapshot — homepage content + live form in hero
     Reuses all .mp-* styles from homepage; only adds .snap-* form styles
     ═══════════════════════════════════════════════════════ */

  /* ─── Top nav (logo only) — matches / ─── */
  .mp-nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(255,255,255,0.72);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .mp-nav-inner {
    max-width: 1280px; margin: 0 auto;
    padding: 0 32px; height: 56px;
    display: flex; align-items: center;
  }
  .mp-logo {
    display: flex; align-items: center;
    min-height: 44px; text-decoration: none;
  }
  .mp-logo img { height: 44px; width: auto; display: block; }
  .mp-logo:hover { text-decoration: none; }
  @media (max-width: 600px) {
    .mp-logo img { height: 34px; }
  }

  /* ─── Page base ─── */
  .mp { background: var(--canvas); color: var(--graphite); }
  .mp h1, .mp h2 { font-family: var(--font-d); color: var(--graphite); }
  .mp p { color: var(--graphite); }

  /* ─── Primary button ─── */
  .mp-btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--blue); color: #fff;
    font-family: var(--font-t); font-size: 17px;
    font-weight: 400; letter-spacing: -0.022em;
    padding: 12px 24px; border-radius: 980px;
    text-decoration: none; transition: background 0.2s;
    line-height: 1; border: none; cursor: pointer;
  }
  .mp-btn-primary:hover { background: var(--blue-link); text-decoration: none; color: #fff; }
  .mp-btn-primary::after {
    content: "→"; font-size: 17px; line-height: 1;
    transition: transform 0.2s;
  }
  .mp-btn-primary:hover::after { transform: translateX(3px); }

  /* ─── Eyebrows + headings (shared) ─── */
  .mp-eye {
    font-family: var(--font-t);
    font-size: 12px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--blue); margin-bottom: 16px;
  }
  .mp-h1 {
    font-family: var(--font-d);
    font-size: clamp(36px, 4.2vw, 52px);
    font-weight: 600; line-height: 1.05;
    letter-spacing: -0.022em; color: var(--graphite);
    margin-bottom: 14px;
  }
  .mp-h2 {
    font-family: var(--font-d);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600; line-height: 1.07;
    letter-spacing: -0.018em; color: var(--graphite);
    margin-bottom: 20px;
    max-width: 760px;
  }
  .mp-lede {
    font-family: var(--font-t);
    font-size: 21px; line-height: 1.4;
    letter-spacing: -0.022em; color: var(--mid-gray);
    max-width: 680px;
  }
  .mp-micro {
    font-family: var(--font-t);
    font-size: 13px; color: var(--light-gray);
    letter-spacing: -0.015em;
  }
  .mp-section-head { margin-bottom: 48px; }
  .mp-section-head.mp-center { text-align: center; }
  .mp-section-head.mp-center .mp-h2,
  .mp-section-head.mp-center .mp-lede { margin-left: auto; margin-right: auto; }

  /* ─── HERO ─── */
  .mp-hero {
    padding: 56px 32px 48px;
    background: var(--canvas);
  }
  .mp-hero-grid {
    max-width: 1320px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr; gap: 56px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .mp-hero-grid {
      grid-template-columns: minmax(360px, 460px) minmax(0, 1fr);
      gap: 64px;
    }
  }
  .mp-hero-copy { max-width: 460px; }
  .mp-hero-punch {
    font-family: var(--font-d);
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 500; line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--blue); margin-bottom: 24px;
  }
  .mp-hero-sub {
    font-family: var(--font-t);
    font-size: 19px; line-height: 1.5;
    letter-spacing: -0.022em;
    color: var(--mid-gray);
    max-width: 540px; margin-bottom: 36px;
  }
  .mp-hero-prose {
    display: flex; flex-direction: column;
    gap: 14px;
    max-width: 540px;
    margin-bottom: 36px;
  }
  .mp-hero-prose p {
    font-family: var(--font-t);
    font-size: 17px; line-height: 1.55;
    letter-spacing: -0.022em;
    color: var(--mid-gray);
  }
  .mp-hero-prose p strong {
    color: var(--blue); font-weight: 600;
  }
  .mp-hero-prose-close {
    color: var(--graphite) !important;
    font-weight: 500;
  }
  .mp-hero-trust {
    display: flex; flex-direction: column; gap: 14px;
    padding-top: 24px; border-top: 1px solid var(--border);
  }
  .mp-guarantee-chip {
    display: inline-flex; align-items: center; gap: 10px;
    align-self: flex-start;
    padding: 8px 14px;
    background: var(--white); border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-t);
    font-size: 13px; color: var(--graphite);
    letter-spacing: -0.01em;
  }
  .mp-guarantee-chip strong { font-weight: 600; }
  .mp-chip-check {
    width: 18px; height: 18px; border-radius: 50%;
    background: var(--blue); color: #fff;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 700;
  }
  .mp-cred-line {
    font-family: var(--font-t);
    font-size: 14px; line-height: 1.5;
    letter-spacing: -0.015em;
    color: var(--mid-gray); max-width: 500px;
  }
  .mp-cred-line strong { color: var(--graphite); font-weight: 600; }

  /* ─── SNAPSHOT FORM CARD (hero right column) ─── */
  .snap-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 32px 36px;
    box-shadow: var(--shadow-xl, rgba(0,0,0,0.22) 3px 5px 30px 0px);
    justify-self: stretch;
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
  }
  .snap-card-head {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 22px;
    gap: 12px; flex-wrap: wrap;
  }
  .snap-card-eye {
    font-family: var(--font-t);
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--blue);
  }
  .snap-card-loc {
    font-family: var(--font-m);
    font-size: 12px; color: var(--mid-gray);
    letter-spacing: 0.02em;
  }
  .snap-form { display: flex; flex-direction: column; }
  .snap-sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }
  .snap-sentence {
    font-family: var(--font-d);
    font-size: clamp(20px, 2.2vw, 24px);
    line-height: 1.4;
    letter-spacing: -0.018em;
    color: var(--graphite);
    margin: 4px 0 22px;
  }
  .snap-sentence strong {
    color: var(--graphite);
    font-weight: 600;
  }
  .snap-inline-input {
    background: transparent;
    border: none;
    border-bottom: 2px solid var(--blue);
    border-radius: 0;
    font-family: var(--font-d);
    font-size: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    color: var(--blue);
    font-weight: 600;
    padding: 0 6px 2px;
    margin: 0 2px;
    min-width: 160px;
    max-width: 100%;
    outline: none;
    -webkit-appearance: none;
    transition: border-color 0.15s;
    display: inline-block;
    vertical-align: baseline;
  }
  .snap-inline-input::placeholder {
    color: var(--light-gray);
    font-weight: 400;
    font-style: italic;
  }
  .snap-inline-input:focus {
    border-bottom-color: var(--graphite);
  }
  .snap-label {
    font-family: var(--font-t);
    font-size: 13px; font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--graphite); margin-bottom: 10px;
  }
  .snap-input {
    width: 100%;
    background: var(--canvas);
    border: 1px solid var(--border);
    border-radius: 0;
    color: var(--graphite);
    font-family: var(--font-t);
    font-size: 17px;
    letter-spacing: -0.022em;
    padding: 14px 16px;
    margin-bottom: 18px;
    outline: none;
    -webkit-appearance: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .snap-input::placeholder { color: var(--light-gray); }
  .snap-input:focus {
    border-color: var(--blue);
    background: var(--white);
  }
  .snap-btn {
    width: 100%;
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    background: var(--blue); color: #fff;
    font-family: var(--font-t);
    font-size: 17px; font-weight: 400;
    letter-spacing: -0.022em;
    padding: 14px 20px;
    border: none; border-radius: 980px;
    cursor: pointer; line-height: 1;
    transition: background 0.2s;
  }
  .snap-btn:hover { background: var(--blue-link); }
  .snap-btn:disabled { opacity: 0.6; cursor: wait; }
  .snap-btn-arrow {
    display: inline-block; transition: transform 0.2s;
  }
  .snap-btn:hover .snap-btn-arrow { transform: translateX(3px); }
  .snap-micro {
    font-family: var(--font-t);
    font-size: 12px; color: var(--light-gray);
    letter-spacing: -0.015em;
    text-align: center;
    margin-top: 12px;
  }
  .snap-scarcity {
    display: flex; align-items: flex-start; gap: 10px;
    margin-top: 22px; padding: 12px 14px;
    background: rgba(214,40,40,0.05);
    border: 1px solid rgba(214,40,40,0.2);
    border-radius: 8px;
    font-family: var(--font-t);
    font-size: 13px; line-height: 1.45;
    color: var(--graphite);
    letter-spacing: -0.015em;
  }
  .snap-scarcity strong { color: #d62828; font-weight: 600; }
  .snap-scarcity-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: #d62828; flex-shrink: 0;
    margin-top: 6px;
    animation: snapPulse 1.6s ease-in-out infinite;
  }
  @keyframes snapPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.35); }
  }

  /* ─── Seat-check result ─── */
  .snap-field-label {
    font-family: var(--font-t);
    font-size: 13px; font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--graphite); margin-bottom: 8px;
  }
  .snap-result {
    margin-top: 26px; padding-top: 24px;
    border-top: 1px solid var(--border);
  }
  .snap-r-eye {
    font-family: var(--font-t);
    font-size: 12px; font-weight: 600;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--mid-gray);
  }
  .snap-r-num {
    font-family: var(--font-d);
    font-size: clamp(48px, 8vw, 68px);
    font-weight: 600; letter-spacing: -0.03em; line-height: 1;
    color: var(--graphite); margin-top: 6px;
  }
  .snap-r-unit {
    font-family: var(--font-t);
    font-size: 15px; color: var(--mid-gray); margin-top: 6px;
  }
  .snap-r-val {
    font-family: var(--font-t);
    font-size: 14px; line-height: 1.5;
    color: var(--graphite); margin-top: 14px; letter-spacing: -0.01em;
  }
  .snap-r-status {
    margin-top: 16px; padding: 14px 16px;
    font-family: var(--font-t);
    font-size: 14px; line-height: 1.5;
    letter-spacing: -0.01em; border-radius: 8px;
  }
  .snap-r-open { background: rgba(0,113,227,0.06); border: 1px solid rgba(0,113,227,0.25); }
  .snap-r-open strong { color: var(--blue); }
  .snap-r-taken { background: rgba(179,53,46,0.06); border: 1px solid rgba(179,53,46,0.25); }
  .snap-r-taken strong { color: #b3352e; }
  .snap-lock { display: flex; flex-direction: column; margin-top: 20px; }

  /* ─── PROOF ARTIFACT (HVAC intent screenshot) ─── */
  .mp-proof {
    padding: 56px 32px 8px;
    background: var(--canvas);
  }
  .mp-proof-head {
    max-width: 880px;
    margin: 0 auto 24px;
    text-align: center;
  }
  .mp-proof-h {
    font-family: var(--font-d);
    font-size: clamp(28px, 3.6vw, 40px);
    font-weight: 600; line-height: 1.1;
    letter-spacing: -0.018em;
    color: var(--graphite);
  }
  .mp-proof-inner {
    max-width: 1080px;
    margin: 0 auto;
    display: flex; flex-direction: column;
    align-items: center;
    gap: 22px;
  }
  .mp-proof-img,
  .mp-proof-video {
    width: 100%; height: auto;
    border-radius: 8px;
    box-shadow: var(--shadow-xl, rgba(0,0,0,0.22) 3px 5px 30px 0px);
    background: var(--white);
    display: block;
  }
  .mp-proof-img { aspect-ratio: 2882 / 1472; }
  .mp-proof-video {
    aspect-ratio: 1280 / 800;
    object-fit: cover;
    background: #0a0a0a;
  }
  .mp-proof-cap {
    display: flex; flex-direction: column;
    align-items: center; text-align: center;
    gap: 4px;
  }
  .mp-proof-cap-main {
    font-family: var(--font-t);
    font-size: 14px;
    letter-spacing: -0.018em;
    color: var(--mid-gray);
  }
  .mp-proof-cap-main strong {
    color: var(--graphite);
    font-weight: 600;
  }
  .mp-proof-cap-sub {
    font-family: var(--font-t);
    font-size: 13px;
    letter-spacing: -0.015em;
    color: var(--light-gray);
  }

  /* ─── ANCHOR TESTIMONIALS ─── */
  .mp-anchor {
    background: var(--white);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 48px 32px;
  }
  .mp-anchor-alt { background: var(--canvas); }
  .mp-anchor-inner {
    max-width: 960px; margin: 0 auto;
    display: flex; align-items: center; gap: 32px;
  }
  .mp-anchor-photo {
    width: 80px; height: 80px;
    border-radius: 50%;
    background: var(--canvas);
    border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-d);
    font-size: 22px; font-weight: 600;
    color: var(--mid-gray);
    flex-shrink: 0;
    overflow: hidden;
  }
  .mp-anchor-photo img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  .mp-anchor-quote {
    font-family: var(--font-d);
    font-size: 22px; line-height: 1.36;
    letter-spacing: -0.022em;
    color: var(--graphite);
    font-weight: 400;
    margin-bottom: 12px;
  }
  .mp-anchor-attr {
    font-family: var(--font-t);
    font-size: 14px; color: var(--mid-gray);
    margin-bottom: 8px; letter-spacing: -0.018em;
  }
  .mp-anchor-attr strong { color: var(--graphite); font-weight: 600; }
  .mp-anchor-stats {
    font-family: var(--font-t);
    font-size: 13px; color: var(--blue-link);
    letter-spacing: -0.015em;
    display: flex; flex-wrap: wrap; gap: 8px;
  }
  .mp-anchor-stats strong { font-weight: 600; }
  .mp-dot { color: var(--light-gray); }
  @media (max-width: 640px) {
    .mp-anchor-inner { flex-direction: column; align-items: flex-start; }
  }

  /* ─── FOUNDER ─── */
  .mp-founder {
    padding: 96px 32px;
    background: var(--canvas);
  }
  .mp-founder-inner {
    max-width: 960px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr; gap: 36px;
    align-items: center;
  }
  @media (min-width: 768px) {
    .mp-founder-inner {
      grid-template-columns: 280px 1fr;
      gap: 56px;
    }
  }
  .mp-founder-photo {
    width: 100%; max-width: 280px;
    aspect-ratio: 1 / 1;
    object-fit: cover; object-position: top;
    border-radius: 8px;
    box-shadow: var(--shadow-xl, rgba(0,0,0,0.22) 3px 5px 30px 0px);
  }
  .mp-founder-eye {
    font-family: var(--font-t);
    font-size: 12px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--blue); margin-bottom: 12px;
  }
  .mp-founder-name {
    font-family: var(--font-d);
    font-size: clamp(28px, 3vw, 40px);
    font-weight: 600; line-height: 1.1;
    letter-spacing: -0.018em;
    color: var(--graphite); margin-bottom: 6px;
  }
  .mp-founder-title {
    font-family: var(--font-t);
    font-size: 15px; color: var(--mid-gray);
    letter-spacing: -0.018em; margin-bottom: 24px;
  }
  .mp-founder-quote {
    font-family: var(--font-d);
    font-size: 21px; line-height: 1.36;
    letter-spacing: -0.022em;
    color: var(--graphite);
    padding-left: 18px;
    border-left: 2px solid var(--blue);
    margin-bottom: 24px;
  }
  .mp-founder-cred {
    font-family: var(--font-t);
    font-size: 14px; line-height: 1.55;
    letter-spacing: -0.018em;
    color: var(--mid-gray);
  }
  .mp-founder-cred strong { color: var(--graphite); font-weight: 600; }

  /* ─── PRODUCT CLARITY ─── */
  .mp-clarity {
    padding: 120px 32px;
    background: var(--white);
    border-top: 1px solid var(--border);
  }
  .mp-clarity .mp-section-head {
    max-width: 720px; text-align: center;
    margin: 0 auto 64px;
  }
  .mp-clarity .mp-h2,
  .mp-clarity .mp-lede { margin-left: auto; margin-right: auto; }

  .mp-intel-wrap {
    max-width: 1080px; margin: 0 auto 64px;
    border-radius: 8px; overflow: hidden;
    box-shadow: var(--shadow-xl, rgba(0,0,0,0.22) 3px 5px 30px 0px);
    background: #0a0a0a;
  }
  .mp-intel {
    width: 100%; height: auto; display: block;
  }

  .mp-do-grid {
    max-width: 880px; margin: 0 auto 40px;
    display: grid; grid-template-columns: 1fr; gap: 24px;
  }
  @media (min-width: 720px) {
    .mp-do-grid { grid-template-columns: 1fr 1fr; gap: 32px; }
  }
  .mp-do-col {
    padding: 32px 28px;
    background: var(--canvas);
  }
  .mp-do-yes { border-top: 2px solid var(--blue); }
  .mp-do-no { border-top: 2px solid var(--light-gray); }
  .mp-do-h {
    font-family: var(--font-t);
    font-size: 12px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--mid-gray); margin-bottom: 18px;
  }
  .mp-do-col ul {
    list-style: none; padding: 0;
    display: flex; flex-direction: column; gap: 12px;
  }
  .mp-do-col li {
    font-family: var(--font-t);
    font-size: 17px; line-height: 1.4;
    letter-spacing: -0.022em;
    color: var(--graphite);
    display: flex; align-items: flex-start; gap: 12px;
  }
  .mp-do-mark {
    font-weight: 600; color: var(--blue); flex-shrink: 0;
    width: 18px; display: inline-block;
  }
  .mp-mark-x { color: var(--light-gray); }
  .mp-fit-line {
    max-width: 720px; margin: 0 auto;
    text-align: center; padding: 20px 28px;
    background: var(--canvas);
    font-family: var(--font-t);
    font-size: 16px; line-height: 1.5;
    letter-spacing: -0.018em;
    color: var(--mid-gray);
  }
  .mp-fit-line strong { color: var(--graphite); font-weight: 600; }

  /* ─── HOW IT WORKS ─── */
  .mp-engine {
    padding: 120px 32px;
    background: var(--canvas);
    border-top: 1px solid var(--border);
  }
  .mp-engine .mp-section-head {
    max-width: 720px; text-align: center;
    margin: 0 auto 48px;
  }
  .mp-engine .mp-h2,
  .mp-engine .mp-lede { margin-left: auto; margin-right: auto; }

  .mp-mechanism {
    max-width: 720px; margin: 0 auto 64px;
    display: flex; flex-direction: column; gap: 18px;
    padding: 32px 36px;
    background: var(--white);
    border-left: 2px solid var(--blue);
    border-radius: 0;
  }
  .mp-mechanism p {
    font-family: var(--font-t);
    font-size: 18px; line-height: 1.55;
    letter-spacing: -0.022em;
    color: var(--graphite);
  }
  .mp-mechanism strong { color: var(--blue); font-weight: 600; }

  .mp-explode {
    display: block; width: 100%; height: auto; max-width: 900px;
    aspect-ratio: 1536 / 1024;
    margin: 0 auto 64px;
    border-radius: 8px;
  }

  .mp-modules {
    max-width: 1080px; margin: 0 auto 56px;
    display: grid; grid-template-columns: repeat(5, 1fr);
    gap: 1px; background: var(--border);
  }
  @media (max-width: 960px) {
    .mp-modules { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 640px) {
    .mp-modules { grid-template-columns: 1fr; }
  }
  .mp-mod { background: var(--white); padding: 28px 22px; }
  .mp-mod-num {
    font-family: var(--font-t);
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.08em; color: var(--blue);
    margin-bottom: 12px;
  }
  .mp-mod-name {
    font-family: var(--font-d);
    font-size: 17px; font-weight: 600;
    letter-spacing: -0.022em;
    color: var(--graphite); margin-bottom: 10px;
    line-height: 1.3;
  }
  .mp-mod-desc {
    font-family: var(--font-t);
    font-size: 13px; line-height: 1.55;
    letter-spacing: -0.015em;
    color: var(--mid-gray);
  }

  .mp-timeline {
    max-width: 600px; margin: 0 auto 48px;
    text-align: center;
    padding: 16px 24px;
    background: rgba(0,113,227,0.05);
    border: 1px solid rgba(0,113,227,0.2);
    font-family: var(--font-t);
    font-size: 16px; letter-spacing: -0.018em;
    color: var(--graphite);
  }
  .mp-timeline strong { color: var(--blue); font-weight: 600; }

  .mp-status {
    max-width: 560px; margin: 0 auto;
    background: var(--white);
    border: 1px solid var(--border);
    padding: 28px 32px;
  }
  .mp-status-cap {
    font-family: var(--font-t);
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--mid-gray); margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }
  .mp-status-rows { display: flex; flex-direction: column; }
  .mp-status-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid var(--canvas);
    font-family: var(--font-t);
    font-size: 13px; color: var(--mid-gray);
    letter-spacing: -0.015em;
  }
  .mp-status-row:last-child { border-bottom: none; }
  .mp-status-v {
    font-family: var(--font-t);
    color: var(--blue); font-weight: 600;
    letter-spacing: 0.04em; font-size: 12px;
  }

  /* ─── RESULTS ─── */
  .mp-results {
    padding: 120px 32px;
    background: var(--white);
    border-top: 1px solid var(--border);
  }
  .mp-results-grid {
    max-width: 1100px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 1px; background: var(--border);
    border: 1px solid var(--border);
  }
  @media (max-width: 720px) {
    .mp-results-grid { grid-template-columns: 1fr; }
  }
  .mp-result {
    background: var(--white);
    padding: 40px 36px;
    display: flex; flex-direction: column;
  }
  .mp-result-headline {
    font-family: var(--font-d);
    font-size: 22px; font-weight: 600;
    line-height: 1.25; letter-spacing: -0.022em;
    color: var(--graphite); margin-bottom: 16px;
  }
  .mp-result-quote {
    font-family: var(--font-t);
    font-size: 15px; line-height: 1.55;
    letter-spacing: -0.018em;
    color: var(--mid-gray);
    margin-bottom: 16px; flex: 1;
  }
  .mp-result-attr {
    font-family: var(--font-t);
    font-size: 13px; color: var(--light-gray);
    letter-spacing: -0.015em;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }
  .mp-result-attr strong { color: var(--graphite); font-weight: 600; }

  /* ─── EXCLUSIVITY ─── */
  .mp-exclusivity {
    padding: 80px 32px;
    background: var(--canvas);
    border-top: 1px solid var(--border);
  }
  .mp-exclusivity-inner {
    max-width: 880px; margin: 0 auto;
    padding: 40px 44px;
    background: rgba(214,40,40,0.04);
    border-top: 2px solid #d62828;
  }
  .mp-excl-eye {
    font-family: var(--font-t);
    font-size: 12px; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: #d62828; margin-bottom: 14px;
  }
  .mp-excl-h {
    font-family: var(--font-d);
    font-size: clamp(24px, 2.8vw, 32px);
    font-weight: 600; line-height: 1.15;
    letter-spacing: -0.018em;
    color: var(--graphite); margin-bottom: 16px;
  }
  .mp-excl-body {
    font-family: var(--font-t);
    font-size: 17px; line-height: 1.5;
    letter-spacing: -0.022em;
    color: var(--mid-gray); margin-bottom: 24px;
  }
  .mp-excl-warn {
    padding-top: 22px;
    border-top: 1px solid rgba(214,40,40,0.25);
  }
  .mp-excl-warn-h {
    font-family: var(--font-d);
    font-size: 19px; font-weight: 600;
    letter-spacing: -0.022em;
    color: #d62828; margin-bottom: 10px;
    line-height: 1.3;
  }
  .mp-excl-warn p:not(.mp-excl-warn-h) {
    font-family: var(--font-t);
    font-size: 15px; line-height: 1.55;
    letter-spacing: -0.018em;
    color: var(--graphite);
  }

  /* ─── GUARANTEE + PRICING ─── */
  .mp-guarantee {
    padding: 120px 32px;
    background: var(--canvas);
    border-top: 1px solid var(--border);
  }
  .mp-guarantee .mp-section-head {
    max-width: 720px; text-align: center;
    margin: 0 auto 48px;
  }
  .mp-guarantee .mp-h2 { margin-left: auto; margin-right: auto; }

  .mp-guarantee-card {
    max-width: 720px; margin: 0 auto;
    background: var(--white);
    border: 1px solid var(--border);
    padding: 48px 52px;
  }
  .mp-guarantee-badge {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--blue); color: #fff;
    padding: 8px 18px; border-radius: 999px;
    font-family: var(--font-t);
    font-size: 13px; font-weight: 600;
    letter-spacing: 0.02em;
    margin-bottom: 24px;
  }
  .mp-badge-check {
    width: 18px; height: 18px; border-radius: 50%;
    background: #fff; color: var(--blue);
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 700;
  }
  .mp-guarantee-lead {
    font-family: var(--font-d);
    font-size: clamp(22px, 2.6vw, 28px);
    font-weight: 600; line-height: 1.25;
    letter-spacing: -0.018em;
    color: var(--graphite); margin-bottom: 18px;
  }
  .mp-guarantee-body {
    font-family: var(--font-t);
    font-size: 17px; line-height: 1.55;
    letter-spacing: -0.022em;
    color: var(--mid-gray); margin-bottom: 14px;
  }
  .mp-guarantee-body strong { color: var(--blue); font-weight: 600; }
  .mp-guarantee-closer {
    font-family: var(--font-d);
    font-size: 17px; font-weight: 500; font-style: italic;
    line-height: 1.5;
    color: var(--graphite);
    padding-top: 20px; margin-top: 8px;
    border-top: 1px solid var(--border);
  }

  .mp-pricing {
    margin-top: 32px; padding-top: 32px;
    border-top: 1px solid var(--border);
  }
  .mp-pricing-eye {
    font-family: var(--font-t);
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--mid-gray); margin-bottom: 12px;
  }
  .mp-pricing-headline {
    display: flex; align-items: baseline; flex-wrap: wrap;
    gap: 6px; margin-bottom: 14px;
    font-family: var(--font-d);
  }
  .mp-pricing-num {
    font-size: 44px; font-weight: 600;
    letter-spacing: -0.022em; color: var(--graphite);
    line-height: 1;
  }
  .mp-pricing-per {
    font-size: 18px; font-weight: 400;
    color: var(--mid-gray); margin-right: 8px;
  }
  .mp-pricing-plus {
    font-family: var(--font-t);
    font-size: 15px; font-weight: 400;
    color: var(--mid-gray); letter-spacing: -0.018em;
  }
  .mp-pricing-body {
    font-family: var(--font-t);
    font-size: 15px; line-height: 1.55;
    letter-spacing: -0.018em;
    color: var(--mid-gray);
  }
  .mp-pricing-body strong { color: var(--graphite); font-weight: 600; }

  /* ─── CLOSE ─── */
  .mp-close {
    padding: 160px 32px 140px;
    background: var(--canvas);
    border-top: 1px solid var(--border);
    text-align: center;
  }
  .mp-close-h1 {
    font-family: var(--font-d);
    font-size: clamp(36px, 5.5vw, 56px);
    font-weight: 600; line-height: 1.05;
    letter-spacing: -0.022em;
    color: var(--graphite); margin-bottom: 4px;
  }
  .mp-close-h2 {
    font-family: var(--font-d);
    font-size: clamp(36px, 5.5vw, 56px);
    font-weight: 600; line-height: 1.05;
    letter-spacing: -0.022em;
    color: var(--blue); margin-bottom: 32px;
  }
  .mp-close-body {
    font-family: var(--font-t);
    font-size: 19px; line-height: 1.5;
    letter-spacing: -0.022em;
    color: var(--mid-gray);
    max-width: 620px; margin: 0 auto 40px;
  }
  .mp-close-cta {
    display: flex; flex-direction: column;
    align-items: center; gap: 10px;
  }

  /* ─── Spinner overlay (dark, intentional) ─── */
  #snap-spinner {
    position: fixed; inset: 0; z-index: 9999;
    background: #0a0a0a;
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none;
    transition: opacity 0.25s ease;
  }
  #snap-spinner.on { opacity: 1; pointer-events: all; }
  .spinner-inner {
    width: 100%; max-width: 560px;
    padding: 0 28px;
    display: flex; flex-direction: column; gap: 18px;
  }
  .spinner-ref {
    font-family: 'SF Mono', 'Courier New', monospace;
    font-size: 12px; color: #b0b0b0;
    letter-spacing: 0.04em;
  }
  .spinner-query {
    font-family: 'SF Mono', 'Courier New', monospace;
    font-size: 16px; color: #f5f5f7;
    border-left: 3px solid #2997ff;
    padding-left: 14px; line-height: 1.4;
  }
  .spinner-bar-wrap {
    display: flex; align-items: center; gap: 12px;
  }
  .spinner-bar-track {
    flex: 1; height: 3px;
    background: #2a2a2a; overflow: hidden;
    border-radius: 2px;
  }
  .spinner-bar {
    height: 3px; background: #2997ff;
    width: 0%; transition: width 0.9s linear;
  }
  .spinner-pct {
    font-family: 'SF Mono', 'Courier New', monospace;
    font-size: 13px; color: #cfcfcf;
    min-width: 40px; text-align: right;
    font-weight: 500;
  }
  .spinner-log {
    font-family: 'SF Mono', 'Courier New', monospace;
    font-size: 13px; line-height: 2;
    display: flex; flex-direction: column;
    max-height: 240px; overflow: hidden;
  }
  .log-line { color: #8ec5ff; }
  .log-ready { color: #2997ff; font-weight: 700; }

  /* ─── Responsive ─── */
  @media (max-width: 768px) {
    .mobile-hide { display: none; }
    .mp-hero { padding: 40px 22px 40px; }
    .mp-hero-grid { gap: 32px; }
    .mp-clarity, .mp-engine, .mp-results, .mp-guarantee { padding: 80px 22px; }
    .mp-founder { padding: 64px 22px; }
    .mp-close { padding: 96px 22px 88px; }
    .mp-exclusivity { padding: 56px 22px; }
    .mp-exclusivity-inner { padding: 28px 24px; }
    .mp-guarantee-card { padding: 32px 28px; }
    .mp-anchor { padding: 36px 22px; }
    .mp-do-col { padding: 24px 22px; }
    .mp-result { padding: 28px 24px; }
    .snap-card { padding: 24px 22px; }
    .mp-proof { padding: 24px 22px 56px; }
    .mp-proof-head { margin-bottom: 18px; }
  }
</style>

<!-- Global styles for the JS-injected seat-check result (Astro scopes normal <style>, so innerHTML content needs is:global) -->
<style is:global>
  .snap-result { margin-top: 26px; padding-top: 24px; border-top: 1px solid var(--border); }
  .snap-r-eye { font-family: var(--font-t); font-size: 12px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--mid-gray); margin: 0; }
  .snap-r-num { font-family: var(--font-d); font-size: clamp(48px, 8vw, 68px); font-weight: 600; letter-spacing: -0.03em; line-height: 1; color: var(--graphite); margin: 6px 0 0; }
  .snap-r-unit { font-family: var(--font-t); font-size: 15px; color: var(--mid-gray); margin: 6px 0 0; }
  .snap-r-val { font-family: var(--font-t); font-size: 14px; line-height: 1.5; color: var(--graphite); margin: 14px 0 0; letter-spacing: -0.01em; }
  .snap-r-status { margin: 16px 0 0; padding: 14px 16px; font-family: var(--font-t); font-size: 14px; line-height: 1.5; letter-spacing: -0.01em; border-radius: 8px; }
  .snap-r-open { background: rgba(0,113,227,0.06); border: 1px solid rgba(0,113,227,0.25); }
  .snap-r-open strong { color: var(--blue); }
  .snap-r-taken { background: rgba(179,53,46,0.06); border: 1px solid rgba(179,53,46,0.25); }
  .snap-r-taken strong { color: #b3352e; }
  .snap-lock { display: flex; flex-direction: column; margin-top: 20px; }
  .snap-lock .snap-input { width: 100%; box-sizing: border-box; background: var(--canvas); border: 1px solid var(--border); border-radius: 0; color: var(--graphite); font-family: var(--font-t); font-size: 17px; letter-spacing: -0.022em; padding: 14px 16px; margin-bottom: 12px; outline: none; -webkit-appearance: none; }
  .snap-lock .snap-input:focus { border-color: var(--blue); background: var(--white); }
  .snap-lock .snap-btn { width: 100%; box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: var(--blue); color: #fff; font-family: var(--font-t); font-size: 17px; font-weight: 400; letter-spacing: -0.022em; padding: 14px 20px; border: none; border-radius: 980px; cursor: pointer; line-height: 1; margin-top: 4px; }
  .snap-lock .snap-btn:disabled { opacity: 0.6; cursor: wait; }
  .snap-lock .snap-btn-arrow { display: inline-block; }
  .snap-lock .snap-micro { font-family: var(--font-t); font-size: 12px; color: var(--light-gray); text-align: center; margin-top: 12px; }
</style>
