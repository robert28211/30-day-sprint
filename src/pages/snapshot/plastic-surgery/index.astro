---
import Base from '../../../layouts/Base.astro'
---
<Base
  title="Free Practice Market Snapshot — Plastic Surgery"
  description="See exactly how many people in your market are actively researching cosmetic procedures right now — before they search, before they compare, before they book someone else."
>
  <main class="snapshot-page">

    <div class="snap-logo">
      <a href="https://marketingperformance.net" class="snap-logo-link">Marketing Performance Group</a>
      <span class="snap-logo-sub">Powered by EngageEngine™</span>
    </div>

    <!-- Split layout: headline left, form right -->
    <div class="snap-split">

      <!-- Left: hook -->
      <div class="snap-left">
        <div class="snap-eyebrow">/ Practice Market Snapshot</div>
        <h1 class="snap-headline">
          People In Your Market Are Researching Cosmetic Procedures Right Now.
          <span class="snap-headline-sub">They Haven't Found You Yet. We Know Who They Are.</span>
        </h1>
        <p class="snap-hook">We identify people actively researching cosmetic procedures in your city — before they search, before they compare, before they book someone else.</p>

        <div class="snap-proof-inline">
          <div class="snap-proof-stat"><span class="snap-proof-num">60%</span><span class="snap-proof-label">ad cost reduction</span></div>
          <div class="snap-proof-dot"></div>
          <div class="snap-proof-stat"><span class="snap-proof-num">2×</span><span class="snap-proof-label">website traffic</span></div>
          <div class="snap-proof-dot"></div>
          <div class="snap-proof-stat"><span class="snap-proof-num">Full</span><span class="snap-proof-label">appointment calendar</span></div>
        </div>
        <div class="snap-proof-source">One of our plastic surgery clients — 90 days after their first Market Snapshot</div>
      </div>

      <!-- Right: two-step form -->
      <div class="snap-right">
        <div class="snap-card">
          <div class="snap-card-eyebrow">FREE &nbsp;·&nbsp; INSTANT &nbsp;·&nbsp; NO EMAIL REQUIRED</div>
          <div class="snap-card-headline">See Your Practice's Market Now</div>

          <!-- Step 1: commitment button -->
          <div class="step-1" id="step-1">
            <p class="step1-sub">We identify people actively researching cosmetic procedures in your city. Ready in 30 seconds — no email, no pitch.</p>
            <button class="snap-cta" id="step1-btn" type="button">
              Yes — Show Me My Market →
            </button>
            <p class="snap-cta-timer">No email required &nbsp;·&nbsp; Results in ~30 seconds</p>
          </div>

          <!-- Step 2: fields (hidden until step 1 clicked) -->
          <div class="step-2" id="step-2">
            <form id="snapshot-form" class="snap-form">
              <input type="hidden" name="trade" value="Plastic Surgery" />
              <div class="field-group">
                <input type="text" name="city_state" placeholder="City / State  (e.g. Miami, FL)" required class="snap-input" id="city-input" />
              </div>
              <div class="snap-scarcity">
                <strong>One practice per market.</strong> If a competing practice requests this first, your market locks.
              </div>
              <p class="snap-cta-note">No name. No email. No credit card. Free.</p>
              <button type="submit" class="snap-cta" id="snap-submit">
                Pull My Market Data →
              </button>
              <p class="snap-cta-timer">Results in ~30 seconds</p>
            </form>
          </div>

        </div>
      </div>

    </div>

    <!-- Below fold: value stack for skeptics -->
    <div class="snap-below" data-animate>
      <ul class="snap-value-stack">
        <li><span class="check">✓</span> Active procedure research signals in your city</li>
        <li><span class="check">✓</span> Intent data from the last 72 hours</li>
        <li><span class="check">✓</span> How many competing practices are already reaching them</li>
        <li><span class="check">✓</span> Ready in 30 seconds — no account, no pitch</li>
      </ul>
    </div>

    <div class="snap-footer-line">
      EngageEngine™ is a full-stack demand activation platform. The snapshot is where we start.
    </div>

  </main>

  <!-- Spinner overlay -->
  <div id="snap-spinner" aria-hidden="true">
    <div class="spinner-inner">
      <div class="spinner-ref" id="spinner-ref"></div>
      <div class="spinner-query" id="spinner-query"></div>
      <div class="spinner-bar-wrap">
        <div class="spinner-bar-track">
          <div class="spinner-bar" id="spinner-bar"></div>
        </div>
        <div class="spinner-pct" id="spinner-pct">0%</div>
      </div>
      <div class="spinner-log" id="spinner-log"></div>
    </div>
  </div>

<script>
// Two-step reveal
const step1El = document.getElementById('step-1') as HTMLElement;
const step2El = document.getElementById('step-2') as HTMLElement;
const step1Btn = document.getElementById('step1-btn') as HTMLButtonElement;

step1Btn?.addEventListener('click', () => {
  step1El.classList.add('fade-out');
  setTimeout(() => {
    step1El.style.display = 'none';
    step2El.classList.add('reveal');
    const cityInput = document.getElementById('city-input') as HTMLInputElement;
    cityInput?.focus();
  }, 260);
});

const form = document.getElementById('snapshot-form') as HTMLFormElement;
const spinner = document.getElementById('snap-spinner') as HTMLElement;
const spinnerRef = document.getElementById('spinner-ref') as HTMLElement;
const spinnerQuery = document.getElementById('spinner-query') as HTMLElement;
const spinnerLog = document.getElementById('spinner-log') as HTMLElement;
const spinnerBar = document.getElementById('spinner-bar') as HTMLElement;
const spinnerPct = document.getElementById('spinner-pct') as HTMLElement;

const STEP_MS = 1900;

form?.addEventListener('submit', (e) => {
  e.preventDefault();
  const fd = new FormData(form);
  const city        = (fd.get('city_state') as string) || '';
  const trade       = 'Plastic Surgery';
  const failureMode = (fd.get('failure_mode') as string) || '';

  const refNum = 'EE-' + Date.now().toString(36).toUpperCase().slice(-6);
  const totalEvents = 10000 + Math.floor(Math.random() * 40000);

  spinnerRef.textContent = 'REF: ' + refNum + '  ·  ' + new Date().toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  spinnerQuery.textContent = 'QUERY: ' + city + ' / Cosmetic Procedures — last 72 hrs';

  const steps = [
    'INIT      connecting to intent index...',
    'INDEX     ' + totalEvents.toLocaleString() + ' search events in scope — ' + city,
    'FILTER    applying category: cosmetic & aesthetic procedures',
    'FILTER    multi-site visit flag (3+ sites)...',
    'MATCH     cross-referencing 72-hr decision window...',
    'EXCLUDE   removing previously contacted records...',
    'BUILD     compiling patient signal summary...',
    'EXPORT    ' + (80 + Math.floor(Math.random() * 220)) + ' records matched — packaging for delivery...',
    'READY     data package compiled — access granted.',
  ];

  const TOTAL_MS = steps.length * STEP_MS + 800;
  spinner.classList.add('on');
  runSteps(steps, TOTAL_MS);

  if (typeof gtag !== 'undefined') {
    gtag('event', 'snapshot_gate1_submit', { market: city, trade, failure_mode: failureMode });
  }

  setTimeout(() => {
    const p = new URLSearchParams({ city_state: city, trade, failure_mode: failureMode });
    window.location.href = '/snapshot/preview?' + p.toString();
  }, TOTAL_MS);
});

function runSteps(steps: string[], totalMs: number) {
  let i = 0;
  spinnerLog.innerHTML = '';
  spinnerBar.style.width = '0%';
  spinnerPct.textContent = '0%';
  function next() {
    if (i >= steps.length) return;
    const el = document.createElement('div');
    el.className = 'log-line' + (i === steps.length - 1 ? ' log-ready' : '');
    el.textContent = steps[i];
    spinnerLog.appendChild(el);
    spinnerLog.scrollTop = spinnerLog.scrollHeight;
    const pct = Math.round(((i + 1) / steps.length) * 100);
    spinnerBar.style.width = pct + '%';
    spinnerPct.textContent = pct + '%';
    i++;
    if (i < steps.length) setTimeout(next, STEP_MS);
  }
  next();
}
</script>
</Base>

<style>
  :global(body) { background: #0D1828; }

  .snapshot-page {
    min-height: 100vh;
    padding: 40px 24px 80px;
    max-width: 1080px;
    margin: 0 auto;
  }

  /* Logo */
  .snap-logo {
    font-family: 'DM Sans', sans-serif;
    font-weight: 500; font-size: 13px; letter-spacing: 0.08em;
    color: rgba(244,241,234,0.5);
    display: flex; flex-direction: column; gap: 2px;
    margin-bottom: 48px;
  }
  .snap-logo-sub { font-size: 10px; font-weight: 400; letter-spacing: 0.06em; color: #c9a84c; }
  .snap-logo-link { color: inherit; text-decoration: none; }
  .snap-logo-link:hover { color: #c9a84c; }

  /* Split layout */
  .snap-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: start;
    margin-bottom: 64px;
  }

  /* Left column */
  .snap-eyebrow {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px; font-weight: 400;
    letter-spacing: 0.18em; text-transform: uppercase;
    color: rgba(244,241,236,0.35); margin-bottom: 20px;
  }

  .snap-headline {
    font-family: 'Playfair Display', serif;
    font-weight: 900; font-size: clamp(32px, 4vw, 52px);
    line-height: 1.08; letter-spacing: -0.02em;
    color: #F4F1EA; margin: 0 0 20px;
    display: flex; flex-direction: column; gap: 12px;
  }
  .snap-headline-sub {
    color: #c9a84c;
    font-size: clamp(22px, 2.8vw, 36px);
  }

  .snap-hook {
    font-family: 'DM Sans', sans-serif;
    font-size: 17px; font-weight: 300; line-height: 1.65;
    color: rgba(244,241,236,0.65); margin: 0 0 36px;
  }

  /* Inline proof stats */
  .snap-proof-inline {
    display: flex; align-items: center; gap: 16px; margin-bottom: 10px;
  }
  .snap-proof-stat { display: flex; flex-direction: column; gap: 2px; }
  .snap-proof-num {
    font-family: 'Playfair Display', serif;
    font-size: 28px; font-weight: 900; color: #c9a84c; line-height: 1;
  }
  .snap-proof-label {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
    color: rgba(244,241,236,0.35);
  }
  .snap-proof-dot {
    width: 1px; height: 32px; background: rgba(255,255,255,0.1); flex-shrink: 0;
  }
  .snap-proof-source {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px; font-style: italic;
    color: rgba(244,241,236,0.25);
  }

  /* Right column: card */
  .snap-card {
    background: #1B2A4A; border: 1px solid #253B66;
    padding: 32px;
  }

  .snap-card-eyebrow {
    display: inline-block;
    font-family: 'DM Sans', sans-serif;
    font-size: 10px; font-weight: 600; letter-spacing: 0.16em;
    text-transform: uppercase; color: #0D1828;
    background: #c9a84c; padding: 5px 12px;
    margin-bottom: 18px;
  }

  .snap-card-headline {
    font-family: 'Playfair Display', serif;
    font-weight: 700; font-size: 22px;
    color: #F4F1EA; margin-bottom: 24px;
  }

  .snap-form { display: flex; flex-direction: column; }
  .field-group { display: flex; flex-direction: column; gap: 10px; margin-bottom: 18px; }

  .snap-input {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px; font-weight: 400; color: #F4F1EA;
    background: #0D1828; border: 1px solid #253B66;
    padding: 13px 16px; outline: none;
    transition: border-color 0.2s; width: 100%;
  }
  .snap-input::placeholder { color: rgba(244,241,236,0.3); }
  .snap-input:focus { border-color: #c9a84c; }

  .snap-scarcity {
    font-family: 'DM Sans', sans-serif;
    font-size: 12px; line-height: 1.6;
    color: rgba(244,241,236,0.50);
    border: 1px solid rgba(200,168,75,0.2);
    padding: 10px 14px; margin-bottom: 18px;
  }
  .snap-scarcity strong { color: #c9a84c; }

  .snap-cta-note {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px; font-weight: 500; color: #c9a84c;
    margin: 0 0 12px; letter-spacing: 0.02em;
  }

  .snap-cta {
    display: block; width: 100%;
    background: #C8A84B; color: #0D1828;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500; font-size: 16px;
    padding: 15px 32px; border: none; cursor: pointer;
    text-align: center; transition: background 0.2s; margin-bottom: 10px;
  }
  .snap-cta:hover { background: #e8c97a; }

  .snap-cta-timer {
    font-family: 'DM Sans', sans-serif;
    font-size: 11px; color: rgba(244,241,236,0.25);
    margin: 0; text-align: center; letter-spacing: 0.04em;
  }

  /* Two-step */
  .step1-sub {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px; font-weight: 300; line-height: 1.6;
    color: rgba(244,241,236,0.60); margin: 0 0 24px;
  }

  .step-1 {
    transition: opacity 0.25s ease;
  }
  .step-1.fade-out {
    opacity: 0; pointer-events: none;
  }

  .step-2 {
    opacity: 0; max-height: 0; overflow: hidden;
    transition: opacity 0.35s ease, max-height 0.4s ease;
  }
  .step-2.reveal {
    opacity: 1; max-height: 400px;
  }

  /* Below fold */
  .snap-below {
    border-top: 1px solid #253B66;
    padding-top: 40px; margin-bottom: 40px;
  }

  .snap-value-stack {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: 1fr 1fr; gap: 12px 40px;
  }
  .snap-value-stack li {
    font-family: 'DM Sans', sans-serif;
    font-size: 15px; font-weight: 400; line-height: 1.5;
    color: rgba(244,241,236,0.65);
    display: flex; align-items: flex-start; gap: 10px;
  }
  .snap-value-stack .check { color: #c9a84c; font-weight: 700; flex-shrink: 0; }

  .snap-footer-line {
    font-family: 'DM Sans', sans-serif;
    font-size: 13px; font-style: italic;
    color: rgba(244,241,236,0.2);
    text-align: center;
  }

  /* Spinner */
  #snap-spinner {
    position: fixed; inset: 0; z-index: 9999;
    background: #0a0a0a;
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none; transition: opacity 0.2s;
  }
  #snap-spinner.on { opacity: 1; pointer-events: all; }
  .spinner-inner {
    width: 100%; max-width: 560px; padding: 0 32px;
    display: flex; flex-direction: column; gap: 18px;
  }
  .spinner-ref { font-family: 'Courier New', monospace; font-size: 12px; color: #999; letter-spacing: 0.04em; }
  .spinner-query { font-family: 'Courier New', monospace; font-size: 18px; color: #f0f0f0; border-left: 3px solid #666; padding-left: 14px; line-height: 1.4; }
  .spinner-bar-wrap { display: flex; align-items: center; gap: 12px; }
  .spinner-bar-track { flex: 1; height: 2px; background: #333; overflow: hidden; }
  .spinner-bar { height: 2px; background: #bbb; width: 0%; transition: width 1.6s linear; }
  .spinner-pct { font-family: 'Courier New', monospace; font-size: 13px; color: #999; min-width: 36px; text-align: right; }
  .spinner-log { font-family: 'Courier New', monospace; font-size: 13px; line-height: 2; display: flex; flex-direction: column; max-height: 240px; overflow: hidden; }
  .log-line { color: #aaa; }
  .log-ready { color: #f0f0f0; font-weight: bold; }

  /* Mobile */
  @media (max-width: 768px) {
    .snapshot-page { padding: 32px 20px 60px; }
    .snap-split { grid-template-columns: 1fr; gap: 40px; }
    .snap-value-stack { grid-template-columns: 1fr; }
    .snap-proof-inline { gap: 12px; }
    .snap-proof-num { font-size: 22px; }
  }
</style>
