---
import Base from '../../layouts/Base.astro'
export const prerender = false

const { id } = Astro.params
const isPreview = !id || id === 'preview'
const env = (Astro.locals as any).runtime?.env ?? (Astro.locals as any)

let data: any = null
if (id && id !== 'preview') {
  try {
    data = await env.DB.prepare(
      'SELECT * FROM snapshot_leads WHERE id = ?'
    ).bind(id).first()
  } catch (_) {}
}

if (!data) {
  const city_state    = Astro.url.searchParams.get('city_state') || 'Your Market'
  const trade         = Astro.url.searchParams.get('trade') || 'Home Services'
  const failure_mode  = Astro.url.searchParams.get('failure_mode') || ''
  let hash = 0
  for (const c of (city_state + trade).toLowerCase()) {
    hash = Math.imul(31, hash) + c.charCodeAt(0) | 0
  }
  const abs = Math.abs(hash)
  const vary = (n: number, pct = 0.15) => Math.round(n * (1 + (Math.random() * 2 - 1) * pct))
  const total     = vary(180 + (abs % 120))
  const multiSite = vary(Math.round(total * (0.34 + (abs >> 4 & 0xf) / 150)))
  data = { city_state, trade, total_buyers: total, multi_site: multiSite,
           uncaptured: multiSite, competitor_exposed: Math.round(multiSite * 0.37), failure_mode }
}

const isHomeService = !['plastic surgery'].includes((data.trade || '').toLowerCase())
const prospectWord  = isHomeService ? 'homeowners' : 'people'
const pullDate   = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
const psMarketRaw = data.total_buyers * 6000
const psMarketStr = psMarketRaw >= 1000000
  ? `$${(psMarketRaw / 1000000).toFixed(1)}M`
  : `$${Math.round(psMarketRaw / 1000)}k`
const expiryBase = data.created_at ? (data.created_at * 1000 + 86400000) : (Date.now() + 86400000)
const expiryDate = new Date(expiryBase).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })
const shortDate  = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
const refId      = id && id !== 'preview' ? id.split('-')[0].toUpperCase() : 'PREVIEW'
---
