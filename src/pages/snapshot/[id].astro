<!-- Claim / Waitlist section -->
<div class="claim-section">
  <div class="claim-inner">

    <!-- FREE SAMPLE OFFER (Hormozi "Costco free sample" — lower-friction path) -->
    <div class="sample-block">
      <p class="sample-eye">Want Real Names?</p>
      <h3 class="sample-headline">The Free Sample.</h3>
      <p class="sample-body">
        I'll personally pull <strong>10 real buyers</strong> from your {data.city_state} market — name, email, phone, and what they searched for — and send it to your inbox within 24 hours.
      </p>
      <p class="sample-body sample-body-trust">
        Same data we send paying clients. <strong>No pitch. No follow-up sequence.</strong> We just want you to see it work.
      </p>
      <form id="sample-form" class="sample-form">
        <input type="hidden" name="city_state" value={data.city_state} />
        <input type="hidden" name="trade" value={data.trade} />
        <input type="hidden" name="failure_mode" value={data.failure_mode || ''} />
        <input type="hidden" name="total_buyers" value={data.total_buyers} />
        <input type="hidden" name="request_type" value="free_sample_10_names" />
        <label for="sample-email" class="sample-sr">Email</label>
        <div class="sample-row">
          <input
            id="sample-email"
            type="email"
            name="email"
            placeholder="you@yourbusiness.com"
            required
            class="sample-input"
            autocomplete="email"
          />
          <button type="submit" class="sample-btn" id="sample-submit">
            <span>Send Me 10 Names</span>
            <span class="sample-btn-arrow">→</span>
          </button>
        </div>
        <p class="sample-note">One sample per market. First-come, first-served. <span class="sample-sig">— Robbie</span></p>
      </form>
      <div id="sample-confirm" class="sample-confirm" style="display:none">
        <div class="sample-confirm-check">✓</div>
        <div class="sample-confirm-headline">Got it. Watch your inbox.</div>
        <p class="sample-confirm-body">Your sample of 10 real buyers from {data.city_state} will land within 24 hours.</p>
      </div>
    </div>

    <div class="sample-divider"><span>OR</span></div>

    {isHomeService ? (
      <div class="claim-copy">
        <p class="claim-body">There are {data.total_buyers} people in {data.city_state} who need {data.trade} work right now. They haven't found you yet. We only work with one company per market.</p>
        <p class="claim-kicker">If you want {data.city_state}, add your info.</p>
      </div>
    ) : (
      <div class="claim-copy">
        <div class="claim-headline">Right now, {data.total_buyers} people in {data.city_state} are in the early stages of thinking about cosmetic surgery.</div>
        <p class="claim-body">They haven't Googled it yet. They haven't called anyone. They haven't told their friends. We can put your practice in front of them before any of that happens.</p>
        <p class="claim-kicker">One practice per market — if a competitor gets here first, we can't help you.</p>
      </div>
    )}

    <div id="claim-form-wrap">
      <form id="claim-form" class="claim-form">
        <input type="hidden" name="city_state" value={data.city_state} />
        <input type="hidden" name="trade" value={data.trade} />
        <input type="hidden" name="failure_mode" value={data.failure_mode || ''} />
        <input type="hidden" name="total_buyers" value={data.total_buyers} />
        <input type="hidden" name="multi_site" value={data.multi_site} />
        <input type="hidden" name="competitor_exposed" value={data.competitor_exposed} />
        <div class="claim-fields">
          <div class="claim-field">
            <label for="claim-name" class="claim-label">Name</label>
            <input id="claim-name" type="text" name="name" placeholder="Your name" required class="claim-input" autocomplete="name" />
          </div>
          <div class="claim-field">
            <label for="claim-email" class="claim-label">Email</label>
            <input id="claim-email" type="email" name="email" placeholder="you@yourbusiness.com" required class="claim-input" autocomplete="email" />
          </div>
          <div class="claim-field">
            <label for="claim-phone" class="claim-label">Phone</label>
            <input id="claim-phone" type="tel" name="phone" placeholder="(555) 555-5555" class="claim-input" autocomplete="tel" />
          </div>
        </div>
        <button type="submit" class="claim-btn" id="claim-submit">
          {isHomeService ? 'Send Me the Names →' : 'Claim My Market →'}
        </button>
        <p class="claim-note">Your sample lands in your inbox within 24 hours. No call, no pitch.</p>
      </form>
      <div id="claim-confirm" class="claim-confirm" style="display:none">
        <div class="claim-confirm-check">✓</div>
        <div class="claim-confirm-headline">On its way.</div>
        <p class="claim-confirm-body">We're pulling 10 real buyers from {data.city_state} right now. Check your inbox within 24 hours. — Robbie</p>
      </div>
    </div>

  </div>
</div>

<!-- Pitch / supporting detail section -->
<div class="unlock-section">
  <div class="unlock-inner">

    <p class="analyst-note">
      {data.failure_mode === 'ads_not_working' && (
        <>Your ads may be running — but these {data.total_buyers} {prospectWord} found their way into the decision window without clicking them. They are actively searching, comparing, and waiting for someone to reach them first.</>
      )}
      {data.failure_mode === 'traffic_not_booking' && (
        <>Traffic is not the problem — timing is. Every contact in this export is mid-decision: visited multiple sites, have not called anyone, have not committed. Most will book with whoever reaches them first in the next 48 hours.</>
      )}
      {data.failure_mode === 'losing_to_competitors' && (
        <>{data.multi_site} of these buyers have visited 3 or more contractor sites — including your competitors. They have not decided yet. Competitor identities are locked until activation.</>
      )}
      {data.failure_mode === 'calls_go_cold' && (
        <>These contacts are live and in-window — they have not called anyone yet. This is a timing problem, not a lead quality problem. The 72-hour window is open.</>
      )}
      {(!data.failure_mode || !['ads_not_working','traffic_not_booking','losing_to_competitors','calls_go_cold'].includes(data.failure_mode)) && (
        <>Every contact in this pull was flagged by the intent index within the last 72 hours. Active search behavior confirmed. {data.trade} category filter applied. This pull expires {expiryDate}.</>
      )}
    </p>

    <div class="pitch-divider"></div>

    <div class="pitch-section">
      <div class="pitch-label">WHAT HAPPENS NEXT</div>
      <div class="pitch-phase">
        <div class="pitch-phase-name">Month 1 — The 30-Day Recovery Sprint</div>
        <div class="pitch-phase-body">We run the Demand Collapse Diagnostic — seven phases to find exactly where revenue is leaking before marketing gets a chance to work. Then we fix it and build your activation system in parallel. The moment the Sprint ends, we deploy.</div>
      </div>
      <div class="pitch-phase">
        <div class="pitch-phase-name">Months 2–3 — Full EngageEngine™ Activation</div>
        <div class="pitch-phase-body">We pull the active buyers in your market. Identity resolution on site visitors. Email, SMS, retargeting, and chatbot running simultaneously — all pointed at people already looking for what you do. Most clients see ad spend drop 60–90% while generating more qualified conversations than before.</div>
      </div>
      <div class="pitch-callout">WE RUN IT. YOU TAKE THE CALLS.</div>
    </div>

    <div class="pitch-guarantee">
      <div class="pitch-label">THE GUARANTEE</div>
      <p class="pitch-guarantee-text">If we don't generate qualified conversations — a {prospectWord.replace(/s$/, '')} in your market who needs your service, confirmed via call or reply — within 90 days, we work free until we do.</p>
    </div>

    <div class="pitch-pricing">
      <div class="pitch-label">INVESTMENT</div>
      <p class="pitch-fine">$3,500/month · $500–$1,500/month ad spend (we manage, you approve) · Month to month · No contracts · One {data.trade} company in {data.city_state} — permanently exclusive · Slot expires {expiryDate}</p>
    </div>

  </div>
</div>

<script>
// GA4: report page viewed
if (typeof gtag !== 'undefined') {
  const sp = new URLSearchParams(window.location.search);
  gtag('event', 'snapshot_viewed', {
    market: sp.get('city_state') || document.title,
    trade: sp.get('trade') || '',
    failure_mode: sp.get('failure_mode') || '',
  });
}

const claimForm = document.getElementById('claim-form') as HTMLFormElement | null;
if (claimForm) {
  claimForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('claim-submit') as HTMLButtonElement;
    btn.textContent = 'Securing your slot...';
    btn.disabled = true;
    const fd = new FormData(claimForm);

    if (typeof gtag !== 'undefined') {
      gtag('event', 'snapshot_sample_request', {
        market: fd.get('city_state'),
        trade: fd.get('trade'),
        failure_mode: fd.get('failure_mode'),
      });
    }
    if (typeof fbq !== 'undefined') {
      fbq('track', 'CompleteRegistration', { content_name: 'Waitlist Signup', content_category: String(fd.get('trade') || '') });
    }

    fetch('https://formspree.io/f/mgodnjje', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({
        request_type: 'waitlist',
        name: fd.get('name'),
        email: fd.get('email'),
        phone: fd.get('phone'),
        city_state: fd.get('city_state'),
        trade: fd.get('trade'),
        failure_mode: fd.get('failure_mode'),
        total_buyers: fd.get('total_buyers'),
        multi_site: fd.get('multi_site'),
        competitor_exposed: fd.get('competitor_exposed'),
      }),
    }).catch(() => {});

    // Show confirmation in place of form
    claimForm.style.display = 'none';
    const confirm = document.getElementById('claim-confirm') as HTMLElement;
    if (confirm) confirm.style.display = 'block';
  });
}

// Free Sample submission — same Formspree endpoint, request_type marks it
const sampleForm = document.getElementById('sample-form') as HTMLFormElement | null;
if (sampleForm) {
  sampleForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('sample-submit') as HTMLButtonElement;
    const btnLabel = btn.querySelector('span') as HTMLElement | null;
    if (btnLabel) btnLabel.textContent = 'Sending...';
    btn.disabled = true;

    const fd = new FormData(sampleForm);

    if (typeof gtag !== 'undefined') {
      gtag('event', 'snapshot_free_sample_submit', {
        market: fd.get('city_state'),
        trade: fd.get('trade'),
        failure_mode: fd.get('failure_mode'),
      });
    }
    if (typeof fbq !== 'undefined') {
      fbq('track', 'Lead', { content_name: 'Free Sample — 10 Names', content_category: String(fd.get('trade') || '') });
    }

    fetch('https://formspree.io/f/mgodnjje', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({
        request_type: 'free_sample_10_names',
        email: fd.get('email'),
        city_state: fd.get('city_state'),
        trade: fd.get('trade'),
        failure_mode: fd.get('failure_mode'),
        total_buyers: fd.get('total_buyers'),
      }),
    }).catch(() => {});

    sampleForm.style.display = 'none';
    const confirm = document.getElementById('sample-confirm') as HTMLElement;
    if (confirm) confirm.style.display = 'block';
  });
}
</script>

</Base>

<style>
