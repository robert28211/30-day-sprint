---
export const prerender = false
import Base from '../../layouts/Base.astro'
import Nav from '../../components/Nav.astro'

const cf = (Astro.locals as any).runtime?.cf
const detectedCity   = cf?.city   || ''
const detectedRegion = cf?.region || cf?.regionCode || ''
const detectedLocation = detectedCity
  ? (detectedRegion ? `${detectedCity}, ${detectedRegion}` : detectedCity)
  : ''
---
<Base
  title="Your Market Snapshot — EngageEngine™"
  description="See the buyers already looking for your services in your market right now. Free Market Snapshot from EngageEngine™."
>
  <Nav />
  <main class="snap-page">

    <section class="snap-above">
      <div class="snap-wrap">
        <div class="snap-eyebrow" data-animate>We track every service search in your market</div>

        <h1 class="snap-headline" data-animate data-delay="0.05">
          We already know who's looking for your services in your city.
          <em class="snap-headline-sub">They haven't called you yet.</em>
        </h1>

        <form id="snapshot-form" class="snap-form" data-animate data-delay="0.15" novalidate>
          <label class="snap-field-label" for="service-input">What service do you offer?</label>
          <input
            type="text"
            name="trade"
            id="service-input"
            
            required
            class="snap-input"
            autocomplete="off"
            inputmode="text"
          />

          <div class="snap-scarcity">
            <strong>One business per service per market.</strong> If a competitor pulls this before you, you lose access.
          </div>

          <button type="submit" class="btn btn-blue snap-cta" id="snap-submit">
            Show Me Who's Searching →
          </button>
          <p class="snap-cta-trust">Free &nbsp;·&nbsp; No email required &nbsp;·&nbsp; Results in seconds</p>
        </form>
      </div>
    </section>

    <section class="snap-below">
      <div class="snap-wrap">
        <div class="snap-proof" data-animate>
          <div class="snap-proof-label">Real result</div>
          <div class="snap-proof-result">170% more booked appointments.</div>
          <div class="snap-proof-detail">McClintock HVAC — same ad budget, 90 days.</div>
        </div>

        <div class="snap-value-heading" data-animate data-delay="0.1">Your snapshot includes</div>
        <ul class="snap-value-stack" data-animate data-delay="0.15">
          <li><span class="snap-check">✓</span> How many buyers searched for your service in the last 72 hours</li>
          <li><span class="snap-check">✓</span> Which competitor sites they visited — and who's already reaching them</li>
          <li><span class="snap-check">✓</span> How many of those buyers are reachable with ads right now</li>
          <li><span class="snap-check">✓</span> No account, no pitch, no sales call — just your data</li>
        </ul>

        <p class="snap-footer-line">EngageEngine™ is a full-stack demand activation platform. The snapshot is where we start.</p>
      </div>
    </section>

  </main>

  <!-- Spinner overlay — stays dark: it's a dramatic loading state -->
  <div id="snap-spinner" aria-hidden="true">
    <div class="spinner-inner">
      <div class="spinner-ref" id="spinner-ref"></div>
      <div class="spinner-query" id="spinner-query"></div>
      <div class="spinner-bar-wrap">
        <div class="spinner-bar-track">
          <div class="spinner-bar" id="spinner-bar"></div>
        </div>
        <div class="spinner-pct" id="spinner-pct">0%</div>
      </div>
      <div class="spinner-log" id="spinner-log"></div>
    </div>
  </div>

<script define:vars={{ detectedLocation }}>
const autoCity = detectedLocation;

const params = new URLSearchParams(window.location.search);
const paramService = params.get('trade') || params.get('service') || '';
if (paramService) (document.getElementById('service-input')).value = paramService;

const form       = document.getElementById('snapshot-form');
const spinner    = document.getElementById('snap-spinner');
const spinnerRef   = document.getElementById('spinner-ref');
const spinnerQuery = document.getElementById('spinner-query');
const spinnerLog   = document.getElementById('spinner-log');
const spinnerBar   = document.getElementById('spinner-bar');
const spinnerPct   = document.getElementById('spinner-pct');

const STEP_MS = 1100;

form?.addEventListener('submit', (e) => {
  e.preventDefault();
  const fd      = new FormData(form);
  const service = (fd.get('trade') || '').trim();

  if (!service) return;

  const city = autoCity || 'your market';

  const refNum      = 'EE-' + Date.now().toString(36).toUpperCase().slice(-6);
  const totalEvents = 10000 + Math.floor(Math.random() * 40000);

  spinnerRef.textContent   = 'REF: ' + refNum + '  ·  ' + new Date().toLocaleString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' });
  spinnerQuery.textContent = 'QUERY: ' + city + ' / ' + service + ' — last 72 hrs';

  const steps = [
    'INIT      connecting to intent index...',
    'INDEX     ' + totalEvents.toLocaleString() + ' search events in scope — ' + city,
    'FILTER    applying service classification: ' + service,
    'MATCH     cross-referencing 72-hr decision window...',
    'EXCLUDE   removing previously contacted records...',
    'BUILD     compiling buyer signal summary...',
    'READY     data package compiled — access granted.',
  ];

  const TOTAL_MS = steps.length * STEP_MS + 600;
  spinner.classList.add('on');
  runSteps(steps);

  if (typeof gtag !== 'undefined') {
    gtag('event', 'snapshot_gate1_submit', { market: city, trade: service });
  }
  if (typeof fbq !== 'undefined') {
    fbq('track', 'Lead', { content_name: 'Market Snapshot', content_category: service });
  }

  setTimeout(() => {
    const p = new URLSearchParams({ city_state: city, trade: service });
    window.location.href = '/snapshot/preview?' + p.toString();
  }, TOTAL_MS);
});

function runSteps(steps) {
  let i = 0;
  spinnerLog.innerHTML = '';
  spinnerBar.style.width = '0%';
  spinnerPct.textContent = '0%';
  function next() {
    if (i >= steps.length) return;
    const el = document.createElement('div');
    el.className = 'log-line' + (i === steps.length - 1 ? ' log-ready' : '');
    el.textContent = steps[i];
    spinnerLog.appendChild(el);
    spinnerLog.scrollTop = spinnerLog.scrollHeight;
    const pct = Math.round(((i + 1) / steps.length) * 100);
    spinnerBar.style.width = pct + '%';
    spinnerPct.textContent = pct + '%';
    i++;
    if (i < steps.length) setTimeout(next, STEP_MS);
  }
  next();
}
</script>
</Base>

<style>
  .snap-page { background: var(--canvas); }
  .snap-wrap { max-width: 480px; margin: 0 auto; padding: 0 22px; }

  .snap-above { padding: 48px 0 40px; border-bottom: 1px solid var(--border); background: #fff; }
  .snap-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--blue); margin-bottom: 16px; }
  .snap-headline { font-family: var(--font-d); font-size: clamp(26px, 5vw, 34px); font-weight: 600; line-height: 1.1; letter-spacing: -0.005em; color: var(--graphite); margin: 0 0 28px; display: flex; flex-direction: column; gap: 8px; }
  .snap-headline-sub { font-style: normal; color: var(--blue); font-size: clamp(20px, 4vw, 26px); font-weight: 400; }

  .snap-form { display: flex; flex-direction: column; }
  .snap-field-label { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--mid-gray); display: block; margin-bottom: 8px; }
  .snap-input { width: 100%; background: var(--canvas); border: 1px solid var(--border); border-radius: 10px; color: var(--graphite); font-size: 16px; padding: 14px; margin-bottom: 14px; outline: none; -webkit-appearance: none; transition: border-color 0.15s; }
  .snap-input::placeholder { color: var(--light-gray); }
  .snap-input:focus { border-color: var(--blue); }

  .snap-scarcity { background: rgba(192,57,43,0.06); border: 1px solid rgba(192,57,43,0.2); border-radius: 10px; padding: 12px 16px; margin-bottom: 14px; font-size: 13px; line-height: 1.5; color: #8b2e22; }
  .snap-scarcity strong { color: #c0392b; }

  .snap-cta { width: 100%; display: block; border-radius: 10px; font-size: 17px; padding: 16px; margin-bottom: 10px; }
  .snap-cta-trust { font-size: 12px; color: var(--light-gray); text-align: center; letter-spacing: 0.02em; margin: 0; }

  .snap-below { padding: 36px 0 48px; }
  .snap-proof { padding-bottom: 24px; border-bottom: 1px solid var(--border); margin-bottom: 24px; }
  .snap-proof-label { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--light-gray); margin-bottom: 6px; }
  .snap-proof-result { font-family: var(--font-d); font-size: 22px; font-weight: 600; color: var(--graphite); line-height: 1.2; margin-bottom: 4px; }
  .snap-proof-detail { font-size: 13px; color: var(--mid-gray); }

  .snap-value-heading { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--light-gray); margin-bottom: 16px; }
  .snap-value-stack { list-style: none; padding: 0; margin: 0 0 36px; display: flex; flex-direction: column; gap: 14px; }
  .snap-value-stack li { font-size: 14px; line-height: 1.5; color: var(--mid-gray); display: flex; align-items: flex-start; gap: 10px; }
  .snap-check { color: var(--blue); flex-shrink: 0; margin-top: 1px; }
  .snap-footer-line { font-size: 11px; font-style: italic; color: var(--light-gray); text-align: center; letter-spacing: 0.03em; }

  /* Spinner overlay — dark by design */
  #snap-spinner { position: fixed; inset: 0; z-index: 9999; background: #0a0a0a; display: flex; align-items: center; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 0.2s; }
  #snap-spinner.on { opacity: 1; pointer-events: all; }
  .spinner-inner { width: 100%; max-width: 560px; padding: 0 28px; display: flex; flex-direction: column; gap: 18px; }
  .spinner-ref   { font-family: 'Courier New', monospace; font-size: 11px; color: #666; letter-spacing: 0.04em; }
  .spinner-query { font-family: 'Courier New', monospace; font-size: 16px; color: #f0f0f0; border-left: 3px solid #444; padding-left: 14px; line-height: 1.4; }
  .spinner-bar-wrap { display: flex; align-items: center; gap: 12px; }
  .spinner-bar-track { flex: 1; height: 2px; background: #222; overflow: hidden; }
  .spinner-bar  { height: 2px; background: #0071e3; width: 0%; transition: width 0.9s linear; }
  .spinner-pct  { font-family: 'Courier New', monospace; font-size: 12px; color: #666; min-width: 36px; text-align: right; }
  .spinner-log  { font-family: 'Courier New', monospace; font-size: 12px; line-height: 2; display: flex; flex-direction: column; max-height: 220px; overflow: hidden; }
  .log-line  { color: #5aaeee; }
  .log-ready { color: #0071e3; font-weight: bold; }

  @media (min-width: 640px) {
    .snap-above { padding: 64px 0 56px; }
    .snap-below { padding: 48px 0 64px; }
  }
</style>
