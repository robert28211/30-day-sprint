    font-size: 17px; line-height: 1.4;
    letter-spacing: -0.022em;
    color: var(--graphite);
    display: flex; align-items: flex-start; gap: 12px;
  }
  .mp-do-mark {
    font-weight: 600; color: var(--blue); flex-shrink: 0;
    width: 18px; display: inline-block;
  }
  .mp-mark-x { color: var(--light-gray); }
  .mp-fit-line {
    max-width: 720px; margin: 0 auto;
    text-align: center; padding: 20px 28px;
    background: var(--canvas);
    font-family: var(--font-t);
    font-size: 16px; line-height: 1.5;
    letter-spacing: -0.018em;
    color: var(--mid-gray);
  }
  .mp-fit-line strong { color: var(--graphite); font-weight: 600; }

  /* ─── HOW IT WORKS ─── */
  .mp-engine {
    padding: 120px 32px;
    background: var(--canvas);
    border-top: 1px solid var(--border);
  }
  .mp-engine .mp-section-head {
    max-width: 720px; text-align: center;
    margin: 0 auto 48px;
  }
  .mp-engine .mp-h2,
  .mp-engine .mp-lede { margin-left: auto; margin-right: auto; }

  .mp-mechanism {
    max-width: 720px; margin: 0 auto 64px;
    display: flex; flex-direction: column; gap: 18px;
    padding: 32px 36px;
    background: var(--white);
    border-left: 2px solid var(--blue);
    border-radius: 0;
  }
  .mp-mechanism p {
    font-family: var(--font-t);
    font-size: 18px; line-height: 1.55;
    letter-spacing: -0.022em;
    color: var(--graphite);
  }
