  .mp-anchor-stats strong { font-weight: 600; }
  .mp-dot { color: var(--light-gray); }
  @media (max-width: 640px) {
    .mp-anchor-inner { flex-direction: column; align-items: flex-start; }
  }

  /* ─── FOUNDER ─── */
  .mp-founder {
    padding: 96px 32px;
    background: var(--canvas);
  }
  .mp-founder-inner {
    max-width: 960px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr; gap: 36px;
    align-items: center;
  }
