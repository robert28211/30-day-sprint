---
export const prerender = false
import Base from '../../layouts/Base.astro'
import Footer from '../../components/Footer.astro'

const cf = (Astro.locals as any).runtime?.cf
const detectedCity   = cf?.city   || ''
const detectedRegion = cf?.region || cf?.regionCode || ''
const detectedLocation = detectedCity
  ? (detectedRegion ? `${detectedCity}, ${detectedRegion}` : detectedCity)
  : ''
const displayMarket = detectedLocation || 'your market'
---
<Base
  title="Your Market Snapshot — Marketing Performance Group"
  description="Right now, buyers in your market are calling your competitors. See exactly how many are searching for your services — by name and address. Free 30-second snapshot. No email required."
>
  <!-- Minimal top nav — logo only -->
  <nav class="mp-nav">
    <div class="mp-nav-inner">
      <a href="/" class="mp-logo">
        Marketing Performance Group
        <span class="mp-logo-sub">Powered by EngageEngine™</span>
      </a>
    </div>
  </nav>

  <main class="mp">

    <!-- ═══ 1. HERO — copy left, LIVE FORM right ═══ -->
    <section class="mp-hero">
      <div class="mp-hero-grid">
        <div class="mp-hero-copy">
          <h1 class="mp-h1">
            <span class="hero-word">Right </span>
            <span class="hero-word">now, </span>
            <span class="hero-word">buyers </span>
            <span class="hero-word">in </span>
            <span class="hero-word">your </span>
            <span class="hero-word">market </span>
            <span class="hero-word">are </span>
            <span class="hero-word">calling </span>
            <span class="hero-word">your </span>
            <span class="hero-word">competitors.</span>
          </h1>
          <p class="mp-hero-punch hero-sub">Not because your service is worse. Because they found them first.</p>
          <p class="mp-hero-sub hero-sub">We already know who's searching for your services in your market — by name and address. See how many, and whether a competitor has already claimed this data.</p>

          <div class="mp-hero-trust">
            <div class="mp-guarantee-chip">
              <span class="mp-chip-check">✓</span>
              <span>Backed by our <strong>2X Revenue Guarantee</strong> — or we keep working. Free.</span>
            </div>
            <p class="mp-cred-line"><strong>31 years in business. Zero refunds.</strong> Not because we don't offer them — because we don't need to.</p>
          </div>
        </div>

        <!-- LIVE FORM — replaces the static screenshot from / -->
        <div class="snap-card" id="snap-form-card">
          <div class="snap-card-head">
            <span class="snap-card-eye">Pull Your Market Snapshot</span>
            <span class="snap-card-loc">{detectedLocation ? `Detected: ${detectedLocation}` : 'Detecting your market…'}</span>
          </div>

          <form id="snapshot-form" class="snap-form" novalidate>
            <label class="snap-label" for="service-input">What service do you offer?</label>
            <input
              type="text"
              name="trade"
              id="service-input"
              placeholder="e.g. HVAC, Plumbing, Roofing, Fencing"
              required
              class="snap-input"
              autocomplete="off"
              inputmode="text"
            />

            <button type="submit" class="snap-btn" id="snap-submit">
              <span>Show Me Who's Searching in {displayMarket}</span>
              <span class="snap-btn-arrow">→</span>
            </button>

            <p class="snap-micro">No email required · Results in 30 seconds</p>

            <div class="snap-scarcity">
              <span class="snap-scarcity-dot"></span>
              <span><strong>One business per service per market.</strong> If a competitor pulls this before you, you lose access.</span>
            </div>
          </form>
        </div>
      </div>
    </section>

    <!-- ═══ 2. HERO-ANCHOR TESTIMONIAL ═══ -->
    <section class="mp-anchor">
      <div class="mp-anchor-inner" data-animate>
        <div class="mp-anchor-photo">RG</div>
        <div class="mp-anchor-body">
          <p class="mp-anchor-quote">"We were running ads, getting clicks, and watching people disappear. They found the problem. Booked appointments jumped 170%. I haven't touched the budget since."</p>
          <p class="mp-anchor-attr"><strong>George Rogerson</strong> · McClintock HVAC · Charlotte, NC</p>
          <div class="mp-anchor-stats">
            <span><strong>170%</strong> more booked appointments</span>
            <span class="mp-dot">·</span>
            <span>same ad budget</span>
            <span class="mp-dot">·</span>
            <span>90 days</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 3. FOUNDER ═══ -->
    <section class="mp-founder">
      <div class="mp-founder-inner" data-animate>
        <img src="/img/robbie-butt.jpg" alt="Robbie Butt, Founder of EngageEngine™" class="mp-founder-photo" />
        <div class="mp-founder-body">
          <p class="mp-founder-eye">The Founder</p>
          <h2 class="mp-founder-name">Robbie Butt</h2>
          <p class="mp-founder-title">Founder, EngageEngine™ · 41 years in this industry</p>
          <p class="mp-founder-quote">"I personally sign every client. If it doesn't work, I keep working. That's been the deal for 31 years."</p>
          <p class="mp-founder-cred"><strong>31 years in business. Zero refunds.</strong> Not because we don't offer them — because we don't need to.</p>
        </div>
      </div>
    </section>

    <!-- ═══ 4. PRODUCT CLARITY ═══ -->
    <section class="mp-clarity">
      <div class="mp-section-head">
        <p class="mp-eye" data-animate>What This Is</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">EngageEngine™ is a fully managed service.</h2>
        <p class="mp-lede" data-animate data-delay="0.1">Not software. Not a dashboard. Not another platform to learn. We do the work. You tell us your market and your service — we handle audience building, ad placement, optimization, and reporting.</p>
      </div>

      <div class="mp-intel-wrap" data-animate data-delay="0.15">
        <img src="/img/intelligence-layer.png" alt="The Intelligence Layer — input data, the engine, and the outputs that find buyers before they call" class="mp-intel" />
      </div>

      <div class="mp-do-grid" data-animate data-delay="0.2">
        <div class="mp-do-col mp-do-yes">
          <p class="mp-do-h">Here's what you do</p>
          <ul>
            <li><span class="mp-do-mark">✓</span> Tell us your service area</li>
            <li><span class="mp-do-mark">✓</span> Tell us what a good job looks like</li>
            <li><span class="mp-do-mark">✓</span> Answer the calls</li>
          </ul>
        </div>
        <div class="mp-do-col mp-do-no">
          <p class="mp-do-h">Here's what you don't</p>
          <ul>
            <li><span class="mp-do-mark mp-mark-x">✕</span> Manage campaigns</li>
            <li><span class="mp-do-mark mp-mark-x">✕</span> Build audiences</li>
            <li><span class="mp-do-mark mp-mark-x">✕</span> Touch the platform</li>
            <li><span class="mp-do-mark mp-mark-x">✕</span> Learn another dashboard</li>
          </ul>
        </div>
      </div>

      <p class="mp-fit-line" data-animate data-delay="0.25">Built for service businesses doing <strong>$500K–$5M/year in revenue</strong>.</p>
    </section>

    <!-- ═══ 5. HOW IT WORKS ═══ -->
    <section class="mp-engine">
      <div class="mp-section-head">
        <p class="mp-eye" data-animate>How It Works</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">We find buyers before they call anyone.</h2>
      </div>

      <div class="mp-mechanism" data-animate data-delay="0.1">
        <p>Before a homeowner calls anyone, they're already searching. Reading reviews. Comparing options. Looking at maps.</p>
        <p>We identify those <strong>specific people</strong> — by name and address — and put your ads in front of them, and only them, across Google, Facebook, YouTube, and every other platform they use.</p>
        <p>No wasted spend on people who'll never call. No guessing who's in market. Just the buyers who are actually deciding right now.</p>
      </div>

      <img src="/ee-explode.png" alt="EngageEngine — five-layer system" class="mp-explode" data-animate data-delay="0.15" />

      <div class="mp-modules" data-animate data-delay="0.2">
        <div class="mp-mod">
          <div class="mp-mod-num">01</div>
          <div class="mp-mod-name">We find them</div>
          <div class="mp-mod-desc">45,000+ data sources tell us who in your market is searching for your service this week.</div>
        </div>
        <div class="mp-mod">
          <div class="mp-mod-num">02</div>
          <div class="mp-mod-name">We match them</div>
          <div class="mp-mod-desc">Custom audiences built daily — matched to your service, your geography, and the kind of job you want.</div>
        </div>
        <div class="mp-mod">
          <div class="mp-mod-num">03</div>
          <div class="mp-mod-name">We reach them</div>
          <div class="mp-mod-desc">Your ads run on Google, Meta, and programmatic — in front of the same people, across every channel.</div>
        </div>
        <div class="mp-mod">
          <div class="mp-mod-num">04</div>
          <div class="mp-mod-name">We learn from them</div>
          <div class="mp-mod-desc">Every closed job feeds back in. The system gets sharper every week about what a real customer looks like.</div>
        </div>
        <div class="mp-mod">
          <div class="mp-mod-num">05</div>
          <div class="mp-mod-name">We prove it</div>
          <div class="mp-mod-desc">Every lead traced from first signal to closed job. You always see exactly what's working — and what it cost.</div>
        </div>
      </div>

      <p class="mp-timeline" data-animate data-delay="0.25"><strong>Most clients are live within 72 hours of the diagnostic.</strong></p>

      <div class="mp-status" data-animate data-delay="0.3">
        <p class="mp-status-cap">Live system performance — across all active client accounts</p>
        <div class="mp-status-rows">
          <div class="mp-status-row"><span>System Status</span><span class="mp-status-v">ACTIVE</span></div>
          <div class="mp-status-row"><span>Cost Reduction vs. Platform-Native</span><span class="mp-status-v">67–90%</span></div>
          <div class="mp-status-row"><span>Attribution</span><span class="mp-status-v">CLOSED LOOP</span></div>
          <div class="mp-status-row"><span>Audiences</span><span class="mp-status-v">REFRESHED DAILY</span></div>
        </div>
      </div>
    </section>

    <!-- ═══ 6. MECHANISM TESTIMONIAL ═══ -->
    <section class="mp-anchor mp-anchor-alt">
      <div class="mp-anchor-inner" data-animate>
        <div class="mp-anchor-photo">LG</div>
        <div class="mp-anchor-body">
          <p class="mp-anchor-quote">"Our call volume went down. Our sales went up. We're getting better customers — people who are actually ready to buy."</p>
          <p class="mp-anchor-attr"><strong>Larry Gates</strong> · Floor Pro · Columbia, SC</p>
          <div class="mp-anchor-stats">
            <span>Same ad budget</span>
            <span class="mp-dot">·</span>
            <span>fewer junk calls</span>
            <span class="mp-dot">·</span>
            <span><strong>higher close rate</strong></span>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 7. RESULTS ═══ -->
    <section class="mp-results">
      <div class="mp-section-head mp-center">
        <p class="mp-eye" data-animate>Results</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">Four service businesses. Same system. Different verticals.</h2>
        <p class="mp-lede" data-animate data-delay="0.1">These are working businesses you can verify. Ask us for contact info — they've agreed to talk to qualified prospects.</p>
      </div>

      <div class="mp-results-grid">
        <article class="mp-result" data-animate>
          <p class="mp-result-headline">$440K in sales. One week.</p>
          <p class="mp-result-quote">"We diagnosed the problem — buyers found us but didn't trust what they saw. We tightened the trust signals. A hundred and twenty days later, we did $440,000 in sales in one week. Same traffic. Different result."</p>
          <p class="mp-result-attr"><strong>Bob Farnsworth</strong> · Landscape Charleston · Charleston, SC</p>
        </article>
        <article class="mp-result" data-animate data-delay="0.1">
          <p class="mp-result-headline">Monthly sales tripled. Ad spend cut 60%.</p>
          <p class="mp-result-quote">"We fixed the right problem. Monthly sales tripled. We're spending 60% less than before."</p>
          <p class="mp-result-attr"><strong>Bobby Wood</strong> · King's Fencing · Nashville, TN</p>
        </article>
        <article class="mp-result" data-animate data-delay="0.2">
          <p class="mp-result-headline">Phones ring year-round. Zero extra spend.</p>
          <p class="mp-result-quote">"The phones ring. The jobs book. We don't have seasonal slowdowns anymore. And we're not spending any more than we were."</p>
          <p class="mp-result-attr"><strong>Ethan Del Priore</strong> · Carolina Stone Craftsman · Columbia, SC</p>
        </article>
        <article class="mp-result" data-animate data-delay="0.1">
          <p class="mp-result-headline">Close rate jumped. Price resistance disappeared.</p>
          <p class="mp-result-quote">"Our close rates jumped. The price conversations got easier. Buyers just stopped pushing back."</p>
          <p class="mp-result-attr"><strong>John Raz</strong> · Orange County Garage Doors · Tustin, CA</p>
        </article>
      </div>
    </section>

    <!-- ═══ 8. MARKET EXCLUSIVITY ═══ -->
    <section class="mp-exclusivity">
      <div class="mp-exclusivity-inner" data-animate>
        <p class="mp-excl-eye">Market Exclusivity</p>
        <h2 class="mp-excl-h">One business per service category per market.</h2>
        <p class="mp-excl-body">We only take one roofing company in Columbia. One HVAC company. One landscaper. One fencing company. When that slot closes, it closes — until the current client leaves or the market is reopened.</p>
        <div class="mp-excl-warn">
          <p class="mp-excl-warn-h">Your competitor may have already pulled this snapshot.</p>
          <p>If they did, they're already running ads to the buyers who were supposed to call you. The snapshot takes 30 seconds. No email. No call.</p>
        </div>
      </div>
    </section>

    <!-- ═══ 9. GUARANTEE + PRICING ═══ -->
    <section class="mp-guarantee">
      <div class="mp-section-head mp-center">
        <p class="mp-eye" data-animate>The Guarantee</p>
        <h2 class="mp-h2" data-animate data-delay="0.05">The guarantee nobody else in this industry will make.</h2>
      </div>

      <div class="mp-guarantee-card" data-animate data-delay="0.1">
        <div class="mp-guarantee-badge">
          <span class="mp-badge-check">✓</span>
          <span>2X Revenue Guarantee</span>
        </div>
        <p class="mp-guarantee-lead">We stay until it works. That's the deal.</p>
        <p class="mp-guarantee-body">If EngageEngine™ doesn't deliver at least <strong>2X our fee in closed revenue within 90 days</strong> — we keep working until it does. Free. No refund and disappear. We stay. We fix. We run it until the number is there.</p>
        <p class="mp-guarantee-closer">Because if we can't find the buyers, we don't deserve to get paid.</p>

        <div class="mp-pricing">
          <p class="mp-pricing-eye">Pricing</p>
          <p class="mp-pricing-headline">
            <span class="mp-pricing-num">$3,500</span><span class="mp-pricing-per">/month</span>
            <span class="mp-pricing-plus">+ ad spend</span>
          </p>
          <p class="mp-pricing-body">The guarantee is on our fee — not your ad spend. <strong>$3,500 in → at least $7,000/month in closed revenue within 90 days</strong>, or we keep working until it does. Free.</p>
        </div>
      </div>
    </section>

    <!-- ═══ 10. CLOSE — CTA scrolls to top form ═══ -->
    <section class="mp-close">
      <h2 class="mp-close-h1" data-animate>The buyers are already in your market.</h2>
      <p class="mp-close-h2" data-animate data-delay="0.05">The only question is who gets to them first.</p>
      <p class="mp-close-body" data-animate data-delay="0.1">Every day this runs without you, a competitor is capturing demand that should be yours. Your slot may already be gone. Pull the snapshot now — 30 seconds, no email, just your data.</p>
      <div class="mp-close-cta" data-animate data-delay="0.2">
        <a href="#snap-form-card" class="mp-btn-primary" id="close-cta">Show Me Who's Searching in My Market</a>
        <p class="mp-micro">No email required</p>
      </div>
    </section>

  </main>
  <Footer />

  <!-- Spinner overlay — dark, dramatic loading state -->
  <div id="snap-spinner" aria-hidden="true">
    <div class="spinner-inner">
      <div class="spinner-ref" id="spinner-ref"></div>
      <div class="spinner-query" id="spinner-query"></div>
      <div class="spinner-bar-wrap">
        <div class="spinner-bar-track">
          <div class="spinner-bar" id="spinner-bar"></div>
        </div>
        <div class="spinner-pct" id="spinner-pct">0%</div>
      </div>
      <div class="spinner-log" id="spinner-log"></div>
    </div>
  </div>

  <script define:vars={{ detectedLocation }}>
    const autoCity = detectedLocation;

    // Prefill from URL params if present (preserves ad-link behavior)
    const params = new URLSearchParams(window.location.search);
    const paramService = params.get('trade') || params.get('service') || '';
    if (paramService) {
      document.getElementById('service-input').value = paramService;
    }

    const form         = document.getElementById('snapshot-form');
    const input        = document.getElementById('service-input');
    const spinner      = document.getElementById('snap-spinner');
    const spinnerRef   = document.getElementById('spinner-ref');
    const spinnerQuery = document.getElementById('spinner-query');
    const spinnerLog   = document.getElementById('spinner-log');
    const spinnerBar   = document.getElementById('spinner-bar');
    const spinnerPct   = document.getElementById('spinner-pct');
    const closeCta     = document.getElementById('close-cta');

    const STEP_MS = 1100;

    // Final-close CTA: scroll to the form + focus the input
    closeCta?.addEventListener('click', (e) => {
      e.preventDefault();
      document.getElementById('snap-form-card')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setTimeout(() => input?.focus(), 600);
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd      = new FormData(form);
      const service = (fd.get('trade') || '').trim();
      if (!service) {
        input?.focus();
        return;
      }

      const city = autoCity || 'your market';
      const refNum      = 'EE-' + Date.now().toString(36).toUpperCase().slice(-6);
      const totalEvents = 10000 + Math.floor(Math.random() * 40000);

      spinnerRef.textContent   = 'REF: ' + refNum + '  ·  ' + new Date().toLocaleString('en-US', {
        month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit'
      });
      spinnerQuery.textContent = 'QUERY: ' + city + ' / ' + service + ' — last 72 hrs';

      const steps = [
        'INIT      connecting to intent index...',
        'INDEX     ' + totalEvents.toLocaleString() + ' search events in scope — ' + city,
        'FILTER    applying service classification: ' + service,
        'MATCH     cross-referencing 72-hr decision window...',
        'EXCLUDE   removing previously contacted records...',
        'BUILD     compiling buyer signal summary...',
        'READY     data package compiled — access granted.',
      ];

      const TOTAL_MS = steps.length * STEP_MS + 600;
      spinner.classList.add('on');
      runSteps(steps);

      if (typeof gtag !== 'undefined') {
        gtag('event', 'snapshot_gate1_submit', { market: city, trade: service });
      }
      if (typeof fbq !== 'undefined') {
        fbq('track', 'Lead', { content_name: 'Market Snapshot', content_category: service });
      }

      setTimeout(() => {
        const p = new URLSearchParams({ city_state: city, trade: service });
        window.location.href = '/snapshot/preview?' + p.toString();
      }, TOTAL_MS);
    });

    function runSteps(steps) {
      let i = 0;
      spinnerLog.innerHTML = '';
      spinnerBar.style.width = '0%';
      spinnerPct.textContent = '0%';
      function next() {
        if (i >= steps.length) return;
        const el = document.createElement('div');
        el.className = 'log-line' + (i === steps.length - 1 ? ' log-ready' : '');
        el.textContent = steps[i];
        spinnerLog.appendChild(el);
        spinnerLog.scrollTop = spinnerLog.scrollHeight;
        const pct = Math.round(((i + 1) / steps.length) * 100);
        spinnerBar.style.width = pct + '%';
        spinnerPct.textContent = pct + '%';
        i++;
        if (i < steps.length) setTimeout(next, STEP_MS);
      }
      next();
    }
  </script>
</Base>

<style>
  /* ═══════════════════════════════════════════════════════
     /snapshot — homepage content + live form in hero
     Reuses all .mp-* styles from homepage; only adds .snap-* form styles
     ═══════════════════════════════════════════════════════ */

  /* ─── Top nav (logo only) — matches / ─── */
  .mp-nav {
    position: sticky; top: 0; z-index: 100;
    background: rgba(255,255,255,0.72);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border);
  }
  .mp-nav-inner {
    max-width: 1280px; margin: 0 auto;
    padding: 0 32px; height: 56px;
    display: flex; align-items: center;
  }
  .mp-logo {
    font-family: var(--font-t);
    font-size: 13px; font-weight: 600;
    letter-spacing: -0.01em; color: var(--graphite);
    text-decoration: none;
    display: flex; flex-direction: column; gap: 1px;
    min-height: 44px; justify-content: center;
  }
  .mp-logo:hover { color: var(--graphite); text-decoration: none; }
  .mp-logo-sub {
    font-size: 10px; font-weight: 400;
    letter-spacing: 0.02em; color: var(--mid-gray);
  }

  /* ─── Page base ─── */
  .mp { background: var(--canvas); color: var(--graphite); }
  .mp h1, .mp h2 { font-family: var(--font-d); color: var(--graphite); }
  .mp p { color: var(--graphite); }

  /* ─── Primary button ─── */
  .mp-btn-primary {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--blue); color: #fff;
    font-family: var(--font-t); font-size: 17px;
    font-weight: 400; letter-spacing: -0.022em;
    padding: 12px 24px; border-radius: 980px;
    text-decoration: none; transition: background 0.2s;
    line-height: 1; border: none; cursor: pointer;
  }
  .mp-btn-primary:hover { background: var(--blue-link); text-decoration: none; color: #fff; }
  .mp-btn-primary::after {
    content: "→"; font-size: 17px; line-height: 1;
    transition: transform 0.2s;
  }
  .mp-btn-primary:hover::after { transform: translateX(3px); }

  /* ─── Eyebrows + headings (shared) ─── */
  .mp-eye {
    font-family: var(--font-t);
    font-size: 12px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--blue); margin-bottom: 16px;
  }
  .mp-h1 {
    font-family: var(--font-d);
    font-size: clamp(36px, 4.2vw, 52px);
    font-weight: 600; line-height: 1.05;
    letter-spacing: -0.022em; color: var(--graphite);
    margin-bottom: 14px;
  }
  .mp-h2 {
    font-family: var(--font-d);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 600; line-height: 1.07;
    letter-spacing: -0.018em; color: var(--graphite);
    margin-bottom: 20px;
    max-width: 760px;
  }
  .mp-lede {
    font-family: var(--font-t);
    font-size: 21px; line-height: 1.4;
    letter-spacing: -0.022em; color: var(--mid-gray);
    max-width: 680px;
  }
  .mp-micro {
    font-family: var(--font-t);
    font-size: 13px; color: var(--light-gray);
    letter-spacing: -0.015em;
  }
  .mp-section-head { margin-bottom: 48px; }
  .mp-section-head.mp-center { text-align: center; }
  .mp-section-head.mp-center .mp-h2,
  .mp-section-head.mp-center .mp-lede { margin-left: auto; margin-right: auto; }

  /* ─── HERO ─── */
  .mp-hero {
    padding: 80px 32px 100px;
    background: var(--canvas);
  }
  .mp-hero-grid {
    max-width: 1320px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr; gap: 56px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .mp-hero-grid {
      grid-template-columns: minmax(360px, 460px) minmax(0, 1fr);
      gap: 64px;
    }
  }
  .mp-hero-copy { max-width: 460px; }
  .mp-hero-punch {
    font-family: var(--font-d);
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 500; line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--blue); margin-bottom: 24px;
  }
  .mp-hero-sub {
    font-family: var(--font-t);
    font-size: 19px; line-height: 1.5;
    letter-spacing: -0.022em;
    color: var(--mid-gray);
    max-width: 540px; margin-bottom: 36px;
  }
  .mp-hero-trust {
    display: flex; flex-direction: column; gap: 14px;
    padding-top: 24px; border-top: 1px solid var(--border);
  }
  .mp-guarantee-chip {
    display: inline-flex; align-items: center; gap: 10px;
    align-self: flex-start;
    padding: 8px 14px;
    background: var(--white); border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-t);
    font-size: 13px; color: var(--graphite);
    letter-spacing: -0.01em;
  }
  .mp-guarantee-chip strong { font-weight: 600; }
  .mp-chip-check {
    width: 18px; height: 18px; border-radius: 50%;
    background: var(--blue); color: #fff;
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 700;
  }
  .mp-cred-line {
    font-family: var(--font-t);
    font-size: 14px; line-height: 1.5;
    letter-spacing: -0.015em;
    color: var(--mid-gray); max-width: 500px;
  }
  .mp-cred-line strong { color: var(--graphite); font-weight: 600; }

  /* ─── SNAPSHOT FORM CARD (hero right column) ─── */
  .snap-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 32px 36px;
    box-shadow: var(--shadow-xl, rgba(0,0,0,0.22) 3px 5px 30px 0px);
    justify-self: stretch;
    width: 100%;
    max-width: 560px;
    margin: 0 auto;
  }
  .snap-card-head {
    display: flex; justify-content: space-between; align-items: baseline;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 22px;
    gap: 12px; flex-wrap: wrap;
  }
  .snap-card-eye {
    font-family: var(--font-t);
    font-size: 11px; font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--blue);
  }
  .snap-card-loc {
    font-family: var(--font-m);
    font-size: 12px; color: var(--mid-gray);
    letter-spacing: 0.02em;
  }
  .snap-form { display: flex; flex-direction: column; }
  .snap-label {
    font-family: var(--font-t);
    font-size: 13px; font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--graphite); margin-bottom: 10px;
  }
  .snap-input {
    width: 100%;
    background: var(--canvas);
    border: 1px solid var(--border);
    border-radius: 0;
    color: var(--graphite);
    font-family: var(--font-t);
    font-size: 17px;
    letter-spacing: -0.022em;
    padding: 14px 16px;
    margin-bottom: 18px;
    outline: none;
    -webkit-appearance: none;
    transition: border-color 0.15s, background 0.15s;
  }
  .snap-input::placeholder { color: var(--light-gray); }
  .snap-input:focus {
    border-color: var(--blue);
    background: var(--white);
  }
  .snap-btn {
    width: 100%;
    display: inline-flex; align-items: center; justify-content: center; gap: 10px;
    background: var(--blue); color: #fff;
    font-family: var(--font-t);
    font-size: 17px; font-weight: 400;
    letter-spacing: -0.022em;
    padding: 14px 20px;
    border: none; border-radius: 980px;
    cursor: pointer; line-height: 1;
    transition: background 0.2s;
  }
  .snap-btn:hover { background: var(--blue-link); }
  .snap-btn:disabled { opacity: 0.6; cursor: wait; }
  .snap-btn-arrow {
    display: inline-block; transition: transform 0.2s;
  }
  .snap-btn:hover .snap-btn-arrow { transform: translateX(3px); }
  .snap-micro {
    font-family: var(--font-t);
    font-size: 12px; color: var(--light-gray);
    letter-spacing: -0.015em;
    text-align: center;
    margin-top: 12px;
  }
  .snap-scarcity {
    display: flex; align-items: flex-start; gap: 10px;
    margin-top: 22px; padding: 12px 14px;
    background: rgba(214,40,40,0.05);
    border: 1px solid rgba(214,40,40,0.2);
    border-radius: 8px;
    font-family: var(--font-t);
    font-size: 13px; line-height: 1.45;
    color: var(--graphite);
    letter-spacing: -0.015em;
  }
  .snap-scarcity strong { color: #d62828; font-weight: 600; }
  .snap-scarcity-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: #d62828; flex-shrink: 0;
    margin-top: 6px;
    animation: snapPulse 1.6s ease-in-out infinite;
  }
  @keyframes snapPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.35); }
  }

  /* ─── ANCHOR TESTIMONIALS ─── */
  .mp-anchor {
    background: var(--white);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 48px 32px;
  }
  .mp-anchor-alt { background: var(--canvas); }
  .mp-anchor-inner {
    max-width: 960px; margin: 0 auto;
    display: flex; align-items: center; gap: 32px;
  }
  .mp-anchor-photo {
    width: 80px; height: 80px;
    border-radius: 50%;
    background: var(--canvas);
    border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-d);
    font-size: 22px; font-weight: 600;
    color: var(--mid-gray);
    flex-shrink: 0;
  }
  .mp-anchor-quote {
    font-family: var(--font-d);
    font-size: 22px; line-height: 1.36;
    letter-spacing: -0.022em;
    color: var(--graphite);
    font-weight: 400;
    margin-bottom: 12px;
  }
  .mp-anchor-attr {
    font-family: var(--font-t);
    font-size: 14px; color: var(--mid-gray);
    margin-bottom: 8px; letter-spacing: -0.018em;
  }
