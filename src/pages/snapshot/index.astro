    color: var(--graphite); margin-bottom: 6px;
  }
  .mp-founder-title {
    font-family: var(--font-t);
    font-size: 15px; color: var(--mid-gray);
    letter-spacing: -0.018em; margin-bottom: 24px;
  }
  .mp-founder-quote {
    font-family: var(--font-d);
    font-size: 21px; line-height: 1.36;
    letter-spacing: -0.022em;
    color: var(--graphite);
    padding-left: 18px;
    border-left: 2px solid var(--blue);
    margin-bottom: 24px;
  }
  .mp-founder-cred {
    font-family: var(--font-t);
    font-size: 14px; line-height: 1.55;
    letter-spacing: -0.018em;
    color: var(--mid-gray);
  }
  .mp-founder-cred strong { color: var(--graphite); font-weight: 600; }

  /* ─── PRODUCT CLARITY ─── */
  .mp-clarity {
    padding: 120px 32px;
    background: var(--white);
    border-top: 1px solid var(--border);
  }
  .mp-clarity .mp-section-head {
    max-width: 720px; text-align: center;
    margin: 0 auto 64px;
  }
  .mp-clarity .mp-h2,
  .mp-clarity .mp-lede { margin-left: auto; margin-right: auto; }

  .mp-intel-wrap {
    max-width: 1080px; margin: 0 auto 64px;
    border-radius: 8px; overflow: hidden;
    box-shadow: var(--shadow-xl, rgba(0,0,0,0.22) 3px 5px 30px 0px);
    background: #0a0a0a;
